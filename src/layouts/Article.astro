---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  audience: string;
  category: string;
  readingMinutes: number;
  headings: MarkdownHeading[];
}

const {
  title,
  description,
  publishedAt,
  updatedAt,
  author,
  audience,
  category,
  readingMinutes,
  headings,
} = Astro.props;

const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
const visibleHeadings = headings.filter((heading) => heading.depth === 2);
const publishedIso = publishedAt.toISOString();
const updatedIso = updatedAt?.toISOString();
---

<Base
  title={`${title} | Registry Stack`}
  description={description}
  type="article"
  publishedAt={publishedIso}
  updatedAt={updatedIso}
  author={author}
  ogImagePath="/blog-field-notes-og.png"
  ogImageAlt="Registry Stack Field Notes: Define the question. Choose the boundary. Preserve the evidence."
>
  <SiteHeader current="blog" />
  <main>
    <header class="article-header">
      <div class="article-header-inner">
        <p class="eyebrow"><span class="reg-no">Field notes</span> · {category}</p>
        <h1>{title}</h1>
        <p class="article-standfirst">{description}</p>
        <dl class="article-meta">
          <div>
            <dt>Published</dt>
            <dd><time datetime={publishedIso}>{dateFormatter.format(publishedAt)}</time></dd>
          </div>
          <div>
            <dt>For</dt>
            <dd>{audience}</dd>
          </div>
          <div>
            <dt>Reading time</dt>
            <dd>{readingMinutes} minutes</dd>
          </div>
        </dl>
        {
          updatedAt && (
            <p class="article-updated">
              Materially updated <time datetime={updatedIso}>{dateFormatter.format(updatedAt)}</time>.
            </p>
          )
        }
      </div>
    </header>

    <div class="article-frame">
      <article class="article-body">
        <slot />
      </article>

      {
        visibleHeadings.length > 2 && (
          <aside class="article-contents" aria-labelledby="article-contents-title">
            <p class="eyebrow" id="article-contents-title">On this page</p>
            <ol>
              {visibleHeadings.map((heading) => (
                <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    <DocsHandoff
      eyebrow="Continue into the implementation"
      heading="Take the decision into the technical documentation."
      primaryLabel="Read the technical docs"
      primaryHref="https://docs.registrystack.org/"
      emphasis="docs"
    />
  </main>
  <SiteFooter />
</Base>
