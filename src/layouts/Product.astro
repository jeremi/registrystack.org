---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { describeServiceHref } from '../data/contact';
import type { products } from '../data/products';
import { localeForPath, localizedPath, translator } from '../i18n';

interface Props {
  product: (typeof products)[number];
  heading: string;
  // The hero lead. The search snippet is the product's shorter `description`.
  description: string;
  note?: string;
}
const { product, heading, description, note } = Astro.props;
// French product pages pass the product from src/data/fr/products.ts; the
// frame's own wording follows the page's locale.
const locale = localeForPath(Astro.url.pathname);
const t = translator(locale);
const l = (href: string) => localizedPath(href, locale);
const discussHref = describeServiceHref(product.name, locale);
---
<Base title={product.name + ' | Registry Stack'} description={product.description}>
  <SiteHeader current={product.key} />
  <main id="main-content" tabindex="-1" class="product-page">
    <section class="hero" aria-labelledby="product-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">{product.name}</p>
          <h1 id="product-title">{heading}</h1>
          <p class="hero-lead">{description}</p>
          <div class="hero-actions" aria-label={t('Primary actions', 'Actions principales')}>
            <a class="button button-primary" href="#product-example">{t('See an example', 'Voir un exemple')}</a>
            <a class="button button-secondary" href="#fit">{t('How it fits', 'Comment il s’intègre')}</a>
          </div>
          <p class="hero-note">{note ?? t('Open-source software. Your team or an appointed provider can operate it, or we run it for you. Screens and connections are agreed in the implementation.', 'Logiciel open source. Votre équipe ou un prestataire désigné peut l’exploiter, ou nous l’exploitons pour vous. Les écrans et les connexions sont convenus lors de la mise en œuvre.')}</p>
        </div>
      </div>
    </section>
    <slot />
    <section class="final-cta" aria-labelledby="product-pilot-title">
      <div class="section-inner">
        <p class="eyebrow">{t('Discuss your service', 'Décrivez votre service')}</p>
        <h2 id="product-pilot-title">{t('Start with the service you need to deliver.', 'Commencez par le service que vous devez assurer.')}</h2>
        <p>{t('Tell us what your service needs to do. We can agree what to configure, which systems to connect and what help your team needs.', 'Dites-nous ce que votre service doit faire. Nous pouvons convenir de ce qu’il faut configurer, des systèmes à connecter et de l’aide dont votre équipe a besoin.')}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={discussHref}>{t('Discuss your service', 'Décrivez votre service')}</a>
          <a class="button button-secondary" href={l('/pricing/')}>{t('Implementation and pricing', 'Mise en œuvre et tarifs')}</a>
        </div>
        <p class="final-cta-note"><a href={l('/products/')}>{t('See how the products fit around a register', 'Voir comment les produits s’articulent autour d’un registre')}</a>.</p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .product-page :global(.section-inner) { padding-top: clamp(44px, 6vw, 68px); padding-bottom: clamp(44px, 6vw, 68px); }
  .product-page :global(h2) { font-size: clamp(28px, 3.7vw, 42px); }
  .product-page :global(.product-facts) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .product-page :global(.product-facts article) { border-top: 2px solid var(--registry-blue); padding-top: 20px; }
  .product-page :global(.product-facts p) { margin-bottom: 0; }
  .product-page :global(.product-fit) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
  .product-page :global(.product-fit dl) { margin: 0; }
  .product-page :global(.product-fit dt) { font-weight: 700; color: var(--registry-ink); margin-bottom: 5px; }
  .product-page :global(.product-fit dd) { margin: 0 0 20px; padding-bottom: 18px; border-bottom: 1px solid var(--registry-rule); line-height: 1.55; }
  .product-page :global(.product-fit dd:last-child) { margin-bottom: 0; }
  .product-page :global(.product-note) { border-left: 3px solid var(--registry-blue); padding-left: 18px; margin: 28px 0 0; }
  .product-page :global(.final-cta-note) { font-size: var(--type-sm); margin-top: 12px; opacity: 0.85; }
  @media (max-width: 700px) {
    .product-page :global(.product-facts), .product-page :global(.product-fit) { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
