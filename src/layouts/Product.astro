---
import Base from './Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { contactEmail, describeServiceHref } from '../data/contact';
import type { products } from '../data/products';

interface Props {
  product: (typeof products)[number];
  heading: string;
  // The hero lead. The search snippet is the product's shorter `description`.
  description: string;
  note?: string;
}
const { product, heading, description, note } = Astro.props;
const discussHref = describeServiceHref(product.name);
---
<Base title={product.name + ' | Registry Stack'} description={product.description}>
  <SiteHeader current={product.key} />
  <main class="product-page">
    <section class="hero" aria-labelledby="product-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">{product.name}</p>
          <h1 id="product-title">{heading}</h1>
          <p class="hero-lead">{description}</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="#product-example">See an example</a>
            <a class="button button-secondary" href="#fit">How it fits</a>
          </div>
          <p class="hero-note">{note ?? 'Open-source software for institutional pilots. An implementation can include staff screens and connections to your existing systems.'}</p>
        </div>
      </div>
    </section>
    <slot />
    <section class="final-cta" aria-labelledby="product-pilot-title">
      <div class="section-inner">
        <p class="eyebrow">Discuss your service</p>
        <h2 id="product-pilot-title">Start with the service you need to deliver.</h2>
        <p>Tell us which service you want to improve and which systems you already use. We can agree what to configure, what to connect and what help your team needs.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={discussHref}>Discuss your service</a>
          <a class="button button-secondary" href="/pricing/">Implementation and support</a>
        </div>
        <p class="final-cta-note">Or email {contactEmail}.</p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .product-page :global(.section-inner) { padding-top: clamp(44px, 6vw, 68px); padding-bottom: clamp(44px, 6vw, 68px); }
  .product-page :global(h2) { font-size: clamp(28px, 3.7vw, 42px); }
  .product-page :global(.product-facts) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .product-page :global(.product-facts article) { border-top: 2px solid var(--registry-blue); padding-top: 20px; }
  .product-page :global(.product-facts p) { margin-bottom: 0; }
  .product-page :global(.product-fit) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
  .product-page :global(.product-fit dl) { margin: 0; }
  .product-page :global(.product-fit dt) { font-weight: 700; color: var(--registry-ink); margin-bottom: 5px; }
  .product-page :global(.product-fit dd) { margin: 0 0 20px; padding-bottom: 18px; border-bottom: 1px solid var(--registry-rule); line-height: 1.55; }
  .product-page :global(.product-fit dd:last-child) { margin-bottom: 0; }
  .product-page :global(.product-note) { border-left: 3px solid var(--registry-blue); padding-left: 18px; margin: 28px 0 0; }
  .product-page :global(.final-cta-note) { font-size: var(--type-sm); margin-top: 12px; opacity: 0.85; }
  @media (max-width: 700px) {
    .product-page :global(.product-facts), .product-page :global(.product-fit) { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
