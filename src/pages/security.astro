---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';
import { askQuestionHref } from '../data/contact';

const pageTitle = 'Security | Registry Stack';
const pageDescription =
  'Controls and operating responsibilities for governed changes, limited disclosure, signed answers, and accountable review.';
const securityDocsHref = 'https://docs.registrystack.org/spec/rs-sec-g/';
const securityReportHref =
  'https://github.com/registrystack/registry-stack/security/advisories/new';
const releaseVerifyHref = 'https://github.com/registrystack/registry-stack/blob/main/release/VERIFY.md';

// Explain the useful control first, with implementation and operating detail
// available through the maintained security documentation.
const properties = [
  {
    title: 'Authorize changes to the register',
    body:
      'Base Registry Engine checks who may change a record and whether the change follows your configured rules. It keeps revisions so authorized users can inspect the history through your application.',
  },
  {
    title: 'Limit what each service receives',
    body:
      'Evidence Gateway checks permission for a predefined question before consulting its source. Your organization defines the permitted recipient, purpose, source, and answer.',
  },
  {
    title: 'Verify where an answer came from',
    body:
      'Evidence Gateway signs its answers. A receiving service can check that the answer came from a trusted issuer, has not been altered, and meets the expected purpose and validity requirements.',
  },
  {
    title: 'Keep human decisions attributable',
    body:
      'Registry Casework records who reviewed each item and who decided. Applying a change is a separate step. The register checks the permission of the person or service applying it and records who made the change.',
  },
  {
    title: 'Retain activity for review',
    body:
      'Record history and audit events support later review. Evidence Gateway records authorized source access and disclosure before releasing an answer. Your team protects and retains these records for review.',
  },
];

const responsibilities = [
  {
    title: 'Your organization sets the rules',
    body:
      'You own the records and decide who may maintain them, which services may ask for information, and for what purpose. Your team defines the rules, reviews the configured permissions, and decides how returned information is used.',
  },
  {
    title: 'Your operator runs the deployment',
    body:
      'Your organization or an operator it appoints runs the software in an environment it controls. The operator manages database and source access, credentials, audit logs, monitoring, updates, backups, and incident response. The software does not send your records or audit logs to Aubex.',
  },
];

const evidence = [
  {
    label: 'Security model and responsibilities',
    href: securityDocsHref,
    description: 'Trust boundaries, request checks, and the controls your operator supplies.',
  },
  {
    label: 'Security self-assessment',
    href: 'https://docs.registrystack.org/security/self-assessment/',
    description: 'Control-by-control questions and implementation references for an evaluator.',
  },
  {
    label: 'Release verification',
    href: releaseVerifyHref,
    description: 'How to check release assets against signed checksums and inspect the software bill of materials.',
  },
  {
    label: 'Known limitations',
    href: 'https://docs.registrystack.org/explanation/known-limitations/',
    description: 'What the software does not do yet, its release status, and the platforms a release supports.',
  },
  {
    label: 'Source code and releases',
    href: 'https://github.com/registrystack/registry-stack',
    description: 'The public implementation and its release history for your technical team and auditors.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="security" />

  <main>
    <section class="hero" aria-labelledby="security-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Security</p>
          <h1 id="security-hero-title">Keep authority and accountability with your organization.</h1>
          <p class="hero-lead">
            Registry Stack applies the access, change, review, and disclosure rules your
            organization configures. Your governance team defines those rules, and your operator
            protects the deployment and its records.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="security-properties-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">What the software does</p>
          <h2 id="security-properties-title">Make each change and disclosure accountable.</h2>
          <p>
            Base Registry Engine, Evidence Gateway, and Registry Casework have separate
            responsibilities and can be used independently. Each enforces its own access boundary.
          </p>
        </div>
        <div class="security-properties">
          {properties.map((item) => (
            <article class="quiet-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="security-shared-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Organizational responsibility</p>
          <h2 id="security-shared-title">Assign policy and operating responsibilities explicitly.</h2>
          <p>
            Software controls implement part of the security model. Governance, source quality,
            identity, infrastructure, and operating procedures remain part of the service.
          </p>
        </div>
        <div class="security-pair">
          {responsibilities.map((item) => (
            <article class="quiet-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <p class="security-note">
          Your technical team scopes database accounts, source connections, and network access
          to the work each deployment needs. The maintained security docs explain the threat
          model, host protection, key management, and audit retention.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="assertion-protection-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Understanding a signed answer</p>
          <h2 id="assertion-protection-title">A service can verify the answer before using it.</h2>
        </div>
        <div class="security-explanation">
          <p>
            In an illustrative procurement check, Evidence Gateway consults the configured
            business register and signs an answer about a supplier&rsquo;s registration status.
            The procurement service checks the issuer, signature, intended use, and validity
            before relying on that answer.
          </p>
          <p>
            The signature establishes the origin and integrity of the answer. The register
            owner remains responsible for the source information, including its factual accuracy
            and current status. A valid signature does not establish that a fact is correct or
            that a person is legally entitled to something. The procurement service remains
            responsible for its purchasing decision.
          </p>
          <a class="inline-cta" href="/products/evidence-gateway/">Explore Evidence Gateway &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="security-verify-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">For governance, security, and technical review</p>
          <h2 id="security-verify-title">Review the controls before adoption.</h2>
          <p>
            Your evaluators can inspect the source, verify release assets, review the security
            model, and run local tutorials with sample data. The maintained documentation covers
            threats, operating responsibilities, and known limitations in more detail.
          </p>
        </div>
        <div class="security-properties">
          {evidence.map((item) => (
            <article class="quiet-card">
              <h3><a href={item.href}>{item.label}</a></h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
        <div class="security-contact">
          <a class="button button-secondary" href={askQuestionHref('Registry Stack security and governance')}>Ask about your requirements</a>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="security-report-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Coordinated disclosure</p>
          <h2 id="security-report-title">Report a security issue privately.</h2>
          <p>
            Use GitHub private vulnerability reporting so an issue can be investigated before
            it is made public and handled through coordinated disclosure.
          </p>
        </div>
        <div class="solution-choice-row">
          <a class="button button-primary" href={securityReportHref}>Report a vulnerability</a>
          <a class="button button-secondary" href={securityDocsHref}>Read the security docs</a>
        </div>
        <p class="security-disclosure-extra">
          <a class="inline-cta" href="/.well-known/security.txt">Machine-readable reporting details in security.txt &rarr;</a>
        </p>
      </div>
    </section>
  </main>

  <DocsHandoff
    eyebrow="For your security team"
    heading="Review the detailed security model with your technical team."
    primaryLabel="Read the security docs"
    primaryHref={securityDocsHref}
    emphasis="docs"
  />
  <SiteFooter />
</Base>

<style>
  /* Balanced pairs keep the controls and organizational responsibilities easy
     to compare without ranking them. */
  .security-properties,
  .security-pair {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(24px, 4vw, 36px);
  }

  .quiet-card h3 {
    margin-top: 0;
  }

  .quiet-card p:last-child,
  .security-explanation p:last-child {
    margin-bottom: 0;
  }

  .security-note {
    color: var(--registry-body);
    margin: clamp(24px, 3vw, 32px) auto 0;
    max-width: 760px;
    text-align: center;
  }

  .security-explanation {
    border-top: 2px solid var(--registry-ink);
    padding-top: 18px;
  }

  .security-disclosure-extra {
    margin-top: 20px;
  }

  .security-contact {
    margin-top: clamp(24px, 3vw, 32px);
  }

  .security-contact p {
    font-size: var(--type-sm);
    margin: 12px 0 0;
  }

  @media (max-width: 620px) {
    .security-properties,
    .security-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
