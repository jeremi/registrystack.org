---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { askQuestionHref } from '../data/contact';

const pageTitle = 'Security | Registry Stack';
const pageDescription =
  'Read about the Registry Stack controls for governed changes, limited disclosure, signed answers and accountable review. See who owns each operating duty.';
const securityDocsHref = 'https://docs.registrystack.org/spec/rs-sec-g/';
const securityReportHref =
  'https://github.com/registrystack/registry-stack/security/advisories/new';
const releaseVerifyHref = 'https://github.com/registrystack/registry-stack/blob/main/release/VERIFY.md';

// Explain the useful control first, with implementation and operating detail
// available through the maintained security documentation.
const properties = [
  {
    title: 'Check each change to a record',
    body: 'Base Registry Engine checks who may change a record. It checks whether the change follows your configured rules. It keeps the record’s revisions. Authorised users can inspect the history through your institution’s application.',
  },
  {
    title: 'Check permission before each answer',
    body: 'Evidence Gateway checks permission for a predefined question before it consults the source. It records the authorised source access and the disclosure before it releases the answer. You define the permitted recipient, purpose, source and answer.',
  },
  {
    title: 'Sign each answer',
    body: 'Evidence Gateway signs its answers. A receiving service can verify who issued the answer and whether it was altered. It can also verify the intended use and whether the answer is valid. The source owner stays responsible for the accuracy of the information. The receiving service makes its own decision.',
  },
  {
    title: 'Record who reviews and who decides',
    body: 'Registry Casework records who reviewed each item and who decided. Applying the change is a separate step. The register checks the permission of the person or service that applies the change. It also records who made the change.',
  },
];

const responsibilities = [
  {
    title: 'Own the records and set the rules',
    body: 'Your institution owns the records. It decides who may maintain them. It decides which services may ask for information and for what purpose. Your institution’s team defines the rules and reviews the configured permissions. It also decides how returned information is used.',
  },
  {
    title: 'Run and protect the deployment',
    body: 'Your institution or an operator it appoints runs the software in an environment it controls. Or we run it for you. The operator manages database access, source access and credentials. It also manages audit logs, monitoring and updates. It manages backups and incident response too. Your institution’s team controls the systems the deployment connects to.',
  },
];

const evidence = [
  {
    label: 'Security model and responsibilities',
    href: securityDocsHref,
    description: 'The trust boundaries, the checks on each request and the controls your operator supplies.',
  },
  {
    label: 'Security self-assessment',
    href: 'https://docs.registrystack.org/security/self-assessment/',
    description: 'Questions on each control for your evaluators, with references to the implementation.',
  },
  {
    label: 'Release verification',
    href: releaseVerifyHref,
    description: 'How to check release assets against signed checksums and how to inspect the software bill of materials.',
  },
  {
    label: 'Known limitations',
    href: 'https://docs.registrystack.org/explanation/known-limitations/',
    description: 'What the software does not do, its release status and the platforms a release supports.',
  },
  {
    label: 'Source code and releases',
    href: 'https://github.com/registrystack/registry-stack',
    description: 'The public source code and its release history, for your technical team and your auditors.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="security" />

  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="security-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Security</p>
          <h1 id="security-hero-title">Your institution keeps authority over its register and stays accountable for it.</h1>
          <p class="hero-lead">Registry Stack applies the access, change, review and disclosure rules that you configure. Your governance team defines those rules. Your operator protects the deployment and its records.</p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="security-properties-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">What the software does</p>
          <h2 id="security-properties-title">You can trace each change and each disclosure to a person or service.</h2>
          <p><a href="/products/base-registry/">Base Registry Engine</a>, <a href="/products/evidence-gateway/">Evidence Gateway</a> and <a href="/products/casework/">Registry Casework</a> have separate responsibilities. You can use them independently. Each one enforces its own access boundary.</p>
        </div>
        <div class="security-properties">
          {properties.map((item) => (
            <article class="quiet-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="security-shared-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Your institution’s responsibilities</p>
          <h2 id="security-shared-title">Each policy and operating duty for your register has a named owner.</h2>
          <p>The software controls cover one part of the security model. Governance, source quality, identity, infrastructure and operating procedures stay part of your service.</p>
        </div>
        <div class="security-pair">
          {responsibilities.map((item) => (
            <article class="quiet-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <p class="security-note">Your technical team limits database accounts, source connections and network access to what each deployment needs. The maintained security documentation explains the threat model, host protection, key management and audit retention.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="security-verify-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">For governance, security and technical review</p>
          <h2 id="security-verify-title">You can check the controls before you adopt Registry Stack.</h2>
          <p>Your evaluators can inspect the source code and verify the release assets. They can review the security model. They can also run tutorials locally with sample data. The maintained documentation covers threats, operating responsibilities and known limitations in more detail.</p>
        </div>
        <div class="security-properties">
          {evidence.map((item) => (
            <article class="quiet-card">
              <h3><a href={item.href}>{item.label}</a></h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
        <div class="security-contact">
          <a class="button button-secondary" href={askQuestionHref('Registry Stack security and governance')}>Ask about your requirements</a>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="security-report-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Coordinated disclosure</p>
          <h2 id="security-report-title">Report a security issue privately.</h2>
          <p>Use GitHub private vulnerability reporting. The issue can then be investigated before it is made public. It is handled through coordinated disclosure.</p>
        </div>
        <div class="solution-choice-row">
          <a class="button button-primary" href={securityReportHref}>Report a vulnerability</a>
          <a class="button button-secondary" href={securityDocsHref}>Read the security docs</a>
        </div>
        <p class="security-disclosure-extra">
          <a class="inline-cta" href="/.well-known/security.txt">See the machine-readable reporting details in security.txt &rarr;</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  /* Balanced pairs keep the controls and organizational responsibilities easy
     to compare without ranking them. */
  .security-properties,
  .security-pair {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(24px, 4vw, 36px);
  }

  .quiet-card h3 {
    margin-top: 0;
  }

  .quiet-card p:last-child {
    margin-bottom: 0;
  }

  .security-note {
    color: var(--registry-body);
    margin: clamp(24px, 3vw, 32px) auto 0;
    max-width: 760px;
    text-align: center;
  }

  .security-disclosure-extra {
    margin-top: 20px;
  }

  .security-contact {
    margin-top: clamp(24px, 3vw, 32px);
  }

  .security-contact p {
    font-size: var(--type-sm);
    margin: 12px 0 0;
  }

  @media (max-width: 620px) {
    .security-properties,
    .security-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
