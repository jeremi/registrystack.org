---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';

const pageTitle = 'Security | Registry Stack';
const pageDescription =
  'How Registry Stack controls changes and access, what a signed answer establishes, and how your organization can review the software.';
const securityDocsHref = 'https://docs.registrystack.org/spec/rs-sec-g/';
const securityReportHref =
  'https://github.com/registrystack/registry-stack/security/advisories/new';
const releaseVerifyHref = 'https://github.com/registrystack/registry-stack/blob/main/release/VERIFY.md';

// Explain the useful control first, with implementation and operating detail
// available through the maintained security documentation.
const properties = [
  {
    title: 'Control changes to the register',
    body:
      'Base Registry Engine checks who may change a record and whether the change follows your configured rules. It keeps revisions so authorized users can inspect the history through your application.',
  },
  {
    title: 'Decide what each service receives',
    body:
      'Evidence Gateway checks permission for a predefined question before reading the source. Registry Relay applies your rules for access to selected fields. Your organization defines those permissions and the information each service may receive.',
  },
  {
    title: 'Verify where an answer came from',
    body:
      'Evidence Gateway signs its answers. A receiving service can check that the answer came from a trusted issuer, has not been altered, and meets the expected purpose and validity requirements.',
  },
  {
    title: 'Review activity',
    body:
      'The products record audit events for the requests they handle. Evidence Gateway records authorized source access and disclosure before releasing an answer. Your team protects and retains these records for review.',
  },
];

const responsibilities = [
  {
    title: 'Your organization sets the rules',
    body:
      'You own the records and decide who may maintain them, which services may ask for information, and for what purpose. Your team defines the rules, reviews the configured permissions, and decides how returned information is used.',
  },
  {
    title: 'Your operator runs the deployment',
    body:
      'You host the software in an environment you control. Your operator manages access to the database or source, protects credentials and audit logs, and handles monitoring, updates, and incident response. The software does not send your records or audit logs to Aubex.',
  },
];

const evidence = [
  {
    label: 'Security model and responsibilities',
    href: securityDocsHref,
    description: 'Trust boundaries, request checks, and the controls your operator supplies.',
  },
  {
    label: 'Security self-assessment',
    href: 'https://docs.registrystack.org/security/self-assessment/',
    description: 'Published security claims and the evidence available to review them.',
  },
  {
    label: 'Release verification',
    href: releaseVerifyHref,
    description: 'How to check release assets against signed checksums and inspect the software bill of materials.',
  },
  {
    label: 'Source code and releases',
    href: 'https://github.com/registrystack/registry-stack',
    description: 'The public implementation and its release history for your technical team and auditors.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="security" />

  <main>
    <section class="hero" aria-labelledby="security-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Security</p>
          <h1 id="security-hero-title">Your records. Your rules. Controls you can review.</h1>
          <p class="hero-lead">
            Registry Stack helps your organization control changes to its records and access
            to the information it shares. You define the permissions and operate the deployment;
            the open-source software applies the configured rules.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="security-properties-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">What the software does</p>
          <h2 id="security-properties-title">Make each change and disclosure accountable.</h2>
          <p>
            Base Registry Engine and Evidence Gateway address different responsibilities and
            can be used independently. Each product checks its own access rules.
          </p>
        </div>
        <div class="security-properties">
          {properties.map((item) => (
            <article class="quiet-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="security-shared-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Organizational responsibility</p>
          <h2 id="security-shared-title">Keep authority with the people responsible for the register.</h2>
          <p>
            Software controls support the rules your organization has agreed. They work
            alongside your governance, source systems, and operating safeguards.
          </p>
        </div>
        <div class="security-pair">
          {responsibilities.map((item) => (
            <article class="quiet-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
        <p class="security-note">
          Your technical team scopes database accounts, source connections, and network access
          to the work each deployment needs. The maintained security docs explain the threat
          model, host protection, key management, and audit retention.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="assertion-protection-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Understanding a signed answer</p>
          <h2 id="assertion-protection-title">A service can verify the answer before using it.</h2>
        </div>
        <div class="security-explanation">
          <p>
            In an illustrative procurement check, Evidence Gateway consults the configured
            business register and signs an answer about a supplier&rsquo;s registration status.
            The procurement service checks the issuer, signature, intended use, and validity
            before relying on that answer.
          </p>
          <p>
            The signature establishes the origin and integrity of the answer. The registry
            owner remains responsible for the source information; the procurement service
            remains responsible for its purchasing decision.
          </p>
          <a class="inline-cta" href="/solutions/evidence-gateway/">Explore Evidence Gateway &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="security-verify-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">For your technical and security teams</p>
          <h2 id="security-verify-title">Inspect the software and the evidence behind it.</h2>
          <p>
            Your team and auditors can review the source, verify a release, and use the local
            tutorials to assess product behavior with sample data. Detailed threat and operating
            guidance lives in the maintained documentation.
          </p>
        </div>
        <div class="security-properties">
          {evidence.map((item) => (
            <article class="quiet-card">
              <h3><a href={item.href}>{item.label}</a></h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="security-report-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Coordinated disclosure</p>
          <h2 id="security-report-title">Report a security issue privately.</h2>
          <p>
            Use GitHub private vulnerability reporting so an issue can be investigated before
            it is made public. We will acknowledge your report and work with you on coordinated
            disclosure.
          </p>
        </div>
        <div class="solution-choice-row">
          <a class="button button-primary" href={securityReportHref}>Report a vulnerability</a>
          <a class="button button-secondary" href={securityDocsHref}>Read the security docs</a>
        </div>
        <p class="security-disclosure-extra">
          <a class="inline-cta" href="/.well-known/security.txt">Machine-readable reporting details in security.txt &rarr;</a>
        </p>
      </div>
    </section>
  </main>

  <DocsHandoff
    eyebrow="For your security team"
    heading="Review the detailed security model with your technical team."
    primaryLabel="Read the security docs"
    primaryHref={securityDocsHref}
    emphasis="docs"
  />
  <SiteFooter />
</Base>

<style>
  /* Balanced pairs keep the controls and organizational responsibilities easy
     to compare without ranking them. */
  .security-properties,
  .security-pair {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(24px, 4vw, 36px);
  }

  .quiet-card h3 {
    margin-top: 0;
  }

  .quiet-card p:last-child,
  .security-explanation p:last-child {
    margin-bottom: 0;
  }

  .security-note {
    color: var(--registry-body);
    margin: clamp(24px, 3vw, 32px) auto 0;
    max-width: 760px;
    text-align: center;
  }

  .security-explanation {
    border-top: 2px solid var(--registry-ink);
    padding-top: 18px;
  }

  .security-disclosure-extra {
    margin-top: 20px;
  }

  @media (max-width: 620px) {
    .security-properties,
    .security-pair {
      grid-template-columns: 1fr;
    }
  }
</style>
