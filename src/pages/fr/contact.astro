---
// French twin of src/pages/contact.astro. The form posts to the same endpoint
// with the same fields and values; only the wording the reader sees is French.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import StarterRequestForm from '../../components/StarterRequestForm.astro';
import { starterRequestEndpoint as parseStarterRequestEndpoint } from '../../lib/starter-request';

const pageTitle = 'Nous contacter';
const pageDescription =
  'Posez une question sur un registre public, demandez une proposition ou l’accès à une configuration de départ, ou écrivez-nous sur les données personnelles.';
const endpoint = parseStarterRequestEndpoint(import.meta.env.PUBLIC_STARTER_REQUEST_ENDPOINT, 'kiosk');
const trackedEndpoint = parseStarterRequestEndpoint(import.meta.env.PUBLIC_STARTER_REQUEST_TRACKED_ENDPOINT, 'consented');
if (trackedEndpoint && !endpoint) {
  throw new Error('A tracked contact form endpoint requires the kiosk endpoint.');
}
if (endpoint && trackedEndpoint) {
  const kioskUrl = new URL(endpoint);
  const trackedUrl = new URL(trackedEndpoint);
  if (kioskUrl.origin !== trackedUrl.origin ||
      kioskUrl.searchParams.get('formId') === trackedUrl.searchParams.get('formId')) {
    throw new Error('Contact form endpoints must share an origin and use distinct form IDs.');
  }
}
---

<Base title={`${pageTitle} | Registry Stack`} description={pageDescription}>
  <SiteHeader current="contact" />
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="contact-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Contact</p>
          <h1 id="contact-title">Parlez-nous de vos besoins.</h1>
          <p class="hero-lead">
            Posez une question, décrivez un service, demandez une proposition ou l’accès à une
            configuration de départ. N’indiquez ni fiches confidentielles ni informations personnelles sur un dossier.
          </p>
          <p class="hero-note" data-contact-context hidden></p>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-label="Formulaire de contact">
      <div class="section-inner contact-form-wrap">
        <StarterRequestForm
          endpoint={endpoint}
          trackedEndpoint={trackedEndpoint}
          requestType="question"
          requestContext=""
          requestFromUrl
          headingLevel={2}
          eyebrow="Contacter Registry Stack"
          heading="Envoyer un message"
          intro="Parlez-nous de vos besoins. Nous examinerons votre message et vous répondrons."
          messageLabel="Votre message"
          submitLabel="Envoyer le message"
          successMessage="Message reçu. Nous allons l’examiner et vous répondre."
        />
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<script>
  import { contactFormText, requestContext } from '../../lib/starter-request';

  const context = requestContext(new URLSearchParams(window.location.search).get('context') ?? undefined);
  const note = document.querySelector<HTMLElement>('[data-contact-context]');
  if (context && note) {
    note.textContent = `${contactFormText('fr').about}${context}`;
    note.hidden = false;
  }
</script>

<style>
  .contact-form-wrap {
    max-width: 1040px;
  }
</style>
