---
// Lecteur : le responsable d’un registre de population ou d’un registre
// social, qui se demande à quoi ressemblerait une semaine avec ce logiciel
// pour son registre. Les sections suivent ses questions : montrez-moi une
// semaine, ce qui change pour mon institution, par où commencer, les doutes,
// qui contacter. Jumelle française de
// src/pages/solutions/people-and-social-programmes.astro.
import Solution from '../../../layouts/Solution.astro';
import RegisterWeek from '../../../components/RegisterWeek.astro';
import SolutionStarters from '../../../components/SolutionStarters.astro';
import SolutionFaq from '../../../components/SolutionFaq.astro';
import DocsHandoff from '../../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../../data/fr/solutions';
import { describeServiceHref } from '../../../data/contact';
import { weekProduct, type WeekStep } from '../../../data/fr/register-week';
const area = solutionAreas.find((a) => a.key === 'people-and-social-programmes')!;

const steps: WeekStep[] = [
  {
    when: 'Demande déposée',
    product: 'Votre application de réception des demandes',
    title: 'Un ménage fait une demande',
    text: 'Un ménage demande son inscription au bureau du district. Le service de réception recueille les informations d’évaluation du programme, dont le rapport de visite à domicile, avant d’envoyer le dossier complet pour décision. Le registre ne change pas encore.',
    card: { kind: 'record', recordType: 'Demande', recordId: 'APP-5120', icon: 'household', fields: [
      { label: 'Ménage', value: 'HH-30944' },
      { label: 'Programme', value: 'Protection sociale' },
      { label: 'Lieu de dépôt', value: 'Bureau du district' },
    ] },
  },
  {
    when: 'Évaluation et décision',
    ...weekProduct('casework'),
    title: 'Un agent décide',
    text: 'La demande complète entre dans la file d’examen des inscriptions. A. Haddad examine la demande et l’évaluation, puis consigne la décision du programme.',
    card: { kind: 'history', items: [
      { state: 'Reçue', note: 'Dirigée vers les inscriptions' },
      { state: 'Prise en charge', note: 'Confiée à A. Haddad' },
      { state: 'Approuvée', note: 'Évaluation terminée' },
    ] },
  },
  {
    when: 'Fiche du ménage mise à jour',
    ...weekProduct('base-registry'),
    title: 'La fiche du ménage change et garde son historique',
    text: 'L’agent enregistre l’inscription sous son propre nom. La version 4 contient le statut ; la version 3 reste consultable.',
    card: { kind: 'record', recordType: 'Fiche du ménage', recordId: 'HH-30944', icon: 'household', fields: [
      { label: 'Statut', value: 'Inscrit' },
      { label: 'Modifiée par', value: 'A. Haddad' },
      { label: 'Version', value: '4' },
    ] },
  },
  {
    when: 'Vérification par un programme autorisé',
    ...weekProduct('evidence-gateway'),
    title: 'Un autre programme vérifie l’inscription',
    text: 'Un programme de cantines scolaires habilité à faire cette vérification demande si le ménage est inscrit et reçoit une réponse signée numériquement. Les informations sur les revenus et les notes du dossier ne sont pas communiquées.',
    card: { kind: 'answer', fieldLabel: 'Ménage inscrit', value: 'Oui', recipient: 'Programme de cantines scolaires', issuer: 'Registre social' },
  },
];
---
<Solution
  area={area}
  heading="Tenez les fiches des personnes, des ménages et des inscriptions."
  description="Enregistrez l’identité, les liens entre membres d’un ménage, l’inscription ou le statut pour un registre de population, un registre social ou un programme que votre institution gère. Les agents examinent les demandes et les corrections ; les services autorisés peuvent vérifier une information précise sans recevoir le dossier complet. Chaque institution reste responsable de ses règles d’éligibilité et de ses décisions."
>
  <section class="section" id="example" aria-labelledby="people-example-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">Une demande, du début à la fin</p>
        <h2 id="people-example-title">Suivez la demande d’inscription d’un ménage.</h2>
      </div>
      <RegisterWeek
        id="people-week"
        kicker="Ménage HH-30944, une demande"
        heading="Suivez la demande du ménage."
        caption="Demande d’un ménage, du dépôt à la vérification de l’inscription par un autre programme, en passant par la décision de l’agent et la modification de la fiche. Les fiches sont fictives."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="people-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">Ce qui change pour votre institution</p>
        <h2 id="people-change-title">Contrôlez ce que chaque programme peut vérifier.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Reliez les personnes à la fiche de leur ménage</h3><p>Lorsqu’une personne quitte un ménage, votre équipe modifie le lien et le ménage précédent reste dans l’historique.</p><a class="inline-cta" href="/fr/products/base-registry/">Comment le registre tient les personnes et les ménages <span aria-hidden="true">→</span></a></article>
        <article><h3>Limitez les vérifications à la personne sur laquelle un service doit se renseigner</h3><p>Votre institution peut autoriser un programme à vérifier le statut d’une personne connue tout en l’empêchant de lister tous les inscrits du registre. La mise en œuvre définit les permissions et la couverture de l’audit pour chaque connexion.</p><a class="inline-cta" href="/fr/security/">Qui est responsable de quoi <span aria-hidden="true">→</span></a></article>
        <article><h3>Délivrez une attestation confirmant l’inscription à un programme</h3><p>Une mise en œuvre peut utiliser Evidence Gateway pour délivrer une attestation numérique indiquant si une personne est inscrite. La mise en œuvre connecte et teste le portefeuille numérique qui la reçoit et le service qui l’accepte.</p><a class="inline-cta" href="/fr/solutions/verifiable-credentials/">Découvrir les attestations vérifiables <span aria-hidden="true">→</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters area={area} />
  <SolutionFaq
    items={[
      {
        q: 'Cela remplace-t-il notre registre de population ou notre registre social ?',
        a: 'Vous pouvez garder le registre que vous tenez déjà et y connecter Evidence Gateway pour répondre aux questions convenues. Utilisez Base Registry Engine lorsqu’il vous faut un nouveau registre ou que vous décidez de migrer un registre existant.',
        link: { href: 'https://docs.registrystack.org/start/concepts/', label: 'Comment il s’intègre aux systèmes existants (en anglais)' },
      },
      {
        q: 'Un programme peut-il vérifier une information sans voir le dossier de la personne ?',
        a: 'Oui. Le programme pose une question que votre institution a convenu de traiter, par exemple si un ménage est inscrit, et reçoit cette réponse, et rien d’autre. Votre institution décide quels programmes peuvent poser des questions, lesquelles, et pour quel motif.',
        link: { href: '/solutions/check-a-fact/', label: 'Comment un service vérifie une information' },
      },
      {
        q: 'Cela évalue-t-il l’éligibilité ou calcule-t-il les prestations ?',
        a: 'Votre programme reste responsable de l’évaluation de l’éligibilité et du calcul des prestations. Un programme destinataire applique ses propres règles à la réponse qu’il reçoit ; le registre consigne la décision prise par l’organisation responsable.',
      },
      {
        q: 'Qui peut consulter la fiche d’une personne ?',
        a: 'Votre institution décide qui peut enregistrer une personne, modifier un ménage ou rechercher quelqu’un, et pour quel motif. Base Registry Engine conserve un historique des modifications qu’il traite. La couverture de l’audit pour l’ensemble du registre et des applications connectées est convenue lors de la mise en œuvre.',
        link: { href: '/security/', label: 'Qui est responsable de quoi' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Travaillons ensemble"
    heading="Parlons de votre service."
    body="Dites-nous quelles fiches de personnes et quels services de programme vous devez gérer, qui prend chaque décision et quels systèmes doivent échanger des informations. Nous pouvons vous montrer comment Registry Stack pourrait s’intégrer en ne partageant que ce dont chaque service a besoin."
    primaryLabel="Décrivez votre service"
    primaryHref={describeServiceHref(area.name, 'fr')}
    note="Le cœur du logiciel est open source (Apache-2.0). Votre équipe, un prestataire que vous désignez ou nous pouvons le mettre en œuvre et l’exploiter. L’hébergement et l’exploitation font l’objet d’un devis distinct."
    emphasis="docs"
  />
</Solution>
