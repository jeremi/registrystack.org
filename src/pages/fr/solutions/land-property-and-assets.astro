---
// Lecteur : le responsable d’un cadastre, d’un registre foncier ou d’un
// registre de véhicules ou de biens, qui se demande à quoi ressemblerait une
// semaine avec ce logiciel pour son registre. Les sections suivent ses
// questions : montrez-moi une semaine, ce qui change pour mon institution, par
// où commencer, les doutes, qui contacter. Jumelle française de
// src/pages/solutions/land-property-and-assets.astro.
import Solution from '../../../layouts/Solution.astro';
import RegisterWeek from '../../../components/RegisterWeek.astro';
import SolutionStarters from '../../../components/SolutionStarters.astro';
import SolutionFaq from '../../../components/SolutionFaq.astro';
import DocsHandoff from '../../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../../data/fr/solutions';
import { describeServiceHref } from '../../../data/contact';
import { weekProduct, type WeekStep } from '../../../data/fr/register-week';
const area = solutionAreas.find((a) => a.key === 'land-property-and-assets')!;

const steps: WeekStep[] = [
  {
    when: 'Mutation déposée',
    product: 'Votre service de dépôt',
    title: 'Une mutation est déposée',
    text: 'Un notaire dépose la mutation de la parcelle P-11-0482, acte joint. Le registre ne change pas tant qu’un agent du registre n’a pas décidé.',
    card: { kind: 'record', recordType: 'Demande de mutation', recordId: 'TR-7731', icon: 'data', fields: [
      { label: 'Parcelle', value: 'P-11-0482' },
      { label: 'Droit', value: 'Pleine propriété' },
      { label: 'Déposée par', value: 'Notaire' },
    ] },
  },
  {
    when: 'Examen et décision',
    ...weekProduct('casework'),
    title: 'Un agent du registre décide',
    text: 'La mutation entre dans la file d’examen. S. Nakamura vérifie l’acte au regard des données du levé topographique et approuve la demande.',
    card: { kind: 'history', items: [
      { state: 'Reçue', note: 'Dirigée vers les mutations' },
      { state: 'Prise en charge', note: 'Confiée à S. Nakamura' },
      { state: 'Approuvée', note: 'Contrôles terminés' },
    ] },
  },
  {
    when: 'Fiche du bien mise à jour',
    ...weekProduct('base-registry'),
    title: 'Les droits sur la parcelle changent et gardent leur historique',
    text: 'L’agent du registre enregistre le nouveau titulaire, et le registre consigne qui a fait la modification. Le droit antérieur reste dans l’historique, avec la période pendant laquelle il s’est appliqué.',
    card: { kind: 'record', recordType: 'Fiche de la parcelle', recordId: 'P-11-0482', icon: 'data', fields: [
      { label: 'Titulaire', value: 'Nouveau titulaire enregistré' },
      { label: 'Modifiée par', value: 'S. Nakamura' },
      { label: 'Révision', value: '9' },
    ] },
  },
  {
    when: 'Extrait demandé',
    ...weekProduct('render'),
    title: 'Le nouveau titulaire reçoit un extrait imprimé',
    text: 'Le service demande un extrait à partir de la révision enregistrée et en conserve l’empreinte. À partir des mêmes données d’émission, Registry Render reproduit l’extrait afin qu’une copie ultérieure corresponde à l’original.',
    card: { kind: 'document', documentType: 'Extrait de titre foncier', title: 'Parcelle P-11-0482, extrait des droits', fields: [
      { label: 'Titulaire', value: 'Tel qu’enregistré à la révision 9' },
      { label: 'Révision', value: '9' },
      { label: 'Émis à partir de', value: 'Révision 9' },
    ], hash: '3f9a…c21e' },
  },
];
---
<Solution
  area={area}
  heading="Gérez les fiches des biens et leurs modifications."
  description="Les agents du registre examinent les demandes et consignent les modifications approuvées des parcelles, bâtiments, véhicules, navires ou biens publics. Les services connectés ne reçoivent que les informations que votre institution autorise. Les plans, les actes et les registres spécialisés existants peuvent rester dans leurs systèmes actuels."
>
  <section class="section" id="example" aria-labelledby="land-example-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">Une demande, du début à la fin</p>
        <h2 id="land-example-title">Suivez une mutation de propriété.</h2>
      </div>
      <RegisterWeek
        id="land-week"
        kicker="Parcelle P-11-0482, une demande"
        heading="Suivez la mutation de propriété."
        caption="Mutation de propriété, du dépôt à l’extrait imprimé du nouveau titulaire, en passant par la décision de l’agent du registre et la modification des droits. Les fiches sont fictives."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="land-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">Ce qui change pour votre institution</p>
        <h2 id="land-change-title">Consultez les droits en vigueur et les modifications antérieures.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Enregistrez qui détient chaque droit</h3><p>Les agents consignent chaque droit ou détenteur dans la fiche de la parcelle, du bâtiment, du véhicule ou du navire concerné, avec la quote-part et la période d’application. Un service d’évaluation foncière lit le titulaire et la quote-part tels que votre registre les détient.</p><a class="inline-cta" href="/fr/products/base-registry/">Comment le registre sert d’autres services <span aria-hidden="true">→</span></a></article>
        <article><h3>C’est votre législation qui décide de ce qui est public</h3><p>Votre institution décide quelles informations sont publiques et lesquelles exigent la permission d’un agent ou d’un service connecté. Les accès sont configurés pour le registre et selon les responsabilités de chaque lecteur.</p><a class="inline-cta" href="/fr/security/">Qui est responsable de quoi <span aria-hidden="true">→</span></a></article>
        <article><h3>Reproduisez un extrait quand une autre copie est nécessaire</h3><p>À partir des mêmes données d’émission, Registry Render reproduit l’extrait afin que la copie ultérieure corresponde à l’original. Le service de l’institution contrôle quand un extrait peut être délivré et quel effet juridique il a.</p><a class="inline-cta" href="https://docs.registrystack.org/explanation/render-determinism/" hreflang="en">Comment Registry Render reproduit un document (en anglais) <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters area={area} />
  <SolutionFaq
    items={[
      {
        q: 'Cela remplace-t-il notre système cadastral ?',
        a: 'Vos systèmes de cartographie et de gestion des documents peuvent rester en place. Utilisez Base Registry Engine pour un nouveau registre des droits ou pour un registre que vous décidez de migrer. Si le registre officiel reste dans son système actuel, la mise en œuvre se connecte à ce système pour les informations dont les autres services ont besoin.',
        link: { href: 'https://docs.registrystack.org/start/concepts/', label: 'Comment il s’intègre aux systèmes existants (en anglais)' },
      },
      {
        q: 'Un service d’évaluation foncière peut-il lire notre registre sans compte sur notre système ?',
        a: 'Deux cas. Un particulier ou un notaire qui consulte une seule parcelle utilise le service de recherche public que fournit votre application en vertu de votre législation. Un service connecté, comme un service d’évaluation foncière qui prépare sa liste des biens à évaluer, ne reçoit que les informations que votre institution a convenu de partager, comme le titulaire et la quote-part. Votre institution décide quels services peuvent lire chaque information.',
        link: { href: '/products/base-registry/', label: 'Comment Base Registry Engine sert d’autres services' },
      },
      {
        q: 'Un extrait imprimé prouve-t-il ce que contient le registre ?',
        a: 'L’extrait représente la révision de la fiche utilisée pour le produire, et son empreinte peut être conservée avec cette fiche. Qu’un extrait prouve un titre ou ait un autre effet juridique dépend du droit et des procédures de l’institution ; Registry Stack ne porte pas cette appréciation juridique.',
        link: { href: 'https://docs.registrystack.org/explanation/render-determinism/', label: 'Pourquoi une réimpression correspond à l’original (en anglais)' },
      },
      {
        q: 'Qui peut voir qui détient une parcelle ou un véhicule ?',
        a: 'Votre institution décide qui peut enregistrer un droit, qui peut consulter un titulaire et pour quel motif. Base Registry Engine conserve un historique des modifications qu’il traite. La mise en œuvre convient de la couverture de l’audit pour l’ensemble du registre et des applications connectées.',
        link: { href: '/security/', label: 'Qui est responsable de quoi' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Travaillons ensemble"
    heading="Parlons de votre service."
    body="Décrivez les biens à enregistrer, qui tient le registre officiel et les systèmes de cartographie, de gestion des documents ou d’évaluation à connecter. Nous pouvons vous montrer comment Registry Stack pourrait s’intégrer."
    primaryLabel="Décrivez votre service"
    primaryHref={describeServiceHref(area.name, 'fr')}
    note="Le cœur du logiciel est open source (Apache-2.0). Votre équipe, un prestataire que vous désignez ou nous pouvons le mettre en œuvre et l’exploiter. L’hébergement et l’exploitation font l’objet d’un devis distinct."
    emphasis="docs"
  />
</Solution>
