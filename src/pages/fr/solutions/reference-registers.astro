---
// Lecteur : l’équipe qui tient une nomenclature, un annuaire ou un catalogue
// sur lesquels s’appuient d’autres registres, et qui se demande à quoi
// ressemblerait une semaine avec ce logiciel pour sa liste. Les sections
// suivent ses questions : montrez-moi une semaine, ce qui change pour mon
// institution, par où commencer, les doutes, qui contacter. Jumelle française
// de src/pages/solutions/reference-registers.astro.
import Solution from '../../../layouts/Solution.astro';
import RegisterWeek from '../../../components/RegisterWeek.astro';
import SolutionStarters from '../../../components/SolutionStarters.astro';
import SolutionFaq from '../../../components/SolutionFaq.astro';
import DocsHandoff from '../../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../../data/fr/solutions';
import { describeServiceHref } from '../../../data/contact';
import { weekProduct, type WeekStep } from '../../../data/fr/register-week';
const area = solutionAreas.find((a) => a.key === 'reference-registers')!;

const steps: WeekStep[] = [
  {
    when: 'Modification proposée',
    product: 'Votre application de réception des demandes',
    title: 'Une modification est proposée',
    text: 'Le ministère informe votre service que deux districts fusionnent le 1er janvier. La liste ne change pas tant que votre équipe n’a pas décidé.',
    card: { kind: 'record', recordType: 'Proposition de modification', recordId: 'CHG-118', icon: 'data', fields: [
      { label: 'Entrée', value: 'District NR-07' },
      { label: 'Modification', value: 'Fusion dans NR-05' },
      { label: 'Applicable à partir du', value: '1er janvier' },
    ] },
  },
  {
    when: 'Examen et décision',
    ...weekProduct('casework'),
    title: 'Votre équipe décide',
    text: 'La proposition est confiée à E. Lindqvist, qui confirme l’avis du ministère et approuve la modification.',
    card: { kind: 'history', items: [
      { state: 'Reçue', note: 'Dirigée vers les modifications de nomenclature' },
      { state: 'Prise en charge', note: 'Confiée à E. Lindqvist' },
      { state: 'Approuvée', note: 'Source confirmée' },
    ] },
  },
  {
    when: 'Modification autorisée de la liste',
    ...weekProduct('base-registry'),
    title: 'La liste change et garde l’ancienne entrée',
    text: 'L’agent clôt NR-07 avec sa date de fin et désigne son successeur. Le registre consigne le nom de l’agent, et les fiches qui utilisent NR-07 restent reliées à l’entrée conservée.',
    card: { kind: 'record', recordType: 'Entrée de la nomenclature', recordId: 'NR-07', icon: 'data', fields: [
      { label: 'Statut', value: 'Clôturée à partir du 1er janvier' },
      { label: 'Successeur', value: 'NR-05' },
      { label: 'Modifiée par', value: 'E. Lindqvist' },
    ] },
  },
  {
    when: 'Liste actuelle publiée',
    product: 'Votre service de publication',
    title: 'Les services connectés récupèrent la liste actuelle',
    text: 'L’équipe publie la liste actuelle par un service ou un export convenu. Les métadonnées de catalogue décrivent la liste, sa version et l’endroit où la récupérer.',
    card: { kind: 'document', documentType: 'Nomenclature publiée', format: 'JSON', title: 'Divisions administratives, version 2027-01', fields: [
      { label: 'Entrées', value: '312' },
      { label: 'Modifications', value: 'NR-07 clôturée, NR-05 étendue' },
      { label: 'Statut', value: 'Liste actuelle publiée' },
    ], footnote: 'La publication et la gestion des mises à jour sont configurées pour les services connectés' },
  },
];
---
<Solution
  area={area}
  heading="Tenez les listes sur lesquelles s’appuient les autres services."
  description="Examinez et publiez les modifications des noms de lieux, des annuaires d’organismes, des classifications et des listes de codes. Les services connectés récupèrent la version actuelle, tandis que les fiches qui utilisent un code antérieur renvoient toujours à une entrée connue."
>
  <section class="section" id="example" aria-labelledby="reference-example-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">Une demande, du début à la fin</p>
        <h2 id="reference-example-title">Examinez et publiez une modification de nomenclature.</h2>
      </div>
      <RegisterWeek
        id="reference-week"
        kicker="Code de district NR-07, une demande"
        heading="Suivez la modification de la nomenclature."
        caption="Modification d’un code de district, de la proposition à la liste mise à jour que récupèrent les services connectés, en passant par la décision de votre équipe. Les fiches sont fictives."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="reference-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">Ce qui change pour votre institution</p>
        <h2 id="reference-change-title">Tenez une seule liste actuelle et gardez les entrées antérieures.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Utilisez le même code pour le même lieu</h3><p>Chaque entrée comprend son code officiel, son parent s’il y en a un, et les dates auxquelles elle s’applique. Le registre des adresses et l’institut de statistique peuvent récupérer les entrées dans la même liste.</p><a class="inline-cta" href="/fr/products/base-registry/">Comment le registre sert d’autres services <span aria-hidden="true">→</span></a></article>
        <article><h3>Contrôlez qui modifie la liste</h3><p>Votre institution décide qui peut ajouter, renommer ou clôturer une entrée. Les services connectés peuvent recevoir un accès en lecture, tandis que les agents ou systèmes autorisés enregistrent les modifications.</p><a class="inline-cta" href="/fr/security/">Qui est responsable de quoi <span aria-hidden="true">→</span></a></article>
        <article><h3>Aidez les autres services à trouver la liste actuelle</h3><p>Publiez les entrées par un service ou un export convenu. Les métadonnées de catalogue décrivent cette source et sa version, afin que les autres équipes sachent où récupérer la liste.</p><a class="inline-cta" href="https://docs.registrystack.org/products/registry-manifest/" hreflang="en">Comment les descriptions de catalogue sont publiées (en anglais) <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters area={area} />
  <SolutionFaq
    items={[
      {
        q: 'Cela remplace-t-il le tableur que nous diffusons ?',
        a: 'Cela peut remplacer les copies de tableur envoyées par courriel par une source tenue à jour. Les services connectés récupèrent les entrées par un service ou un export convenu et suivent les règles convenues pour adopter une nouvelle version.',
        link: { href: 'https://docs.registrystack.org/start/concepts/', label: 'Comment il s’intègre aux systèmes existants (en anglais)' },
      },
      {
        q: 'Que deviennent les fiches qui renvoient à un ancien code ?',
        a: 'Une entrée renommée ou retirée reste dans la liste, avec les dates auxquelles elle s’est appliquée. Les fiches qui utilisent l’ancien code peuvent toujours renvoyer à cette entrée. Chaque service connecté a besoin de règles pour traiter un code renommé ou retiré.',
      },
      {
        q: 'La liste contient-elle aussi les limites des districts ?',
        a: 'La liste donnée en exemple contient des codes, des noms et des dates. Gardez les cartes des limites dans le système de cartographie et reliez les entrées par leurs codes officiels.',
      },
      {
        q: 'Qui peut modifier la liste ?',
        a: 'Seules les personnes que désigne votre institution. Votre institution décide qui peut enregistrer une nouvelle entrée, qui peut en clôturer une, et qui peut seulement lire ; chaque modification est conservée avec son auteur et sa date.',
        link: { href: '/security/', label: 'Qui est responsable de quoi' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Travaillons ensemble"
    heading="Parlons de votre liste partagée."
    body="Décrivez la liste partagée dont vous avez besoin, qui approuve les modifications et quels services l’utiliseront. Nous pouvons vous montrer comment Registry Stack pourrait publier une seule version actuelle tout en conservant les entrées antérieures."
    primaryLabel="Décrivez votre service"
    primaryHref={describeServiceHref(area.name, 'fr')}
    note="Le cœur du logiciel est open source (Apache-2.0). Votre équipe, un prestataire que vous désignez ou nous pouvons le mettre en œuvre et l’exploiter. L’hébergement et l’exploitation font l’objet d’un devis distinct."
    emphasis="docs"
  />
</Solution>
