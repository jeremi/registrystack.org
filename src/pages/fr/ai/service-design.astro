---
// French twin of src/pages/ai/service-design.astro: the same sections in the
// same order.
import Base from '../../../layouts/Base.astro';
import AiLandingHero from '../../../components/AiLandingHero.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { describeServiceHref } from '../../../data/contact';

const context = 'Conception de service assistée par l’IA';
---

<Base
  title="Concevoir un service public avec l’IA | Registry Stack"
  description="Partir des recherches et des exigences, tester un prototype avec agents et demandeurs, puis remettre une note de cadrage claire à votre équipe de réalisation."
  ogImagePath="/og-ai.png"
  ogImageAlt="Registry Stack : concevoir, adapter et ouvrir l’accès aux services publics avec l’IA."
>
  <SiteHeader current="ai-service-design" />
  <main id="main-content" tabindex="-1">
    <AiLandingHero
      eyebrow="Conception du service avec l’IA"
      heading="Concevez un service et testez-le avant de le construire."
      lead="Avec l’IA, vous transformez les recherches et les exigences du service en note de cadrage. Avant de décider ce qu’il faut construire, vous testez un prototype avec les demandeurs et les agents."
      context={context}
      exampleHref="#worked-example"
      exampleLabel="Découvrez l’exemple de l’inscription scolaire"
      exampleNote="Exemple fictif : dans son ébauche de note de cadrage sur l’inscription scolaire, un partenaire de réalisation relève un contrôle de l’âge et une règle que l’autorité chargée de l’éducation doit confirmer."
      note="Proposée sous forme de mission au périmètre convenu, menée principalement par nos partenaires."
    >
      <p class="ai-example-label">Exemple : note de cadrage préparée par votre partenaire de réalisation</p>
      <p class="ai-example-title">Inscription scolaire</p>
      <dl class="ai-example-rows">
        <div><dt>Élément 1 du formulaire</dt><dd>Le parent indique la date de naissance de l’enfant.</dd></div>
        <div><dt>Modification proposée</dt><dd>Demander au registre de l’état civil si l’enfant remplit la condition d’âge.</dd></div>
        <div><dt>Décision pour l’autorité chargée de l’éducation</dt><dd>Quelle date limite s’applique pour cette année scolaire ?</dd></div>
      </dl>
    </AiLandingHero>

    <section class="section section-muted" id="worked-example" aria-labelledby="example-title">
      <div class="section-inner approach-split">
        <div class="section-heading">
          <p class="eyebrow">Exemple : l’inscription scolaire</p>
          <h2 id="example-title">Aider un parent à inscrire son enfant à l’école</h2>
          <p>Un parent apporte un formulaire au secrétariat de l’école. L’agent saisit la date de naissance de l’enfant et la vérifie auprès du parent.</p>
          <p>L’équipe essaie un prototype qui demande à un registre de l’état civil approuvé de contrôler l’âge. Si la source ne peut pas répondre, l’écran invite l’agent à examiner la pièce justificative avec le parent.</p>
          <p>L’autorité chargée de l’éducation confirme la règle d’âge. L’autorité de l’état civil décide si elle peut proposer ce contrôle et les informations qu’elle peut communiquer.</p>
        </div>
        <div class="editorial-callout">
          <h3>Trois situations à tester</h3>
          <ol class="approach-steps">
            <li><strong>L’enfant relève de l’école de son secteur</strong><span>Confirmer l’affectation et remettre une référence au parent.</span></li>
            <li><strong>La source ne peut pas confirmer l’âge de l’enfant</strong><span>Guider l’agent dans le contrôle manuel convenu.</span></li>
            <li><strong>Le parent demande une autre école</strong><span>Consigner la décision de l’agent du district. Une personne ou un service habilité l’applique au registre.</span></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="outputs-title">
      <div class="section-inner">
        <div class="section-heading">
          <h2 id="outputs-title">Une note de cadrage prête pour votre équipe de réalisation</h2>
        </div>
        <div class="value-grid">
          <article>
            <h3>Repérer où les personnes ont besoin d’aide</h3>
            <p>Parcourir le service prévu avec les agents et les demandeurs, en conservant les références des sources et, si l’on adapte un formulaire existant, les numéros de ses éléments : chacun peut ainsi vérifier chaque modification proposée.</p>
          </article>
          <article>
            <h3>Trancher les questions qui pèsent sur la réalisation</h3>
            <p>L’IA organise les éléments recueillis et signale les lacunes. Les équipes responsables confirment les règles applicables et les sources utilisables, et précisent qui peut décider d’une exception.</p>
          </article>
          <article>
            <h3>Déceler les problèmes sur un prototype</h3>
            <p>Les demandeurs et les agents essaient des cas courants et des cas difficiles. Les enseignements servent à réviser la note et à convenir des tests à mener sur le service en fonctionnement.</p>
          </article>
        </div>
        <p class="section-note">Nous proposons cette méthode de conception sous forme de mission au périmètre convenu, menée principalement par nos partenaires. La note oriente <a href="/fr/customization/">notre usage de l’IA dans la mise en œuvre</a>.</p>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="next-title">
      <div class="section-inner">
        <h2 id="next-title">Parlons du service à concevoir</h2>
        <p>Partez des exigences d’un nouveau service, ou d’un formulaire et d’une procédure à adapter. Nous menons la conception du service avec nos partenaires, et la note de cadrage oriente ensuite une mise en œuvre au périmètre convenu.</p>
        <div class="section-links">
          <a class="button button-primary" href={describeServiceHref(context, 'fr')} data-journey="service-inquiry">Décrivez votre service</a>
          <a class="button button-secondary" href="/fr/pricing/#process">Découvrez le déroulement de la mise en œuvre</a>
        </div>
        <p class="final-cta-note"><a href="/fr/pricing/">Voir les options de mise en œuvre et d’assistance technique</a></p>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>
