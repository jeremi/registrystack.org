---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';

const posts = (await getCollection('blog', ({ data }) => data.status === 'published')).sort(
  (left, right) =>
    right.data.publishedAt.valueOf() - left.data.publishedAt.valueOf() ||
    left.data.order - right.data.order,
);
const dateFormatter = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  title="Blog | Registry Stack"
  description="Practical guides on sharing register information with approved services. They cover how to limit what you disclose and how to review access."
  ogImagePath="/blog-field-notes-og.png"
  ogImageAlt="Registry Stack Field Notes: Define the question. Choose the boundary. Preserve the evidence."
>
  <SiteHeader current="blog" />
  <main id="main-content" tabindex="-1">
    <header class="blog-intro">
      <div class="blog-intro-inner">
        <div class="blog-intro-copy">
          <p class="eyebrow">Our guides and notes</p>
          <h1 id="blog-title">Blog</h1>
          <p>
            Read practical guides on how to share register information with approved services.
            The guides also cover how to limit what you disclose and how to review access.
          </p>
        </div>
        <a class="blog-rss" href="/rss.xml">RSS feed <span aria-hidden="true">&rarr;</span></a>
      </div>
    </header>

    <section class="blog-feed" aria-labelledby="articles-title">
      <div class="blog-feed-inner">
        <div class="blog-feed-heading">
          <h2 id="articles-title">Choose from the published guides.</h2>
          <p>Guides published: {posts.length}</p>
        </div>

        <div class="blog-grid">
          {
            posts.map((post) => (
              <article class="blog-card">
                <div class="blog-card-copy">
                  <p class="blog-card-kicker">
                    <span>{post.data.category}</span>
                    <span aria-hidden="true">·</span>
                    <time datetime={post.data.publishedAt.toISOString()}>
                      {dateFormatter.format(post.data.publishedAt)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{post.data.readingMinutes} min read</span>
                  </p>
                  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
                  <p>{post.data.description}</p>
                  <p class="blog-card-link"><a href={`/blog/${post.id}/`}>Read the guide <span aria-hidden="true">&rarr;</span></a></p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
    <DocsHandoff />
  </main>
  <SiteFooter />
</Base>
