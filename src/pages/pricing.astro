---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { askQuestionHref, proposalHref } from '../data/contact';

// Timing and budget are optional so a reader without a budget or date can
// still request a proposal.
const brief = [
  'Your organisation and your role',
  'The service you need, who will use it and what it needs to do',
  'Any records or systems to connect, and where you want help',
  'Timing: when you want to start and any funding deadline (optional)',
  'Budget: your budget range and currency, if you can share it (optional)',
];
const proposalRoute = proposalHref();
---

<Base title="Implementation and pricing | Registry Stack" description="See how implementation works. Compare starting prices for pilot register implementation and annual support. Discuss your service and request a proposal.">
  <SiteHeader current="pricing" />
  <main id="main-content" tabindex="-1">
    <section class="hero hero-cover" aria-labelledby="pricing-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Implementation and pricing</p>
          <h1 id="pricing-title">Implementation and support for your service.</h1>
          <p class="hero-lead">We can configure and test your service with you. Or your own team can lead the implementation and get annual technical support from us.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="#scope">Compare the two paid options</a>
            <a class="button button-secondary" href="#self-service">Use the software with your own team</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="scope" aria-labelledby="options-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Two kinds of paid help</p>
          <h2 id="options-title">Compare the starting price of each option.</h2>
          <p>We agree the work, who does what and a fixed fee with you. We do this in writing before work starts.</p>
        </div>
        <div class="service-options">
          <article id="pilot" aria-labelledby="implementation-title">
            <p class="option-label">We implement it with you</p>
            <h3 id="implementation-title">Pilot register implementation</h3>
            <p class="starting-fee"><span>From</span> <strong>US$20,000</strong></p>
            <p class="fee-basis">Per register, with an agreed scope</p>
            <p>We implement one register and its service together with your own team. We configure it to your rules. We test it with your staff. The proposal states whether your pilot register runs with test data or live records.</p>
            <h4>What we agree before work starts</h4>
            <p>We agree the screens, sign-in and integrations. We agree the data preparation, hosting and handover. We also agree who does each part and how your own team will evaluate the result. The written scope lists what you receive: the configuration, tests, instructions and service-specific code. It also states the licensing and maintenance terms.</p>
            <p>The fee depends on the steps in your service and its connections. It also depends on the data preparation and the deployment work. Read <a href="#process">how implementation works</a>.</p>
          </article>
          <article id="support" aria-labelledby="support-title">
            <p class="option-label">Your own team leads</p>
            <h3 id="support-title">Annual support</h3>
            <p class="starting-fee"><span>From</span> <strong>US$7,500</strong> <span>/ year</span></p>
            <p class="fee-basis">For teams that implement and operate Registry Stack</p>
            <p>Your own team implements and operates the service. Support can cover technical questions, upgrade planning and troubleshooting for the Registry Stack products and versions you run. The contract states what support covers and who is responsible for what.</p>
            <p>The proposal lists the deployments covered and how to contact support. It also lists when support is available and the agreed response times.</p>
          </article>
        </div>
        <p class="hosting-note">We can also host and operate the service for you. We price hosting separately in the proposal.</p>
        <p class="options-next"><a class="inline-cta" href="#inquiry">Discuss your needs <span aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <section class="section section-muted" id="inquiry" aria-labelledby="inquiry-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Discuss your needs</p>
          <h2 id="inquiry-title">Ask us a question about your service.</h2>
          <p>Tell us who you are. Describe the service or what you need. You do not need a budget to ask.</p>
          <a class="button button-secondary" href={askQuestionHref()} data-journey="ask-question">Ask a question</a>
        </div>
        <div class="pilot-brief" aria-labelledby="brief-title">
          <h3 id="brief-title">Request a proposal</h3>
          <p>Describe what you need so that we can propose the work and its cost. Include:</p>
          <ol>
            {brief.map((item) => <li>{item}</li>)}
          </ol>
          <p>You can leave timing and budget blank if you do not know them yet.</p>
          <div class="inquiry-action">
            <a class="button button-primary" href={proposalRoute} data-journey="implementation-support-inquiry">Request a proposal</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="process" aria-labelledby="process-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">The implementation process</p>
          <h2 id="process-title">How implementation works</h2>
          <ol class="next-steps">
            <li>We discuss your needs. We review your service and follow up with any questions.</li>
            <li>We agree the scope, who does what and a fixed fee in writing. Your procurement team can review this proposal.</li>
            <li>We configure and test the service with your own team. We use AI to draft configuration and test cases. That team reviews and approves each change. The configured service needs no AI model to run. <a href="/customization/">See how we use AI</a>.</li>
            <li>We hand over the service. Your own team or a provider you appoint runs it. Or we run it for you. <a href="#support">Annual support</a> is available when your own team runs it.</li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="self-service" aria-labelledby="self-service-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">Open-source self-service</p>
          <h2 id="self-service-title">Use Registry Stack with your own team.</h2>
          <p>The core software is open source under the Apache-2.0 licence. There is no software licence fee. Your own team can evaluate, implement and operate it using the documentation and the source code.</p>
          <a class="button button-secondary" href="/#developers">See the developer tutorials</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .service-options { display: grid; gap: 28px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .service-options article { border: 1px solid var(--registry-rule); border-top: 3px solid var(--registry-blue); padding: clamp(22px, 3vw, 32px); }
  .option-label { color: var(--registry-blue); font: var(--type-xs)/1.5 var(--registry-mono); margin: 0 0 16px; }
  .service-options h3 { font-size: var(--type-2xl); margin: 0 0 20px; }
  .service-options article > p:last-child { margin-bottom: 0; }
  .starting-fee { display: flex; align-items: baseline; flex-wrap: wrap; gap: 6px 9px; color: var(--registry-ink); margin: 0; }
  .starting-fee span { font-size: var(--type-md); }
  .starting-fee strong { font-size: var(--type-2xl); line-height: 1.2; }
  .fee-basis { color: var(--registry-muted); font-size: var(--type-sm); line-height: 1.5; min-height: 40px; margin: 8px 0 18px; }
  .hosting-note { font-size: var(--type-md); line-height: 1.6; margin: 24px 0 0; }
  .options-next { margin: 24px 0 0; }
  .pilot-brief { background: var(--registry-white); border-top: 3px solid var(--registry-blue); padding: clamp(20px, 3vw, 28px); }
  .pilot-brief h3 { font-size: var(--type-2xl); }
  .pilot-brief ol { line-height: 1.6; margin: 24px 0; padding-left: 22px; }
  .pilot-brief li { margin-bottom: 18px; padding-left: 4px; }
  .pilot-brief li::marker { color: var(--registry-stamp); font-family: var(--registry-mono); }
  .inquiry-action { border-top: 1px solid var(--registry-rule); padding-top: 22px; }
  .inquiry-action > p:first-child { font-size: var(--type-md); line-height: 1.6; }
  .service-options h4 { font-size: var(--type-body); margin: 22px 0 6px; }
  .pilot-brief > p { font-size: var(--type-md); line-height: 1.6; }
  .next-steps { line-height: 1.6; margin: 20px 0 0; padding-left: 22px; }
  .next-steps li { margin-bottom: 12px; padding-left: 4px; }
  .next-steps li::marker { color: var(--registry-stamp); font-family: var(--registry-mono); }
  .next-steps a { text-decoration: underline; }
  @media (max-width: 700px) {
    .service-options { grid-template-columns: 1fr; }
    .fee-basis { min-height: 0; }
  }
</style>
