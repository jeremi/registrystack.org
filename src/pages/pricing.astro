---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';

const pageTitle = 'Pricing | Registry Stack';
const pageDescription =
  'Self-host every product free under Apache-2.0. The subscription adds packaged support and governance across many registry services. No per-citizen or per-credential fees, ever.';

const mailto = 'mailto:contact@registrystack.org?subject=Registry%20Stack%20package%20fit';
const scopeMailto = 'mailto:contact@registrystack.org?subject=Registry%20Stack%20scope%20conversation';
const scopeFirstMailto = 'mailto:contact@registrystack.org?subject=Registry%20Stack%20scope%3A%20First%20registry';
const scopeProgramMailto = 'mailto:contact@registrystack.org?subject=Registry%20Stack%20scope%3A%20Program';
const scopeNationalMailto = 'mailto:contact@registrystack.org?subject=Registry%20Stack%20scope%3A%20National';
const scopeCountryMailto = 'mailto:contact@registrystack.org?subject=Registry%20Stack%20scope%3A%20Country%20membership';

// Bands count managed registry services: one registry behind one governed
// answering point. Listed figures are lower-middle-income reference prices;
// the income-scaling note renders below the cards.
const plans = [
  {
    name: 'Community',
    price: 'Free',
    term: 'forever',
    priceNote: 'Free in every country',
    tagline: 'Everything one registry needs is free. Forever. Self-hosted, and complete.',
    includes: [
      'Registry Relay, Registry Notary, and Registry Manifest under Apache-2.0',
      'Signed release assets, checksums, software bills of materials (SBOMs), posture and audit schemas, and the local doctor check',
      'Reports and evidence packs (a bundled, readable record of checks, decisions, and audit history) for a single service',
      'Community support. No registration, no callback.',
    ],
    cta: { label: 'Read the docs', href: 'https://docs.registrystack.org/', kind: 'secondary' },
  },
  {
    name: 'First registry',
    price: 'From $7,500',
    term: 'per year',
    priceNote: 'Price for lower-middle-income countries',
    tagline: 'One registry under management, with packaged support behind it.',
    featured: true,
    flag: 'Most programs start here',
    includes: [
      'Up to 2 managed registry services in one environment',
      'Inventory, health, and posture history (the recorded state of each deployment’s configuration and checks over time) for the services under management',
      'An evidence pack a reviewer, an auditor, or a funder can read',
      'Business-hours engineering support from Aubex, with response targets set in the scope confirmation',
    ],
    cta: { label: 'Request First registry scope', href: scopeFirstMailto, kind: 'primary' },
  },
  {
    name: 'Program',
    price: 'From $25,000',
    term: 'per year',
    priceNote: 'Price for lower-middle-income countries',
    tagline: 'Your program’s registries under one governance discipline.',
    includes: [
      'Up to 6 managed registry services across 3 environments',
      'Findings and exceptions: time-bounded, owned, revocable decisions on record',
      'Audit continuity tracked across every service, with evidence packs to match',
      'A web console for governance decisions, and priority support',
    ],
    cta: { label: 'Request Program scope', href: scopeProgramMailto, kind: 'secondary' },
  },
];

const scalePlans = [
  {
    name: 'National',
    body: 'For a government taking Registry Stack beyond one program: up to 15 managed registry services across ministries, integrated with the national identity, audit, and security systems. Compared with Program, it adds longer audit retention and faster response commitments. One fixed annual price, agreed in the scope confirmation.',
    cta: { label: 'Request National scope', href: scopeNationalMailto, kind: 'secondary' },
  },
  {
    name: 'Country membership',
    body: 'The whole-of-government agreement: one flat annual price, no limit on managed registry services, everything running on government-owned infrastructure. Comes with a named Aubex engineer and a direct voice in the product roadmap.',
    cta: { label: 'Discuss Country membership', href: scopeCountryMailto, kind: 'secondary' },
  },
];

const openCoreRows = [
  {
    label: 'Apache-2.0 baseline',
    body: 'Registry Relay, Registry Notary, Registry Manifest, registryctl, docs, local demos, release verification, and the self-check stay open source.',
  },
  {
    label: 'Subscription layer',
    body: 'The paid layer covers packaged support, multi-service governance history, reviewer evidence packs, and subscription-only operational tooling where a program needs it.',
  },
  {
    label: 'If you stop paying',
    body: 'Your self-hosted open-source deployments keep running. Paid support, subscription evidence packs, and subscription-only governance tooling stop.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="pricing" />

  <main>
    <section class="hero" aria-labelledby="pricing-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Pricing</p>
          <h1 id="pricing-hero-title">Self-host every product free. Subscribe for support and governance.</h1>
          <p class="hero-lead">
            Registry Relay, Registry Notary, and Registry Manifest are open source,
            self-hosted, Apache-2.0, and complete: signed release assets, public posture
            evidence, a local doctor check, no registration.
            The paid subscription runs many registry services under one governance discipline,
            with engineering support from Aubex included in each package.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href={scopeMailto}>Request a scope conversation</a>
            <a class="button button-secondary" href="https://docs.registrystack.org/">Start with the free tier</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="never-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">The pricing rule</p>
          <h2 id="never-title">Priced per registry service. Never per citizen.</h2>
        </div>
        <ul class="never-list">
          <li>Per citizen</li>
          <li>Per credential</li>
          <li>Per answer</li>
          <li>Per audit event</li>
          <li>Per read-only user</li>
        </ul>
        <p class="never-note">
          A price that meters answers taxes the success of a citizen service. Registry Stack
          is priced by the registry services under management, so a program that reaches
          twice as many people pays exactly the same. Questions are unmetered too: a managed
          registry can answer every question it is approved to answer, and adding one is
          configuration plus a sign-off, not a new contract.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="open-core-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Open-core boundary</p>
          <h2 id="open-core-title">What stays free, what the subscription adds.</h2>
          <p>
            The public roadmap does not imply a community support SLA. Paid support is the
            subscription layer, agreed separately from the open-source baseline.
          </p>
        </div>
        <div class="pricing-boundary-list">
          {openCoreRows.map((row) => (
            <article>
              <h3>{row.label}</h3>
              <p>{row.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="plans-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Plans</p>
          <h2 id="plans-title">Annual, per managed registry service, on your infrastructure.</h2>
          <p>
            A managed registry service is one registry behind one governed answering point.
            Every package is annual, fixed-price, and runs on your infrastructure.
          </p>
        </div>
        <div class="plan-grid">
          {plans.map((plan) => (
            <article class={plan.featured ? 'plan-card plan-card-featured' : 'plan-card'}>
              {plan.flag && <p class="plan-flag">{plan.flag}</p>}
              <h3>{plan.name}</h3>
              <p class="plan-price">{plan.price} <span>{plan.term}</span></p>
              {plan.priceNote && <p class="plan-price-note">{plan.priceNote}</p>}
              <p class="plan-tagline">{plan.tagline}</p>
              <ul class="check-list">
                {plan.includes.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <a
                class={`button button-${plan.cta.kind} plan-cta`}
                href={plan.cta.href ?? mailto}
              >
                {plan.cta.label}
              </a>
            </article>
          ))}
        </div>
        <div class="scale-grid">
          {scalePlans.map((plan) => (
            <article class="plan-card scale-card">
              <h3>{plan.name}</h3>
              <p class="plan-price plan-price-talk">Fixed annual price</p>
              <p class="plan-tagline">{plan.body}</p>
              <a
                class={`button button-${plan.cta.kind} plan-cta`}
                href={plan.cta.href}
              >
                {plan.cta.label}
              </a>
            </article>
          ))}
        </div>
        <p class="plan-band-note">
          Listed prices are the published packages for lower-middle-income countries, following
          the World Bank income classification of the deploying country. Low-income and
          humanitarian deployments pay less, high-income countries pay more, and nonprofits pay
          the low-income price. The exact figure is fixed in the scope confirmation.
        </p>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="direct-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Fixed packages</p>
          <h2 id="direct-title">Scope is confirmed before support starts.</h2>
        </div>
        <div class="direct-body">
          <p>
            Registry Stack support is packaged to keep procurement simple and avoid
            open-ended sales cycles. If your use case fits a listed package, the price is
            fixed. If it does not, we first confirm whether it belongs in a published support
            band before scheduling implementation time.
          </p>
          <p>
            Subscriptions are delivered by Aubex Consulting LLC, the San Francisco company behind
            OpenSPP and Registry Stack. Business-hours support means engineering response during the
            agreed business week for the paid package. The scope confirmation is a short signed
            document that fixes the services, environments, response targets, and invoicing entity
            before support starts.
          </p>
          <a class="inline-cta" href={scopeMailto}>Request a scope conversation &rarr;</a>
        </div>
      </div>
    </section>
  </main>

  <DocsHandoff
    eyebrow="For your technical team"
    heading="The docs cover everything, free tier included. Bring us the scope and we will confirm it in writing."
    primaryLabel="Read the docs"
    emphasis="pilot"
  />
  <SiteFooter />
</Base>

<style>
  .never-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
  }

  .never-list li {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
    font-family: var(--registry-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    padding: 10px 16px;
  }

  /* Each metering model is struck from the register: a stamp-red cross, the
     mark an examiner puts against a rejected line item. */
  .never-list li::before {
    color: var(--registry-stamp);
    content: '✕ ' / '';
    font-weight: 700;
  }

  .never-note {
    color: var(--registry-body);
    margin: 0 auto;
    max-width: 620px;
    text-align: center;
  }

  .pricing-boundary-list {
    display: grid;
    gap: 14px;
  }

  .pricing-boundary-list article {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
    padding: 20px 22px;
  }

  .pricing-boundary-list h3,
  .pricing-boundary-list p {
    margin: 0;
  }

  .pricing-boundary-list h3 {
    margin-bottom: 8px;
  }

  .pricing-boundary-list p {
    color: var(--registry-body);
  }

  /* Six shared rows (name, price, price note, tagline, the includes list,
     CTA) so the prices sit on one line and the buttons on another, across
     all three cards, however long each tagline wraps. */
  .plan-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-template-rows: repeat(6, auto);
  }

  .scale-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(4, auto);
    margin: 24px auto 0;
    max-width: 860px;
  }

  .plan-card {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
    display: grid;
    grid-row: 1 / -1;
    grid-template-rows: subgrid;
    padding: 22px;
    position: relative;
    row-gap: 12px;
  }

  .plan-card h3 {
    margin: 0;
  }

  /* The recommended band carries the project's ink: blue border, the same
     hard offset shadow the product cards lift to on hover. */
  .plan-card-featured {
    border-color: var(--registry-blue);
    box-shadow: 4px 4px 0 rgba(23, 59, 122, 0.12);
  }

  /* A tab over the card's top rule, like a flag on a register page. */
  .plan-flag {
    background: var(--registry-blue);
    color: #ffffff;
    font-family: var(--registry-mono);
    font-size: 11px;
    font-weight: 700;
    left: 21px;
    letter-spacing: 0.06em;
    margin: 0;
    padding: 4px 10px;
    position: absolute;
    text-transform: uppercase;
    top: -12px;
  }

  .plan-cta {
    align-self: end;
    justify-content: center;
  }

  /* The fixed bands print as record slips, not catalogue items: ledger
     paper and a perforated edge, matching the product artifact cards. */
  .scale-card {
    background: var(--registry-paper);
    border: 1px dashed #c2cce0;
  }

  .plan-price {
    color: var(--registry-ink);
    font-family: var(--registry-mono);
    font-size: 24px;
    margin: 0;
  }

  .plan-price span {
    color: var(--registry-body);
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  .plan-price-talk {
    font-size: 16px;
    letter-spacing: 0.02em;
  }

  .plan-price-note {
    color: var(--registry-body);
    font-size: 12px;
    letter-spacing: 0.02em;
    margin: 2px 0 0;
  }

  .plan-band-note {
    color: var(--registry-body);
    font-size: 13px;
    line-height: 1.55;
    margin: 18px auto 0;
    max-width: 720px;
    text-align: center;
  }

  .plan-tagline {
    color: var(--registry-body);
    margin: 0;
  }

  .direct-body p {
    color: var(--registry-body);
    margin: 0 0 14px;
  }

  /* Stacked cards lay out their own rows; the shared-row subgrid only earns
     its keep when the cards sit side by side. */
  @media (max-width: 900px) {
    .plan-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .plan-grid .plan-card {
      grid-row: auto;
      grid-template-rows: none;
    }
  }

  @media (max-width: 620px) {
    .scale-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
    }

    .scale-card {
      grid-row: auto;
      grid-template-rows: none;
    }
  }
</style>
