---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';
import { askQuestionHref, contactEmail } from '../data/contact';

const pageTitle = 'FAQ | Registry Stack';
const pageDescription =
  'Answers about which products and starters fit, control of your records, self-service evaluation, and implementation and support.';

// Grouped so a reader can scan to their own concern. Each answer stays short and
// links to the page that carries the depth, so the FAQ does not become a second
// copy of the site.
const groups = [
  {
    "heading": "Choose what fits",
    "items": [
      {
        "q": "What does Registry Stack help us do?",
        "a": "Base Registry Engine holds the register: records about people, households, organizations, assets, and more, which your applications create, find, and update under your rules. Evidence Gateway lets approved services receive a signed answer from a register your organization controls, without receiving its full records. Registry Casework puts the changes that need an officer's decision in one queue. Registry Relay publishes selected fields from an existing register to approved services.",
        "link": {
          "label": "Explore the product choices",
          "href": "/solutions/#products"
        }
      },
      {
        "q": "Which products do we need?",
        "a": "Usually one to start. Base Registry Engine holds a register. Evidence Gateway answers a defined question about a register you already have. Registry Casework queues the changes an officer must decide. Registry Relay publishes selected fields to approved services. Each runs on its own; the solution page for your register says which ones most offices of that kind start with.",
        "link": {
          "label": "Find your register",
          "href": "/solutions/"
        }
      },
      {
        "q": "Which solution area am I in?",
        "a": "Start from the kind of register your office keeps: licences, businesses and taxpayers, people and households, land, property and vehicles, agriculture and food, health and regulated products, or public bodies and reference lists. If your question is about checking facts between services or reviewing changes, those two areas apply to every kind of register.",
        "link": {
          "label": "See the solution areas",
          "href": "/solutions/"
        }
      },
      {
        "q": "Who is behind Registry Stack?",
        "a": "Aubex Consulting LLC, based in San Francisco, builds and supports Registry Stack. The software is open source under Apache-2.0, and Aubex offers paid implementation pilots and support at published prices.",
        "link": {
          "label": "Read who does the work",
          "href": "/pricing/#team"
        }
      },
      {
        "q": "Can we keep our existing register?",
        "a": "Yes. Evidence Gateway can use an existing source to answer configured questions, such as whether a supplier is actively registered. When a service needs selected fields instead, Registry Relay can provide access to data your team prepares from that source.",
        "link": {
          "label": "Explore Evidence Gateway",
          "href": "/products/evidence-gateway/"
        }
      },
      {
        "q": "What is Registry Stack not?",
        "a": "It is not a central data store, a data exchange platform, or a replacement for the applications your staff use. It does not copy your registries into one place, and it does not decide eligibility for you. Each product does one job beside the systems you already run: hold records, answer a defined question, publish selected fields, or coordinate the officers who review changes.",
        "link": {
          "label": "Read how it sits beside existing systems",
          "href": "https://docs.registrystack.org/explanation/integration-patterns/"
        }
      }
    ]
  },
  {
    "heading": "Your records and your applications",
    "items": [
      {
        "q": "Who owns and controls the records?",
        "a": "Your organization does. You decide who may create or change a record, which services can ask for information, and what they may receive. The software applies the rules your team configures. You host the deployment; the software does not send your records or audit logs to Aubex.",
        "link": {
          "label": "Understand the security responsibilities",
          "href": "/security/"
        }
      },
      {
        "q": "What does our team supply?",
        "a": "Your organization defines the records and access rules, provides the application people use, and operates the service. Base Registry Engine handles record storage, relationships, and controlled access and updates. Evidence Gateway connects to a source your team makes available and returns the answers you have defined.",
        "link": {
          "label": "See how Base Registry Engine supports your application",
          "href": "/products/base-registry/"
        }
      },
      {
        "q": "Can we start from a spreadsheet or legacy database?",
        "a": "Yes, with preparation by your technical team. To share selected information with Registry Relay, your team prepares and maintains a reviewed extract. To move records into Base Registry Engine, your team defines the record structure and plans the migration.",
        "link": {
          "label": "Explore Registry Relay",
          "href": "/products/registry-relay/"
        }
      },
      {
        "q": "Does every new question mean a new integration project?",
        "a": "No. The register is connected once. Each further question a service asks is a configuration change: your team defines the answer, its source, and who may receive it, and reviews that definition before it goes live. The first connection carries the integration cost; later questions reuse it.",
        "link": {
          "label": "Read how to define the question first",
          "href": "/blog/before-you-connect-a-registry-define-the-question/"
        }
      }
    ]
  },
  {
    "heading": "Starters",
    "items": [
      {
        "q": "What is a starter?",
        "a": "A starting configuration for one common kind of register: the kinds of record it holds, the fields, and who may change what. Your team generates a project from it and adds what your register needs. A starter is a starting point, not a running registry, and does not show that the register is in use anywhere.",
        "link": {
          "label": "Browse the starters",
          "href": "/starters/"
        }
      },
      {
        "q": "How do we get a starter?",
        "a": "From the starter's page, by email. Someone on the Aubex team replies from contact@registrystack.org with the zip attached and its SHA-256 checksum, and says when to expect it. Nobody calls unless you ask, and we add you to no mailing list.",
        "link": {
          "label": "Choose a starter",
          "href": "/starters/"
        }
      },
      {
        "q": "Why is it sent by email rather than downloaded?",
        "a": "The starters repository is not yet public. Until it is, we send each starter as a zip on request. Each zip carries a checksum so your team can confirm it is the file we published.",
        "link": {
          "label": "Browse the starters",
          "href": "/starters/"
        }
      }
    ]
  },
  {
    "heading": "Evaluation and paid support",
    "items": [
      {
        "q": "Is there a software licence fee?",
        "a": "No. Registry Stack is Apache-2.0 open-source software. Your team provides the hosting, implementation, and operation. Self-service use is separate from paid delivery and private support.",
        "link": {
          "label": "Read the documentation",
          "href": "https://docs.registrystack.org/"
        }
      },
      {
        "q": "What can our developers try?",
        "a": "The Base Registry Engine tutorial creates and updates a sample business record. The Evidence Gateway tutorial checks a synthetic person's adult status and verifies the signed answer. The Registry Relay tutorial publishes a sample business register with two permitted fields. Each tutorial explains its prerequisites and steps.",
        "link": {
          "label": "Choose an introductory tutorial",
          "href": "/#developers"
        }
      },
      {
        "q": "What implementation and support services are available?",
        "a": "We can help deliver a scoped implementation pilot. If your team handles implementation itself, you can choose an ongoing support contract. Both are paid services, with the scope and fee agreed before work begins. You can discuss your needs before installing the software.",
        "link": {
          "label": "See implementation and support pricing",
          "href": "/pricing/"
        }
      },
      {
        "q": "Are the examples real?",
        "a": "No. Every record, name and organization in the illustrations is fictional and labeled as such. We do not publish customer names or outcomes we cannot show.",
        "link": {
          "label": "See where the project stands",
          "href": "/#project-status"
        }
      }
    ]
  }
];

// FAQPage structured data, built from every group's question and answer so the
// markup stays in step with the visible FAQ.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  ),
};
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="faq" />

  <main>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <section class="hero" aria-labelledby="faq-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">FAQ</p>
          <h1 id="faq-hero-title">What would Registry Stack mean for your team?</h1>
          <p class="hero-lead">
            Product fit, control of your records, and the choice between self-service
            evaluation and paid implementation or support.
          </p>
        </div>
      </div>
    </section>

    {groups.map((group, index) => (
      <section class={index % 2 === 1 ? 'section section-muted' : 'section'} aria-labelledby={`faq-group-${index}`}>
        <div class="section-inner">
          <div class="section-heading">
            <h2 id={`faq-group-${index}`}>{group.heading}</h2>
          </div>
          <div class="faq-list">
            {group.items.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                  <a class="inline-cta" href={item.link.href}>{item.link.label} &rarr;</a>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>

  <DocsHandoff
    heading="Still have a question?"
    body="Write to us and say which register you keep."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref()}
    emphasis="docs"
    note={contactEmail}
  />
  <SiteFooter />
</Base>

<style>
  .faq-list {
    display: grid;
    gap: 12px;
    margin-top: clamp(20px, 3vw, 28px);
    max-width: 820px;
  }

  .faq-item {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
  }

  .faq-item summary {
    align-items: center;
    color: var(--registry-ink);
    cursor: pointer;
    display: flex;
    font-size: var(--type-body);
    font-weight: 700;
    gap: 16px;
    justify-content: space-between;
    list-style: none;
    padding: 18px 20px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* A register tick that opens into a cross, so the control reads without
     relying on a dash glyph. */
  .faq-item summary::after {
    color: var(--registry-blue);
    content: '+';
    font-family: var(--registry-mono);
    font-size: var(--type-subhead);
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item summary:hover {
    color: var(--registry-blue);
  }

  .faq-answer {
    border-top: 1px solid var(--registry-rule);
    display: grid;
    gap: 12px;
    padding: 16px 20px 20px;
  }

  .faq-answer p {
    color: var(--registry-body);
    line-height: 1.6;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item summary::after {
      transition: none;
    }
  }
</style>
