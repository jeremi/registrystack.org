---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';

const pageTitle = 'FAQ | Registry Stack';
const pageDescription =
  'Answers about product fit, control of your records, self-service evaluation, and implementation and support.';

// Grouped so a reader can scan to their own concern. Each answer stays short and
// links to the page that carries the depth, so the FAQ does not become a second
// copy of the site.
const groups = [
  {
    "heading": "Choose what fits",
    "items": [
      {
        "q": "What does Registry Stack help us do?",
        "a": "Base Registry Engine stores and manages records about people, households, organizations, assets, and more. Your applications can create, find, and update those records under your rules. Evidence Gateway lets approved services receive signed facts from a source your organization controls, without receiving its full records.",
        "link": {
          "label": "See illustrative use cases",
          "href": "/use-cases/"
        }
      },
      {
        "q": "Do we need both main products?",
        "a": "No. Base Registry Engine stores and maintains your organization's records. Evidence Gateway can answer questions using an existing source. Each can be used independently. If you choose to combine them, your technical team configures their connection.",
        "link": {
          "label": "Explore the product choices",
          "href": "/"
        }
      },
      {
        "q": "Can we keep our existing registry?",
        "a": "Yes. Evidence Gateway can use an existing source to answer configured questions, such as whether a supplier is actively registered. When a service needs selected fields instead, Registry Relay can provide access to data your team prepares from that source.",
        "link": {
          "label": "Explore Evidence Gateway",
          "href": "/solutions/evidence-gateway/"
        }
      }
    ]
  },
  {
    "heading": "Your records and your applications",
    "items": [
      {
        "q": "Who owns and controls the records?",
        "a": "Your organization does. You decide who may create or change a record, which services can ask for information, and what they may receive. The software applies the rules your team configures. You host the deployment; the software does not send your records or audit logs to Aubex.",
        "link": {
          "label": "Understand the security responsibilities",
          "href": "/security/"
        }
      },
      {
        "q": "What does our team supply?",
        "a": "Your organization defines the records and access rules, provides the application people use, and operates the service. Base Registry Engine handles record storage, relationships, and controlled access and updates. Evidence Gateway connects to a source your team makes available and returns the answers you have defined.",
        "link": {
          "label": "See how Base Registry Engine supports your application",
          "href": "/solutions/base-registry/"
        }
      },
      {
        "q": "Can we start from a spreadsheet or legacy database?",
        "a": "Yes, with preparation by your technical team. To share selected information with Registry Relay, your team prepares and maintains a reviewed extract. To move records into Base Registry Engine, your team defines the record structure and plans the migration.",
        "link": {
          "label": "Explore Registry Relay",
          "href": "/solutions/protected-registry-apis/"
        }
      }
    ]
  },
  {
    "heading": "Evaluation and paid support",
    "items": [
      {
        "q": "Is there a software license fee?",
        "a": "No. Registry Stack is Apache-2.0 open-source software. Your team provides the hosting, implementation, and operation. Self-service use is separate from paid delivery and private support.",
        "link": {
          "label": "Read the documentation",
          "href": "https://docs.registrystack.org/"
        }
      },
      {
        "q": "What can our developers try?",
        "a": "The Base Registry Engine tutorial creates and updates a sample business record. The Evidence Gateway tutorial checks a synthetic person's adult status and verifies the signed answer. The Registry Relay tutorial publishes a sample business register with two permitted fields. Each tutorial explains its prerequisites and steps.",
        "link": {
          "label": "Choose an introductory tutorial",
          "href": "/use-cases/#tutorial-exercises-title"
        }
      },
      {
        "q": "What implementation and support services are available?",
        "a": "We can help deliver a scoped implementation pilot. If your team handles implementation itself, you can choose an ongoing support contract. Both are paid services, with the scope and fee agreed before work begins. You can discuss your needs before installing the software.",
        "link": {
          "label": "See implementation and support pricing",
          "href": "/pricing/"
        }
      }
    ]
  }
];

// FAQPage structured data, built from every group's question and answer so the
// markup stays in step with the visible FAQ.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  ),
};
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="faq" />

  <main>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <section class="hero" aria-labelledby="faq-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">FAQ</p>
          <h1 id="faq-hero-title">What would Registry Stack mean for your team?</h1>
          <p class="hero-lead">
            Product fit, control of your records, and the choice between self-service
            evaluation and paid implementation or support.
          </p>
        </div>
      </div>
    </section>

    {groups.map((group, index) => (
      <section class={index % 2 === 1 ? 'section section-muted' : 'section'} aria-labelledby={`faq-group-${index}`}>
        <div class="section-inner">
          <div class="section-heading">
            <h2 id={`faq-group-${index}`}>{group.heading}</h2>
          </div>
          <div class="faq-list">
            {group.items.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                  <a class="inline-cta" href={item.link.href}>{item.link.label} &rarr;</a>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>

  <DocsHandoff />
  <SiteFooter />
</Base>

<style>
  .faq-list {
    display: grid;
    gap: 12px;
    margin-top: clamp(20px, 3vw, 28px);
    max-width: 820px;
  }

  .faq-item {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
  }

  .faq-item summary {
    align-items: center;
    color: var(--registry-ink);
    cursor: pointer;
    display: flex;
    font-size: 17px;
    font-weight: 700;
    gap: 16px;
    justify-content: space-between;
    list-style: none;
    padding: 18px 20px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* A register tick that opens into a cross, so the control reads without
     relying on a dash glyph. */
  .faq-item summary::after {
    color: var(--registry-blue);
    content: '+';
    font-family: var(--registry-mono);
    font-size: 20px;
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item summary:hover {
    color: var(--registry-blue);
  }

  .faq-answer {
    border-top: 1px solid var(--registry-rule);
    display: grid;
    gap: 12px;
    padding: 16px 20px 20px;
  }

  .faq-answer p {
    color: var(--registry-body);
    line-height: 1.6;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item summary::after {
      transition: none;
    }
  }
</style>
