---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';
import { askQuestionHref, contactEmail } from '../data/contact';

const pageTitle = 'FAQ | Registry Stack';
const pageDescription =
  'Answers about service fit, control of your records, starting configurations, self-service evaluation, implementation, and support.';

// Grouped so a reader can scan to their own concern. Each answer stays short and
// links to the page that carries the depth, so the FAQ does not become a second
// copy of the site.
const groups = [
  {
    "heading": "Choose what fits",
    "items": [
      {
        "q": "What does Registry Stack help us do?",
        "a": "Registry Stack helps your institution deliver services that depend on authoritative records. You can maintain records under your rules, route changes that need an officer's review, and give approved services a defined, digitally signed answer without sharing a complete record.",
        "link": {
          "label": "Explore the product choices",
          "href": "/solutions/#products"
        }
      },
      {
        "q": "Which products do we need?",
        "a": "You can begin with the service you need rather than choosing products yourself. Base Registry Engine maintains records, Evidence Gateway answers defined questions from an authorized source, and Registry Casework coordinates changes an officer must review. Each runs independently, and a solution can combine only the products its journey requires.",
        "link": {
          "label": "Find your register",
          "href": "/solutions/"
        }
      },
      {
        "q": "Which solution area am I in?",
        "a": "Start from the kind of service or register your institution needs: licences, businesses and taxpayers, people and households, land, property and vehicles, agriculture and food, health and regulated products, or public bodies and reference lists. Checking facts between services and reviewing changes can apply across these areas.",
        "link": {
          "label": "See the solution areas",
          "href": "/solutions/"
        }
      },
      {
        "q": "Who is behind Registry Stack?",
        "a": "Aubex Consulting LLC, based in San Francisco, builds and supports Registry Stack. The core software is open source under Apache-2.0. Aubex offers paid implementation pilots and support at published prices.",
        "link": {
          "label": "Read who does the work",
          "href": "/pricing/#team"
        }
      },
      {
        "q": "Can we keep our existing register?",
        "a": "Yes. Evidence Gateway can use an interface your system offers or a read-only extract to answer approved questions, such as whether a supplier is actively registered. Your team can establish that connection in a self-service implementation, or a paid delivery scope can assign the integration work.",
        "link": {
          "label": "Explore Evidence Gateway",
          "href": "/products/evidence-gateway/"
        }
      },
      {
        "q": "What is Registry Stack not?",
        "a": "Registry Stack is a set of focused products for governed records, review, and limited information sharing. It works beside identity, staff and public screens, payments, data exchange, and other systems your service uses. Your institution remains responsible for policy decisions such as eligibility and permission to practise.",
        "link": {
          "label": "Read the known limitations",
          "href": "https://docs.registrystack.org/explanation/known-limitations/"
        }
      }
    ]
  },
  {
    "heading": "Your service and records",
    "items": [
      {
        "q": "Who owns and controls the records?",
        "a": "Your organization does. You decide who may create or change a record, which services may ask for information, and what they may receive. You or an operator you appoint controls the deployment. The software applies the rules your team configures and does not send your records or audit logs to Aubex.",
        "link": {
          "label": "Understand the security responsibilities",
          "href": "/security/"
        }
      },
      {
        "q": "What does our team supply?",
        "a": "For a self-service implementation, your team defines the journey, records, access rules, screens, identity, integrations, hosting, migration, and operation. In a paid delivery engagement, the written scope can include some of that work. It states what your team and ours will each deliver, including handover.",
        "link": {
          "label": "See how Base Registry Engine supports your application",
          "href": "/products/base-registry/"
        }
      },
      {
        "q": "Can we start from a spreadsheet or legacy database?",
        "a": "Yes. A service can read an agreed extract from an existing source, or records can be prepared for migration into Base Registry Engine. The implementation scope defines mapping, data quality checks, refresh or migration steps, and who is responsible for each one.",
        "link": {
          "label": "Explore Evidence Gateway",
          "href": "/products/evidence-gateway/"
        }
      },
      {
        "q": "Does every new question mean a new integration project?",
        "a": "A source connection can support more than one predefined question when they use the same interface and authority. Each question still needs its answer, source, permitted recipients, and purpose defined and reviewed before use. A question that needs another source or interface may require additional integration work.",
        "link": {
          "label": "Read how to define the question first",
          "href": "/blog/before-you-connect-a-registry-define-the-question/"
        }
      }
    ]
  },
  {
    "heading": "Starters",
    "items": [
      {
        "q": "What is a starter?",
        "a": "A starter is a reusable starting configuration for one kind of register. It defines records, actions, and access roles that your team can adapt to local law and process. The catalogue is not a collection of ready-to-run applications: screens, identity, integrations, hosting, data, and operation still need to be supplied or scoped.",
        "link": {
          "label": "Browse the starters",
          "href": "/starters/"
        }
      },
      {
        "q": "How do we get a starter?",
        "a": "Starters are currently free by request. The button on a starter page opens an email to contact@registrystack.org that names it. We send the configuration as a zip, or help identify a closer starting point if the one you named does not fit.",
        "link": {
          "label": "Choose a starter",
          "href": "/starters/"
        }
      },
      {
        "q": "Why is it sent by email rather than downloaded?",
        "a": "Starting configurations are currently available by request. Contact us to receive a model for your team to evaluate and adapt. Building a service also requires screens, integrations and deployment suited to your institution.",
        "link": {
          "label": "Browse the starters",
          "href": "/starters/"
        }
      },
      {
        "q": "Do we need to choose a starter before asking for help?",
        "a": "No. Describe the service, its users, the records it depends on, and what should improve. In an implementation engagement, our team can identify the nearest available model and adapt it with you.",
        "link": {
          "label": "Describe the service you need",
          "href": "/pricing/#inquiry"
        }
      }
    ]
  },
  {
    "heading": "Evaluation and paid support",
    "items": [
      {
        "q": "Is there a software licence fee?",
        "a": "The core Registry Stack software is available under Apache 2.0 with no software licence fee. Implementation and private support are paid services. Registry Studio is in development under a separate proprietary licence, and Registry App Kit is not a public download.",
        "link": {
          "label": "Read the documentation",
          "href": "https://docs.registrystack.org/"
        }
      },
      {
        "q": "What does using the free software commit us to?",
        "a": "Self-service use does not require buying implementation or support. Your team must preserve the applicable licence and notice files, including attribution for PublicSchema record definitions where used. The core software does not send your records or audit logs to Aubex.",
        "link": {
          "label": "Read the privacy policy",
          "href": "/privacy/"
        }
      },
      {
        "q": "How mature is the software?",
        "a": "The core software is in Beta for institutional pilots. Your organization or an appointed provider operates it. Interfaces may change before version 1.0, so your technical team needs to plan upgrades. A paid implementation proposal states who provides and operates the hosting.",
        "link": {
          "label": "Read the known limitations",
          "href": "https://docs.registrystack.org/explanation/known-limitations/"
        }
      },
      {
        "q": "What can our developers try?",
        "a": "The Base Registry Engine tutorial creates a contact registry, adds and reads a contact, and shows how permissions limit who can find it. The Evidence Gateway tutorial checks a fictional person's adult status and verifies the signed answer. Each tutorial explains its prerequisites and steps.",
        "link": {
          "label": "Choose an introductory tutorial",
          "href": "/#developers"
        }
      },
      {
        "q": "What implementation and support services are available?",
        "a": "An implementation pilot can cover an agreed service journey, screens, identity, integrations, data preparation or migration, hosting responsibilities, and handover. Annual support is for teams that implement and operate Registry Stack themselves. The written scope says what is included, who does each part, and the fee.",
        "link": {
          "label": "See implementation and support pricing",
          "href": "/pricing/"
        }
      },
      {
        "q": "Can AI help customize our service?",
        "a": "Yes, through an implementation pilot with our team. We use AI tools to help adapt records, forms and review steps, then test the result with you. The configured service does not require an AI service for ordinary operation. Registry Studio is in development; its self-service AI assistant is planned.",
        "link": {
          "label": "Explore AI-assisted customization",
          "href": "/customization/"
        }
      }
    ]
  }
];

// FAQPage structured data, built from every group's question and answer so the
// markup stays in step with the visible FAQ.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((group) =>
    group.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  ),
};
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="faq" />

  <main>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <section class="hero" aria-labelledby="faq-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">FAQ</p>
          <h1 id="faq-hero-title">What would Registry Stack mean for your team?</h1>
          <p class="hero-lead">
            Product fit, control of your records, and the choice between self-service
            evaluation and paid implementation or support.
          </p>
        </div>
      </div>
    </section>

    {groups.map((group, index) => (
      <section class={index % 2 === 1 ? 'section section-muted' : 'section'} aria-labelledby={`faq-group-${index}`}>
        <div class="section-inner">
          <div class="section-heading">
            <h2 id={`faq-group-${index}`}>{group.heading}</h2>
          </div>
          <div class="faq-list">
            {group.items.map((item) => (
              <details class="faq-item">
                <summary>{item.q}</summary>
                <div class="faq-answer">
                  <p>{item.a}</p>
                  <a class="inline-cta" href={item.link.href}>{item.link.label} &rarr;</a>
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>

  <DocsHandoff
    heading="Still have a question?"
    body="Tell us about the service you need and what you would like to know."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref()}
    emphasis="docs"
    note={contactEmail}
  />
  <SiteFooter />
</Base>

<style>
  .faq-list {
    display: grid;
    gap: 12px;
    margin-top: clamp(20px, 3vw, 28px);
    max-width: 820px;
  }

  .faq-item {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
  }

  .faq-item summary {
    align-items: center;
    color: var(--registry-ink);
    cursor: pointer;
    display: flex;
    font-size: var(--type-body);
    font-weight: 700;
    gap: 16px;
    justify-content: space-between;
    list-style: none;
    padding: 18px 20px;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  /* A register tick that opens into a cross, so the control reads without
     relying on a dash glyph. */
  .faq-item summary::after {
    color: var(--registry-blue);
    content: '+';
    font-family: var(--registry-mono);
    font-size: var(--type-subhead);
    line-height: 1;
    transition: transform 0.15s ease;
  }

  .faq-item[open] summary::after {
    transform: rotate(45deg);
  }

  .faq-item summary:hover {
    color: var(--registry-blue);
  }

  .faq-answer {
    border-top: 1px solid var(--registry-rule);
    display: grid;
    gap: 12px;
    padding: 16px 20px 20px;
  }

  .faq-answer p {
    color: var(--registry-body);
    line-height: 1.6;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item summary::after {
      transition: none;
    }
  }
</style>
