---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { describeServiceHref } from '../data/contact';
import { teamRecordFull } from '../data/team';

const pageTitle = 'About | Registry Stack';
const pageDescription =
  'Aubex Consulting LLC builds and supports Registry Stack, open-source software for public registries.';
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="about" />

  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="about-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">About</p>
          <h1 id="about-hero-title">Who builds and supports Registry Stack.</h1>
          <p class="hero-lead">
            Aubex Consulting LLC builds and supports Registry Stack. The core software is open
            source under Apache-2.0, so your team can use it with or without us.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="about-work-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">What Aubex does</p>
          <h2 id="about-work-title">Open software, with help when you want it.</h2>
        </div>
        <div class="about-cards">
          <article class="quiet-card">
            <h3>Pilot register implementation</h3>
            <p>We implement one register and its service with your team. See <a href="/pricing/">pricing</a> for what is agreed before work starts.</p>
          </article>
          <article class="quiet-card">
            <h3>Annual support</h3>
            <p>If your team implements and operates Registry Stack, we support the products and versions you run. See <a href="/pricing/">pricing</a> for how support works.</p>
          </article>
          <article class="quiet-card">
            <h3>Registry Studio</h3>
            <p>Studio is a commercial authoring tool with its own licensing terms. The Apache-2.0 licence of the core software does not cover it, and you do not need Studio to run or change a service. <a href="/products/studio/">About Registry Studio</a></p>
          </article>
          <article class="quiet-card">
            <h3>Service design</h3>
            <p>Service design work is mainly delivered through our partners. <a href="/ai/service-design/">About service design</a></p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="about-people-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Who you work with</p>
          <h2 id="about-people-title">Ten years of government registry work.</h2>
          <p>{teamRecordFull}</p>
          <p>Jeremi also:</p>
          <ul class="person-roles">
            <li>
              leads <a href="https://openspp.org/">OpenSPP</a>, open-source software for social protection
              programmes, stewarded by ACN;
            </li>
            <li>
              sits on the <a href="https://spdci.org/">SP-DCI</a> standards committee, which sets common
              standards for social protection systems to exchange data;
            </li>
            <li>
              works in <a href="https://www.govstack.global/">GovStack</a>'s AI and Digital Registries working
              groups, which write open specifications for digital government services.
            </li>
          </ul>
        </div>
        <div class="quiet-card">
          <h3>Your register does not depend on us.</h3>
          <ul class="check-list">
            <li>The core software is open source under Apache-2.0.</li>
            <li>Your rules and configuration are files your team keeps.</li>
            <li>The <a href="https://docs.registrystack.org/">documentation</a> is public.</li>
            <li>Any provider you appoint can run and support it.</li>
          </ul>
          <p class="company-note">
            Aubex Consulting LLC is based in San Francisco, United States. See the <a href="/imprint/">legal notice</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="about-next-title">
      <div class="section-inner">
        <p class="eyebrow">Next step</p>
        <h2 id="about-next-title">Talk to us about your register.</h2>
        <p>Say who you are and what you need. You do not need a budget to ask.</p>
        <div class="hero-actions">
          <a class="button button-primary" href={describeServiceHref('Aubex and Registry Stack')} data-journey="service-inquiry">Discuss your service</a>
          <a class="button button-secondary" href="/pricing/">Implementation and pricing</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .about-cards {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: clamp(24px, 4vw, 36px);
  }

  .quiet-card h3 {
    margin-top: 0;
  }

  .quiet-card p:last-child {
    margin-bottom: 0;
  }

  .person-roles {
    color: var(--registry-body);
    display: grid;
    font-size: var(--type-lg);
    gap: 10px;
    line-height: 1.55;
    margin: 0;
    padding-left: 1.2em;
  }

  /* The company note follows the list as one more ruled row. */
  .company-note {
    border-top: 1px solid var(--registry-rule);
    line-height: 1.5;
    margin-top: 12px;
    padding-top: 12px;
  }

  /* Links in these lists sit inside running text, so they are underlined. */
  .person-roles a,
  .check-list a,
  .company-note a {
    text-decoration: underline;
  }

  @media (max-width: 720px) {
    .about-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
