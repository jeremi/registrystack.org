---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';
import MinimizationFunnel from '../components/MinimizationFunnel.astro';

const pageTitle = 'Use cases | Registry Stack';
const pageDescription =
  'Government registry scenarios using signed minimum-disclosure answers and protected access to selected data.';

const scenarios = [
  {
    domain: 'Civil registration',
    need: 'A service needs the person&rsquo;s age band, not their date of birth.',
    choice: 'Evidence Gateway',
    result: 'Return a clear answer such as “18-64,” calculated from the civil register.',
    stays: 'Date of birth and the rest of the civil-registration record stay with the authority.',
  },
  {
    domain: 'Social protection',
    need: 'A school meal program needs to know whether a household is enrolled.',
    choice: 'Evidence Gateway',
    result: 'Return the current enrollment status agreed by the social registry owner.',
    stays: 'The household case file, income details, and payment history are not returned.',
  },
  {
    domain: 'Business registration',
    need: 'A procurement service needs to check whether a supplier is actively registered.',
    choice: 'Evidence Gateway',
    result: 'Return a signed active or inactive answer tied to the business number.',
    stays: 'Filing history, addresses, and ownership records stay in the business register.',
  },
  {
    domain: 'Farmer support',
    need: 'A subsidy program needs both registration status and farm size.',
    choice: 'Protected Registry APIs',
    result: 'Return the agreed fields, such as registered status and 2.5 hectares.',
    stays: 'Plot coordinates, household members, crop history, and financial records are not returned.',
  },
  {
    domain: 'Residence verification',
    need: 'A service needs the person&rsquo;s residence region, not their full address or household record.',
    choice: 'Evidence Gateway',
    result: 'Return a signed region value defined by the registry owner for the approved purpose.',
    stays: 'The street address, household members, and rest of the source record stay with the authority.',
  },
  {
    domain: 'A registry in a spreadsheet',
    need: 'A partner service needs a few fields from an XLSX or CSV source that is currently shared by email.',
    choice: 'Protected Registry APIs',
    result: 'Provide read-only access to agreed fields through a documented API.',
    stays: 'The source file, database credentials, and unrelated rows are not distributed to the partner.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="use-cases" />

  <main>
    <section class="hero" aria-labelledby="uc-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Use cases</p>
          <h1 id="uc-hero-title">Decide what each service actually needs to receive.</h1>
          <p class="hero-lead">
            A service may need one signed answer or several selected fields from a registry.
            Registry Stack supports both while the source records stay with the registry owner.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="choices-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Two types of response</p>
          <h2 id="choices-title">Choose a signed answer or selected data.</h2>
        </div>
        <div class="choice-grid">
          <article>
            <p class="choice-marker">Answer</p>
            <h3>A fact or status</h3>
            <p>Use Evidence Gateway when the service needs one predefined fact such as active, enrolled, or an age band.</p>
          </article>
          <article>
            <p class="choice-marker">Data</p>
            <h3>Selected data or agreed fields</h3>
            <p>Use Protected Registry APIs when the service needs specific fields for its own work and the registry owner agrees.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="many-answers-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Different services, different information</p>
          <h2 id="many-answers-title">One registry can support several services without sharing every field.</h2>
          <p>
            Different services can receive different answers from the same source record. Each
            request uses the agreement for that service and purpose.
          </p>
        </div>
        <MinimizationFunnel />
      </div>
    </section>

    <section class="section" aria-labelledby="scenarios-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Public-service examples</p>
          <h2 id="scenarios-title">How each type of response works in practice.</h2>
        </div>
        <div class="scenario-grid">
          {scenarios.map((scenario) => (
            <article class="scenario-card">
              <p class="scenario-domain">{scenario.domain}</p>
              <h3 set:html={scenario.need} />
              <p class="scenario-choice">{scenario.choice}</p>
              <div>
                <p class="scenario-label">What is returned</p>
                <p set:html={scenario.result} />
              </div>
              <div>
                <p class="scenario-label">What stays at the source</p>
                <p set:html={scenario.stays} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="ai-context-title">
      <div class="section-inner ai-context">
        <div class="section-heading compact">
          <p class="eyebrow">AI-assisted services</p>
          <h2 id="ai-context-title">AI-assisted services follow the same access rules as other services.</h2>
        </div>
        <div class="ai-context-body">
          <p>
            If a public service uses AI to guide a person or caseworker, it can use the same
            configured Registry Stack interface as any other service. The usual identity, purpose,
            and request checks still apply. The AI does not receive direct access to the source or
            special permission to query it.
          </p>
          <p>
            Registry Stack is not an eligibility decision maker, an approval console, or general
            permission for an AI system to query registries. A model cannot use it to invent a new
            registry question or choose a different person.
          </p>
        </div>
      </div>
    </section>
  </main>

  <DocsHandoff
    eyebrow="Technical details"
    heading="See the supported source types, signed assertion formats, and protected API contracts."
    primaryLabel="Read the docs"
    emphasis="docs"
  />
  <SiteFooter />
</Base>

<style>
  .choice-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .choice-grid article {
    border-top: 2px solid var(--registry-ink);
    padding-top: 16px;
  }

  .choice-grid h3,
  .choice-grid p {
    margin-bottom: 8px;
  }

  .choice-marker,
  .scenario-domain,
  .scenario-label {
    color: var(--registry-blue);
    font-family: var(--registry-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scenario-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .scenario-card {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
    display: grid;
    gap: 16px;
    min-width: 0;
    padding: 22px;
  }

  .scenario-card h3,
  .scenario-card p {
    margin: 0;
  }

  .scenario-choice {
    border-left: 3px solid var(--registry-stamp);
    color: var(--registry-ink);
    font-size: 14px;
    font-weight: 700;
    padding-left: 10px;
  }

  .scenario-label {
    margin-bottom: 5px !important;
  }

  .ai-context {
    display: grid;
    gap: clamp(28px, 6vw, 80px);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .ai-context-body {
    border-top: 2px solid var(--registry-ink);
    padding-top: 18px;
  }

  .ai-context-body p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .scenario-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .choice-grid,
    .scenario-grid,
    .ai-context {
      grid-template-columns: 1fr;
    }
  }
</style>
