---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';
import MinimizationFunnel from '../components/MinimizationFunnel.astro';
import { products } from '../data/products';

const pageTitle = 'Use cases | Registry Stack';
const pageDescription =
  'Illustrative examples of maintaining a register, checking a fact, and sharing selected information with services.';

const scenarios = [
  {
    domain: 'People and households',
    need: 'A local authority needs to maintain resident records and their household relationships.',
    choice: 'Base Registry Engine',
    result: 'Store person and household records, link them, and let authorized staff find and update the information through their application, with a history of changes.',
    stays: 'The authority defines the records, runs the registry, and controls which details each role can access.',
  },
  {
    domain: 'Businesses and establishments',
    need: 'A registration authority needs a register of businesses and the establishments they operate.',
    choice: 'Base Registry Engine',
    result: 'Store and connect business and establishment records. Create registrations, look up existing entries, and keep addresses and status current under the registry&rsquo;s rules.',
    stays: 'The authority owns the register and sets the access, validation, and review rules used by its applications.',
  },
  {
    domain: 'Civil registration',
    need: 'A licensing service needs to check an applicant&rsquo;s age band.',
    choice: 'Evidence Gateway',
    result: 'Return an age band such as “18–64”, calculated from the civil register.',
    stays: 'Date of birth and the rest of the civil-registration record stay with the authority.',
  },
  {
    domain: 'Social protection',
    need: 'A school meal program needs to know whether a household is enrolled.',
    choice: 'Evidence Gateway',
    result: 'Return the current enrollment status agreed by the social registry owner.',
    stays: 'The household case file, income details, and payment history are not returned.',
  },
  {
    domain: 'Business registration',
    need: 'A procurement service needs to check whether a supplier is actively registered.',
    choice: 'Evidence Gateway',
    result: 'Return a signed active or inactive answer for the supplier being checked.',
    stays: 'Filing history, addresses, and ownership records stay in the business register.',
  },
  {
    domain: 'Farmer support',
    need: 'A subsidy program needs both registration status and farm size.',
    choice: 'Registry Relay',
    result: 'Return the agreed fields, such as registered status and 2.5 hectares.',
    stays: 'Plot coordinates, household members, crop history, and financial records are not returned.',
  },
  {
    domain: 'Residence verification',
    need: 'A local service needs to check the person&rsquo;s residence region.',
    choice: 'Evidence Gateway',
    result: 'Return a signed region value defined by the registry owner for the approved purpose.',
    stays: 'The street address, household members, and rest of the source record stay with the authority.',
  },
  {
    domain: 'A registry in a spreadsheet',
    need: 'A partner service needs a few fields from an XLSX or CSV source that is currently shared by email.',
    choice: 'Registry Relay',
    result: 'The registry team prepares and maintains a reviewed extract. Registry Relay gives the partner access to the agreed fields.',
    stays: 'The source file, database credentials, and unrelated rows are not distributed to the partner.',
  },
];

const tutorialExercises = [
  {
    product: 'Base Registry Engine',
    exercise: 'Create a sample business record, change its label, and try requests the server refuses.',
  },
  {
    product: 'Evidence Gateway',
    exercise: 'Ask whether a synthetic person is an adult and verify the signed answer.',
  },
  {
    product: 'Registry Relay',
    exercise: 'Publish a sample business register that returns legal name and legal form, and refuses a request for the address.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="use-cases" />

  <main>
    <section class="hero" aria-labelledby="uc-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Use cases</p>
          <h1 id="uc-hero-title">Keep records useful. Give services the facts they need.</h1>
          <p class="hero-lead">
            A local authority maintains resident records. A procurement service checks a supplier.
            These illustrative examples show how Registry Stack can support the work and
            what remains under the organization&rsquo;s control.
          </p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="choices-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Two ways to start</p>
          <h2 id="choices-title">Build a registry or share a verifiable fact.</h2>
        </div>
        <div class="choice-grid">
          <article>
            <p class="choice-marker">Base Registry Engine</p>
            <h3>A registry your team can maintain</h3>
            <p>Store and manage records about people, households, organizations, or assets. Your applications can create, find, and update them under shared rules, with a history of changes.</p>
            <a class="inline-cta" href="/solutions/base-registry/">Explore Base Registry Engine →</a>
          </article>
          <article>
            <p class="choice-marker">Evidence Gateway</p>
            <h3>A signed fact or status</h3>
            <p>An approved service checks a fact held in an existing source. The gateway returns the agreed answer with a signature the service can verify.</p>
            <a class="inline-cta" href="/solutions/evidence-gateway/">Explore Evidence Gateway →</a>
          </article>
        </div>
        <p class="choice-note">These products can be used independently. When a service needs selected fields, <a href="/solutions/protected-registry-apis/">Registry Relay</a> provides another option.</p>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="many-answers-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Illustration: a civil register</p>
          <h2 id="many-answers-title">One registry can support several services without sharing every field.</h2>
          <p>
            A pension service checks whether a person is alive. A licensing service checks
            whether they are 18 or older. The registry owner defines the permitted questions and
            access rules; Evidence Gateway applies those rules to each request.
          </p>
        </div>
        <MinimizationFunnel />
      </div>
    </section>

    <section class="section" aria-labelledby="scenarios-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Illustrative public-service scenarios</p>
          <h2 id="scenarios-title">Start with the work your team needs to do.</h2>
          <p>Each scenario shows a possible configuration. Your organization defines the records, permissions, and service rules for its own use.</p>
        </div>
        <div class="scenario-grid">
          {scenarios.map((scenario) => (
            <article class="scenario-card">
              <p class="scenario-domain">{scenario.domain}</p>
              <h3 set:html={scenario.need} />
              <p class="scenario-choice">{scenario.choice}</p>
              <div>
                <p class="scenario-label">The result</p>
                <p set:html={scenario.result} />
              </div>
              <div>
                <p class="scenario-label">What stays with the institution</p>
                <p set:html={scenario.stays} />
              </div>
              <a class="inline-cta" href={products.find((product) => product.name === scenario.choice)?.href}>Explore {scenario.choice} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="ai-context-title">
      <div class="section-inner ai-context">
        <div class="section-heading compact">
          <p class="eyebrow">AI-assisted services</p>
          <h2 id="ai-context-title">The same access rules apply to an AI-assisted service.</h2>
        </div>
        <div class="ai-context-body">
          <p>
            A service that uses AI to guide a person or caseworker can call the same configured
            Registry Stack interface as other services. Registry Stack checks the service&rsquo;s
            permission for each request and returns only the information its rules allow.
          </p>
          <p>
            The service owner remains responsible for how the application uses that information,
            including decisions about eligibility, approvals, and the people it makes requests about.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="tutorial-exercises-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">For developers</p>
          <h2 id="tutorial-exercises-title">Run an introductory exercise with sample data.</h2>
          <p>The tutorials introduce each product through the exercises below. The scenarios above are illustrations for discussing your own use case.</p>
        </div>
        <div class="scenario-grid">
          {tutorialExercises.map((tutorial) => (
            <article class="scenario-card">
              <h3>{tutorial.product}</h3>
              <p>{tutorial.exercise}</p>
              <a class="inline-cta" href={products.find((product) => product.name === tutorial.product)?.tutorialHref}>{tutorial.product} introductory tutorial →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <DocsHandoff />
  <SiteFooter />
</Base>

<style>
  .choice-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .choice-grid article {
    border-top: 2px solid var(--registry-ink);
    padding-top: 16px;
  }

  .choice-grid h3,
  .choice-grid p {
    margin-bottom: 8px;
  }

  .choice-note {
    margin: 24px 0 0;
    max-width: 760px;
  }

  .choice-marker,
  .scenario-domain,
  .scenario-label {
    color: var(--registry-blue);
    font-family: var(--registry-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .scenario-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .scenario-card {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
    display: grid;
    gap: 16px;
    min-width: 0;
    padding: 22px;
  }

  .scenario-card h3,
  .scenario-card p {
    margin: 0;
  }

  .scenario-choice {
    border-left: 3px solid var(--registry-stamp);
    color: var(--registry-ink);
    font-size: 14px;
    font-weight: 700;
    padding-left: 10px;
  }

  .scenario-label {
    margin-bottom: 5px !important;
  }

  .ai-context {
    display: grid;
    gap: clamp(28px, 6vw, 80px);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .ai-context-body {
    border-top: 2px solid var(--registry-ink);
    padding-top: 18px;
  }

  .ai-context-body p:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .scenario-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .choice-grid,
    .scenario-grid,
    .ai-context {
      grid-template-columns: 1fr;
    }
  }
</style>
