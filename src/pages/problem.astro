---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';

const pageTitle = 'The problem | Registry Stack';
const pageDescription =
  'The registry problems Registry Stack is built around: over-sharing by default, safeguards on paper, integrations that do not compound, and the integrator concerns underneath.';

// Condensed from the docs-site problem framings. Each card names the recurring
// failure, a short concrete illustration, and what Registry Stack changes.
// The lead group is ordered for a funder or policy reader: the failures a
// program officer recognizes without needing an integration diagram first.
// Each lead card also carries the stake: what actually goes wrong if the
// failure stays unfixed. The second group is the integrator's view of the
// same territory: what determines whether a connection is fast or another
// one-off.
const leadProblems = [
  {
    title: 'Over-sharing by default',
    illustration:
      'A partner needs to confirm one fact. The only thing on offer is a full export or a database login, because there is no smaller unit of sharing than the whole registry.',
    change:
      'A route can answer "license valid" or "actively registered" without exposing the underlying record. The caller gets the fact; the rest stays with the owner.',
    stake:
      'One leaked export is every record at once, and people are left proving facts the state already holds.',
  },
  {
    title: 'Safeguards on paper',
    illustration:
      'A data-sharing agreement promises one purpose. The system enforces none of it: no purpose field, no scope, no access log a reviewer could read. A year later, an inspector has nowhere to look.',
    change:
      'Purpose, scope, and disclosure limits are checked at the point of access, and each trust-critical request leaves a reviewable audit record.',
    stake:
      'Compliance rests on trust and after-the-fact discovery instead of enforcement, so incidents surface late, or never.',
  },
  {
    title: 'Integrations that do not compound',
    illustration:
      'A national registry has integrated three partners, each starting from the same questions in a fresh email thread. The fourth partner asks them again next week.',
    change:
      'The answers are published once, as artifacts every partner can read. The negotiation starts from a shared contract instead of from scratch.',
    stake:
      'Every new service pays the full integration cost again, and nothing accumulates into shared infrastructure.',
  },
];

const integratorProblems = [
  {
    title: 'Data exists, but is not service-ready',
    illustration:
      'A school directory lives in one focal point’s spreadsheet. Three teams email for copies, and three months later nobody can say which list is authoritative.',
    change:
      'The source stays where it is. A public contract describes who may ask, for what, with what freshness, and on what authority.',
  },
  {
    title: 'Capabilities are hard to discover',
    illustration:
      'A registry exists, but what it offers lives in a PDF refreshed nine months ago and the memory of two engineers. The first technical decision is made before any artifact exists.',
    change:
      'A registry publishes machine-readable metadata: which entities, fields, policies, and evidence offerings it actually exposes, before any code is written.',
  },
  {
    title: 'Semantics do not line up',
    illustration:
      'Two registries both expose a field called status with a code active, but mean different things by it. The integration code quietly becomes the definition.',
    change:
      'Each registry publishes what its fields and codes mean, so an integrator can see both definitions and decide, instead of discovering the mismatch in production.',
  },
  {
    title: 'Identity and matching are unclear',
    illustration:
      'A cadastral service answers "owner confirmed" without saying which record it matched, on what fields, or how confident the match was. The assessment goes out anyway.',
    change:
      'The match becomes part of the contract: a configured proof carries which record was matched and on what basis, instead of a hidden join inside integration code.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="problem" />

  <main>
    <section class="hero" aria-labelledby="why-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">The problem</p>
          <h1 id="why-hero-title">The answers already exist. Asking for them safely is the hard part.</h1>
          <p class="hero-lead">
            Governments already hold the data for faster, fairer services. What is usually
            missing is the safe way to use it: who may ask, what answer is appropriate, what
            stays private, and how use is reviewed. When that safe way is missing, the failure
            is not abstract: it shows up as leaked exports, safeguards nobody can point to, and
            programs paying to reconnect the same data again and again.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="payoff-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">The payoff</p>
          <h2 id="payoff-title">Fix the asking, and three things change.</h2>
        </div>
        <div class="problem-grid payoff-grid">
          <article class="quiet-card">
            <h3>People stop proving the same facts twice</h3>
            <p>A fact the government already holds is answered by the registry that holds it. Fewer certified copies, fewer queues, fewer reasons to drop out of a service.</p>
          </article>
          <article class="quiet-card">
            <h3>Safeguards become infrastructure</h3>
            <p>Purpose, scope, and disclosure limits are checked on every request, and every trust-critical request leaves an audit record a reviewer can actually read.</p>
          </article>
          <article class="quiet-card">
            <h3>Every integration compounds</h3>
            <p>Each connection leaves behind a described, governed registry surface the next program reuses, instead of code two people understand.</p>
          </article>
        </div>
        <p class="payoff-cta">
          <a class="inline-cta" href="/pilot/">What a pilot delivers &rarr;</a>
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="problems-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">The recurring problems</p>
          <h2 id="problems-title">The failures a program officer recognizes first.</h2>
          <p>
            These show up long before anyone reaches an integration diagram, and they repeat
            across civil registration, social protection, business registries, farmer
            registries, health facility registries, and more.
          </p>
        </div>
        <div class="problem-grid problem-grid-why problem-grid-lead">
          {leadProblems.map((problem) => (
            <article class="quiet-card problem-card problem-card-lead">
              <h3>{problem.title}</h3>
              <p class="problem-illustration">{problem.illustration}</p>
              <p class="problem-change-label">What changes</p>
              <p class="problem-change">{problem.change}</p>
              <p class="problem-stake-label">At stake</p>
              <p class="problem-stake">{problem.stake}</p>
            </article>
          ))}
        </div>

        <div class="section-heading compact problems-underneath-heading">
          <p class="eyebrow">Underneath</p>
          <h3 id="underneath-title">And underneath, the integration reality</h3>
          <p>
            These are what determine whether a connection is fast or another one-off. Registry
            Stack changes the runtime and metadata surface around the data; it does not replace
            the source.
          </p>
        </div>
        <div class="problem-grid problem-grid-why problem-grid-underneath">
          {integratorProblems.map((problem) => (
            <article class="quiet-card problem-card">
              <h3>{problem.title}</h3>
              <p class="problem-illustration">{problem.illustration}</p>
              <p class="problem-change-label">What changes</p>
              <p class="problem-change">{problem.change}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="not-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Division of labor</p>
          <h2 id="not-title">The technology does its part. Institutions keep theirs.</h2>
          <p>
            Registry Stack makes registry use explicit, governed, and reviewable. The decisions
            that belong to institutions stay with institutions, on purpose.
          </p>
          <a class="inline-cta" href="/pilot/">What a pilot looks like &rarr;</a>
        </div>
        <ul class="check-list">
          <li>Whether a caller is legally entitled to a fact remains an institutional decision.</li>
          <li>What a field or code means is defined by the registry that owns it, not by integration code.</li>
          <li>Foundational identity, deduplication, and master data remain with the systems mandated to hold them.</li>
          <li>Semantic review, authorization policy, and human accountability stay human.</li>
        </ul>
      </div>
    </section>
  </main>

  <DocsHandoff
    eyebrow="Read the docs"
    heading="See how each safeguard is enforced at runtime."
    primaryLabel="Read the docs"
    emphasis="pilot"
  />
  <SiteFooter />
</Base>

<style>
  .payoff-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .payoff-cta {
    margin: 18px 0 0;
    text-align: center;
  }

  .problem-grid-why {
    gap: 20px;
  }

  .problem-card {
    display: grid;
    gap: 8px;
  }

  .problem-illustration {
    color: var(--registry-body);
    margin: 0;
  }

  .problem-change-label {
    color: var(--registry-blue);
    font-family: var(--registry-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    margin: 6px 0 0;
    text-transform: uppercase;
  }

  .problem-change {
    color: var(--registry-ink);
    font-weight: 600;
    margin: 0;
  }

  .problem-stake-label {
    color: var(--registry-stamp);
    font-family: var(--registry-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    margin: 6px 0 0;
    text-transform: uppercase;
  }

  .problem-stake {
    color: var(--registry-ink);
    margin: 0;
  }

  /* The lead group is the same three-card grid, but the top rule and
     slightly heavier border mark it as the primary read. */
  .problem-card-lead {
    border-color: var(--registry-ink);
    border-top: 3px solid var(--registry-stamp);
  }

  .problems-underneath-heading {
    margin-top: 44px;
  }

  /* Four cards read better as two rows of two than a lopsided 3-and-1. */
  .problem-grid-underneath {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* Three short payoff cards: one row on desktop, a single column once the
     row would crowd, mirroring the pilot page's phase cards. */
  @media (max-width: 900px) {
    .payoff-grid {
      grid-template-columns: 1fr;
    }

    .problem-grid-underneath {
      grid-template-columns: 1fr;
    }
  }
</style>
