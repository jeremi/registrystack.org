---
// Reader: the head of a farm, food or environmental register, asking "what
// would a week with this look like for my register?" Sections follow their
// next questions: show me a week, what changes for my office, where do we
// start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { describeServiceHref } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'agriculture-food-and-environment')!;

const steps: WeekStep[] = [
  {
    when: 'Registration submitted',
    product: 'Your registration drive',
    title: 'A farmer registers a holding',
    text: 'A farmer registers a holding at the district office. The register does not change until an officer decides.',
    card: { kind: 'record', recordType: 'Registration request', recordId: 'REG-2290', icon: 'data', fields: [
      { label: 'Holding', value: 'Plot 14, Northern district' },
      { label: 'Crops', value: 'Maize, beans' },
      { label: 'Submitted at', value: 'District office' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'An officer decides',
    text: 'The request enters the registrations queue. D. Mwangi checks that the holding is not already registered under another name and approves the application.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Registrations' },
      { state: 'Claimed', note: 'Held by D. Mwangi' },
      { state: 'Approved', note: 'Duplicate check complete' },
    ] },
  },
  {
    when: 'Producer record updated',
    ...weekProduct('base-registry'),
    title: 'The officer records the holding and its history',
    text: 'The officer records the holding. The register records the officer’s name and retains each earlier status when the record changes.',
    card: { kind: 'record', recordType: 'Holding record', recordId: 'HLD-5582', icon: 'data', fields: [
      { label: 'Status', value: 'Registered' },
      { label: 'District', value: 'Northern' },
      { label: 'Changed by', value: 'D. Mwangi' },
    ] },
  },
  {
    when: 'Permitted programme check',
    ...weekProduct('evidence-gateway'),
    title: 'A subsidy programme receives only the registered district',
    text: 'A subsidy programme authorized to make this check asks which district the holding is registered in. It receives that value in a digitally signed answer, without plot coordinates or household details.',
    card: { kind: 'answer', fieldLabel: 'Registered in district', value: 'Northern', recipient: 'Subsidy programme', issuer: 'Farm register' },
  },
];
---
<Solution
  area={area}
  heading="Maintain producer, holding, establishment and permit records."
  description="Staff can review registrations and record approved changes to holdings, establishments and permits. Authorized programmes can check information such as registration status without receiving the full record. Your institution sets the register’s rules and access."
>
  <section class="section" id="example" aria-labelledby="agriculture-example-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="agriculture-example-title">Review and record one holding registration.</h2>
      </div>
      <RegisterWeek
        id="agriculture-week"
        kicker="Holding HLD-5582, one request"
        heading="Follow the producer registration."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="agriculture-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="agriculture-change-title">Maintain holding records and their status history.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Link each permit to the site it covers</h3><p>Each farm, establishment or site has its own record, and each registration or permit links to it. If one food business operates two establishments, each establishment can have its own registration and recorded status.</p><a class="inline-cta" href="/products/base-registry/">How the register holds an entry <span aria-hidden="true">→</span></a></article>
        <article><h3>Keep earlier statuses when a permit changes</h3><p>A suspension or withdrawal is recorded with the name of the officer and the date. Staff can see which status the register showed on the day of an inspection.</p><a class="inline-cta" href="/solutions/review-changes/">How a decision reaches the register <span aria-hidden="true">→</span></a></article>
        <article><h3>Publish district-level registration counts</h3><p>Configure seasonal counts with small-count suppression and rounding, then publish reviewed releases without exposing the records behind them.</p><a class="inline-cta" href="https://docs.registrystack.org/configure/breg-statistics/">How statistical releases work <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters area={area} />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our farm register or animal identification system?',
        a: 'You can keep the register you run today and connect Evidence Gateway to answer agreed questions from it. Use Base Registry Engine when you need a new register or decide to migrate one, including a register maintained in spreadsheets.',
        link: { href: 'https://docs.registrystack.org/start/concepts/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can a subsidy programme check a farmer without an account on our system?',
        a: 'The programme’s service asks your register a question you have agreed to answer, such as whether a farmer is registered, and gets that answer and nothing else. Your office decides which services may ask, and which questions.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Who can see a farmer’s record?',
        a: 'Your office decides, role by role: who may record a registration, who may record a permit, who may look one up, and for what reason. Base Registry Engine keeps a history of changes it handles. The implementation agrees audit coverage across the register and connected applications.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Discuss your service with our implementation team."
    body="Tell us which producers, establishments or permits you need to register, who records field information and what other programmes need to check. We can show how Registry Stack could fit."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    note="The core software is Apache-2.0 open source. Aubex offers paid implementation and support; your team or another provider can also operate it."
    emphasis="docs"
  />
</Solution>
