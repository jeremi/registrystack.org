---
// Reader: the head of a farm, food or environmental register, asking "what
// would a week with this look like for my register?" Sections follow their
// next questions: show me a week, what changes for my office, where do we
// start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { askQuestionHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'agriculture-food-and-environment')!;

const steps: WeekStep[] = [
  {
    when: 'Registration submitted',
    product: 'Your registration drive',
    title: 'A farmer registers a holding',
    text: 'A farmer registers a holding at the district office. The register does not change until an officer decides.',
    card: { kind: 'record', recordType: 'Registration request', recordId: 'REG-2290', icon: 'data', fields: [
      { label: 'Holding', value: 'Plot 14, Northern district' },
      { label: 'Crops', value: 'Maize, beans' },
      { label: 'Submitted at', value: 'District office' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'An officer decides',
    text: 'The request enters the registrations queue. D. Mwangi checks that the holding is not already registered under another name and approves the application.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Registrations' },
      { state: 'Claimed', note: 'Held by D. Mwangi' },
      { state: 'Approved', note: 'Duplicate check complete' },
    ] },
  },
  {
    when: 'Producer record updated',
    ...weekProduct('base-registry'),
    title: 'The holding is recorded and keeps its history',
    text: 'The officer records the holding under their own name. Each later change of status is added beside it, never over it.',
    card: { kind: 'record', recordType: 'Holding record', recordId: 'HLD-5582', icon: 'data', fields: [
      { label: 'Status', value: 'Registered' },
      { label: 'District', value: 'Northern' },
      { label: 'Changed by', value: 'D. Mwangi' },
    ] },
  },
  {
    when: 'Permitted programme check',
    ...weekProduct('evidence-gateway'),
    title: 'A subsidy programme asks, and gets only the district',
    text: 'A subsidy programme authorised to make this check asks which district the holding is registered in and receives that value in a digitally signed answer. Plot coordinates and household details are not disclosed.',
    card: { kind: 'answer', fieldLabel: 'Registered in district', value: 'Northern', recipient: 'Subsidy programme', issuer: 'Farm register' },
  },
];
---
<Solution
  area={area}
  heading="Keep producer, site, establishment and permit records usable across services."
  description="Connect registration, review and authorised changes, reduce duplicate entries and let permitted programmes check a defined fact without receiving the full record. Your institution keeps control of the register and its rules."
>
  <section class="section" id="example" aria-labelledby="agriculture-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="agriculture-week-title">A farmer applies, an officer checks the holding, the registration is recorded and a programme receives the district it is allowed to use.</h2>
      </div>
      <RegisterWeek
        id="agriculture-week"
        kicker="Holding HLD-5582, one request"
        heading="Follow the producer registration."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="agriculture-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="agriculture-change-title">One maintained identity for each holding, with traceable status changes.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Every permit is tied to the site it covers</h3><p>Each farm, establishment or site is recorded once, and every registration or permit is linked to it. One food business with two establishments has two registrations, and an inspector sees which is current.</p><a class="inline-cta" href="/products/base-registry/">How the register holds an entry <span aria-hidden="true">→</span></a></article>
        <article><h3>A change of status never erases the earlier one</h3><p>A suspended permit or a withdrawn authorization is added as its own entry, with who recorded it and when. The register shows what was valid on the day of an inspection.</p><a class="inline-cta" href="/solutions/review-changes/">How a decision reaches the register <span aria-hidden="true">→</span></a></article>
        <article><h3>Counts for the season, without the farmers’ details</h3><p>The register publishes counts, such as registered holdings per district, with small counts suppressed and no individual records.</p><a class="inline-cta" href="https://docs.registrystack.org/configure/breg-statistics/">How statistical releases work <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from an agriculture, food, or environment register like yours."
    intro="A starting configuration can provide a model for holdings, animals, establishments, permits or natural resources. It is adapted to your rules, field operations and existing sector systems."
    featuredNote="The farmer registry starter records the farm and the registration; the question a programme asks is set up in Evidence Gateway, which the starter does not include."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our farm register or animal identification system?',
        a: 'Not necessarily. Evidence Gateway can answer from the register you run today, through a connection your technical team sets up. The Base Registry Engine is for a register you build or move off spreadsheets.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can a subsidy programme check a farmer without an account on our system?',
        a: 'The programme’s service asks your register a question you have agreed to answer, such as whether a farmer is registered, and gets that answer and nothing else. Your office decides which services may ask, and which questions.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Who can see a farmer’s record?',
        a: 'Your office decides, role by role: who may record a registration, who may record a permit, who may look one up, and for what reason. Every look-up and every change is kept with who did it and when.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A starter is a starting configuration for a particular kind of register. It is available by request and must be adapted to your rules, field operations and existing systems. You can begin by describing your service without selecting a starter first.',
        link: { href: '/starters/#agriculture-food-and-environment', label: 'Browse the agriculture, food and environment starters' },
      },
      {
        q: 'Where does our technical team start?',
        a: 'If you keep your register where it is: the Evidence Gateway tutorial, which answers a question from sample data on a laptop. If you are building or moving a register: the Base Registry Engine tutorial, then the starter closest to your register.',
        link: { href: 'https://docs.registrystack.org/tutorials/first-breg/', label: 'Run the registry tutorial' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Talk it through with the people who build it."
    body="Tell us which producer, establishment or permit service you want to improve, who records field information and what other programmes need to check. We can show how Registry Stack could fit."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
