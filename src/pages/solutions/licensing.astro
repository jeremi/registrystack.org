---
// Reader: the head of a licensing office, asking "what would a week with this
// look like for my register?" Sections follow their next questions: show me a
// week, what changes for my office, where do we start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { askQuestionHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'licensing')!;

const steps: WeekStep[] = [
  {
    when: 'Monday 08:40',
    ...weekProduct('scheduling'),
    title: 'A holder books a counter slot',
    text: 'A licence holder due for renewal books a slot at your counter. Nothing in the register changes yet.',
    card: { kind: 'booking', service: 'Licence renewal', place: 'Counter 3, licensing office', slot: 'Wednesday 10:30', status: 'Confirmed' },
  },
  {
    when: 'Wednesday 10:30',
    ...weekProduct('casework'),
    title: 'An officer reviews the renewal',
    text: 'The renewal lands in the renewals queue. M. Okafor takes it at the counter, checks the certificate, and approves it.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Renewals' },
      { state: 'Claimed', note: 'Held by M. Okafor' },
      { state: 'Approved', note: 'Wednesday 11:20' },
    ] },
  },
  {
    when: 'Wednesday 11:22',
    ...weekProduct('base-registry'),
    title: 'The licence changes and keeps its history',
    text: 'The officer records the renewal under their own name. Revision 7 holds the new expiry; revision 6 stays readable.',
    card: { kind: 'record', recordType: 'Licence record', recordId: 'LIC-2093', icon: 'person', fields: [
      { label: 'Valid until', value: '2029-10-31' },
      { label: 'Changed by', value: 'M. Okafor' },
      { label: 'Revision', value: '7' },
    ] },
  },
  {
    when: 'Wednesday 11:40',
    ...weekProduct('evidence-gateway'),
    title: 'An employer asks, and gets a signed yes',
    text: 'Twenty minutes later an employer asks whether the licence is in good standing and receives a signed yes. The holder’s file stays in your register.',
    card: { kind: 'answer', fieldLabel: 'Licence in good standing', value: 'Yes', recipient: 'Employer’s HR service', issuer: 'Licensing board' },
  },
];
---
<Solution
  area={area}
  heading="Know who holds each licence, on what terms, and what changed."
  description="Employers, inspectors and other services ask your licensing office whether a licence is valid, and every correction waits for someone to find the file. Registry Stack gives your office one register of the licences it has issued: other services check a licence without seeing the file, and each change an officer must decide waits in one queue."
>
  <section class="section" id="example" aria-labelledby="licensing-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="licensing-week-title">Booked on Monday, renewed at the counter on Wednesday, and relied on by an employer twenty minutes later.</h2>
      </div>
      <RegisterWeek
        id="licensing-week"
        kicker="Licence LIC-2093, one request"
        heading="Each step names the product that does it."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="licensing-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="licensing-change-title">Fewer calls about the file, and a register that explains itself.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Services you connect stop asking for the file</h3><p>An employer or inspector gets a yes or no with your register’s name on it, and nothing from the holder’s file.</p><a class="inline-cta" href="/solutions/check-a-fact/">How a service checks a fact <span aria-hidden="true">→</span></a></article>
        <article><h3>A suspension never overwrites the licence it suspends</h3><p>Each renewal, suspension or revocation is its own entry, with who recorded it and when. Lift a suspension and both decisions stay in order.</p><a class="inline-cta" href="/products/base-registry/">How the register keeps its history <span aria-hidden="true">→</span></a></article>
        <article><h3>Every correction has one owner and a due date</h3><p>Corrections and disputes wait in one queue. One officer holds each, the clock is visible to the team, and the register changes only when that officer says so.</p><a class="inline-cta" href="https://docs.registrystack.org/tutorials/review-breg-changes-in-casework/">See a change reviewed before it is applied <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from a licence register like yours."
    intro="A starter sets out what a register of this kind holds and who may change it, for one common kind of licence. Your team takes the closest one and adapts it to its own licensing law."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our licensing system?',
        a: 'It depends on what holds your register today. If an application system takes applications, collects fees and issues the licence, that system stays and records the result in the register. If your register is a spreadsheet, or lives inside an application you are retiring, Base Registry Engine can be the register, with your team planning the migration of the existing entries.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can an employer check a licence without an account on our system?',
        a: 'Two cases. A member of the public or an employer looking up one licence uses the public register your application publishes under your law. A service that needs to check licences as part of its own process asks your register a question you have agreed to answer, such as whether a licence is active for a category, and gets that answer and nothing else. Your office decides which services may ask, and which questions.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Does this give us a public search page?',
        a: 'Not on its own. The register serves its data under your rules, and other services check a licence through it. A search page for the public comes from your application or the people who build it.',
      },
      {
        q: 'Who can see a licence record?',
        a: 'Your office decides, role by role: who may record a licence, who may record a suspension, who may look one up, and for what reason. Every look-up and every change is kept with who did it and when.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A free package requested from the starter’s page and opened to see how a register of this kind is set out: the records it keeps, the changes staff can make, and who may make them. It is a starting point to adapt, not a running system: your team adds what your register needs, and using one does not mean the register is in use anywhere. Anyone from the office can request it; your technical team is who opens it.',
        link: { href: '/starters/#licensing', label: 'Browse the licensing starters' },
      },
      {
        q: 'Where does our technical team start?',
        a: 'If you keep your register where it is: the Evidence Gateway tutorial, which answers a question from sample data on a laptop. If you are building or moving a register: the Base Registry Engine tutorial, then the starter closest to your register.',
        link: { href: 'https://docs.registrystack.org/tutorials/first-breg/', label: 'Run the registry tutorial' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Talk it through with the people who build it."
    body="Tell us which register you keep and what other services ask of it. We reply by email, and a short call is the usual next step. Paid pilots and support are there if you want them."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
