---
// Reader: the service owner responsible for a licensing journey, from
// application and evidence through decision, licence record and renewal.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { askQuestionHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'licensing')!;

const steps: WeekStep[] = [
  {
    when: 'Application submitted',
    product: 'Your application service',
    title: 'A licence holder applies to renew',
    text: 'The holder submits the renewal form and supporting evidence through the service channel your authority provides. This creates an application; it does not change the licence record.',
    card: { kind: 'record', recordType: 'Renewal application', recordId: 'APP-2093', icon: 'person', fields: [
      { label: 'Licence', value: 'LIC-2093' },
      { label: 'Request', value: 'Renewal' },
      { label: 'Evidence', value: 'Submitted for review' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'An officer reviews the renewal',
    text: 'M. Okafor reviews the renewal and closes that review with changes requested because a certificate is unreadable. The application service shows the request to the holder, accepts the replacement and sends the revised application into a new review. The officer approves the complete application.',
    card: { kind: 'history', items: [
      { state: 'Review 1', note: 'Completed: changes requested' },
      { state: 'Application service', note: 'Replacement accepted and resubmitted' },
      { state: 'Review 2', note: 'Completed: approved' },
    ] },
  },
  {
    when: 'Licence record updated',
    ...weekProduct('base-registry'),
    title: 'A new licence term is recorded',
    text: 'After approval, a staff member or connected service with permission records a new term for the licence. Earlier terms remain in its history.',
    card: { kind: 'record', recordType: 'Licence term', recordId: 'TERM-2093-07', icon: 'person', fields: [
      { label: 'Valid until', value: '2029-10-31' },
      { label: 'Recorded by', value: 'Licensing service' },
      { label: 'Term', value: '7' },
    ] },
  },
  {
    when: 'Employer status check',
    ...weekProduct('evidence-gateway'),
    title: 'An employer checks the licence status',
    text: 'An employer authorised to make this check asks whether the licence is in good standing and receives a digitally signed answer. The application and supporting evidence are not disclosed.',
    card: { kind: 'answer', fieldLabel: 'Licence in good standing', value: 'Yes', recipient: 'Employer’s HR service', issuer: 'Licensing board' },
  },
];
---
<Solution
  area={area}
  heading="Connect licensing applications, decisions, licence records and renewal."
  description="Give applicants a clear route to submit information and replace missing evidence, give officers an accountable review process, and keep each authorised licence change in the register. Employers and other permitted services can check a defined status without receiving the application file."
>
  <section class="section" id="example" aria-labelledby="licensing-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="licensing-week-title">A holder applies, supplies the evidence an officer needs, receives a decision and can show the current licence status.</h2>
      </div>
      <RegisterWeek
        id="licensing-week"
        kicker="Licence LIC-2093, one request"
        heading="Follow the renewal."
        steps={steps}
      />
      <p>For local permit services, see <a href="/solutions/local-government/">examples of market permits, food premises and rented-housing registration</a>.</p>
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="licensing-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="licensing-change-title">One connected journey, with each responsibility kept clear.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Applicants can complete the evidence trail</h3><p>When a review ends with changes requested, the application service shows what is missing, accepts replacement evidence and resubmits the revised application for a new review. The institution decides what evidence its rules require.</p><a class="inline-cta" href="/customization/">How a service is adapted <span aria-hidden="true">→</span></a></article>
        <article><h3>A suspension never overwrites the licence it suspends</h3><p>Each renewal, suspension or revocation is its own entry, with who recorded it and when. Lift a suspension and both decisions stay in order.</p><a class="inline-cta" href="/products/base-registry/">How the register keeps its history <span aria-hidden="true">→</span></a></article>
        <article><h3>Review and record change remain distinct</h3><p>An officer records the licensing decision. The resulting change is applied only through the register’s own authorised process, with the decision and record history available for later review.</p><a class="inline-cta" href="/solutions/review-changes/">How accountable review works <span aria-hidden="true">→</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from a licence register like yours."
    intro="A starting configuration can provide a model for one common kind of licence, including the information held and the changes staff may make. Browse if useful, or tell us about your licensing service and we will help identify a suitable starting point."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our licensing system?',
        a: 'It depends on what holds your register today. If an application system takes applications, collects fees and issues the licence, that system stays and records the result in the register. If your register is a spreadsheet, or lives inside an application you are retiring, Base Registry Engine can be the register, with your team planning the migration of the existing entries.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can an employer check a licence without an account on our system?',
        a: 'Two cases. A member of the public or an employer looking up one licence uses the public register your application publishes under your law. A service that needs to check licences as part of its own process asks your register a question you have agreed to answer, such as whether a licence is active for a category, and gets that answer and nothing else. Your office decides which services may ask, and which questions.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Does this give us a public search page?',
        a: 'Yes, when the authority wants one. An implementation can include a public search page with the permitted licence details, accessible user journeys and a connection to the register. The proposal states whether this is included.',
      },
      {
        q: 'Who can see a licence record?',
        a: 'Your office decides, role by role: who may record a licence, who may record a suspension, who may look one up, and for what reason. Every look-up and every change is kept with who did it and when.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A starter is a starting configuration for a particular kind of register. It is available by request and must be adapted to the authority’s rules, service channels and existing systems. You can begin by describing your service without selecting a starter first.',
        link: { href: '/starters/#licensing', label: 'Browse the licensing starters' },
      },
      {
        q: 'Where does our technical team start?',
        a: 'If you keep your register where it is: the Evidence Gateway tutorial, which answers a question from sample data on a laptop. If you are building or moving a register: the Base Registry Engine tutorial, then the starter closest to your register.',
        link: { href: 'https://docs.registrystack.org/tutorials/first-breg/', label: 'Run the registry tutorial' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Talk it through with the people who build it."
    body="Tell us which licensing service you want to improve, who applies, who decides and which systems must connect. We can identify a useful starting configuration and scope the screens, identity, hosting and integrations with you."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
