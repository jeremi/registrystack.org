---
// Reader: the head of a health facility, device or safety register, asking
// "what would a week with this look like for my register?" Sections follow
// their next questions: show me a week, what changes for my office, where do
// we start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { askQuestionHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'health-and-safety')!;

const steps: WeekStep[] = [
  {
    when: 'Monday 11:00',
    product: 'Your inspection application',
    title: 'An inspection report arrives',
    text: 'An inspector files a report on a clinic and recommends suspending its authorization. The register does not change until an officer decides.',
    card: { kind: 'record', recordType: 'Inspection report', recordId: 'INS-4410', icon: 'data', fields: [
      { label: 'Facility', value: 'Clinic HF-0732' },
      { label: 'Finding', value: 'Equipment not maintained' },
      { label: 'Recommendation', value: 'Suspend' },
    ] },
  },
  {
    when: 'Monday to Wednesday',
    ...weekProduct('casework'),
    title: 'An officer decides the suspension',
    text: 'The report lands in the authorizations queue. P. Castillo takes it, hears the operator, and approves the suspension.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Authorizations' },
      { state: 'Claimed', note: 'Held by P. Castillo' },
      { state: 'Waiting', note: 'Operator’s response requested' },
      { state: 'Approved', note: 'Wednesday 09:30' },
    ] },
  },
  {
    when: 'Wednesday 09:30',
    ...weekProduct('base-registry'),
    title: 'The authorization is suspended and keeps its history',
    text: 'The officer records the suspension under their own name, beside the authorization it suspends. Lift it later and both decisions stay in order.',
    card: { kind: 'record', recordType: 'Facility record', recordId: 'HF-0732', icon: 'business', fields: [
      { label: 'Operating authorization', value: 'Suspended' },
      { label: 'Changed by', value: 'P. Castillo' },
      { label: 'Revision', value: '11' },
    ] },
  },
  {
    when: 'Wednesday 09:45',
    ...weekProduct('evidence-gateway'),
    title: 'An insurer asks, and gets a signed no',
    text: 'Fifteen minutes later a health insurance fund asks whether the clinic is authorized to operate and receives a signed no. The inspection file stays in your register.',
    card: { kind: 'answer', fieldLabel: 'Authorized to operate', value: 'No', recipient: 'Health insurance fund', issuer: 'Health facility register' },
  },
];
---
<Solution
  area={area}
  heading="Know which facilities, products, and operators are authorized."
  description="Your facility list, the insurer’s list and the health information system’s list disagree on how many clinics there are and what each is called, and every authorization check lands on an officer’s desk. Registry Stack gives your office one register of the authorizations it has issued, and lets other services check one without seeing the rest of the file."
>
  <section class="section" id="example" aria-labelledby="health-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="health-week-title">An inspection report arrives on Monday. The suspension is recorded on Wednesday, and an insurer sees it fifteen minutes later.</h2>
      </div>
      <RegisterWeek
        id="health-week"
        kicker="Clinic HF-0732, one request"
        heading="Each step names the product that does it."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="health-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="health-change-title">Fewer calls to confirm an authorization, and notices the public can read.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Every facility has one entry and one code</h3><p>Each provider, each facility it operates and each authorization are recorded once, so the insurer, the inspectorate and the health information system read the same list and the same code.</p><a class="inline-cta" href="/products/base-registry/">How the register holds an entry <span aria-hidden="true">→</span></a></article>
        <article><h3>An authorization keeps its history</h3><p>A renewal, suspension or withdrawal is added beside the earlier decision, with who recorded it and when, so the register shows what was valid on the day of an inspection.</p><a class="inline-cta" href="/solutions/review-changes/">How a decision reaches the register <span aria-hidden="true">→</span></a></article>
        <article><h3>Public notices stay public, and private entries stay closed</h3><p>A medicine shortage notice is for everyone. A person’s organ donation instruction is shown only to a hospital your office has agreed may ask, and only as the answer it needs.</p><a class="inline-cta" href="/security/">Who is responsible for what <span aria-hidden="true">→</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from a health or safety register like yours."
    intro="A starter sets out what a register of this kind holds and who may change it, for one common register of facilities, trials, devices, or hazards. Your team takes the closest one and adapts it to its own health or safety law."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this hold patient or clinical data?',
        a: 'No. It holds registers of facilities, trials, devices, operators, and radiation sources. Where an entry needs to point to a medicine, such as a shortage notice, it refers to the medicine’s entry in the existing medicines catalogue instead of copying it.',
      },
      {
        q: 'Does this replace our system?',
        a: 'It depends on what holds your register today. If an authorization system takes applications, collects fees and issues the authorization, that system stays and records the result in the register. If your register is a spreadsheet, or lives inside an application you are retiring, Base Registry Engine can be the register, with your team planning the migration of the existing entries.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can an insurer check a clinic without an account on our system?',
        a: 'The insurer’s service asks your register a question you have agreed to answer, such as whether a clinic’s authorization is current, and gets that answer and nothing else. Your office decides which services may ask, and which questions.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Who can see an entry, and what does the public see?',
        a: 'Your office decides, entry by entry and role by role: what the public may read, who may record an authorization, and who may look one up. Every look-up and every change is kept with who did it and when.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A free package requested from the starter’s page and opened to see how a register of this kind is set out: the records it keeps, the changes staff can make, and who may make them. It is a starting point to adapt, not a running system: your team adds what your register needs, and using one does not mean the register is in use anywhere. Anyone from the office can request it; your technical team is who opens it.',
        link: { href: '/starters/#health-and-safety', label: 'Browse the health and safety starters' },
      },
      {
        q: 'Where does our technical team start?',
        a: 'If you keep your register where it is: the Evidence Gateway tutorial, which answers a question from sample data on a laptop. If you are building or moving a register: the Base Registry Engine tutorial, then the starter closest to your register.',
        link: { href: 'https://docs.registrystack.org/tutorials/first-breg/', label: 'Run the registry tutorial' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Talk it through with the people who build it."
    body="Tell us which register you keep and what other services ask of it. We reply by email, and a short call is the usual next step. Paid pilots and support are there if you want them."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
