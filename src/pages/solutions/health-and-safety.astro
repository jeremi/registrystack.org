---
// Reader: the head of a health facility, device or safety register, asking
// "what would a week with this look like for my register?" Sections follow
// their next questions: show me a week, what changes for my office, where do
// we start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { describeServiceHref } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'health-and-safety')!;

const steps: WeekStep[] = [
  {
    when: 'Inspection report submitted',
    product: 'Your inspection application',
    title: 'An inspection report arrives',
    text: 'The inspection service gives the clinic operator an opportunity to respond, then submits the inspection report, recommendation and response for a decision. The register does not change yet.',
    card: { kind: 'record', recordType: 'Inspection report', recordId: 'INS-4410', icon: 'data', fields: [
      { label: 'Facility', value: 'Clinic HF-0732' },
      { label: 'Finding', value: 'Equipment not maintained' },
      { label: 'Recommendation', value: 'Suspend' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'An officer decides the suspension',
    text: 'The complete case enters the authorizations queue. P. Castillo reviews the report and the operator’s response, then approves the suspension.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Authorizations' },
      { state: 'Claimed', note: 'Held by P. Castillo' },
      { state: 'Approved', note: 'Operator heard' },
    ] },
  },
  {
    when: 'Authorisation record updated',
    ...weekProduct('base-registry'),
    title: 'The authorization is suspended and keeps its history',
    text: 'The officer records the suspension against the authorization. The register records who made the change. Lift it later and both decisions stay in order.',
    card: { kind: 'record', recordType: 'Facility record', recordId: 'HF-0732', icon: 'business', fields: [
      { label: 'Operating authorization', value: 'Suspended' },
      { label: 'Changed by', value: 'P. Castillo' },
      { label: 'Revision', value: '11' },
    ] },
  },
  {
    when: 'Insurer status check',
    ...weekProduct('evidence-gateway'),
    title: 'An insurer checks the current status',
    text: 'A health insurance fund authorized to make this check asks whether the clinic is authorized to operate and receives a digitally signed answer. The inspection report and operator response are not disclosed.',
    card: { kind: 'answer', fieldLabel: 'Authorized to operate', value: 'No', recipient: 'Health insurance fund', issuer: 'Health facility register' },
  },
];
---
<Solution
  area={area}
  heading="Maintain regulated facility, operator, product and hazard records."
  description="Staff can review inspection findings, record decisions and apply authorized status changes. Inspectors, insurers and other permitted services can use the same facility code and check a specific status without receiving the regulatory file."
>
  <section class="section" id="example" aria-labelledby="health-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="health-week-title">Record a status change after an inspection.</h2>
      </div>
      <RegisterWeek
        id="health-week"
        kicker="Clinic HF-0732, one request"
        heading="Follow the inspection decision."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="health-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="health-change-title">Use one facility code and return only permitted status information.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Agree a facility code that connected systems can use</h3><p>Staff maintain separate records for the provider, its facilities and their authorizations. The implementation connects insurers, inspectorates and health information systems to the agreed facility codes.</p><a class="inline-cta" href="/products/base-registry/">How the register holds an entry <span aria-hidden="true">→</span></a></article>
        <article><h3>Keep earlier decisions when an authorization changes</h3><p>A renewal, suspension or withdrawal is recorded with the name of the officer and the date. Staff can see which status the register showed on the day of an inspection.</p><a class="inline-cta" href="/solutions/review-changes/">How a decision reaches the register <span aria-hidden="true">→</span></a></article>
        <article><h3>Publish notices and restrict inspection records</h3><p>An approved medicine-shortage notice can be public. An inspection report can remain restricted to staff, while a permitted service receives only the facility status it is allowed to check.</p><a class="inline-cta" href="/security/">Who is responsible for what <span aria-hidden="true">→</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from a health or safety register like yours."
    intro="A starting configuration can provide a model for facilities, trials, devices, operators or hazards. It is adapted to your rules, terminology, staff work and existing systems."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this hold patient or clinical data?',
        a: 'No. It holds registers of facilities, trials, devices, operators, and radiation sources. Where an entry needs to point to a medicine, such as a shortage notice, it refers to the medicine’s entry in the existing medicines catalogue instead of copying it.',
      },
      {
        q: 'Does this replace our system?',
        a: 'It depends on what holds your register today. If an authorization system takes applications, collects fees and issues the authorization, that system stays and records the result in the register. If your register is a spreadsheet, or lives inside an application you are retiring, Base Registry Engine can be the register, with your team planning the migration of the existing entries.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can an insurer check a clinic without an account on our system?',
        a: 'The insurer’s service asks your register a question you have agreed to answer, such as whether a clinic’s authorization is current, and gets that answer and nothing else. Your office decides which services may ask, and which questions.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Who can see an entry, and what does the public see?',
        a: 'Your office decides, entry by entry and role by role: what the public may read, who may record an authorization, and who may look one up. Base Registry Engine keeps a history of changes it handles. The implementation agrees audit coverage across the register and connected applications.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A starter is a starting configuration for a particular kind of register. It is available by request and must be adapted to your rules, service channels and existing systems. You can begin by describing your service without selecting a starter first.',
        link: { href: '/starters/#health-and-safety', label: 'Browse the health and safety starters' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Discuss your service with our implementation team."
    body="Tell us which facility or oversight service you want to improve, who reports changes, who decides and which systems need the resulting status. We can show how Registry Stack could fit."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    emphasis="docs"
  />
</Solution>
