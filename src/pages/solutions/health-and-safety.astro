---
import Solution from '../../layouts/Solution.astro';
import SolutionExample from '../../components/SolutionExample.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFit from '../../components/SolutionFit.astro';
import SolutionDevelopers from '../../components/SolutionDevelopers.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas } from '../../data/solutions';
const area = solutionAreas.find((a) => a.key === 'health-and-safety')!;
---
<Solution
  area={area}
  heading="Know which facilities, products, and operators are authorized."
  description="Health and safety regulators keep registers of health facilities, clinical trials, medical devices, radiation sources, and cooling towers. Each entry records an authorization, a registration, or a notified hazard. Insurers, procurement teams, inspectors, and the public need to check those entries."
>
  <SolutionExample
    eyebrow="One example: an insurer checks a facility"
    heading="Tell a health insurance fund whether a clinic is authorized to operate."
    intro="A health insurance fund needs to know whether a clinic holds a current operating authorization before it signs a contract with it. The health authority’s facility register holds that authorization."
    items={[
      { term: 'Who asks', body: 'The insurance fund, for the clinic it is about to contract.' },
      { term: 'What the team wants', body: 'A signed answer stating whether the clinic’s operating authorization is current, which the fund can check came from the health authority.' },
      { term: 'What happens', body: 'The fund asks Evidence Gateway. The gateway checks that the fund may ask this question, reads the authorization from the facility register, and returns a signed answer. The fund decides what the answer means for the contract.' },
      { term: 'What stays with the institution', body: 'The rest of the facility file, including its owners and any inspection history, stays with the health authority.' },
    ]}
    link={{ href: '/products/evidence-gateway/', label: 'See how Evidence Gateway signs an answer' }}
  />
  <SolutionStarters
    area={area}
    heading="Start from a health or safety register like yours."
    intro="Each starter is a starting configuration for a common register of facilities, trials, devices, or hazards. It records an authorization or a registration the regulator has issued; your team adapts the records and rules to its own law."
  />
  <section class="section section-muted" aria-labelledby="health-control-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What you keep control of</p>
        <h2 id="health-control-title">The authorizations, what is public, and how a notice changes.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Authorizations and what they cover</h3><p>Record the operator, the facility or product, and the authorization issued for it. The pharmaceutical operator licensing starter links an organization, an establishment, and an operating authorization.</p></article>
        <article><h3>What is public and what is restricted</h3><p>Some entries are meant to be read widely: the medicine shortages starter marks its disruption notices public. Donation preferences are restricted and released only as a bounded result to a service that is already authorized.</p></article>
        <article><h3>Notices that change over time</h3><p>A medicine shortage is recorded, closed, or withdrawn, each as its own action. Each step stays in the record’s history, so a reader can see when the shortage was recognized and when it ended.</p></article>
      </div>
    </div>
  </section>
  <SolutionFit
    area={area}
    heading="Keep clinical data in clinical systems."
    jobs={{
      'base-registry': 'Stores the register of facilities, trials, devices, or sources, with your rules for who may record and read each entry.',
      'evidence-gateway': 'Answers a defined question, such as whether a facility holds a current authorization, with a signed answer the receiving service can verify.',
    }}
    extra={[
      { term: 'Registers, not patient records', body: 'The starters record authorizations and registrations, not clinical records. The medicine shortages starter refers to each medicine through an external FHIR product definition rather than copying it.' },
    ]}
  >
    <p>Each product runs on its own. Evidence Gateway can answer from a register you already run, and health information systems can serve as its source; Base Registry Engine is for a register you build or move into a defined structure.</p>
  </SolutionFit>
  <SolutionDevelopers area={area} muted />
  <DocsHandoff eyebrow="Work with us" heading="Get help when you need it." body="Get hands-on help through a paid implementation pilot, or ongoing support while your team builds and runs the register." emphasis="pilot" primaryHref="/starters/" primaryLabel="Browse the starters" />
</Solution>
