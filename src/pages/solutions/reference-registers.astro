---
// Reader: the team that maintains a code list, directory or catalogue other
// registers rely on, asking "what would a week with this look like for our
// list?" Sections follow their next questions: show me a week, what changes
// for my office, where do we start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { describeServiceHref } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'reference-registers')!;

const steps: WeekStep[] = [
  {
    when: 'Change proposed',
    product: 'Your intake application',
    title: 'A change is proposed',
    text: 'The ministry notifies your office that two districts merge on 1 January. The list does not change until your team decides.',
    card: { kind: 'record', recordType: 'Change proposal', recordId: 'CHG-118', icon: 'data', fields: [
      { label: 'Entry', value: 'District NR-07' },
      { label: 'Change', value: 'Merge into NR-05' },
      { label: 'Applies from', value: '1 January' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'Your team decides',
    text: 'The proposal is assigned to E. Lindqvist, who confirms the ministry’s notice and approves the change.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Code list changes' },
      { state: 'Claimed', note: 'Held by E. Lindqvist' },
      { state: 'Approved', note: 'Source confirmed' },
    ] },
  },
  {
    when: 'Authorised list change',
    ...weekProduct('base-registry'),
    title: 'The list changes and keeps the old entry',
    text: 'The officer closes NR-07 with its end date and names its successor. The register records the officer’s name, and records that use NR-07 still link to the retained entry.',
    card: { kind: 'record', recordType: 'Code list entry', recordId: 'NR-07', icon: 'data', fields: [
      { label: 'Status', value: 'Closed from 1 January' },
      { label: 'Successor', value: 'NR-05' },
      { label: 'Changed by', value: 'E. Lindqvist' },
    ] },
  },
  {
    when: 'Current list published',
    product: 'Your publication service',
    title: 'Connected services retrieve the current list',
    text: 'The team publishes the current list through an agreed service or export. Catalogue metadata describes the list, its version and where it can be retrieved.',
    card: { kind: 'document', documentType: 'Published code list', format: 'JSON', title: 'Administrative areas, version 2027-01', fields: [
      { label: 'Entries', value: '312' },
      { label: 'Changed', value: 'NR-07 closed, NR-05 extended' },
      { label: 'Status', value: 'Current list published' },
    ], footnote: 'Publication and update handling are configured for connected services' },
  },
];
---
<Solution
  area={area}
  heading="Maintain the lists other services rely on."
  description="Review and publish changes to place names, organization directories, classifications and code lists. Connected services can retrieve the current version, while records that use an earlier code still refer to a known entry."
>
  <section class="section" id="example" aria-labelledby="reference-example-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="reference-example-title">Review and publish one code-list change.</h2>
      </div>
      <RegisterWeek
        id="reference-week"
        kicker="District code NR-07, one request"
        heading="Follow the code-list change."
        caption="A district code change, from the proposal through your team's decision to the updated list that connected services retrieve. The records are fictional."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="reference-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="reference-change-title">Maintain one current list and keep earlier entries.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Use the same code for the same place</h3><p>Each entry contains its official code, its parent where there is one, and the dates it applies. The address register and the statistics office can retrieve entries from the same list.</p><a class="inline-cta" href="/products/base-registry/">How the register serves other services <span aria-hidden="true">→</span></a></article>
        <article><h3>Control who changes the list</h3><p>Your office decides who may add, rename or close an entry. Connected services can be given read access while authorized staff or systems record changes.</p><a class="inline-cta" href="/security/">Who is responsible for what <span aria-hidden="true">→</span></a></article>
        <article><h3>Help other services find the current list</h3><p>Publish entries through an agreed service or export. Catalogue metadata describes that source and its version so other teams know where to retrieve the list.</p><a class="inline-cta" href="https://docs.registrystack.org/products/registry-manifest/">How catalogue descriptions are published <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters area={area} />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace the spreadsheet we send out?',
        a: 'It can replace emailed spreadsheet copies with a maintained source. Connected services retrieve entries through an agreed service or export and follow agreed rules for adopting a new version.',
        link: { href: 'https://docs.registrystack.org/start/concepts/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'What happens to records that point to an old code?',
        a: 'A renamed or withdrawn entry remains in the list with the dates it applied. Records using the old code can still refer to that entry. Each connected service needs rules for handling a renamed or withdrawn code.',
      },
      {
        q: 'Does the list hold the district boundaries too?',
        a: 'The example list holds codes, names and dates. Keep boundary maps in the mapping system and connect entries by their official codes.',
      },
      {
        q: 'Who can change the list?',
        a: 'Only the people your office names. Your office decides who may record a new entry, who may close one, and who may only read; every change is kept with who made it and when.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Discuss your shared list with us."
    body="Describe the shared list you need, who approves changes and which services will use it. We can show how Registry Stack could publish one current version while preserving earlier entries."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    note="The core software is Apache-2.0 open source. Your team, an appointed provider or we can implement and operate it. We quote hosting and operation separately."
    emphasis="docs"
  />
</Solution>
