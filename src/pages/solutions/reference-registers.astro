---
// Reader: the team that maintains a code list, directory or catalogue other
// registers rely on, asking "what would a week with this look like for our
// list?" Sections follow their next questions: show me a week, what changes
// for my office, where do we start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { describeServiceHref } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'reference-registers')!;

const steps: WeekStep[] = [
  {
    when: 'Change proposed',
    product: 'Your intake application',
    title: 'Receive the ministry’s notice',
    text: 'A ministry notifies your office that two districts merge on 1 January. The proposed change arrives from your own intake application. The list does not change until your team decides.',
    card: { kind: 'record', recordType: 'Change proposal', recordId: 'CHG-118', icon: 'data', fields: [
      { label: 'Entry', value: 'District NR-07' },
      { label: 'Change', value: 'Merge into NR-05' },
      { label: 'Applies from', value: '1 January' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'Review and approve the change',
    text: 'The proposal is assigned to E. Lindqvist. E. Lindqvist confirms the ministry’s notice and approves the change. Registry Casework assigns and records this review.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Code list changes' },
      { state: 'Claimed', note: 'Held by E. Lindqvist' },
      { state: 'Approved', note: 'Source confirmed' },
    ] },
  },
  {
    when: 'Authorised list change',
    ...weekProduct('base-registry'),
    title: 'Close the old code',
    text: 'The officer closes district NR-07 with its end date. The officer names NR-05 as its successor. The register records the officer’s name. Records that use NR-07 still link to the retained entry. Base Registry Engine keeps the records and their history.',
    card: { kind: 'record', recordType: 'Code list entry', recordId: 'NR-07', icon: 'data', fields: [
      { label: 'Status', value: 'Closed from 1 January' },
      { label: 'Successor', value: 'NR-05' },
      { label: 'Changed by', value: 'E. Lindqvist' },
    ] },
  },
  {
    when: 'Current list published',
    product: 'Your publication service',
    title: 'Publish the current list',
    text: 'Your team publishes the current list through an agreed service or export. Catalogue metadata describes the list, its version and where to retrieve it. Connected services retrieve the current list.',
    card: { kind: 'document', documentType: 'Published code list', format: 'JSON', title: 'Administrative areas, version 2027-01', fields: [
      { label: 'Entries', value: '312' },
      { label: 'Changed', value: 'NR-07 closed, NR-05 extended' },
      { label: 'Status', value: 'Current list published' },
    ], footnote: 'Publication and update handling are configured for connected services' },
  },
];
---
<Solution
  area={area}
  heading="Maintain the code lists, place names and directories that other services rely on."
  description="You can review and publish changes to place names, public-body directories, classifications and code lists. Connected services can retrieve the current version. Records that use an earlier code still refer to a known entry."
>
  <section class="section" id="example" aria-labelledby="reference-example-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request from start to finish</p>
        <h2 id="reference-example-title">Your office reviews and publishes one code-list change.</h2>
      </div>
      <RegisterWeek
        id="reference-week"
        kicker="District code NR-07: one request"
        heading="Follow the code-list change step by step"
        caption="The figure follows one change to a district code. It starts with the proposal and passes through your office’s decision. It ends with the updated list that connected services retrieve. The records are fictional."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="reference-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="reference-change-title">Maintain one current list and keep its earlier entries.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Use the same code for the same place</h3><p>Each entry has its official code and the dates it applies. It also has its parent entry, where there is one. The address register and the statistics office can retrieve entries from the same list.</p><a class="inline-cta" href="/products/base-registry/">Read how Base Registry Engine serves other services <span aria-hidden="true">→</span></a></article>
        <article><h3>Decide who can change each entry</h3><p>Your office decides who may add, rename or close an entry. Connected services can be given read access. Authorised staff or systems record the changes.</p><a class="inline-cta" href="/security/">Read who is responsible for what <span aria-hidden="true">→</span></a></article>
        <article><h3>Publish the list where others can find it</h3><p>Your office publishes entries through an agreed service or export. Other services can then find the current list. Catalogue metadata describes that source and its version. Other teams then know where to retrieve the list.</p><a class="inline-cta" href="https://docs.registrystack.org/products/registry-manifest/">Read how catalogue descriptions are published <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters area={area} />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace the spreadsheet we send out?',
        a: 'It can replace emailed spreadsheet copies with a maintained source. Connected services retrieve entries through an agreed service or export. They follow agreed rules for adopting a new version.',
        link: { href: 'https://docs.registrystack.org/start/concepts/', label: 'Read how Registry Stack sits beside existing systems' },
      },
      {
        q: 'What happens to records that use an old code?',
        a: 'A renamed or withdrawn entry stays in the list with the dates it applied. Records that use the old code can still refer to that entry. Each connected service needs its own rules for handling a renamed or withdrawn code.',
      },
      {
        q: 'Does the list hold the district boundaries too?',
        a: 'The example list holds codes, names and dates. Boundary maps stay in the mapping system. You can connect the two through the official codes.',
      },
      {
        q: 'Who can change the list?',
        a: 'Only the people your office names. Your office decides who may record a new entry, who may close one and who may only read. Every change is kept with who made it and when.',
        link: { href: '/security/', label: 'Read who is responsible for what' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Talk to us about your shared list."
    body="Describe your shared list, who approves changes and which services will use it. We can show how Registry Stack could publish one current version while keeping earlier entries."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    note="The core software is open source under the Apache-2.0 licence. Your own team or a provider you choose can inspect it, adapt it and run it. Or we can implement, host and run it for you, priced separately in your proposal."
    emphasis="docs"
  />
</Solution>
