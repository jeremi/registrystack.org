---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, registerFamilies } from '../../data/solutions';
import { products } from '../../data/products';
import { startersForArea, starterCount } from '../../data/starters';

const pageTitle = 'Solutions | Registry Stack';
const pageDescription = 'Find a public service or register close to your institution’s work, see what applicants and staff can do, and choose a next step.';
const crossCutting = solutionAreas.filter((area) => area.kind === 'cross-cutting');
// The flagship products lead, as in the Products menu; the data order is otherwise kept.
const productEntries = [...products].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="solutions" />
  <main class="solutions-index">
    <section class="hero" aria-labelledby="solutions-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Solutions</p>
          <h1 id="solutions-title">Start from the public service you need to improve.</h1>
          <p class="hero-lead">Explore licensing, registration, facility oversight and other services for national, regional and local government. Each solution shows what applicants and staff can do, how records stay current and how the service can fit systems already in use.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="#registers">Find a service</a>
            <a class="button button-secondary" href="/starters/">Explore {starterCount} starting configurations</a>
          </div>
        </div>
      </div>
    </section>

    <section id="registers" class="section" aria-labelledby="registers-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">By service and register</p>
          <h2 id="registers-title">Find the area closest to your institution’s work.</h2>
          <p>Each area shows the service from request to current record, how it fits existing systems and optional starting configurations that can be adapted.</p>
        </div>
        <ul class="solution-area-grid">
          {registerFamilies.map((area) => (
            <li>
              <a href={area.slug}>
                <span class="solution-area-name">{area.name}</span>
                {area.audience && <span class="solution-area-audience">{area.audience}</span>}
                <span class="solution-area-intent">{area.intent}</span>
                <span class="solution-area-count">{startersForArea(area).length} starters</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="services" class="section section-muted" aria-labelledby="services-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">For local authorities</p>
          <h2 id="services-title">Choose one local service to improve first.</h2>
          <p>Market permits, food-premises registration and rented-housing registration are concrete places to begin. See how applicants, municipal staff and inspectors can work through one connected service.</p>
        </div>
        <ul class="solution-area-grid solution-area-pair">
          <li>
            <a href="/solutions/local-government/">
              <span class="solution-area-name">Local government services</span>
              <span class="solution-area-audience">For municipalities and other local public authorities.</span>
              <span class="solution-area-intent">Run clearer applications, decisions, registrations and renewals</span>
            </a>
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="shared-work-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Work every register shares</p>
          <h2 id="shared-work-title">Share a limited answer. Coordinate the decisions that need a person.</h2>
          <p>These capabilities apply across service areas. The source institution controls permitted checks, and an accountable review decision remains separate from the authorised register change.</p>
        </div>
        <ul class="solution-area-grid solution-area-pair">
          {crossCutting.map((area) => (
            <li>
              <a href={area.slug}>
                <span class="solution-area-name">{area.name}</span>
                <span class="solution-area-intent">{area.intent}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="products" aria-labelledby="products-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Products</p>
          <h2 id="products-title">Reusable components for applications, records and checks.</h2>
          <p>A solution can combine the components it needs with configured screens, identity, hosting and integrations. Each component keeps a focused responsibility and can also be adopted independently.</p>
        </div>
        <ul class="solution-area-grid solution-product-row">
          {productEntries.map((product) => (
            <li>
              <a href={product.href}>
                <span class="solution-area-name">{product.name}</span>
                <span class="solution-area-intent">{product.intent}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <DocsHandoff
      eyebrow="Discuss your service"
      heading="Start with the service that should work better."
      body="Tell us who uses it, what staff decide and which systems are already in place. We can identify a useful starting configuration and explain how Registry Stack could fit."
      primaryLabel="Choose a solution area"
      primaryHref="#registers"
    />
  </main>
  <SiteFooter />
</Base>

<style>
  .solution-area-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 32px; list-style: none; margin: 0; padding: 0; }
  .solution-area-pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .solution-product-row { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .solution-area-grid li { border-top: 1px solid #c9d0c5; }
  .solution-area-grid a { display: grid; gap: 4px; padding: 18px 0 20px; }
  .solution-area-grid a:hover { text-decoration: none; }
  .solution-area-grid a:hover .solution-area-name { color: var(--registry-blue); }
  .solution-area-name { color: var(--registry-ink); font-size: var(--type-body); font-weight: 700; }
  .solution-area-audience { color: var(--registry-body); font-size: var(--type-md); }
  .solution-area-intent { color: var(--registry-muted); font-size: var(--type-md); }
  .solution-area-count { color: var(--registry-blue); font-family: var(--registry-mono); font-size: var(--type-xs); margin-top: 6px; }
  @media (max-width: 900px) {
    .solution-area-grid, .solution-product-row { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 620px) {
    .solution-area-grid, .solution-area-pair, .solution-product-row { grid-template-columns: 1fr; }
  }
</style>
