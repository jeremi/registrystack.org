---
// Reader: the head of a population or social registry, asking "what would a
// week with this look like for my register?" Sections follow their next
// questions: show me a week, what changes for my office, where do we start,
// the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { describeServiceHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'people-and-social-programmes')!;

const steps: WeekStep[] = [
  {
    when: 'Application submitted',
    product: 'Your intake application',
    title: 'A household applies',
    text: 'A household applies for enrollment at the district office. The intake service collects the programme’s assessment information, including the home-visit report, before sending the complete case for a decision. The register does not change yet.',
    card: { kind: 'record', recordType: 'Application', recordId: 'APP-5120', icon: 'household', fields: [
      { label: 'Household', value: 'HH-30944' },
      { label: 'Programme', value: 'Social protection' },
      { label: 'Submitted at', value: 'District office' },
    ] },
  },
  {
    when: 'Assessment and decision',
    ...weekProduct('casework'),
    title: 'An officer decides',
    text: 'The complete application enters the enrollment queue. A. Haddad reviews the application and assessment, then records the programme’s decision.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Enrollment' },
      { state: 'Claimed', note: 'Held by A. Haddad' },
      { state: 'Approved', note: 'Assessment complete' },
    ] },
  },
  {
    when: 'Household record updated',
    ...weekProduct('base-registry'),
    title: 'The household record changes and keeps its history',
    text: 'The officer records the enrollment under their own name. Revision 4 holds the status; revision 3 stays readable.',
    card: { kind: 'record', recordType: 'Household record', recordId: 'HH-30944', icon: 'household', fields: [
      { label: 'Status', value: 'Enrolled' },
      { label: 'Changed by', value: 'A. Haddad' },
      { label: 'Revision', value: '4' },
    ] },
  },
  {
    when: 'Permitted programme check',
    ...weekProduct('evidence-gateway'),
    title: 'Another programme checks enrollment',
    text: 'A school meal programme authorized to make this check asks whether the household is enrolled and receives a digitally signed answer. Income information and case notes are not disclosed.',
    card: { kind: 'answer', fieldLabel: 'Household enrolled', value: 'Yes', recipient: 'School meal programme', issuer: 'Social registry' },
  },
];
---
<Solution
  area={area}
  heading="Maintain people, household and enrollment records."
  description="Record identity, household relationships, enrollment or status for the service your institution runs. Staff review applications and corrections; authorized services can check specific information without receiving the full file. Each institution remains responsible for its eligibility rules and decisions."
>
  <section class="section" id="example" aria-labelledby="people-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="people-week-title">Follow a household enrollment application.</h2>
      </div>
      <RegisterWeek
        id="people-week"
        kicker="Household HH-30944, one request"
        heading="Follow the household application."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="people-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="people-change-title">Control what each programme can check.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Link people to their household records</h3><p>When someone moves out, your team changes the link and the earlier household stays in the history.</p><a class="inline-cta" href="/products/base-registry/">How the register holds people and households <span aria-hidden="true">→</span></a></article>
        <article><h3>Limit checks to the person a service needs to ask about</h3><p>Your institution can allow a programme to check a known person’s status while preventing it from listing everyone in the register. The implementation defines permissions and audit coverage for each connection.</p><a class="inline-cta" href="/security/">Who is responsible for what <span aria-hidden="true">→</span></a></article>
        <article><h3>Issue a credential confirming programme enrollment</h3><p>An implementation can use Evidence Gateway to issue a digital credential stating whether someone is enrolled. The implementation connects and tests the wallet that receives it and the service that accepts it.</p><a class="inline-cta" href="/solutions/verifiable-credentials/">Explore verifiable credentials <span aria-hidden="true">→</span></a></article>
      </div>
      <p class="product-note">The enrollment starter records who is enrolled. A social registry of assessed households also needs the household record used by its intake process.</p>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from a register of people like yours."
    intro="Starting configurations cover population, identity, education, immigration, voting and social programme records. Choose according to the service, the information it needs and which institution is responsible for each decision."
    featuredNote="The enrollment starter records the enrollment; the question a programme asks is set up in Evidence Gateway, which the starter does not include."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our population register or social registry?',
        a: 'No. Evidence Gateway can answer programmes’ questions from a register you already run, through a connection your technical team sets up. Base Registry Engine is for a register you build new, or decide to move.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can a programme check a fact without seeing the person’s file?',
        a: 'Yes. The programme asks a question your office has agreed to answer, such as whether a household is enrolled, and gets that answer and nothing else. Your office decides which programmes may ask, which questions, and for what reason.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Does it assess eligibility or calculate benefits?',
        a: 'No. A programme that receives an answer decides what it means for its applicant under its own rules. The register records the decision made by the organization responsible for that record.',
      },
      {
        q: 'Who can see a person’s record?',
        a: 'Your office decides who may record a person, change a household or look someone up, and for what reason. Base Registry Engine keeps a history of changes it handles. The implementation agrees audit coverage across the register and connected applications.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A starter is a starting configuration for a particular kind of register. It is available by request and must be adapted to your rules, service channels and existing systems. You can begin by describing your service without selecting a starter first.',
        link: { href: '/starters/#people-and-social-programmes', label: 'Browse the starters for registers of people' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Discuss your service with our implementation team."
    body="Tell us which service and people records you want to improve, who makes each decision and which systems need to exchange information. We can show how Registry Stack could fit while sharing only what each service needs."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
