---
// Reader: the head of a population or social registry, asking "what would a
// week with this look like for my register?" Sections follow their next
// questions: show me a week, what changes for my office, where do we start,
// the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { askQuestionHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'people-and-social-programmes')!;

const steps: WeekStep[] = [
  {
    when: 'Monday 10:20',
    product: 'Your intake application',
    title: 'A household applies',
    text: 'A household applies for enrollment at the district office. The register does not change until an officer decides.',
    card: { kind: 'record', recordType: 'Application', recordId: 'APP-5120', icon: 'household', fields: [
      { label: 'Household', value: 'HH-30944' },
      { label: 'Programme', value: 'Social protection' },
      { label: 'Submitted at', value: 'District office' },
    ] },
  },
  {
    when: 'Monday to Thursday',
    ...weekProduct('casework'),
    title: 'An officer decides',
    text: 'The application lands in the enrollment queue. A. Haddad takes it, waits for the home visit report, and approves it.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Enrollment' },
      { state: 'Claimed', note: 'Held by A. Haddad' },
      { state: 'Waiting', note: 'Home visit report requested' },
      { state: 'Approved', note: 'Thursday 15:10' },
    ] },
  },
  {
    when: 'Thursday 15:10',
    ...weekProduct('base-registry'),
    title: 'The household record changes and keeps its history',
    text: 'The officer records the enrollment under their own name. Revision 4 holds the status; revision 3 stays readable.',
    card: { kind: 'record', recordType: 'Household record', recordId: 'HH-30944', icon: 'household', fields: [
      { label: 'Status', value: 'Enrolled' },
      { label: 'Changed by', value: 'A. Haddad' },
      { label: 'Revision', value: '4' },
    ] },
  },
  {
    when: 'Thursday 15:30',
    ...weekProduct('evidence-gateway'),
    title: 'A programme asks, and gets a signed yes',
    text: 'Twenty minutes later the school meal programme asks whether the household is enrolled and receives a signed yes. Income and case notes stay in your register.',
    card: { kind: 'answer', fieldLabel: 'Household enrolled', value: 'Yes', recipient: 'School meal programme', issuer: 'Social registry' },
  },
];
---
<Solution
  area={area}
  heading="Keep records about people current, and let programmes check them."
  description="The same household is registered in three programmes under three spellings, a correction made in one never reaches the others, and each programme asks your office for the file when it needs one answer. Registry Stack gives your office one register of people and households, and lets a programme check the one fact it needs without seeing the person’s file."
>
  <section class="section" id="example" aria-labelledby="people-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="people-week-title">A household applies on Monday. Enrolled on Thursday, and a programme can rely on it twenty minutes later.</h2>
      </div>
      <RegisterWeek
        id="people-week"
        kicker="Household HH-30944, one request"
        heading="Each step names the product that does it."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="people-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="people-change-title">One entry per person, and the file never leaves your office.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Each person is entered once and linked to their household</h3><p>When someone moves out, your team changes the link and the earlier household stays in the history.</p><a class="inline-cta" href="/products/base-registry/">How the register holds people and households <span aria-hidden="true">→</span></a></article>
        <article><h3>Nobody pages through the list of people</h3><p>A programme your office allows finds a person it already knows; it cannot list the register. Every look-up is kept with who asked and when.</p><a class="inline-cta" href="/security/">Who is responsible for what <span aria-hidden="true">→</span></a></article>
        <article><h3>A person can carry the answer</h3><p>Where your office chooses, an answer such as “enrolled” is issued to the person’s digital wallet, to show a service that accepts it.</p><a class="inline-cta" href="https://docs.registrystack.org/configure/evidence-oid4vci/">How wallet delivery is set up <span aria-hidden="true">↗</span></a></article>
      </div>
      <p class="product-note">If your office keeps a social registry of assessed households as well as the list of who is enrolled, start from the enrollment starter and add the household record your intake process needs.</p>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from a register of people like yours."
    intro="A starter sets out what a register of this kind holds and who may change it. This family has no single starter to open first: offices that keep a population register start from Population register; offices that run a benefit programme start from Social registry and programme enrollment. Take the closest one and adapt it."
    featuredNote="The enrollment starter records the enrollment; the question a programme asks is set up in Evidence Gateway, which the starter does not include."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our population register or social registry?',
        a: 'No. Evidence Gateway can answer programmes’ questions from a register you already run, through a connection your technical team sets up. Base Registry Engine is for a register you build new, or decide to move.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can a programme check a fact without seeing the person’s file?',
        a: 'Yes. The programme asks a question your office has agreed to answer, such as whether a household is enrolled, and gets that answer and nothing else. Your office decides which programmes may ask, which questions, and for what reason.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Does it assess eligibility or calculate benefits?',
        a: 'No. A programme that receives an answer decides what it means for its applicant, under its own rules. The register records what the responsible authority has decided.',
      },
      {
        q: 'Who can see a person’s record?',
        a: 'Your office decides, role by role: who may record a person, who may change a household, and who may look someone up, and for what reason. Every look-up and every change is kept with who did it and when.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A free package requested from the starter’s page and opened to see how a register of this kind is set out: the records it keeps, the changes staff can make, and who may make them. It is a starting point to adapt, not a running system: your team adds what your register needs, and using one does not mean the register is in use anywhere. Anyone from the office can request it; your technical team is who opens it.',
        link: { href: '/starters/#people-and-social-programmes', label: 'Browse the starters for registers of people' },
      },
      {
        q: 'Where does our technical team start?',
        a: 'If you keep your register where it is: the Evidence Gateway tutorial, which answers a question from sample data on a laptop. If you are building or moving a register: the Base Registry Engine tutorial, then the starter closest to your register.',
        link: { href: 'https://docs.registrystack.org/tutorials/first-breg/', label: 'Run the registry tutorial' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Talk it through with the people who build it."
    body="Tell us which register you keep and what other services ask of it. We reply by email, and a short call is the usual next step. Paid pilots and support are there if you want them."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
