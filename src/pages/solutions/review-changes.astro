---
import Solution from '../../layouts/Solution.astro';
import SolutionExample from '../../components/SolutionExample.astro';
import SolutionFit from '../../components/SolutionFit.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas } from '../../data/solutions';
import { describeServiceHref } from '../../data/contact';
import { products } from '../../data/products';
const area = solutionAreas.find((a) => a.key === 'review-changes')!;
const casework = products.find((p) => p.key === 'casework')!;
---
<Solution
  area={area}
  heading="Help staff review requests and record decisions."
  description="Assign correction requests, objections and other proposed changes to staff. Track due dates and record each decision. After approval, a staff member or connected service with permission applies the change to the register."
>
  <SolutionExample
    eyebrow="One example: a licence correction"
    heading="Review a request to correct a licence."
    intro="A professional says their licence lists the wrong permitted activities. An officer reviews the supporting evidence and decides whether to approve the correction."
    items={[
      { term: 'Submit a correction request', body: 'The licence holder uses the application service to explain the error and provide supporting evidence.' },
      { term: 'Assign the review', body: 'The request is assigned to an officer. The team can see who is responsible and when a decision is due. The licence remains unchanged during review.' },
      { term: 'Review and decide', body: 'If information is missing, the officer ends the review by requesting changes. The holder revises the application and submits it for a new review. After approval, a staff member or connected service with permission applies the correction.' },
      { term: 'Keep the decision and history', body: 'The application service keeps the holder’s current submission. Casework records each review assignment and decision. The register keeps the corrected licence and the history of its changes.' },
    ]}
    link={{ href: '/products/casework/#product-example', label: 'See the correction step by step' }}
  />
  <section class="section" aria-labelledby="review-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="review-change-title">See who is responsible and what needs a decision.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Choose which requests need staff review</h3><p>Your institution decides which changes need a decision, such as correcting a licence or adding a household member. Each type of request can have its own review team and due date.</p></article>
        <article><h3>Track assignments and overdue requests</h3><p>Staff can see their assigned requests and due dates. Supervisors can identify overdue work and follow up with the responsible officer. An application connected to Casework can display the recorded decision.</p></article>
        <article><h3>Keep a record of the decision and change</h3><p>Casework records who reviewed and decided the request. Only staff or systems authorized by the register can apply the approved change. The register records that change in its own history.</p></article>
      </div>
      <div id="what-your-office-calls-it" class="product-note">
        <h3>Other requests your team could review</h3>
        <p>A correction to a land record, an objection to a household’s recorded details or a request to change a professional’s permitted activities. The review process, required evidence and decision rules are configured for the institution’s work.</p>
      </div>
    </div>
  </section>
  <SolutionFit
    area={area}
    heading="Connect staff reviews to your register."
    muted
    jobs={{
      casework: 'Assigns requests to reviewers, tracks due dates and records decisions according to the review rules your team configures.',
      'base-registry': 'Keeps records and their history. For a change that requires review, it checks the review result and the permission to apply the change.',
    }}
    extra={[
      { term: 'Your institution sets the rules', body: 'Your team decides who reviews each type of request and what they must consider. Staff make the decision; Casework records it.' },
      { term: 'Screens for reviewers', body: 'Reviewers can use screens provided with the service or work through an existing staff application connected to Casework. They see the request, supporting material, due date and actions available to their role.' },
      { term: 'An existing register', body: 'Base Registry Engine has a supported connection to Casework. Your implementation team can build a connection for another register, including how it submits requests and receives review decisions.' },
    ]}
  >
    <p>Agree which changes need review, who may decide them and who may update the register. Then connect those steps to the screens your applicants and staff use.</p>
  </SolutionFit>
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our register system?',
        a: 'No. Casework records assignments, due dates and review decisions. Your register continues to hold the official records and control who may change them. Connecting an existing register is part of the implementation.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Does an approval update the register automatically?',
        a: 'Approval records the review decision. A staff member or connected service must then apply the change with the register’s permission. Your institution can also configure other types of change that do not require a staff review.',
      },
      {
        q: 'Can an existing application submit requests?',
        a: 'Yes. A connected application can submit requests, follow their progress and retrieve recorded decisions. Base Registry Engine has a supported connection; other systems need an integration.',
        link: { href: casework.tutorialHref, label: casework.tutorialLabel },
      },
      {
        q: 'Where does our technical team start?',
        a: 'The reviewed-change tutorial shows how to connect Base Registry Engine to Casework, submit a proposed change, review it and apply an approved result. Applicant and staff applications are connected as part of the service implementation.',
        link: { href: 'https://docs.registrystack.org/tutorials/review-breg-changes-in-casework/', label: 'Configure a reviewed register change' },
      },
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Discuss a staff review process with our team."
    body="Tell us which requests staff review, who decides and how an approved change is applied. We can show how staff screens, review assignments and the register can work together."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    emphasis="docs"
  />
</Solution>
