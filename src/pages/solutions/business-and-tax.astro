---
// Reader: the registrar of a business or tax register, asking "what would a
// week with this look like for my register?" Sections follow their next
// questions: show me a week, what changes for my office, where do we start,
// the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { describeServiceHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'business-and-tax')!;

const steps: WeekStep[] = [
  {
    when: 'Change filed',
    product: 'Your filing service',
    title: 'A company files a change of address',
    text: 'The company secretary files a change of registered address. The register does not change until a registrar decides.',
    card: { kind: 'record', recordType: 'Filing', recordId: 'REQ-8821', icon: 'business', fields: [
      { label: 'Business', value: 'BR-20417' },
      { label: 'Filing', value: 'Change of registered address' },
      { label: 'Filed by', value: 'Company secretary' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'A registrar reviews the filing',
    text: 'The filing enters the review queue. L. Mensah checks the evidence supplied and approves the change.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Filings' },
      { state: 'Claimed', note: 'Held by L. Mensah' },
      { state: 'Approved', note: 'Evidence accepted' },
    ] },
  },
  {
    when: 'Company record updated',
    ...weekProduct('base-registry'),
    title: 'The entry changes and keeps its history',
    text: 'The registrar records the new address, and the register records who made the change. Revision 23 holds it; revision 22 stays readable.',
    card: { kind: 'record', recordType: 'Business entry', recordId: 'BR-20417', icon: 'business', fields: [
      { label: 'Registered address', value: 'Updated' },
      { label: 'Changed by', value: 'L. Mensah' },
      { label: 'Revision', value: '23' },
    ] },
  },
  {
    when: 'Notification requested',
    ...weekProduct('messaging'),
    title: 'The company is told',
    text: 'After the company record is updated, the filing service calls Messaging to send the reviewed email template. Messaging sends only when an authorized caller triggers it, and returns the delivery result to the filing service.',
    card: { kind: 'notice', channel: 'Email', to: 'Company secretary', subject: 'Change of address recorded, BR-20417', status: 'Delivered' },
  },
];
---
<Solution
  area={area}
  heading="Manage business registrations and changes."
  description="Businesses submit registrations and changes. Registrars review each filing and record the approved information in the business register. A bank, procurement system or other approved service can check a permitted fact without receiving the filing file."
>
  <section class="section" id="example" aria-labelledby="business-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="business-week-title">Follow a company address change.</h2>
      </div>
      <RegisterWeek
        id="business-week"
        kicker="Business BR-20417, one request"
        heading="Follow the registration."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="business-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="business-change-title">Keep a clear history of business changes.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Link a business to its registrations</h3><p>Staff can record company registrations, tax registrations and authorizations against a business entry. When another institution holds a registration, the implementation must agree how to identify the business and connect that information.</p><a class="inline-cta" href="/products/base-registry/">How the register holds an entry <span aria-hidden="true">→</span></a></article>
        <article><h3>Check a registration without the full file</h3><p>A bank or procurement team receives only the answer your office permits, such as whether the business is registered. Filing history, addresses and owners stay in your register.</p><a class="inline-cta" href="/solutions/check-a-fact/">How a service checks a fact <span aria-hidden="true">→</span></a></article>
        <article><h3>Reproduce a certificate when another copy is needed</h3><p>When given the same issue details, Registry Render reproduces the certificate so the later copy matches the original. The application decides when a certificate or extract may be issued.</p><a class="inline-cta" href="https://docs.registrystack.org/explanation/render-determinism/">How Registry Render reproduces a document <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from a business or tax register like yours."
    intro="A starting configuration can provide a model for one register of businesses, taxpayers, filings or financial rights. It is adapted to your rules, the services people use and the systems that must connect."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our business registration system?',
        a: 'It depends on what holds your register today. If a registration system takes applications, collects fees and issues the registration, that system stays and records the result in the register. If your register is a spreadsheet, or lives inside an application you are retiring, Base Registry Engine can be the register, with your team planning the migration of the existing entries.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can a bank check a business is registered without an account on our system?',
        a: 'Two cases. A member of the public or a bank looking up one business uses the public register your application publishes under your law. A service that needs to check businesses as part of its own process asks your register a question you have agreed to answer, such as whether the register records a business as active, and gets that answer and nothing else. Your office decides which services may ask, and which questions.',
        link: { href: '/solutions/check-a-fact/', label: 'How a service checks a fact' },
      },
      {
        q: 'Who can see who owns a business?',
        a: 'Your office decides who may record an owner, who may look one up and under which legal duty. Base Registry Engine keeps a history of changes it handles. The implementation agrees audit coverage across the register and connected applications.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What if our office is a central bank or financial supervisor?',
        a: 'The bank account, credit and collateral starters follow the same rules, with lookups limited to named roles and no balances or repayments recorded.',
        link: { href: '/starters/#business-and-tax', label: 'Browse the business and tax starters' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A starter is a starting configuration for a particular kind of register. It is available by request and must be adapted to your rules, service channels and existing systems. You can begin by describing your service without selecting a starter first.',
        link: { href: '/starters/#business-and-tax', label: 'Browse the business and tax starters' },
      },
      {
        q: 'Can we still sell certificates and extracts?',
        a: 'Yes. Your institution keeps control of any fees and issuance rules. When given the same issue details, Registry Render reproduces the certificate so a later copy matches the original. The service application decides when issuance is authorized.',
        link: { href: 'https://docs.registrystack.org/explanation/render-determinism/', label: 'How deterministic rendering works' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Discuss your service with our implementation team."
    body="Tell us which registration or filing service you want to improve, who submits changes, who decides and which systems staff use today. We can show how Registry Stack could fit."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
