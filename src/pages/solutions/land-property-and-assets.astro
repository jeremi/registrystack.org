---
// Reader: the registrar of a cadastre, vehicle or asset register, asking "what
// would a week with this look like for my register?" Sections follow their
// next questions: show me a week, what changes for my office, where do we
// start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { askQuestionHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'land-property-and-assets')!;

const steps: WeekStep[] = [
  {
    when: 'Monday 09:00',
    product: 'Your lodgement service',
    title: 'A transfer is lodged',
    text: 'A notary lodges a transfer of parcel P-11-0482 with the deed attached. The register does not change until a registrar decides.',
    card: { kind: 'record', recordType: 'Transfer application', recordId: 'TR-7731', icon: 'data', fields: [
      { label: 'Parcel', value: 'P-11-0482' },
      { label: 'Right', value: 'Full ownership' },
      { label: 'Lodged by', value: 'Notary' },
    ] },
  },
  {
    when: 'Monday to Wednesday',
    ...weekProduct('casework'),
    title: 'A registrar decides',
    text: 'The transfer lands in the transfers queue. S. Nakamura takes it, checks the deed against the survey, and approves it.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Transfers' },
      { state: 'Claimed', note: 'Held by S. Nakamura' },
      { state: 'Approved', note: 'Wednesday 11:40' },
    ] },
  },
  {
    when: 'Wednesday 11:40',
    ...weekProduct('base-registry'),
    title: 'The parcel’s rights change and keep their history',
    text: 'The registrar records the new holder under their own name. The earlier right stays in the history with the period it applied.',
    card: { kind: 'record', recordType: 'Parcel record', recordId: 'P-11-0482', icon: 'data', fields: [
      { label: 'Holder', value: 'New holder recorded' },
      { label: 'Changed by', value: 'S. Nakamura' },
      { label: 'Revision', value: '9' },
    ] },
  },
  {
    when: 'Wednesday 11:45',
    ...weekProduct('render'),
    title: 'The new holder gets a printed extract',
    text: 'Minutes later a title extract is printed from the register and its fingerprint is kept beside the record. Print it again next year and the bytes match.',
    card: { kind: 'document', documentType: 'Title extract', title: 'Parcel P-11-0482, extract of rights', fields: [
      { label: 'Holder', value: 'As recorded on Wednesday' },
      { label: 'Revision', value: '9' },
      { label: 'Printed', value: 'Wednesday 11:45' },
    ], hash: '3f9a…c21e' },
  },
];
---
<Solution
  area={area}
  heading="Record what is registered, who holds it, and since when."
  description="A transfer waits in the backlog, two entries claim the same parcel, and the valuation office and the notaries work from a spreadsheet your staff exported last quarter. Registry Stack gives your office one register of the assets it records and the rights over them, and shares only the details you have agreed with each office that needs them."
>
  <section class="section" id="example" aria-labelledby="land-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="land-week-title">A transfer is lodged on Monday. The registrar decides on Wednesday, and the new holder has an extract minutes later.</h2>
      </div>
      <RegisterWeek
        id="land-week"
        kicker="Parcel P-11-0482, one request"
        heading="Each step names the product that does it."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="land-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="land-change-title">One entry per parcel, and the services you connect stop re-typing it into spreadsheets.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Each right shows who holds it, in what share, and since when</h3><p>A parcel, building, vehicle or vessel is entered once, and each right or keeper is recorded against it for a period. A valuation office reads holder and share as your register holds them.</p><a class="inline-cta" href="/products/base-registry/">How the register serves other services <span aria-hidden="true">→</span></a></article>
        <article><h3>Your law decides what is public</h3><p>Your office sets which entries are public and which only named roles may look up. The starters begin with holders restricted; public transport stops begin open to all.</p><a class="inline-cta" href="/security/">Who is responsible for what <span aria-hidden="true">→</span></a></article>
        <article><h3>An extract prints the same every time</h3><p>A title extract or certificate is printed from the register, with its fingerprint kept beside the record. A reprint matches the original byte for byte.</p><a class="inline-cta" href="https://docs.registrystack.org/start/registry-render/">How printed documents work <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from an asset register like yours."
    intro="A starter sets out what a register of this kind holds and who may change it, for one common register of land, buildings, vehicles, or places. Your team takes the closest one and adapts it to its own law."
    featuredNote="The cadastre starter records the parcel right and defines a reader role; your team gives that role to the valuation office’s service."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our cadastre system?',
        a: 'No. Your mapping system keeps parcel boundaries and your document store keeps deeds and plans. Base Registry Engine is for the register of rights you build new, or decide to move. If that register stays in its current system, that system serves its details; Registry Stack does not publish fields from a register it does not hold.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can a valuation office read our register without an account on our system?',
        a: 'Two cases. A member of the public or a notary looking up one parcel uses the public register your application publishes under your law. A service that needs holder details as part of its own process, such as the valuation office preparing its roll, reads the details your office has agreed to share with it, such as holder and share, and nothing else. Your office decides which services may read, and which details.',
        link: { href: '/products/base-registry/', label: 'How Base Registry Engine serves other services' },
      },
      {
        q: 'Is a printed extract proof of what the register holds?',
        a: 'The extract shows what the register held when it was printed, and its fingerprint is kept with the record. Whether a paper extract has legal effect is a matter for your law; a service that needs the current state asks the register.',
        link: { href: 'https://docs.registrystack.org/explanation/render-determinism/', label: 'Why a reprint matches the original' },
      },
      {
        q: 'Who can see who holds a parcel or a vehicle?',
        a: 'Your office decides, role by role: who may record a right, who may look up a holder, and for what reason. Every look-up and every change is kept with who did it and when.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A free package requested from the starter’s page and opened to see how a register of this kind is set out: the records it keeps, the changes staff can make, and who may make them. It is a starting point to adapt, not a running system: your team adds what your register needs, and using one does not mean the register is in use anywhere. Anyone from the office can request it; your technical team is who opens it.',
        link: { href: '/starters/#land-property-and-assets', label: 'Browse the land, property and vehicle starters' },
      },
      {
        q: 'Where does our technical team start?',
        a: 'If you keep your register where it is: the Evidence Gateway tutorial, which answers a question from sample data on a laptop. If you are building or moving a register: the Base Registry Engine tutorial, then the starter closest to your register.',
        link: { href: 'https://docs.registrystack.org/tutorials/first-breg/', label: 'Run the registry tutorial' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Talk it through with the people who build it."
    body="Tell us which register you keep and what other services ask of it. We reply by email, and a short call is the usual next step. Paid pilots and support are there if you want them."
    primaryLabel="Ask a question"
    primaryHref={askQuestionHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
