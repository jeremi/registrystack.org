---
// Reader: the registrar of a cadastre, vehicle or asset register, asking "what
// would a week with this look like for my register?" Sections follow their
// next questions: show me a week, what changes for my office, where do we
// start, the doubts, who to ask.
import Solution from '../../layouts/Solution.astro';
import RegisterWeek from '../../components/RegisterWeek.astro';
import SolutionStarters from '../../components/SolutionStarters.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import { solutionAreas, sharedFamilyFaq } from '../../data/solutions';
import { describeServiceHref, contactEmail } from '../../data/contact';
import { weekProduct, type WeekStep } from '../../data/register-week';
const area = solutionAreas.find((a) => a.key === 'land-property-and-assets')!;

const steps: WeekStep[] = [
  {
    when: 'Transfer lodged',
    product: 'Your lodgement service',
    title: 'A transfer is lodged',
    text: 'A notary lodges a transfer of parcel P-11-0482 with the deed attached. The register does not change until a registrar decides.',
    card: { kind: 'record', recordType: 'Transfer application', recordId: 'TR-7731', icon: 'data', fields: [
      { label: 'Parcel', value: 'P-11-0482' },
      { label: 'Right', value: 'Full ownership' },
      { label: 'Lodged by', value: 'Notary' },
    ] },
  },
  {
    when: 'Review and decision',
    ...weekProduct('casework'),
    title: 'A registrar decides',
    text: 'The transfer enters the review queue. S. Nakamura checks the deed against the survey information and approves the application.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Transfers' },
      { state: 'Claimed', note: 'Held by S. Nakamura' },
      { state: 'Approved', note: 'Checks complete' },
    ] },
  },
  {
    when: 'Property record updated',
    ...weekProduct('base-registry'),
    title: 'The parcel’s rights change and keep their history',
    text: 'The registrar records the new holder, and the register records who made the change. The earlier right stays in the history with the period it applied.',
    card: { kind: 'record', recordType: 'Parcel record', recordId: 'P-11-0482', icon: 'data', fields: [
      { label: 'Holder', value: 'New holder recorded' },
      { label: 'Changed by', value: 'S. Nakamura' },
      { label: 'Revision', value: '9' },
    ] },
  },
  {
    when: 'Extract requested',
    ...weekProduct('render'),
    title: 'The new holder gets a printed extract',
    text: 'The service requests an extract from the recorded revision and keeps its fingerprint. When given the same issue details, Registry Render reproduces the extract so a later copy matches the original.',
    card: { kind: 'document', documentType: 'Title extract', title: 'Parcel P-11-0482, extract of rights', fields: [
      { label: 'Holder', value: 'As recorded in revision 9' },
      { label: 'Revision', value: '9' },
      { label: 'Issued from', value: 'Revision 9' },
    ], hash: '3f9a…c21e' },
  },
];
---
<Solution
  area={area}
  heading="Manage asset records and their changes."
  description="Registrars review applications and record approved changes to parcels, buildings, vehicles, vessels or public assets. Connected services receive only the information your office allows. Existing maps, deeds and specialist records can stay in their current systems."
>
  <section class="section" id="example" aria-labelledby="land-week-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">One request, start to finish</p>
        <h2 id="land-week-title">Follow a property transfer.</h2>
      </div>
      <RegisterWeek
        id="land-week"
        kicker="Parcel P-11-0482, one request"
        heading="Follow the property transfer."
        steps={steps}
      />
    </div>
  </section>
  <section class="section section-muted" id="what-changes" aria-labelledby="land-change-title">
    <div class="section-inner">
      <div class="section-heading">
        <p class="eyebrow">What changes for your office</p>
        <h2 id="land-change-title">Review current rights and earlier changes.</h2>
      </div>
      <div class="product-facts">
        <article><h3>Record who holds each right</h3><p>Staff record each right or keeper against the relevant parcel, building, vehicle or vessel, including the share and the period it applies. A valuation office reads holder and share as your register holds them.</p><a class="inline-cta" href="/products/base-registry/">How the register serves other services <span aria-hidden="true">→</span></a></article>
        <article><h3>Your law decides what is public</h3><p>Your office sets which entries are public and which only named roles may look up. The starters begin with holders restricted; public transport stops begin open to all.</p><a class="inline-cta" href="/security/">Who is responsible for what <span aria-hidden="true">→</span></a></article>
        <article><h3>Reproduce an extract when another copy is needed</h3><p>When given the same issue details, Registry Render reproduces the extract so the later copy matches the original. The institution’s service controls when an extract may be issued and what legal effect it has.</p><a class="inline-cta" href="https://docs.registrystack.org/explanation/render-determinism/">How Registry Render reproduces a document <span aria-hidden="true">↗</span></a></article>
      </div>
    </div>
  </section>
  <SolutionStarters
    area={area}
    heading="Start from an asset register like yours."
    intro="A starting configuration can provide a model for land, buildings, vehicles, vessels or places. It is adapted to your law, terminology, decision process and existing mapping or document systems."
    featuredNote="The cadastre starting configuration records the parcel right. Your team decides whether the valuation office’s service may read holder and share information."
  />
  <SolutionFaq
    items={[
      {
        q: 'Does this replace our cadastre system?',
        a: 'No. Your mapping system keeps parcel boundaries and your document store keeps deeds and plans. Base Registry Engine is for the register of rights you build new, or decide to move. If that register stays in its current system, the current system must provide its details; Registry Stack does not publish fields from a register it does not hold.',
        link: { href: 'https://docs.registrystack.org/explanation/integration-patterns/', label: 'How it sits beside existing systems' },
      },
      {
        q: 'Can a valuation office read our register without an account on our system?',
        a: 'Two cases. A person or notary looking up one parcel uses the public search service your application provides under your law. A connected service, such as a valuation office preparing its roll, receives only the details your office has agreed to share, such as holder and share. Your office decides which services may read each detail.',
        link: { href: '/products/base-registry/', label: 'How Base Registry Engine serves other services' },
      },
      {
        q: 'Is a printed extract proof of what the register holds?',
        a: 'The extract represents the record revision used to render it, and its fingerprint can be retained with that record. Whether an extract proves title or has another legal effect depends on the institution’s law and process; Registry Stack does not make that legal determination.',
        link: { href: 'https://docs.registrystack.org/explanation/render-determinism/', label: 'Why a reprint matches the original' },
      },
      {
        q: 'Who can see who holds a parcel or a vehicle?',
        a: 'Your office decides who may record a right, who may look up a holder and for what reason. Base Registry Engine keeps a history of changes it handles. The implementation agrees audit coverage across the register and connected applications.',
        link: { href: '/security/', label: 'Who is responsible for what' },
      },
      {
        q: 'What is a starter, exactly?',
        a: 'A starter is a starting configuration for a particular kind of register. It is available by request and must be adapted to your law, service channels and existing systems. You can begin by describing your service without selecting a starter first.',
        link: { href: '/starters/#land-property-and-assets', label: 'Browse the land, property and vehicle starters' },
      },
      ...sharedFamilyFaq,
    ]}
  />
  <DocsHandoff
    eyebrow="Work with us"
    heading="Discuss your service with our implementation team."
    body="Tell us which asset register you want to improve, who maintains the official record and which mapping, document or valuation systems staff use today. We can show how Registry Stack could fit."
    primaryLabel="Discuss your service"
    primaryHref={describeServiceHref(area.name)}
    emphasis="docs"
    note={`Or write to ${contactEmail}.`}
  />
</Solution>
