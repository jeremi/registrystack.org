---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SolutionFaq from '../../components/SolutionFaq.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import Illustration from '../../components/Illustration.astro';
import { describeServiceHref } from '../../data/contact';

const pageTitle = 'Local government services | Registry Stack';
const pageDescription = 'Run local permit and registration services, from application and staff review to record updates, notices and renewals.';
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="local-government" />
  <main id="main-content" tabindex="-1" class="solution-page local-government-page">
    <section class="hero" aria-labelledby="local-government-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Local government</p>
          <h1 id="local-government-title">Run local permits and registrations from application to renewal.</h1>
          <p class="hero-lead">Residents and businesses get a clear way to apply. Your staff get one place to review each request. The permit or registration record that results stays current. Registry Stack can connect to the payment, document and mapping systems you already use.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="#example">Explore service examples</a>
            <a class="button button-secondary" href="#what-changes">Follow the service from application to renewal</a>
          </div>
        </div>
      </div>
    </section>

    <section id="example" class="section" aria-labelledby="local-examples-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Service examples</p>
          <h2 id="local-examples-title">Run the permits and registrations your authority delivers.</h2>
          <p>These services are illustrations. Your authority’s forms, decisions and rules for public information shape how each service is set up.</p>
        </div>
        <div class="product-facts">
          <article>
            <h3>Market-trader permits</h3>
            <p>A trader submits the form and the evidence. They see what is missing and replace a document without starting again. Staff review the application, record the decision and issue the permit. Inspectors can check the current permit status without receiving the application file.</p>
            <a class="inline-cta" href="/solutions/licensing/">Explore licensing services <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <h3>Food-premises registration</h3>
            <p>A business registers each premises. It updates the details when something changes. Staff review the submission and the inspection information. They correct duplicate entries and keep the establishment’s current status. Public and partner services see only the details your authority allows.</p>
            <a class="inline-cta" href="/solutions/agriculture-food-and-environment/">Explore establishment registers <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <h3>Rented-housing registration</h3>
            <p>An owner submits a registration or reports a change. Staff check the information, decide the request and keep the property’s registration history. The service can keep using your existing property, payment and document systems. This means nobody copies that information by hand.</p>
            <a class="inline-cta" href="/solutions/land-property-and-assets/">Explore property records <span aria-hidden="true">→</span></a>
          </article>
        </div>
        <Illustration
          name="service-template"
          alt="A City Council shares its market stall permit service as a template with a District Council and a Town Council. The District Council adds a site visit. The Town Council drops the fee. Each council runs its own installation on its own servers. Each council keeps its own permits."
          caption="One council shares its market stall permit service as a template. Every council adapts the service and keeps its own permits. The councils are fictional."
        />
      </div>
    </section>

    <section id="what-changes" class="section section-muted" aria-labelledby="local-journey-title">
      <div class="section-inner product-fit">
        <div class="section-heading compact">
          <p class="eyebrow">From application to renewal</p>
          <h2 id="local-journey-title">Receive applications, review them and update records.</h2>
          <p>The four steps below can support a permit, a premises registration or another local service. Each step can use your existing channels and systems where they already work well.</p>
        </div>
        <dl>
          <dt>Apply and provide evidence</dt>
          <dd>Applicants submit their details and supporting evidence. They can return to a saved draft. They can replace missing documents.</dd>
          <dt>Review and decide</dt>
          <dd>Staff receive the request in the right queue and check the evidence. If something is missing, they request changes. The applicant revises the request and submits it for a new review. Supervisors can see which officer is responsible for each active review. They can also see what needs attention.</dd>
          <dt>Update the permit or registration</dt>
          <dd>A staff member or a connected service with permission records the permit, registration or status after the decision. Authorised staff can still see earlier versions.</dd>
          <dt>Notify, inspect and renew</dt>
          <dd>The service can send an approved notice when the application system requests it. Inspectors can check permitted details. Staff can renew, suspend, correct or close a permit or registration.</dd>
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="local-scope-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Fits your existing systems</p>
          <h2 id="local-scope-title">Keep the systems that still serve you well.</h2>
          <p>Your register can connect to the payment, identity, mapping, document and finance systems you already use. The implementation scope names what is added and what stays in place. It also names who operates each part.</p>
        </div>
      </div>
    </section>

    <div id="questions">
      <SolutionFaq
        heading="Questions to ask when you choose your first service."
        items={[
          {
            q: 'Do we need to choose a starting configuration first?',
            a: 'No. Tell us which service you need, who will use it and what it should do. We can identify a useful starting configuration. We can also explain how it would be adapted. You can request free access to the current configurations.',
            link: { href: 'https://marketplace.registrystack.org/', label: 'Browse the configuration marketplace' },
          },
          {
            q: 'Do we have to replace our current applications?',
            a: 'No. Registry Stack can provide a new register. It can also connect selected capabilities to systems you already use. For example, a market-permit service could keep its existing payment system and document store. It could then add clearer review, permit history and status checks.',
            link: { href: 'https://docs.registrystack.org/start/concepts/', label: 'See integration patterns' },
          },
          {
            q: 'Can the implementation include screens and hosting?',
            a: 'Yes. The written scope can include applicant, staff or public screens. It can also include identity, hosting, migration and integrations. We agree with you what your authority needs. We also agree how it will be tested before handover. If we host the service, hosting is priced separately in your proposal.',
          },
          {
            q: 'Which service should we discuss first?',
            a: 'You can bring a new permit or registration requirement. You can also bring a service where applicants and staff need a better way to work. Describe who will use it, the decisions your authority makes and any systems to connect.',
          },
        ]}
      />
    </div>

    <DocsHandoff
      eyebrow="Discuss one local service"
      heading="Tell us about a service your authority needs."
      body="Describe a market permit, a premises registration, a rented-housing registration or another local service. Include who applies, what staff decide and any systems to connect."
      primaryLabel="Discuss a local service"
      primaryHref={describeServiceHref('a local government service')}
      note="The core software is open source under the Apache-2.0 licence. Your own team or a provider you choose can inspect it, adapt it and run it. Or we can implement, host and run it for you, priced separately in your proposal."
      emphasis="docs"
    />
  </main>
  <SiteFooter />
</Base>

<style>
  .local-government-page :global(.section-inner) { padding-top: clamp(44px, 6vw, 68px); padding-bottom: clamp(44px, 6vw, 68px); }
  .local-government-page :global(h2) { font-size: clamp(28px, 3.7vw, 42px); }
  .local-government-page :global(.product-facts) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px; }
  .local-government-page :global(.product-facts article) { border-top: 2px solid var(--registry-blue); padding-top: 20px; }
  .local-government-page :global(.product-facts p) { margin-bottom: 0; }
  .local-government-page :global(.product-facts .inline-cta) { display: inline-block; margin-top: 12px; }
  .local-government-page :global(.product-fit) { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 40px; }
  .local-government-page :global(.product-fit dl) { margin: 0; }
  .local-government-page :global(.product-fit dt) { color: var(--registry-ink); font-weight: 700; margin-bottom: 5px; }
  .local-government-page :global(.product-fit dd) { border-bottom: 1px solid var(--registry-rule); line-height: 1.55; margin: 0 0 20px; padding-bottom: 18px; }
  @media (max-width: 700px) {
    .local-government-page :global(.product-facts), .local-government-page :global(.product-fit) { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
