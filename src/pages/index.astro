---
// Reader: an institutional service owner deciding whether to discuss a service.
// A configured service leads; ownership, implementation and evaluation follow.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeServiceMockup from '../components/HomeServiceMockup.astro';
import { products } from '../data/products';
import { registerFamilies, solutionAreas } from '../data/solutions';
import { describeServiceHref } from '../data/contact';
import { teamRecordFull } from '../data/team';

const featured = registerFamilies.filter((area) => ['licensing', 'business-and-tax', 'agriculture-food-and-environment'].includes(area.key));
const crossCutting = solutionAreas.filter((area) => area.kind === 'cross-cutting');
---
<Base>
  <SiteHeader />
  <main id="main-content" tabindex="-1">
    <section class="hero hero-cover" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-top">
          <div class="hero-copy">
            <p class="eyebrow">Open-source software for public registers and services</p>
            <h1 id="hero-title">Software for official registers and the services that use them.</h1>
            <p class="hero-lead">Create a new register or adapt one you already run. Registry Stack keeps your records, staff reviews and the history of changes. It works alongside your existing portals and ID systems. The core software is open source, with no licence fee. You keep control of your data.</p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button button-primary" href="/solutions/">See solutions for your service</a>
              <a class="button button-secondary" href={describeServiceHref()} data-journey="service-inquiry">Discuss your service</a>
            </div>
            <p class="hero-note">Our paid services start with your <a href="/pricing/#pilot">pilot register</a>. We implement it together with your own team.</p>
          </div>
          <div class="hero-figure"><HomeServiceMockup /></div>
        </div>
      </div>
    </section>

    <section class="section" id="registers" aria-labelledby="registers-title">
      <div class="section-inner" id="how-a-register-runs">
        <div class="section-heading">
          <p class="eyebrow">For national, regional and local government</p>
          <h2 id="registers-title">Build new public services and adapt existing ones.</h2>
          <p>For example, you can:</p>
          <ul class="home-list">
            <li>issue a first licence</li>
            <li>renew a licence</li>
            <li>set up a business register</li>
            <li>keep records of facilities up to date</li>
          </ul>
          <p>Applications, staff decisions and official records stay connected. Other services that you authorise can check the information they need from your register.</p>
        </div>
        <ul class="register-grid featured-solutions">
          {featured.map((area) => (
            <li>
              <a href={area.slug}>
                <span class="register-name">{area.name}</span>
                <span class="register-intent">{area.intent}</span>
                {area.audience && <span class="register-audience">{area.audience}</span>}
              </a>
            </li>
          ))}
        </ul>
        <div class="section-links"><a class="inline-cta" href="/solutions/">Explore all solution areas <span aria-hidden="true">→</span></a></div>
        <nav class="shared-work" id="shared-work" aria-label="Related capabilities">
          <p>Related capabilities</p>
          <ul>{crossCutting.map((area) => <li><a href={area.slug}>{area.name}</a></li>)}</ul>
        </nav>
      </div>
    </section>

    <section class="section section-muted" id="open-source" aria-labelledby="ownership-title">
      <div class="section-inner" id="get-started">
        <div class="section-heading">
          <p class="eyebrow">Open-source software with paid implementation and support</p>
          <h2 id="ownership-title">Build your register with your own team or work with us.</h2>
        </div>
        <div class="value-grid adoption-grid">
          <article><h3>Choose who runs the software and where</h3><p>The core software is open source under the Apache-2.0 licence. Your own team or a provider you choose can inspect it, adapt it and run it. Or we can host and run it for you, priced separately in your proposal. You decide where the software runs and who can use your records.</p><a class="inline-cta" href="/faq/">Read about ownership, licensing and hosting <span aria-hidden="true">→</span></a></article>
          <article><h3>Work with us on your pilot register</h3><p>We are Aubex. We build and support Registry Stack. You bring one service. Together we agree a written scope for your pilot register. The scope sets out:</p><ul class="home-list"><li>the configuration</li><li>the screens</li><li>the connections to other systems</li><li>who is responsible for what</li></ul><p>Implementation and ongoing support are paid services.</p><a class="inline-cta" href="/pricing/">Read about implementation and pricing <span aria-hidden="true">→</span></a></article>
        </div>
        <p class="team-record"><strong>Experience from earlier registry projects.</strong> {teamRecordFull}</p>
      </div>
    </section>

    <section class="section" id="customization" aria-labelledby="customization-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">AI for public services</p>
          <h2 id="customization-title">Use AI where it helps your service.</h2>
          <p>You can use AI to:</p>
          <ul class="home-list">
            <li>help define a service</li>
            <li>help prepare changes to a service</li>
            <li>help people prepare a request</li>
          </ul>
          <p>You define the rules. People stay responsible for what is submitted and for each decision.</p>
          <a class="inline-cta" href="/ai/">See the three ways to use AI <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="developers" aria-labelledby="developers-title">
      <div class="section-inner" id="start-testing">
        <div class="section-heading"><p class="eyebrow">For technical teams</p><h2 id="developers-title">Inspect the software and run an example.</h2><p>Follow a tutorial that runs on your own computer with sample data. Use it to evaluate the core capabilities. You do not need to contact us.</p></div>
        <div id="products"><div id="how-it-works" class="home-product-links" aria-label="Product details">{products.map((product) => <a href={product.href}>{product.name}</a>)}</div></div>
        <div class="developer-grid">{products.filter((product) => product.featured).map((product) => (<article><h3>{product.solution}</h3><p>{product.firstResult}</p><a class="inline-cta developer-tutorial" href={product.tutorialHref}>{product.tutorialLabel} <span aria-hidden="true">↗</span></a></article>))}</div>
        <p class="developer-note" id="project-status">Read the <a href="https://docs.registrystack.org/">documentation</a> at docs.registrystack.org. Find the <a href="https://github.com/registrystack/registry-stack">source code and releases</a> on GitHub.</p>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="pilot-title"><div class="section-inner"><p class="eyebrow">Your next service</p><h2 id="pilot-title">Tell us what your institution needs.</h2><p>Describe the service, who will use it and what it needs to do. We can help you check whether Registry Stack fits. We can also scope the work with you. You can start from a new mandate with no form or register yet.</p><div class="hero-actions"><a class="button button-primary" href={describeServiceHref()} data-journey="service-inquiry">Discuss your service</a><a class="button button-secondary" href="/pricing/">See implementation and pricing</a></div></div></section>
  </main>
  <SiteFooter />
</Base>
<style>
  .hero-top { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(32px, 5vw, 64px); }
  .hero-inner { padding-top: clamp(40px, 5vw, 72px); padding-bottom: clamp(44px, 6vw, 80px); }
  .hero-cover h1 { font-size: clamp(2.3rem, 4.4vw, 3.7rem); }
  .hero-lead { font-size: clamp(18px, 1.8vw, 21px); line-height: 1.55; }
  .hero-note a { color: inherit; }
  .register-grid { display: grid; gap: 0 32px; list-style: none; margin: 0; padding: 0; }
  .register-grid li { border-top: 1px solid var(--registry-rule); }
  .register-grid a { display: grid; gap: 4px; padding: 18px 0 20px; }
  .register-grid a:hover { text-decoration: none; }
  .register-grid a:hover .register-name { color: var(--registry-blue); }
  .register-name { color: var(--registry-ink); font-size: var(--type-body); font-weight: 700; }
  .register-intent { color: var(--registry-muted); font-size: var(--type-md); }
  .register-audience { color: var(--registry-body); font-size: var(--type-sm); margin-top: 4px; }
  .featured-solutions { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .shared-work { border-top: 1px solid var(--registry-rule); margin-top: 36px; padding-top: 20px; }
  .shared-work > p { color: var(--registry-muted); font-size: var(--type-base); margin: 0 0 8px; }
  .shared-work ul { display: flex; flex-wrap: wrap; gap: 4px 28px; list-style: none; padding: 0; margin: 0; }
  .shared-work a { display: inline-block; padding: 8px 0; font-size: var(--type-base); }
  .team-record { max-width: 78ch; border-top: 1px solid var(--registry-rule); margin: 32px 0 0; padding-top: 24px; font-size: var(--type-base); }
  .home-product-links { display: flex; flex-wrap: wrap; gap: 12px 28px; border-bottom: 1px solid var(--registry-rule); margin-bottom: 32px; padding-bottom: 20px; }
  .home-product-links a { font-weight: 700; }
  .adoption-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .developer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .developer-grid article { border-top: 1px solid var(--registry-rule); padding-top: 22px; }
  .developer-grid h3 { font-size: var(--type-subhead); }
  .developer-grid p { font-size: var(--type-body-sm); }
  .developer-grid a { font-size: var(--type-base); }
  .developer-note { font-size: var(--type-base); margin-top: 28px; }
  .home-list { line-height: 1.58; margin: 0 0 16px; padding-left: 1.25em; }
  .home-list li + li { margin-top: 4px; }
  .section-heading .home-list { color: var(--registry-body); font-size: var(--type-lg); max-width: 760px; }
  .value-grid .home-list { font-size: var(--type-body-sm); line-height: 1.65; }
  @media (max-width: 900px) { .hero-top, .featured-solutions { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .adoption-grid, .developer-grid { grid-template-columns: 1fr; } }
</style>
