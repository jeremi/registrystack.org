---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroAnswerCard from '../components/HeroAnswerCard.astro';
import RegistrySeal from '../components/RegistrySeal.astro';

const pageTitle = 'Registry Stack | Answer the question. Keep the records.';
const pageDescription =
  'Registry Stack helps government registries return signed minimum-disclosure answers or protected, selected data while source records stay with the authority that holds them.';
const repoHref = 'https://github.com/registrystack/registry-stack';
const roadmapHref = 'https://github.com/registrystack/registry-stack/blob/main/ROADMAP.md';
const releaseVerifyHref = 'https://github.com/registrystack/registry-stack/blob/main/release/VERIFY.md';

const heroAnswers = [
  {
    domain: 'Civil registration',
    question: 'Which age band applies to this person?',
    answer: 'Age band · 18-64',
  },
  {
    domain: 'Social protection',
    question: 'Is this household enrolled?',
    answer: 'Enrolled household',
  },
  {
    domain: 'Business registry',
    question: 'Is this supplier actively registered?',
    answer: 'Active',
  },
  {
    domain: 'Farmer registry',
    question: 'Is this a registered farmer, and what is the farm size?',
    answer: 'Registered farmer · 2.5 ha',
  },
];

const workflowSteps = [
  {
    number: '01',
    title: 'Connect the registry you already have.',
    body:
      'Work with an existing spreadsheet, database, extract, or registry system. You do not have to replace it or move the records.',
  },
  {
    number: '02',
    title: 'Agree what can be asked and returned.',
    body:
      'Define who may ask, for what purpose, and whether the service should receive one signed answer or selected fields.',
  },
  {
    number: '03',
    title: 'Return only what was agreed.',
    body:
      'Check each request against the reviewed definition, read the source, and return the agreed answer or selected data.',
  },
  {
    number: '04',
    title: 'Keep a record of what happened.',
    body:
      'The registry owner can see who asked, the purpose they gave, and whether evidence was provided or the request was refused.',
  },
];

const programOutcomes = [
  {
    title: 'Services ask for the fact they need',
    body:
      'Evidence Gateway lets an approved service ask one predefined question and receive a signed answer instead of collecting the source facts again.',
  },
  {
    title: 'Registries disclose less data',
    body:
      'A clear answer or a few agreed fields can replace a database login, a full export, or another copy of the registry.',
  },
  {
    title: 'New service connections can reuse existing definitions',
    body:
      'Once a registry has described its evidence and data, another service can reuse those descriptions instead of documenting the source again.',
  },
];

const exampleAnswers = [
  {
    domain: 'Civil registration',
    question: 'Which age band applies to this person?',
    answer: 'Age band · 18-64',
    denied: false,
  },
  {
    domain: 'Social protection',
    question: 'Is this household enrolled?',
    answer: 'Enrolled household',
    denied: false,
  },
  {
    domain: 'Business registry',
    question: 'Is this supplier actively registered?',
    answer: 'Active',
    denied: false,
  },
  {
    domain: 'Farmer registry',
    question: 'Send the full list of registered farmers.',
    answer: 'Refused · outside the agreed scope',
    denied: true,
  },
];

const solutions = [
  {
    eyebrow: 'When a service needs proof',
    title: 'Evidence Gateway',
    body:
      'Answer one predefined question against an authoritative source and return a signed, minimum-disclosure assertion.',
    href: '/solutions/evidence-gateway/',
    cta: 'See the Evidence Gateway',
    points: [
      'Answer defined questions such as “is this business actively registered?”',
      'The requesting service receives the answer, not the source record behind it.',
    ],
  },
  {
    eyebrow: 'When a service needs registry data',
    title: 'Protected Registry APIs',
    body:
      'Provide read-only access to defined registry fields without giving out a database login or distributing copies of the source.',
    href: '/solutions/protected-registry-apis/',
    cta: 'See Protected Registry APIs',
    points: [
      'Return agreed fields, metadata, or allowed counts through a protected API.',
      'Keep the existing registry as the official record and record each read.',
    ],
  },
];

const audiences = [
  {
    marker: 'Owner',
    title: 'Registry authorities',
    body:
      'Provide signed answers or selected data while keeping the source records and deciding what each service may receive.',
  },
  {
    marker: 'Service',
    title: 'Public-service teams',
    body:
      'Confirm facts such as enrollment, registration, or status without collecting more information than the service needs.',
  },
  {
    marker: 'Deliver',
    title: 'Digital delivery partners',
    body:
      'Connect existing systems without creating another central database, and leave infrastructure the government can inspect and operate.',
  },
];

// Neighbor platforms shown as monochrome marks. Display sizes are tuned per
// logo for visual parity, not taken from the source files.
const worksAlongside = [
  { name: 'OpenCRVS', src: '/logos/opencrvs.svg', width: 128, height: 24 },
  { name: 'OpenSPP', src: '/logos/openspp.svg', width: 114, height: 24 },
  { name: 'DHIS2', src: '/logos/dhis2.svg', width: 92, height: 28 },
  { name: 'HL7 FHIR', src: '/logos/fhir.svg', width: 92, height: 30 },
  { name: 'MOSIP', src: '/logos/mosip.png', width: 75, height: 34 },
  { name: 'OpenFn', src: '/logos/openfn.png', width: 81, height: 30 },
];

const proofPoints = [
  {
    title: 'Try the complete flow',
    body:
      'The hosted lab uses synthetic data to show registry-backed requests and protected registry reads without using production records.',
    fact: 'No install or sign-up',
  },
  {
    title: 'Inspect and deploy the software',
    body:
      'The products and documentation are Apache-2.0. Run them on infrastructure controlled by the government or its chosen operator.',
    fact: 'Open source and self-hosted',
  },
  {
    title: 'Get help with the first registry',
    body:
      'Aubex provides pilot design, source integration, deployment, training, and ongoing engineering support.',
    fact: 'Delivery and support available',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader />

  <main>
    <section class="hero hero-cover" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-top">
          <div class="hero-copy">
            <p class="eyebrow">Open-source infrastructure for government registries and their partners</p>
            <h1 id="hero-title">Answer the question. Keep the records.</h1>
            <p class="hero-thesis">
              Registry Stack helps the registries a government already runs provide what another
              service needs: one signed answer or selected data. The records stay with the
              authority that holds them.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button button-primary" href="https://lab.registrystack.org/">Try the live demo</a>
              <a class="button button-secondary" href="/pilot/">Start with one registry</a>
            </div>
            <p class="hero-note">
              The demo uses synthetic data only. No sign-up required.
            </p>
          </div>

          <div class="hero-figure" aria-hidden="true">
            <div class="hero-card-wrap">
              <HeroAnswerCard answers={heroAnswers} />
              <div class="hero-seal"><RegistrySeal size={110} /></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="partner-strip" aria-label="Platforms Registry Stack works alongside">
      <div class="partner-strip-inner">
        <span>Works alongside the platforms governments already run</span>
        <ul class="partner-logos">
          {worksAlongside.map((item) => (
            <li>
              <img src={item.src} alt={item.name} width={item.width} height={item.height} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section home-workflow-section" id="how-it-works" aria-labelledby="workflow-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">How it works</p>
          <h2 id="workflow-title">How Registry Stack handles a request to an existing registry.</h2>
          <p>
            The registry owner defines who may request an answer or selected data, for what
            purpose, and what may be returned. Registry Stack applies those rules and records each
            request.
          </p>
        </div>
        <ol class="home-workflow" aria-label="Registry Stack workflow">
          {workflowSteps.map((step) => (
            <li>
              <span class="workflow-number">{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
        <div class="home-workflow-cta">
          <a class="inline-cta" href="/pilot/">See how to start with one registry &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="outcomes" aria-labelledby="outcomes-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">What this changes</p>
          <h2 id="outcomes-title">Services can use registry information without copying the full record.</h2>
          <p>
            A service can receive a signed answer or selected data directly. The source record
            remains with the registry owner.
          </p>
        </div>
        <div class="home-outcome-grid">
          {programOutcomes.map((outcome) => (
            <article>
              <h3>{outcome.title}</h3>
              <p>{outcome.body}</p>
            </article>
          ))}
        </div>
        <div class="centered-action">
          <a class="inline-cta" href="/how-it-fits/">See where Registry Stack fits &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section" id="in-practice" aria-labelledby="practice-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">In practice</p>
          <h2 id="practice-title">Start with questions services already ask.</h2>
          <p>
            A pension program may need an age band. A payment system may need a supplier&rsquo;s
            registration status. Neither needs the complete record behind the answer.
          </p>
        </div>
        <div class="answer-examples">
          {exampleAnswers.map((row) => (
            <div class={row.denied ? 'answer-example is-denied' : 'answer-example'}>
              <span class="ae-domain">{row.domain}</span>
              <p class="ae-question">&ldquo;{row.question}&rdquo;</p>
              <span class="ae-answer">{row.answer}</span>
            </div>
          ))}
        </div>
        <div class="centered-action">
          <a class="inline-cta" href="/use-cases/">See the worked scenarios &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="solutions" aria-labelledby="solutions-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Two ways to start</p>
          <h2 id="solutions-title">Sometimes a service needs an answer. Sometimes it needs a few fields.</h2>
          <p>
            Registry Stack supports both through separate products. Evidence Gateway returns a
            signed minimum-disclosure assertion. Registry Relay exposes protected, selected data.
          </p>
        </div>
        <div class="home-solution-grid">
          {solutions.map((solution) => (
            <article class="home-solution-card">
              <p class="eyebrow">{solution.eyebrow}</p>
              <h3>{solution.title}</h3>
              <p>{solution.body}</p>
              <ul>
                {solution.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a class="inline-cta" href={solution.href}>{solution.cta} &rarr;</a>
            </article>
          ))}
        </div>
        <div class="centered-action">
          <a class="inline-cta" href="/use-cases/">Compare real use cases &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section" id="who-it-is-for" aria-labelledby="audience-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Who it is for</p>
          <h2 id="audience-title">For teams that need registries to work together.</h2>
          <p>
            Registry Stack is government-first. It helps registry owners, public-service teams,
            and their implementation partners agree what can be asked, then make that agreement
            work in practice.
          </p>
        </div>
        <div class="home-audience-grid">
          {audiences.map((audience) => (
            <article>
              <span>{audience.marker}</span>
              <h3>{audience.title}</h3>
              <p>{audience.body}</p>
            </article>
          ))}
        </div>
        <p class="private-sector-note">
          The same infrastructure can support regulated private-sector networks where one
          organization needs evidence held by another, but should not receive the source records.
        </p>
      </div>
    </section>

    <section class="proof-band" id="built-in-the-open" aria-labelledby="proof-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Evaluate Registry Stack</p>
          <h2 id="proof-title">Try the demo, review the software, and plan a pilot.</h2>
          <p>
            Current releases are for evaluation, integration pilots, and public review. The
            <a href={roadmapHref}>public roadmap</a> records the work toward stable deployment and
            compatibility commitments.
          </p>
        </div>
        <div class="proof-grid">
          {proofPoints.map((point) => (
            <article>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
              <p class="proof-fact">{point.fact}</p>
            </article>
          ))}
        </div>
        <div class="proof-steward">
          <h3>Built and supported by Aubex</h3>
          <p>
            Registry Stack is built by Aubex. Founder Jeremi Joslin brings experience from
            OpenSPP. Aubex also participates in Digital Convergence Initiative standards work and
            has contributed to the GovStack registry building block. Our engineers work directly
            with pilot teams and publish the code, documentation, releases, and security material
            for review.
          </p>
        </div>
        <div class="proof-links">
          <a href="https://lab.registrystack.org/">Open the live lab &rarr;</a>
          <a href="/how-it-fits/">See how it fits existing systems &rarr;</a>
          <a href="/pilot/">See implementation and support &rarr;</a>
          <a href={repoHref}>Browse the code on GitHub &rarr;</a>
          <a href={releaseVerifyHref}>Verify a release &rarr;</a>
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="section-inner">
        <p class="pill">Plan a pilot</p>
        <h2 id="final-title">Start with one registry and one service need.</h2>
        <p class="final-cta-copy">
          We can help determine whether the service should receive one signed answer through
          Evidence Gateway or selected data through Registry Relay. We then define a pilot around
          that decision.
        </p>
        <div class="hero-actions">
          <a class="button button-primary" href="/pilot/">Start with one registry</a>
          <a class="button button-secondary" href="https://lab.registrystack.org/">Try the demo first</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>

<style>
  .home-workflow-section {
    overflow: hidden;
  }

  .home-workflow-section .section-heading {
    margin-bottom: 0;
  }

  .home-workflow {
    counter-reset: workflow;
    display: grid;
    column-gap: clamp(22px, 3vw, 34px);
    grid-template-columns: repeat(4, minmax(0, 1fr));
    list-style: none;
    margin: clamp(32px, 4vw, 46px) 0 0;
    padding: 0;
    row-gap: 40px;
  }

  .home-workflow li {
    border-top: 1px solid var(--registry-rule);
    min-width: 0;
    padding: 26px 8px 0 0;
    position: relative;
  }

  .home-workflow li::before {
    background: var(--registry-blue);
    content: '';
    height: 3px;
    left: 0;
    position: absolute;
    top: -2px;
    width: 44px;
  }

  .home-workflow li:not(:last-child)::after {
    background: #ffffff;
    color: var(--registry-blue);
    content: '\2192';
    font-size: 22px;
    font-weight: 700;
    line-height: 1;
    padding: 0 5px;
    position: absolute;
    right: calc(clamp(22px, 3vw, 34px) / -2 - 12px);
    top: -11px;
    z-index: 1;
  }

  .workflow-number {
    color: var(--registry-stamp);
    display: block;
    font-family: var(--registry-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }

  .home-workflow h3 {
    color: var(--registry-ink);
    font-size: clamp(20px, 2vw, 25px);
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .home-workflow p {
    color: var(--registry-body);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }

  .home-workflow-cta {
    margin-top: 32px;
    text-align: center;
  }

  .home-outcome-grid {
    display: grid;
    gap: clamp(20px, 3vw, 40px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(28px, 4vw, 44px);
  }

  .home-outcome-grid article {
    border-top: 2px solid var(--registry-ink);
    min-width: 0;
    padding-top: 16px;
  }

  .home-outcome-grid h3 {
    color: var(--registry-ink);
    font-size: 19px;
    line-height: 1.25;
    margin: 0 0 10px;
  }

  .home-outcome-grid p {
    color: var(--registry-body);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }

  .home-audience-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(28px, 4vw, 44px);
  }

  .home-audience-grid article {
    border: 1px solid var(--registry-rule);
    min-width: 0;
    padding: 22px;
  }

  .home-audience-grid span {
    color: var(--registry-blue);
    display: block;
    font-family: var(--registry-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    margin-bottom: 18px;
    text-transform: uppercase;
  }

  .home-audience-grid h3 {
    color: var(--registry-ink);
    font-size: 18px;
    margin: 0 0 10px;
  }

  .home-audience-grid p {
    color: var(--registry-body);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }

  .private-sector-note {
    border-left: 3px solid var(--registry-blue);
    color: var(--registry-body);
    font-size: 15px;
    line-height: 1.55;
    margin: 28px auto 0;
    max-width: 840px;
    padding: 4px 0 4px 18px;
  }

  .final-cta-copy {
    color: var(--registry-body);
    font-size: 18px;
    line-height: 1.55;
    margin: 0 0 24px;
    max-width: 760px;
  }

  @media (max-width: 1080px) {
    .home-workflow,
    .home-audience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-workflow li:not(:last-child)::after {
      content: none;
    }
  }

  @media (max-width: 620px) {
    .home-workflow,
    .home-outcome-grid,
    .home-audience-grid {
      grid-template-columns: 1fr;
    }

    .home-workflow li {
      padding-right: 0;
    }

    .home-workflow li:not(:last-child)::after {
      background: transparent;
      bottom: -32px;
      content: '\2193';
      padding: 0;
      right: auto;
      top: auto;
    }
  }
</style>
