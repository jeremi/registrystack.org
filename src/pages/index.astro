---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HeroAnswerCard from '../components/HeroAnswerCard.astro';
import RegistrySeal from '../components/RegistrySeal.astro';
import SystemsDiagram from '../components/SystemsDiagram.astro';

const pageTitle = 'Registry Stack | Answer the question. Keep the records.';
const pageDescription =
  'Registry Stack lets government registries confirm facts and share proof while the records stay with the authority that holds them. Open source, commercially supported.';
const repoHref = 'https://github.com/registrystack/registry-stack';
const roadmapHref = 'https://github.com/registrystack/registry-stack/blob/main/ROADMAP.md';
const releaseVerifyHref = 'https://github.com/registrystack/registry-stack/blob/main/release/VERIFY.md';

const heroAnswers = [
  {
    domain: 'Civil registration',
    question: 'Which age band applies to this person?',
    answer: 'Age band · 18-64',
  },
  {
    domain: 'Social protection',
    question: 'Is this household enrolled?',
    answer: 'Enrolled household',
  },
  {
    domain: 'Business registry',
    question: 'Is this supplier actively registered?',
    answer: 'Active',
  },
  {
    domain: 'Farmer registry',
    question: 'Is this a registered farmer, and what is the farm size?',
    answer: 'Registered farmer · 2.5 ha',
  },
];

const problemPoints = [
  {
    label: 'People keep proving what the state already knows',
    body: 'Programs collect the same facts another registry already holds, because there is no safe way to ask for just the fact.',
  },
  {
    label: 'A bulk export answers one question with every record',
    body: 'When sharing means shipping a copy of the registry, one leaked file is every record at once, and no one can say afterwards who used it for what.',
  },
  {
    label: 'Every integration starts from zero',
    body: 'Each new program negotiates its own export or its own point-to-point build, and nothing is left for the next program to reuse.',
  },
];

const exampleAnswers = [
  {
    domain: 'Civil registration',
    question: 'Is this person over 18?',
    answer: 'Yes · signed proof',
    denied: false,
  },
  {
    domain: 'Social protection',
    question: 'Is this household enrolled?',
    answer: 'Enrolled household',
    denied: false,
  },
  {
    domain: 'Business registry',
    question: 'Is this supplier actively registered?',
    answer: 'Active',
    denied: false,
  },
  {
    domain: 'Farmer registry',
    question: 'Send the full list of registered farmers.',
    answer: 'Denied · no approved purpose',
    denied: true,
  },
];

const solutions = [
  {
    eyebrow: 'Share evidence, not records',
    title: 'Evidence Gateway',
    body:
      'Use this when a service needs proof of a fact, a yes or no, a status, or a credential, but should never receive the underlying record.',
    href: '/solutions/evidence-gateway/',
    cta: 'See how Evidence Gateway works',
    points: [
      'Every request is checked for who is asking and why before any answer is returned.',
      'The answer carries its own freshness, redaction, and audit trail.',
    ],
  },
  {
    eyebrow: 'Open a registry safely',
    title: 'Protected Registry APIs',
    body:
      'Use this when a registry already exists, in a file, a database, or a legacy system, and partners need a safe, read-only way to consult it.',
    href: '/solutions/protected-registry-apis/',
    cta: 'See how Protected Registry APIs work',
    points: [
      'Approved services get scoped routes, not a copy of the file or a database login.',
      'Every read is limited to agreed fields and recorded in the audit trail.',
    ],
  },
];

const products = [
  {
    title: 'Registry Notary',
    role: 'Verify',
    body: 'Answers a precise question against a registry and returns a configured proof or a wallet credential.',
    href: '/notary/',
  },
  {
    title: 'Registry Relay',
    role: 'Expose',
    body: 'Serves a protected, read-only API over the files and tables a registry already lives in.',
    href: '/relay/',
  },
  {
    title: 'Registry Manifest',
    role: 'Describe',
    body: 'Publishes a registry’s metadata, policies, and schemas in the standard formats partners read.',
    href: '/manifest/',
  },
];

// Neighbor platforms shown as monochrome marks. Display sizes are tuned per
// logo for visual parity, not taken from the source files.
const worksAlongside = [
  { name: 'OpenCRVS', src: '/logos/opencrvs.svg', width: 128, height: 24 },
  { name: 'OpenSPP', src: '/logos/openspp.svg', width: 114, height: 24 },
  { name: 'DHIS2', src: '/logos/dhis2.svg', width: 92, height: 28 },
  { name: 'HL7 FHIR', src: '/logos/fhir.svg', width: 92, height: 30 },
  { name: 'MOSIP', src: '/logos/mosip.png', width: 75, height: 34 },
  { name: 'OpenFn', src: '/logos/openfn.png', width: 81, height: 30 },
];

const proofPoints = [
  {
    title: 'Free to run, commercially supported',
    body: 'Every product is Apache-2.0 and complete for a single registry on your own infrastructure. Subscriptions add packaged support and governance tooling across registry services.',
    fact: 'Self-host free, forever',
  },
  {
    title: 'A live demo you can try now',
    body: 'The hosted lab runs on synthetic data. It issues a signed proof into a wallet, runs flows with OpenCRVS and DHIS2, and serves protected APIs backed by ordinary files and tables.',
    fact: 'No install, no sign-up',
  },
  {
    title: 'Built on open standards',
    body: 'Proofs are credentials standard wallets can read, catalogs publish in the metadata formats public-sector partners already use, and registry sync follows the Digital Convergence Initiative (DCI) exchange standard where it fits: the reusable building blocks funders look for in digital public infrastructure.',
    fact: 'Open formats you can read and leave',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader />

  <main>
    <section class="hero hero-cover" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-top">
          <div class="hero-copy">
            <p class="eyebrow">Open-source infrastructure for government registries and their partners</p>
            <h1 id="hero-title">Answer the question. Keep the records.</h1>
            <p class="hero-thesis">
              Registry Stack lets the registries a government already runs confirm facts, like
              &ldquo;is this household enrolled?&rdquo;, and return just the answer. The records
              never leave the authority that holds them.
            </p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button button-primary" href="https://lab.registrystack.org/">Try the live demo</a>
              <a class="button button-secondary" href="/pilot/">Start a pilot conversation</a>
            </div>
            <p class="hero-note">
              The demo runs on synthetic data and issues a real proof into a wallet. No sign-up
              needed.
            </p>
          </div>

          <div class="hero-figure" aria-hidden="true">
            <div class="hero-card-wrap">
              <HeroAnswerCard answers={heroAnswers} />
              <div class="hero-seal"><RegistrySeal size={110} /></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="partner-strip" aria-label="Platforms Registry Stack works alongside">
      <div class="partner-strip-inner">
        <span>Works alongside the platforms governments already run</span>
        <ul class="partner-logos">
          {worksAlongside.map((item) => (
            <li>
              <img src={item.src} alt={item.name} width={item.width} height={item.height} loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section" id="problem" aria-labelledby="problem-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow"><span class="reg-no">No. 01</span> &middot; The problem</p>
          <h2 id="problem-title">Today, the smallest unit of sharing is the whole registry.</h2>
          <p>
            When one service needs a fact from another agency&rsquo;s registry, the options are a
            bulk export or a one-off integration. Registry Stack exists because neither is safe
            enough to say yes to.
          </p>
        </div>
        <div class="home-problem-grid">
          {problemPoints.map((point) => (
            <article>
              <h3>{point.label}</h3>
              <p>{point.body}</p>
            </article>
          ))}
        </div>
        <div class="centered-action">
          <a class="inline-cta" href="/problem/">Why whole-registry sharing fails &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="where-it-runs" aria-labelledby="sysmap-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow"><span class="reg-no">No. 02</span> &middot; The safe pattern</p>
          <h2 id="sysmap-title">Records stay inside the authority. Only answers leave.</h2>
          <p>
            The products run inside the registry&rsquo;s own infrastructure; partner services and
            wallets stay outside and only ever receive answers. Every request is checked for who
            is asking and for what purpose, and each one leaves an audit record a reviewer can
            read.
          </p>
        </div>
        <SystemsDiagram />
      </div>
    </section>

    <section class="section" id="in-practice" aria-labelledby="practice-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow"><span class="reg-no">No. 03</span> &middot; In practice</p>
          <h2 id="practice-title">Real questions, bounded answers.</h2>
          <p>
            A service asks a precise question and gets the smallest answer that does the job. A
            request without an approved purpose gets nothing, and the refusal is logged too.
          </p>
        </div>
        <div class="answer-examples">
          {exampleAnswers.map((row) => (
            <div class={row.denied ? 'answer-example is-denied' : 'answer-example'}>
              <span class="ae-domain">{row.domain}</span>
              <p class="ae-question">&ldquo;{row.question}&rdquo;</p>
              <span class="ae-answer">{row.answer}</span>
            </div>
          ))}
        </div>
        <div class="centered-action">
          <a class="inline-cta" href="/use-cases/">See the worked scenarios &rarr;</a>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="solutions" aria-labelledby="solutions-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow"><span class="reg-no">No. 04</span> &middot; Two ways in</p>
          <h2 id="solutions-title">Two ways in, built from three open-source products.</h2>
          <p>
            Start from the outcome you need. Both paths follow the same rule: the services you
            work with get the answer they need, and the records behind it stay with the registry.
          </p>
        </div>
        <div class="home-solution-grid">
          {solutions.map((solution) => (
            <article class="home-solution-card">
              <p class="eyebrow">{solution.eyebrow}</p>
              <h3>{solution.title}</h3>
              <p>{solution.body}</p>
              <ul>
                {solution.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
              <a class="inline-cta" href={solution.href}>{solution.cta} &rarr;</a>
            </article>
          ))}
        </div>
        <div class="home-product-strip">
          {products.map((product) => (
            <article>
              <p class="product-role">{product.role}</p>
              <h3>{product.title}</h3>
              <p>{product.body}</p>
              <a class="inline-cta" href={product.href}>Open {product.title} &rarr;</a>
            </article>
          ))}
        </div>
        <div class="centered-action">
          <a class="inline-cta" href="/pricing/">See plans and support &rarr;</a>
        </div>
      </div>
    </section>

    <section class="proof-band" id="built-in-the-open" aria-labelledby="proof-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Built in the open</p>
          <h2 id="proof-title">Open source, commercially supported, built in the open.</h2>
          <p>
            The code is Apache-2.0 and free to run; what we sell is what keeps a deployment
            dependable. Stability commitments are tracked on the
            <a href={roadmapHref}>public roadmap</a>, and every claim on this page is something
            your team can check.
          </p>
        </div>
        <div class="proof-grid">
          {proofPoints.map((point) => (
            <article>
              <h3>{point.title}</h3>
              <p>{point.body}</p>
              <p class="proof-fact">{point.fact}</p>
            </article>
          ))}
        </div>
        <div class="proof-steward">
          <h3>Who builds it</h3>
          <p>
            Registry Stack is built by Aubex, the team behind OpenSPP, with seats in Digital
            Convergence Initiative standards work and contributions to the GovStack registry
            building block. Registry interoperability is our day job: releases are signed and
            verifiable, and our engineers work directly with every pilot.
          </p>
        </div>
        <div class="proof-links">
          <a href="https://lab.registrystack.org/">Try the live demo &rarr;</a>
          <a href="/pricing/">Plans and support &rarr;</a>
          <a href="/pilot/">What a pilot looks like &rarr;</a>
          <a href="/ecosystem/">How Registry Stack fits the ecosystem &rarr;</a>
          <a href={repoHref}>Browse the code on GitHub &rarr;</a>
          <a href={releaseVerifyHref}>For your security team: verify a release &rarr;</a>
        </div>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="final-title">
      <div class="section-inner">
        <p class="pill">Start small</p>
        <h2 id="final-title">Start with one registry, one question, one pilot.</h2>
        <div class="hero-actions">
          <a class="button button-primary" href="/pilot/">Start a pilot conversation</a>
          <a class="button button-secondary" href="/pricing/">See plans and support</a>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
