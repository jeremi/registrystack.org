---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import RegistryExample from '../components/RegistryExample.astro';
import { products } from '../data/products';

const pageTitle = 'Registry Stack | Maintain your registry. Share only what services need.';
const pageDescription = 'Open-source software to store and manage records about people, households, organizations, and assets, and share verifiable facts with services. Explore Base Registry Engine and Evidence Gateway.';
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader />
  <main>
    <section class="hero hero-cover" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-top">
          <div class="hero-copy">
            <p class="eyebrow">Open-source software for registries</p>
            <h1 id="hero-title">Maintain your registry. Share only what services need.</h1>
            <p class="hero-lead">People, households, businesses, assets: your organization keeps records that others rely on. Registry Stack helps you store and manage those records, and share the facts services need without handing over the full record.</p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button button-primary" href="#how-it-works">See how it works</a>
              <a class="button button-secondary" href="#developers">For developers</a>
            </div>
            <p class="hero-note">Your organization controls the records, the rules, and who gets access.</p>
          </div>
          <div class="hero-figure"><RegistryExample /></div>
        </div>
      </div>
    </section>

    <section class="section" id="how-it-works" aria-labelledby="solutions-title">
      <div class="section-inner" id="solutions">
        <div class="section-heading">
          <p class="eyebrow">Two ways to start</p>
          <h2 id="solutions-title">Keep records current. Put them to use.</h2>
          <p>Build and run a registry, or let services check facts against one you already have. Choose the product for the job; each works independently.</p>
        </div>
        <div class="home-solution-grid">
          <article class="home-solution-card">
            <p class="eyebrow">Base Registry Engine</p>
            <h3>Build and run your registry.</h3>
            <p>Store records about people, households, organizations, assets, and more. Give your applications a consistent way to create, find, and update them, with access controls and a history of changes.</p>
            <div class="product-introduction">
              <h4>Shaped around your information</h4>
              <p>Define the records, their relationships, and the rules they must follow. For example, connect people to households and keep their details current as circumstances change.</p>
            </div>
            <a class="inline-cta" href="/solutions/base-registry/">Explore Base Registry Engine <span aria-hidden="true">→</span></a>
          </article>
          <article class="home-solution-card">
            <p class="eyebrow">Evidence Gateway</p>
            <h3>Share a fact a service can verify.</h3>
            <p>Let approved services check information held in your registry. Return a signed answer, such as an age check, residence region, or registration status, while keeping unrelated details private.</p>
            <div class="product-introduction">
              <h4>Only the information needed</h4>
              <p>Define which questions each service may ask. For example, a licensing service can check that someone is 18 or older without receiving their date of birth.</p>
            </div>
            <a class="inline-cta" href="/solutions/evidence-gateway/">Explore Evidence Gateway <span aria-hidden="true">→</span></a>
          </article>
        </div>
        <div class="existing-registry">
          <div><h3>When a service needs selected fields</h3><p>Registry Relay publishes selected data from an existing registry, with rules for what each service may receive.</p></div>
          <a class="inline-cta" href="/solutions/protected-registry-apis/">Explore Relay <span aria-hidden="true">→</span></a>
        </div>
        <p class="example-note"><a href="/use-cases/">Explore examples for public services and registry teams</a>.</p>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="ownership-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Under your organization’s control</p>
          <h2 id="ownership-title">Your registry. Your responsibilities.</h2>
          <p>The software supports the people responsible for the records and the services that use them.</p>
        </div>
        <div class="ownership-grid">
          <article>
            <h3>Your team sets the rules</h3>
            <p>Define what your records contain, who can read or change them, and what another service may learn from them.</p>
            <a class="inline-cta" href="/security/">Read about access and accountability <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <h3>Work with the systems you use</h3>
            <p>Base Registry Engine stores and manages records behind your applications. Evidence Gateway can connect to a source you already maintain.</p>
            <a class="inline-cta" href="/faq/">Explore adoption questions <span aria-hidden="true">→</span></a>
          </article>
          <article>
            <h3>Choose how to deliver it</h3>
            <p>Your team or delivery partner can run the open-source software on infrastructure you control. Paid implementation and support are available when you need them.</p>
            <a class="inline-cta" href="/pricing/">Explore implementation and support <span aria-hidden="true">→</span></a>
          </article>
        </div>
      </div>
    </section>

    <section class="section" id="developers" aria-labelledby="developers-title">
      <div class="section-inner" id="start-testing">
        <div class="section-heading">
          <p class="eyebrow">For developers and technical teams</p>
          <h2 id="developers-title">Try a working example.</h2>
          <p>Run a local tutorial with sample data. Each guide includes the setup and steps to inspect the result.</p>
        </div>
        <div class="developer-grid">
          {products.filter((product) => product.featured).map((product) => (
            <article>
              <h3>{product.name}</h3>
              <p>{product.firstResult}</p>
              <a class="inline-cta developer-tutorial" href={product.tutorialHref}>{product.tutorialLabel} <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
        <p class="developer-note"><a href="https://docs.registrystack.org/">Browse the documentation</a> or <a href="https://github.com/registrystack/registry-stack">inspect the source and releases</a>. The software is Apache-2.0 open source.</p>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="pilot-title">
      <div class="section-inner pilot-invitation">
        <div>
          <p class="eyebrow">Work with us</p>
          <h2 id="pilot-title">Get help when you need it.</h2>
          <p>Build with your own team, or get help through a paid implementation pilot or ongoing support.</p>
        </div>
        <a class="button button-primary" href="/pricing/">Implementation and support <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
  <SiteFooter />
</Base>

<style>
  .hero-top { grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr); gap: clamp(32px, 5vw, 56px); }
  .hero-inner { padding-top: clamp(40px, 5vw, 68px); padding-bottom: clamp(44px, 6vw, 76px); }
  .hero-lead { font-size: clamp(18px, 1.8vw, 21px); line-height: 1.55; }
  .hero-figure { padding-right: 12px; }
  .home-solution-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; max-width: none; margin-top: 0; }
  .home-solution-card { display: flex; flex-direction: column; gap: 18px; border-top: 3px solid var(--registry-blue); padding: 30px; }
  .home-solution-card .eyebrow { font-size: 12px; }
  .home-solution-card h3 { font-size: 28px; line-height: 1.2; }
  .home-solution-card > p:not(.eyebrow) { font-size: 16px; }
  .product-introduction { border-top: 1px solid var(--registry-rule); padding-top: 18px; margin-top: auto; }
  .product-introduction h4 { font-size: 17px; margin: 0; }
  .product-introduction p { font-size: 15px; margin-top: 8px; }
  .home-solution-card .inline-cta { font-size: 14px; }
  .example-note, .developer-note { font-size: 14px; color: var(--registry-muted); margin: 24px 0 0; }
  .existing-registry { display: flex; gap: 24px; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--registry-rule); padding: 28px 0; }
  .existing-registry h3 { font-size: 17px; margin-bottom: 6px; }
  .existing-registry p { font-size: 15px; margin: 0; color: var(--registry-muted); }
  .existing-registry a { flex-shrink: 0; font-size: 14px; }
  .ownership-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .ownership-grid article, .developer-grid article { border-top: 1px solid #c9d0c5; padding-top: 22px; }
  .ownership-grid h3, .developer-grid h3 { font-size: 21px; }
  .ownership-grid p, .developer-grid p { font-size: 16px; }
  .ownership-grid a, .developer-grid a { font-size: 14px; }
  .developer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .pilot-invitation { display: flex; gap: 32px; align-items: center; justify-content: space-between; }
  .pilot-invitation h2 { font-size: clamp(28px, 3.4vw, 40px); }
  .pilot-invitation p:not(.eyebrow) { max-width: 660px; margin-bottom: 0; }
  .pilot-invitation .button { flex-shrink: 0; gap: 18px; }
  @media (max-width: 900px) {
    .hero-top { grid-template-columns: 1fr; }
    .hero-figure { max-width: 520px; }
    .ownership-grid { grid-template-columns: 1fr; gap: 24px; }
    .pilot-invitation, .existing-registry { align-items: flex-start; flex-direction: column; }
  }
  @media (max-width: 620px) {
    .home-solution-grid, .developer-grid { grid-template-columns: 1fr; }
  }
</style>
