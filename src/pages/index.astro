---
// Reader: an institutional service owner deciding whether to discuss a service.
// Solutions lead; customization, ownership and adoption explain the choice.
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ServiceOutline from '../components/ServiceOutline.astro';
import RegisterDay from '../components/RegisterDay.astro';
import { products } from '../data/products';
import { registerFamilies, solutionAreas } from '../data/solutions';
import { contactEmail, describeServiceHref } from '../data/contact';

const featured = registerFamilies.filter((area) => ['licensing', 'business-and-tax', 'health-and-safety'].includes(area.key));
const crossCutting = solutionAreas.filter((area) => area.kind === 'cross-cutting');
---
<Base>
  <SiteHeader />
  <main>
    <section class="hero hero-cover" aria-labelledby="hero-title">
      <div class="hero-inner">
        <div class="hero-top">
          <div class="hero-copy">
            <p class="eyebrow">Open-source software for public registers and services</p>
            <h1 id="hero-title">Public registers and services, built around your rules.</h1>
            <p class="hero-lead">Manage records, applications and approvals with software you can adapt. Connect your existing systems, choose where it runs, and get help delivering the service your institution needs.</p>
            <div class="hero-actions" aria-label="Primary actions">
              <a class="button button-primary" href="/solutions/">Explore solutions</a>
              <a class="button button-secondary" href={describeServiceHref()} data-journey="service-inquiry">Discuss your service</a>
            </div>
            <p class="hero-note">Start with an implementation pilot, with AI-assisted customization and support from our team. <a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
          </div>
          <div class="hero-figure"><ServiceOutline /></div>
        </div>
      </div>
    </section>

    <section class="section" id="registers" aria-labelledby="registers-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Solutions for your work</p>
          <h2 id="registers-title">Start with the service you want to improve.</h2>
          <p>Issue and renew licences, maintain business records, or keep a facility register up to date. Adapt the records and review process to your institution.</p>
        </div>
        <ul class="register-grid featured-solutions">
          {featured.map((area) => (
            <li>
              <a href={area.slug}>
                <span class="register-name">{area.name}</span>
                <span class="register-intent">{area.intent}</span>
                {area.audience && <span class="register-audience">{area.audience}</span>}
              </a>
            </li>
          ))}
        </ul>
        <div class="section-links"><a class="inline-cta" href="/solutions/">Explore all solution areas <span aria-hidden="true">→</span></a><a class="inline-cta" href="/solutions/local-government/">For municipalities and local authorities <span aria-hidden="true">→</span></a></div>
      </div>
    </section>

    <section class="section section-muted" id="customization" aria-labelledby="customization-title">
      <div class="section-inner approach-split">
        <div class="section-heading">
          <p class="eyebrow">AI-assisted customization</p>
          <h2 id="customization-title">Describe what you need. We help configure it.</h2>
          <p>Describe your requirements and current process. Our team uses AI tools and reusable software to help adapt the records, forms and review steps with you.</p>
          <p>You review the proposed workflow and rules. The resulting application runs without an AI service.</p>
          <a class="inline-cta" href="/customization/">Explore customization <span aria-hidden="true">→</span></a>
        </div>
        <ol class="approach-steps">
          <li><strong>Describe the service</strong><span>Who uses it, what information they provide and which decisions your team makes.</span></li>
          <li><strong>Adapt a starting model</strong><span>We identify a suitable configuration and agree the changes with you.</span></li>
          <li><strong>Review and test together</strong><span>Check the screens, rules and connections against your agreed service journey.</span></li>
        </ol>
      </div>
    </section>

    <section class="section" id="how-a-register-runs" aria-labelledby="run-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">A licensing example</p>
          <h2 id="run-title">Connect the request, the decision and the record.</h2>
          <p>In this licensing example, a person requests a correction, an officer reviews it, and another service checks the updated licence status.</p>
        </div>
        <RegisterDay />
        <div class="shared-work" id="shared-work">
          <p>Explore the capabilities behind this journey:</p>
          <ul class="register-grid register-pair">
            {crossCutting.map((area) => (
              <li>
                <a href={area.slug}>
                  <span class="register-name">{area.name}</span>
                  <span class="register-intent">{area.intent}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="open-source" aria-labelledby="ownership-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Open source. Reusable components.</p>
          <h2 id="ownership-title">Keep control as your services change.</h2>
        </div>
        <div class="value-grid">
          <article><h3>Adapt the software</h3><p>The core software is Apache-2.0 open source. Your team or a provider you choose can inspect, adapt and operate it.</p><a class="inline-cta" href="/faq/">Ownership and licensing <span aria-hidden="true">→</span></a></article>
          <article><h3>Connect existing systems</h3><p>Add a registry or connect a service to information you already maintain. Agree the interfaces and any migration needed for your use case.</p><a class="inline-cta" href="/solutions/check-a-fact/">Connect a service to a register <span aria-hidden="true">→</span></a></article>
          <article><h3>Reuse across public services</h3><p>A register can support several services. Combine reusable components as part of a digital public infrastructure programme.</p><a class="inline-cta" href="/digital-public-infrastructure/">Registry Stack and DPI <span aria-hidden="true">→</span></a></article>
        </div>
      </div>
    </section>

    <section class="section" id="products" aria-labelledby="products-title">
      <div class="section-inner" id="how-it-works">
        <div class="section-heading"><p class="eyebrow">The software behind the service</p><h2 id="products-title">Use the capabilities your service needs.</h2><p>Adopt a component on its own or combine them in a configured solution.</p></div>
        <div class="home-solution-grid">
          <article class="home-solution-card"><p class="eyebrow">Base Registry Engine</p><h3>Manage records and their history.</h3><p>Define the information you keep, its relationships and the rules for reading and changing it.</p><a class="inline-cta" href="/products/base-registry/">Explore Base Registry Engine <span aria-hidden="true">→</span></a></article>
          <article class="home-solution-card"><p class="eyebrow">Evidence Gateway</p><h3>Share only the information needed.</h3><p>Let authorized services ask predefined questions and receive digitally signed answers from your register.</p><a class="inline-cta" href="/products/evidence-gateway/">Explore Evidence Gateway <span aria-hidden="true">→</span></a></article>
          <article class="home-solution-card"><p class="eyebrow">Registry Casework</p><h3>Coordinate reviews and decisions.</h3><p>Assign requests, track deadlines and record review decisions. The register controls how approved changes are applied.</p><a class="inline-cta" href="/products/casework/">Explore Registry Casework <span aria-hidden="true">→</span></a></article>
        </div>
      </div>
    </section>

    <section class="section section-muted" id="get-started" aria-labelledby="adoption-title">
      <div class="section-inner">
        <div class="section-heading"><p class="eyebrow">Choose how to get started</p><h2 id="adoption-title">Build with your team or work with ours.</h2></div>
        <div class="value-grid adoption-grid">
          <article><h3>Discuss an implementation</h3><p>Bring one service and the result you need. We agree the configuration, screens, integrations and responsibilities in a written pilot scope.</p><a class="inline-cta" href="/pricing/">Implementation and support <span aria-hidden="true">→</span></a></article>
          <article><h3>Explore starting configurations</h3><p>Inspect models for common registers and request one for evaluation. We can help select a suitable model if you are unsure where to begin.</p><a class="inline-cta" href="/starters/">Browse starting configurations <span aria-hidden="true">→</span></a></article>
        </div>
      </div>
    </section>

    <section class="section" id="developers" aria-labelledby="developers-title">
      <div class="section-inner" id="start-testing">
        <div class="section-heading"><p class="eyebrow">For technical teams</p><h2 id="developers-title">Inspect the software. Run an example.</h2><p>Use a local tutorial with sample data to evaluate the core capabilities.</p></div>
        <div class="developer-grid">{products.filter((product) => product.featured).map((product) => (<article><h3>{product.solution}</h3><p>{product.firstResult}</p><a class="inline-cta developer-tutorial" href={product.tutorialHref}>{product.tutorialLabel} <span aria-hidden="true">↗</span></a></article>))}</div>
        <p class="developer-note" id="project-status">The core software is available for self-hosted pilots. Read the <a href="https://docs.registrystack.org/explanation/known-limitations/">current limitations</a>, <a href="https://docs.registrystack.org/">documentation</a> and <a href="https://github.com/registrystack/registry-stack">source and releases</a>.</p>
      </div>
    </section>

    <section class="final-cta" aria-labelledby="pilot-title"><div class="section-inner"><p class="eyebrow">Your next service</p><h2 id="pilot-title">Tell us what your institution needs.</h2><p>Describe the service, its users and the change you want to make. We can help assess the fit and scope the work.</p><div class="hero-actions"><a class="button button-primary" href={describeServiceHref()} data-journey="service-inquiry">Discuss your service</a><a class="button button-secondary" href="/pricing/">View implementation options</a></div><p class="final-cta-note">You can also email {contactEmail}.</p></div></section>
  </main>
  <SiteFooter />
</Base>
<style>
  .hero-top { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(32px, 5vw, 64px); }
  .hero-inner { padding-top: clamp(40px, 5vw, 72px); padding-bottom: clamp(44px, 6vw, 80px); }
  .hero-cover h1 { font-size: clamp(2.3rem, 4.4vw, 3.7rem); }
  .hero-lead { font-size: clamp(18px, 1.8vw, 21px); line-height: 1.55; }
  .hero-note a { color: inherit; }
  .register-grid { display: grid; gap: 0 32px; list-style: none; margin: 0; padding: 0; }
  .register-grid li { border-top: 1px solid var(--registry-rule); }
  .register-grid a { display: grid; gap: 4px; padding: 18px 0 20px; }
  .register-grid a:hover { text-decoration: none; }
  .register-grid a:hover .register-name { color: var(--registry-blue); }
  .register-name { color: var(--registry-ink); font-size: var(--type-body); font-weight: 700; }
  .register-intent { color: var(--registry-muted); font-size: var(--type-md); }
  .register-audience { color: var(--registry-body); font-size: var(--type-sm); margin-top: 4px; }
  .featured-solutions { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .register-pair { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .shared-work { border-top: 1px solid var(--registry-rule); margin-top: 36px; padding-top: 20px; }
  .shared-work > p { color: var(--registry-body); font-size: var(--type-base); margin: 0 0 8px; }
  .home-solution-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: 1fr; gap: 24px; max-width: none; margin-top: 0; }
  .home-solution-card { display: flex; flex-direction: column; gap: 16px; border-top: 3px solid var(--registry-blue); padding: 28px; }
  .home-solution-card .eyebrow { font-size: var(--type-xs); }
  .home-solution-card h3 { font-size: var(--type-2xl); line-height: 1.25; }
  .home-solution-card > p:not(.eyebrow) { font-size: var(--type-body-sm); }
  .home-solution-card .inline-cta { font-size: var(--type-base); margin-top: auto; }
  .adoption-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .developer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .developer-grid article { border-top: 1px solid var(--registry-rule); padding-top: 22px; }
  .developer-grid h3 { font-size: var(--type-subhead); }
  .developer-grid p { font-size: var(--type-body-sm); }
  .developer-grid a { font-size: var(--type-base); }
  .developer-note { font-size: var(--type-base); margin-top: 28px; }
  @media (max-width: 900px) { .hero-top, .home-solution-grid, .featured-solutions { grid-template-columns: 1fr; } }
  @media (max-width: 700px) { .adoption-grid, .register-pair, .developer-grid { grid-template-columns: 1fr; } }
</style>
