---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';

const pageTitle = 'Pilot and support | Registry Stack';
const pageDescription =
  'Use the Apache-2.0 Registry Stack components for free, or pay for pilot design, integration, deployment, training, upgrades, and support.';
const contactHref = 'mailto:contact@registrystack.org?subject=Registry%20Stack%20pilot%20and%20support';

const paidHelp = [
  {
    title: 'Pilot design',
    body:
      'Choose one registry, one public or partner service, and the first questions or fields worth testing.',
  },
  {
    title: 'Source integration',
    body:
      'Connect the existing file, database, or registry system and configure the read-only access Registry Stack needs.',
  },
  {
    title: 'Deployment and hardening',
    body:
      'Deploy on infrastructure chosen by the government, configure operational controls, and prepare the service for handover.',
  },
  {
    title: 'Evidence and access configuration',
    body:
      'Work with the registry owner to agree what can be asked and returned, then configure signed answers or agreed fields.',
  },
  {
    title: 'Training',
    body:
      'Train the government team and its implementation partner to operate, inspect, and extend the deployment.',
  },
  {
    title: 'Upgrades and support',
    body:
      'Plan version upgrades, troubleshoot production issues, and maintain an agreed support arrangement.',
  },
];

const pilotSteps = [
  {
    number: '01',
    title: 'Choose one useful service need',
    body:
      'Name the registry owner, the public or partner service, and whether it needs one signed answer or selected data.',
  },
  {
    number: '02',
    title: 'Test with synthetic data before using source records',
    body:
      'Use synthetic data to test the source connection, request rules, result, errors, and audit record with the responsible teams.',
  },
  {
    number: '03',
    title: 'Connect, evaluate, and hand over',
    body:
      'Connect the real source read-only, test the agreed questions or fields, document the deployment, and train the operating team.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="pilot" />

  <main>
    <section class="hero" aria-labelledby="pilot-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Pilot and support</p>
          <h1 id="pilot-hero-title">The software is open source. Aubex charges for implementation and support.</h1>
          <p class="hero-lead">
            Registry Stack&rsquo;s core components are open source under Apache-2.0. A government
            or its chosen partner can deploy them without a license fee. Aubex offers paid help
            when a team wants support designing, connecting, deploying, or operating the system.
          </p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href={contactHref}>Discuss a pilot or support</a>
            <a class="button button-secondary" href="https://github.com/registrystack/registry-stack">Inspect the code</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="split-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">Open-source software and paid services</p>
          <h2 id="split-title">Deploy Registry Stack yourself or pay Aubex for delivery support.</h2>
        </div>
        <div class="offer-split">
          <article class="offer-card offer-card-open">
            <p class="offer-marker">Free and open source</p>
            <h3>The Registry Stack components</h3>
            <ul class="check-list">
              <li>Evidence Gateway, Registry Relay, and Registry Manifest under Apache-2.0.</li>
              <li>Source code, product documentation, examples, and release artifacts.</li>
              <li>Self-hosting on infrastructure controlled by the government or its chosen operator.</li>
              <li>No per-person, per-record, or per-assertion software license fee.</li>
            </ul>
            <p class="offer-note">
              Open-source availability does not include a support response time or delivery team.
            </p>
          </article>
          <article class="offer-card">
            <p class="offer-marker">Paid help</p>
            <h3>Scoped delivery and ongoing support</h3>
            <p>
              Scope and pricing are agreed against the source systems, deployment environment,
              training needs, and support level. A software license purchase is not required.
            </p>
            <a class="inline-cta" href={contactHref}>Discuss the scope &rarr;</a>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="help-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Paid services</p>
          <h2 id="help-title">Implementation and support available from Aubex.</h2>
          <p>A government can choose the services it needs without buying a software license.</p>
        </div>
        <div class="help-grid">
          {paidHelp.map((item) => (
            <article>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="pilot-shape-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">A practical first pilot</p>
          <h2 id="pilot-shape-title">Start with one registry and one service need.</h2>
          <p>
            A pilot should be small enough to understand and complete, but real enough for the
            registry owner and service team to evaluate.
          </p>
        </div>
        <ol class="pilot-steps">
          {pilotSteps.map((step) => (
            <li>
              <span>{step.number}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="ready-title">
      <div class="section-inner ready-section">
        <div class="section-heading compact">
          <p class="eyebrow">Planning a pilot</p>
          <h2 id="ready-title">Information needed to define the first pilot.</h2>
        </div>
        <div>
          <ul class="check-list">
            <li>The registry owner and the source format or system.</li>
            <li>The public or partner service and what it actually needs.</li>
            <li>Who can agree what can be asked and returned.</li>
            <li>The intended hosting, identity, and exchange environment, if known.</li>
            <li>The team that will operate the result after handover.</li>
          </ul>
          <a class="button button-primary" href={contactHref}>Discuss a pilot or support</a>
        </div>
      </div>
    </section>
  </main>

  <DocsHandoff
    eyebrow="Review the software"
    heading="Your team can review the code and technical documentation before discussing paid support."
    primaryLabel="Read the docs"
    emphasis="docs"
  />
  <SiteFooter />
</Base>

<style>
  .offer-split {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0 auto;
    max-width: 900px;
  }

  .offer-card {
    border: 1px solid var(--registry-rule);
    padding: 26px;
  }

  .offer-card-open {
    border-top: 4px solid var(--registry-blue);
  }

  .offer-marker {
    color: var(--registry-stamp);
    font-family: var(--registry-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    margin-bottom: 10px;
    text-transform: uppercase;
  }

  .offer-note {
    border-top: 1px solid var(--registry-rule);
    color: var(--registry-muted);
    font-size: 14px;
    margin: 20px 0 0;
    padding-top: 14px;
  }

  .help-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .help-grid article {
    background: #ffffff;
    border-top: 2px solid var(--registry-ink);
    padding: 18px;
  }

  .help-grid h3 {
    margin-bottom: 8px;
  }

  .help-grid p {
    margin: 0;
  }

  .pilot-steps {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pilot-steps li {
    border: 1px solid var(--registry-rule);
    padding: 22px;
  }

  .pilot-steps span {
    color: var(--registry-stamp);
    font-family: var(--registry-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
  }

  .pilot-steps h3 {
    margin: 12px 0 8px;
  }

  .pilot-steps p {
    margin: 0;
  }

  .ready-section {
    display: grid;
    gap: clamp(28px, 6vw, 80px);
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .ready-section .button {
    margin-top: 20px;
  }

  @media (max-width: 800px) {
    .offer-split,
    .help-grid,
    .pilot-steps,
    .ready-section {
      grid-template-columns: 1fr;
    }
  }
</style>
