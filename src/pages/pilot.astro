---
// GitHub Pages serves static HTML. Preserve known inbound section links with
// JavaScript; the native no-script fallback still reaches the full pricing page.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="https://registrystack.org/pricing/" />
    <title>Implementation and support | Registry Stack</title>
    <script is:inline>
      const pilotSections = new Set(['#support', '#scope', '#stewardship']);
      const section = pilotSections.has(window.location.hash) ? window.location.hash : '';
      window.location.replace('/pricing/' + section);
    </script>
    <noscript><meta http-equiv="refresh" content="0;url=/pricing/" /></noscript>
  </head>
  <body>
    <main>
      <h1>Implementation and support</h1>
      <p><a href="/pricing/">Continue to pricing</a>.</p>
      <p><a href="/pricing/#support">Read about implementation and support</a>.</p>
    </main>
  </body>
</html>
