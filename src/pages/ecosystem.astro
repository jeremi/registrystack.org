---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DocsHandoff from '../components/DocsHandoff.astro';

const pageTitle = 'Ecosystem fit | Registry Stack';
const pageDescription =
  'Registry Stack sits behind exchange layers, beside workflow engines and domain platforms, and in front of wallets and portals. Complementary, not competitive.';

// Neighbor-system categories from the docs ecosystem page, reframed as
// positioning. Each names what the neighbor owns and what Registry Stack adds.
const neighbors = [
  {
    category: 'Domain registry platforms',
    examples: 'OpenCRVS, OpenSPP, DHIS2, OpenIMIS',
    owns: 'Storage, business rules, correction workflows, user interfaces, and a domain runtime API.',
    adds: 'Standards-shaped metadata, scoped read-only routes, configured evidence responses, and hash-chained audit records.',
  },
  {
    category: 'Workflow engines',
    examples: 'OpenFn, Camunda, Flowable',
    owns: 'Process state, task assignment, timers, branching, retries, escalation, and history.',
    adds: 'A stable registry contract a workflow step can call without learning source tables, raw SQL, or full records.',
  },
  {
    category: 'Exchange layers',
    examples: 'X-Road, GovStack-style reference exchanges',
    owns: 'Participant onboarding, message transport, mutual trust, routing, addressing, and cross-institution policy.',
    adds: 'The registry-facing surface behind the exchange: route-level scopes, field projection, and source access controls.',
  },
  {
    category: 'API gateways and policy engines',
    examples: 'Kong, Envoy, Open Policy Agent',
    owns: 'Edge routing, shared ingress policy, traffic controls, service identity, and platform-wide authorization decisions.',
    adds: 'The registry-specific contract behind the gateway: entity routes, source scopes, field limits, evidence responses, and audit records.',
  },
  {
    category: 'Health information mediators',
    examples: 'OpenHIM, FHIR gateways',
    owns: 'Health-message mediation, channel orchestration, facility-system routing, terminology handling, and domain-specific interoperability.',
    adds: 'A governed registry answer path for health-adjacent claims, credentials, and status checks without exposing the source registry record.',
  },
  {
    category: 'Wallets',
    examples: 'SD-JWT VC and OpenID4VCI-compatible wallets',
    owns: 'Key management, credential storage, holder consent, and presentation to relying parties.',
    adds: 'The server-side issuance path: claim evaluation against registry data, and discoverable evidence offerings.',
  },
  {
    category: 'Public-service platforms',
    examples: 'Citizen portals, casework systems, service catalogs',
    owns: 'The user journey: forms, case queues, notifications, payments, and channels.',
    adds: 'The narrow registry-facing surface those journeys call: entity routes, evidence responses, and audit records.',
  },
  {
    category: 'Foundational ID and identity providers',
    examples: 'MOSIP, eSignet',
    owns: 'Identity enrollment, deduplication, authentication, e-KYC (electronic know-your-customer identity checks), and assurance levels for who a person is.',
    adds: 'The registry-facing side of that question: configured proofs about what is true of that person in a specific registry (alive, eligible, registered), issued after the identity layer has done its job.',
  },
];
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="ecosystem" />

  <main>
    <section class="hero" aria-labelledby="eco-hero-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Ecosystem fit</p>
          <h1 id="eco-hero-title">Designed to work with the infrastructure governments already choose.</h1>
          <p class="hero-lead">
            Registry Stack assumes a wider ecosystem and is designed to fit into it, not
            replicate it. It does not replace exchange layers, workflow engines, wallets,
            public-service platforms, or domain registry systems. It gives them safer
            registry-facing services to call.
          </p>
        </div>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="is-not-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">In plain terms</p>
          <h2 id="is-not-title">Four things Registry Stack is not.</h2>
          <p>
            Categories matter when budgets are assigned and architecture diagrams are drawn. If
            you are mapping Registry Stack to a program line, start from what it does not do.
          </p>
        </div>
        <ul class="check-list">
          <li>
            <strong>Not an exchange layer.</strong> X-Road-style exchanges carry trust and
            transport between institutions; Registry Stack is the governed registry surface
            behind them.
          </li>
          <li>
            <strong>Not a benefits or payments platform.</strong> Platforms such as OpenSPP own
            enrollment, case management, and payments; Registry Stack lets the registries they
            rely on answer their questions safely. Registry Stack is built by Aubex, the team
            behind OpenSPP, but the product boundary is deliberate: OpenSPP still owns enrollment
            and payments, and Registry Stack does not replace it.
          </li>
          <li>
            <strong>Not a foundational identity system.</strong> MOSIP and eSignet establish who
            a person is; Registry Stack answers what is true about that person in a specific
            registry.
          </li>
          <li>
            <strong>Not master data management or a warehouse.</strong> No records are copied,
            matched, or consolidated; every source stays where it is, under its owner&rsquo;s
            control.
          </li>
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="neighbors-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Neighbor systems</p>
          <h2 id="neighbors-title">Complementary, not competitive.</h2>
          <p>
            Each neighbor keeps what it owns. Registry Stack adds the narrow registry surface
            that was missing: described, scoped, evidence-shaped, and auditable.
          </p>
        </div>
        <div class="neighbor-grid">
          {neighbors.map((item) => (
            <article class="neighbor-card">
              <h3>{item.category}</h3>
              <p class="neighbor-examples">{item.examples}</p>
              <div class="use-case-field">
                <p class="use-case-label">The neighbor owns</p>
                <p class="use-case-text">{item.owns}</p>
              </div>
              <div class="use-case-field">
                <p class="use-case-label">Registry Stack adds</p>
                <p class="use-case-text">{item.adds}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="tco-note">
          A ministry team can build the narrow surface above in-house: a tamper-evident audit
          chain, credential issuance and lifecycle, standards-shaped rendering, and scope and
          field-limit enforcement. Each of those pieces then needs its own maintenance,
          security review, and standards upkeep for as long as the registry runs. Adopting a
          supported open-source product moves that ongoing cost off the program team: the code
          is free, and the subscription keeps those pieces maintained, reviewed, and current.
        </p>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="lab-title">
      <div class="section-inner">
        <div class="section-heading">
          <p class="eyebrow">Demonstrated, not promised</p>
          <h2 id="lab-title">Separate what runs in the hosted lab from what is compatible.</h2>
          <p>
            The logo wall names six neighboring systems and standards. This list separates
            hosted lab paths you can inspect from compatible integration paths that are supported
            by product contracts or examples.
          </p>
        </div>
        <h3 class="lab-group-title">Running in the hosted lab today</h3>
        <dl class="lab-list">
          <div class="lab-entry">
            <dt>DHIS2</dt>
            <dd>The hosted lab runs a DHIS2 health scenario through Registry Notary&rsquo;s built-in <code>http_json</code> source-adapter path against a live DHIS2 demo instance, with its own smoke test.</dd>
          </div>
          <div class="lab-entry">
            <dt>OpenCRVS</dt>
            <dd>The hosted lab runs an OpenCRVS Digital Convergence Initiative (DCI) notary. A step-by-step tutorial issues a wallet credential from an OpenCRVS DCI test birth record.</dd>
          </div>
          <div class="lab-entry">
            <dt>MOSIP</dt>
            <dd>The hosted lab runs MOSIP eSignet for a citizen self-attestation login flow.</dd>
          </div>
        </dl>
        <h3 class="lab-group-title">Compatible paths and shipped examples</h3>
        <dl class="lab-list">
          <div class="lab-entry">
            <dt>OpenSPP</dt>
            <dd>Registry Notary ships an OpenSPP disability-registry credential configuration and client contract examples for issuing and checking credentials from DCI-shaped records.</dd>
          </div>
          <div class="lab-entry">
            <dt>OpenFn</dt>
            <dd>OpenFn is treated as a workflow-engine caller: workflows call Registry Notary for minimized claim results instead of owning source reads. The DHIS2 lab path now uses Registry Notary&rsquo;s built-in adapter rather than an OpenFn-based one.</dd>
          </div>
          <div class="lab-entry">
            <dt>HL7 FHIR</dt>
            <dd>Registry Notary ships a FHIR source-adapter guide for projecting bounded FHIR R4 graphs into evidence-ready source facts without exposing raw bundles.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="layered-title">
      <div class="section-inner">
        <div class="section-heading center">
          <p class="eyebrow">A layered example</p>
          <h2 id="layered-title">Behind an exchange layer, in front of a registry source.</h2>
          <p>
            An exchange layer such as X-Road handles network trust between institutions. The
            registry surface behind it assumes zero trust anyway: a request arriving through a
            trusted channel is still checked for route-level scope, field projection, and source
            access. The two layers do different jobs.
          </p>
        </div>
        <div class="flow-diagram" aria-label="Registry Stack behind an exchange layer">
          <div class="flow-node">
            <span>Exchange layer</span>
            <p>X-Road or a GovStack-style exchange handles trust, transport, routing, and addressing between participants.</p>
          </div>
          <div class="flow-arrow" aria-hidden="true">&rarr;</div>
          <div class="flow-node flow-node-strong">
            <span>Registry Stack</span>
            <ol>
              <li>Scope the caller</li>
              <li>Project fields</li>
              <li>Return evidence</li>
              <li>Record audit</li>
            </ol>
          </div>
          <div class="flow-arrow" aria-hidden="true">&rarr;</div>
          <div class="flow-node">
            <span>Registry source</span>
            <p>The legacy database, extract, or domain platform stays where it is, under institutional control.</p>
          </div>
        </div>
        <p class="layered-note">
          A request forwarded by the exchange layer arrives at a registry surface that can return
          a configured evidence response instead of a copied record, and log who asked and why.
        </p>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="standards-title">
      <div class="section-inner split">
        <div class="section-heading compact">
          <p class="eyebrow">Standards we adopt</p>
          <h2 id="standards-title">Established standards, not a new ontology.</h2>
          <p>
            Registry Stack adopts standards rather than inventing them. Claim levels vary by
            standard; the docs carry the full register before assuming conformance. No universal
            registry ontology is claimed. Concrete conformance evidence, golden output fixtures
            (the published expected outputs that conformance runs are compared against) checked
            against these standards, sits in the manifest renderer&rsquo;s
            <a href="https://github.com/registrystack/registry-stack/tree/main/crates/registry-manifest-core/tests/fixtures/golden">test fixtures</a> in the repo.
          </p>
        </div>
        <ul class="check-list">
          <li>Metadata: DCAT-AP, BRegDCAT-AP, CPSV-AP, ODRL: the vocabularies that describe a dataset, register, service, or usage policy.</li>
          <li>Shape: SHACL, JSON Schema, OpenAPI: the contracts that define what a valid record or response looks like.</li>
          <li>Evidence: CCCEV (JSON-LD), SD-JWT VC, OpenID4VCI: the formats a signed answer or wallet credential arrives in.</li>
          <li>Sector: SP-DCI, OGC API Records, OGC API Features, GovStack Digital Registries: the domain-specific patterns registries and geospatial services already follow.</li>
        </ul>
      </div>
    </section>
  </main>

  <DocsHandoff
    eyebrow="Read the docs"
    heading="See the integration patterns in detail."
    primaryLabel="Read the docs"
    emphasis="pilot"
  />
  <SiteFooter />
</Base>

<style>
  .neighbor-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .neighbor-card {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
    display: grid;
    gap: 12px;
    min-width: 0;
    padding: 22px;
  }

  .neighbor-card h3 {
    margin: 0;
  }

  .neighbor-examples {
    color: var(--registry-blue);
    font-family: var(--registry-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    margin: 0;
  }

  .lab-list {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0 0 24px;
    padding: 0;
  }

  .lab-list:last-child {
    margin-bottom: 0;
  }

  .lab-group-title {
    font-size: 18px;
    margin-bottom: 14px;
  }

  .tco-note {
    color: var(--registry-muted);
    font-size: 15px;
    line-height: 1.55;
    margin: clamp(20px, 3vw, 28px) 0 0;
    max-width: 760px;
  }

  .lab-entry {
    background: #ffffff;
    border: 1px solid var(--registry-rule);
    padding: 20px 22px;
  }

  .lab-entry dt {
    color: var(--registry-ink);
    font-family: var(--registry-mono);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .lab-entry dd {
    color: var(--registry-muted);
    font-size: 14px;
    line-height: 1.55;
    margin: 0;
  }

  .lab-entry code {
    display: inline;
    font-size: 13px;
    padding: 1px 4px;
  }

  @media (max-width: 900px) {
    .lab-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .lab-list {
      grid-template-columns: 1fr;
    }
  }

  .layered-note {
    color: var(--registry-muted);
    font-size: 15px;
    line-height: 1.55;
    margin: clamp(20px, 3vw, 28px) auto 0;
    max-width: 760px;
    text-align: center;
  }

  @media (max-width: 900px) {
    .neighbor-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .neighbor-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
