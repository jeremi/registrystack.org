---
// One page per starter. Every fact on the page comes from the catalogue
// entry in src/data/starters.json; the prose only explains what it means.
// The page presents record types, fields and roles in words, with the
// identifiers in technical details.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import StarterIncludes from '../../components/StarterIncludes.astro';
import StarterRequestForm from '../../components/StarterRequestForm.astro';
import StarterRecordType from '../../components/StarterRecordType.astro';
import StarterTechnical from '../../components/StarterTechnical.astro';
import { products } from '../../data/products';
import { describeServiceHref } from '../../data/contact';
import { areaForStarter, featuredStarterForArea, starterHoldsText, starterLead, starterRequestHref, starters, startersSource, type Starter } from '../../data/starters';
import { actionDescriptionWords, sourceHost, words } from '../../data/starter-words';
import { starterRequestEndpoint as parseStarterRequestEndpoint } from '../../lib/starter-request';

export function getStaticPaths() {
  return starters.map((starter) => ({ params: { id: starter.id }, props: { starter } }));
}

interface Props {
  starter: Starter;
}
const { starter } = Astro.props;

const area = areaForStarter(starter.id);
if (!area) throw new Error(`starter ${starter.id} is not assigned to a register family in solutions.ts`);
const featured = featuredStarterForArea(area)?.id === starter.id;
const baseRegistry = products.find((p) => p.key === 'base-registry')!;

// A starter is sent on request, free of charge, while its repository and
// release remain private.
const requestHref = starterRequestHref(starter.title);
const discussHref = describeServiceHref(starter.title);
const starterRequestEndpoint = parseStarterRequestEndpoint(import.meta.env.PUBLIC_STARTER_REQUEST_ENDPOINT, 'kiosk');
const starterRequestTrackedEndpoint = parseStarterRequestEndpoint(import.meta.env.PUBLIC_STARTER_REQUEST_TRACKED_ENDPOINT, 'consented');
if (starterRequestTrackedEndpoint && !starterRequestEndpoint) {
  throw new Error('A tracked starter form endpoint requires the kiosk endpoint.');
}
if (starterRequestEndpoint && starterRequestTrackedEndpoint) {
  const kioskUrl = new URL(starterRequestEndpoint);
  const trackedUrl = new URL(starterRequestTrackedEndpoint);
  if (kioskUrl.origin !== trackedUrl.origin ||
      kioskUrl.searchParams.get('formId') === trackedUrl.searchParams.get('formId')) {
    throw new Error('Starter form endpoints must share an origin and use distinct form IDs.');
  }
}
const requestFormEnabled = Boolean(starterRequestEndpoint);
const requestActionHref = requestFormEnabled ? '#starter-request-form' : requestHref;

const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
const list = (items: string[]) => items.join(', ');
const recordTypeLabel = (id: string) => starter.recordTypes.find((type) => type.id === id)?.label ?? id;
const actionLabel = (id: string) => starter.actions.find((action) => action.id === id)?.label ?? id;
const lead = starterLead(starter);
const holds = starterHoldsText(starter);
const requiredFields = starter.recordTypes.some((type) => type.fields.some((field) => field.required));
const allCreateOnly = starter.recordTypes.length > 0 && starter.recordTypes.every((type) => type.mutationMode === 'create-only');
const hasCreateOnly = starter.recordTypes.some((type) => type.mutationMode === 'create-only');
const sources = starter.sourceUrls.map((href) => {
  const url = new URL(href);
  const rest = `${url.pathname}${url.search}`;
  return { href, host: sourceHost(href), rest: rest === '/' ? '' : rest };
});

const pageTitle = `${starter.title} starter | Registry Stack`;
---

<Base title={pageTitle} description={lead}>
  <SiteHeader current="starters" />
  <main class="starter-page">
    <section class="hero" aria-labelledby="starter-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">
            <a href={area.slug}>{area.name}</a>
            {featured && <span class="starter-featured">Start here</span>}
          </p>
          <h1 id="starter-title">{starter.title}</h1>
          <p class="hero-lead">{lead}</p>
          <p class="hero-note starter-hero-terms">Free starting configuration. Access is available on request.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href="#whats-inside">What is included</a>
            <a class="button button-secondary" href={requestActionHref} data-journey="starter-request">Request access</a>
            <a class="button button-secondary" href={discussHref}>Discuss your service</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="records-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <h2 id="records-title">What it holds: <span class="starter-count">{plural(starter.counts.recordTypes, 'kind of record', 'kinds of record')}</span></h2>
          {holds && <p>{holds}</p>}
          <p>Each box is one kind of record the register keeps, with the fields an entry has.</p>
          {allCreateOnly ? (
            <p>These records are added once and cannot be edited in place. The record types and actions below show which later events the starter supports. Corrections or renewals not listed here need additional configuration.</p>
          ) : hasCreateOnly ? (
            <p>The labels below show which records can change and which are added once. A create-only record cannot be corrected in place. Check whether the starter includes separate correction or renewal records, and add them if your service requires them.</p>
          ) : (
            <p>The labels below show how each kind of record can change. Compare that model with the correction, renewal, and closure events your service must preserve.</p>
          )}
          <p class="starter-legend">Each kind of record carries a sensitivity label: Public; Staff only, for records kept inside the office; Restricted, for the most sensitive. A field carries its own label, shown in the technical details, which can differ from the record’s. “Who can do what” lists the kinds of record each role can see.</p>
        </div>
        <div class="starter-records">
          {starter.recordTypes.map((type) => <StarterRecordType type={type} recordTypeLabel={recordTypeLabel} />)}
        </div>
        {requiredFields && <p class="starter-legend"><span aria-hidden="true">*</span> A field every entry must have.</p>}
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="actions-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <h2 id="actions-title">What staff can do: <span class="starter-count">{starter.actions.length > 0 ? plural(starter.counts.actions, 'action', 'actions') : 'none defined yet'}</span></h2>
          {starter.actions.length > 0 ? (
            <p>Each action is one change staff make to the register. The register keeps who made it and when.</p>
          ) : (
            <p>This starter defines no actions yet. Your team must define the recording and change operations the service needs, including any correction or renewal process, and assign each operation to a role.</p>
          )}
        </div>
        {starter.actions.length > 0 && (
          <dl class="starter-actions">
            {starter.actions.map((action) => (
              <div>
                <dt>{action.label}</dt>
                <dd>
                  {actionDescriptionWords(action.description)}
                  {actionDescriptionWords(action.description) !== action.description && (
                    <StarterTechnical
                      label="catalogue wording"
                      items={[
                        { term: 'Action', value: action.id },
                        { term: 'Technical description', value: action.description },
                      ]}
                    />
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>

    <section class="section" aria-labelledby="access-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <h2 id="access-title">Who can do what: <span class="starter-count">{plural(starter.accessProfiles.length, 'role', 'roles')}</span></h2>
          <p>The starter sets out roles: what each may record and which records it may see. Your team decides which people and systems hold each role; one person can hold several, and a role named for a system, such as an evidence source, is held by that system.</p>
        </div>
        <div class="starter-roles">
          {starter.accessProfiles.map((profile) => (
            <article class="starter-role">
              <h3>{words(profile.id)}</h3>
              <dl>
                <dt>Can record</dt>
                <dd>{profile.actions.length > 0 ? list(profile.actions.map(actionLabel)) : starter.actions.length > 0 ? 'Nothing. This role only looks things up.' : 'No actions are defined yet. Its scopes are in the technical details.'}</dd>
                <dt>Can see</dt>
                <dd>{profile.recordTypes.length > 0 ? list(profile.recordTypes.map(recordTypeLabel)) : 'No records'}</dd>
              </dl>
              <StarterTechnical
                label="access profile, scopes and purposes"
                items={[
                  { term: 'Access profile', value: profile.id },
                  { term: 'Required scopes', value: profile.requiredScopes.length > 0 ? list(profile.requiredScopes) : 'none' },
                  { term: 'Required purposes', value: profile.requiredPurposes.length > 0 ? list(profile.requiredPurposes) : 'none' },
                ]}
              />
            </article>
          ))}
        </div>
      </div>
    </section>

    {sources.length > 0 && (
      <section class="section section-muted" aria-labelledby="sources-title">
        <div class="section-inner">
          <div class="section-heading compact">
            <h2 id="sources-title">Modeled on public registers</h2>
            <p>The record model was drawn from how these registers are kept in public. Using them as a model does not mean their operators use or endorse the starter.</p>
          </div>
          <ul class="starter-sources">
            {sources.map((source) => (
              <li>
                <a href={source.href} rel="noopener">{source.host}</a>
                {source.rest && <span class="starter-source-path">{source.rest}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="section" id="whats-inside" aria-labelledby="inside-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">Free of charge</p>
          <h2 id="inside-title">What is included</h2>
          <p>Request access to the model and configuration shown above. The core configuration defines records, actions, and access. Your technical team can adapt it and generate a registry project with the {baseRegistry.name} command-line tools.</p>
          <p>You can inspect the catalogue details without requesting access. If you are planning a wider service, discuss your requirements first and use the starter only if it is a useful technical starting point.</p>
        </div>
        <div class="starter-inside">
          <div>
            <h3>Parts of this starter</h3>
            <StarterIncludes includes={starter.includes} />
          </div>
          <div>
            <h3>Configuration values your team supplies</h3>
            <p>This starter declares {plural(starter.counts.values, 'configuration value', 'configuration values')}. Your team supplies values appropriate to the implementation; the technical details list the exact keys.</p>
            <h3>Core and optional definitions</h3>
            <p>The core configuration describes the registry itself. A staff-screen definition, when marked as included, is a separate description for an application to implement. It is not part of the registry runtime and is not a deployed staff application.</p>
            <h3>Review before implementation</h3>
            <p>Compare the model with your law, policy, forms, current data, staff responsibilities, and connected systems. Changes may involve more than adding fields or roles, and the starter does not supply migration, identity, integration, hosting, or operating procedures.</p>
            <p class="starter-request"><a class="button button-primary" href={requestActionHref} data-journey="starter-request">Request access</a></p>
            <p class="starter-legend">Access is free. There is no obligation to start an implementation.</p>
            <div class="starter-inside-technical">
              <StarterTechnical
                label="configuration values"
                items={[
                  { term: 'Values your team fills in', value: list(starter.valuesKeys) },
                ]}
              />
            </div>
          </div>
        </div>
        {requestFormEnabled && starterRequestEndpoint && (
          <StarterRequestForm
            endpoint={starterRequestEndpoint}
            trackedEndpoint={starterRequestTrackedEndpoint}
            starterId={starter.id}
            starterTitle={starter.title}
            sourcePage={`/starters/${starter.id}/`}
            requestType="starter"
            requestContext={starter.title}
          />
        )}
        <p class="starter-attribution">The record definitions draw on <a href={startersSource.publicschema.repository} rel="noopener">PublicSchema</a> {startersSource.publicschema.version}, available under the <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">Creative Commons Attribution 4.0 licence</a>. The starter configuration is provided under the Apache 2.0 licence.</p>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="next-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">Next steps</p>
          <h2 id="next-title">Where to go next.</h2>
        </div>
        <ul class="starter-next">
          <li><a class="inline-cta" href={area.slug}>See {area.name.toLowerCase()} <span aria-hidden="true">→</span></a></li>
          <li><a class="inline-cta" href={baseRegistry.href}>Read about {baseRegistry.name} <span aria-hidden="true">→</span></a></li>
          <li><a class="inline-cta" href={baseRegistry.tutorialHref}>{baseRegistry.tutorialLabel} <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </section>

    <DocsHandoff
      eyebrow="Discuss your service"
      heading="Start with your requirements."
      body="Describe the service, the register, and the systems involved. We can discuss whether this starter fits and what configuration, integration, and delivery work remains."
      primaryLabel="Describe your service"
      primaryHref={discussHref}
      emphasis="docs"
    />
  </main>
  <SiteFooter />
</Base>

<style>
  .starter-page .hero .eyebrow a {
    color: inherit;
    text-decoration: underline;
  }

  .starter-featured {
    background: var(--registry-brass);
    color: var(--registry-ink);
    font-family: var(--registry-mono);
    font-size: var(--type-2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-left: 10px;
    padding: 3px 7px;
    text-transform: uppercase;
    vertical-align: middle;
    white-space: nowrap;
  }

  .starter-page h2 {
    font-size: clamp(28px, 3.7vw, 42px);
  }

  .starter-count {
    color: var(--registry-blue);
    font-family: var(--registry-mono);
    font-size: var(--type-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: middle;
    white-space: nowrap;
  }

  .starter-hero-terms {
    margin: -12px 0 24px;
  }

  .starter-page .section-inner {
    padding-top: clamp(44px, 6vw, 68px);
    padding-bottom: clamp(44px, 6vw, 68px);
  }

  .starter-page h3 {
    font-size: var(--type-body);
  }

  .starter-records {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .starter-legend {
    color: var(--registry-muted);
    font-size: var(--type-sm);
    margin: 14px 0 0;
  }

  .starter-legend span {
    color: var(--registry-stamp);
    font-weight: 700;
  }

  .starter-actions {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .starter-actions > div {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    padding: 22px;
  }

  .starter-actions dt {
    color: var(--registry-ink);
    font-weight: 700;
    margin-bottom: 6px;
  }

  .starter-actions dd {
    margin: 0;
  }

  .starter-roles {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .starter-role {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .starter-role h3 {
    margin: 0;
    padding: 18px 18px 10px;
  }

  .starter-role dl {
    margin: 0;
    padding: 0 18px 14px;
  }

  .starter-role dt {
    color: var(--registry-muted);
    font-size: var(--type-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: 8px;
    text-transform: uppercase;
  }

  .starter-role dd {
    color: var(--registry-body);
    font-size: var(--type-md);
    margin: 2px 0 0;
  }

  .starter-role :global(.starter-technical) {
    border-top: 1px solid var(--registry-rule);
    margin-top: auto;
  }

  .starter-inside {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .starter-inside h3:not(:first-child) {
    margin-top: 28px;
  }

  .starter-sources {
    list-style: none;
    margin: 0;
    max-width: 760px;
    padding: 0;
  }

  .starter-sources li {
    border-bottom: 1px solid var(--registry-rule);
    padding: 10px 0;
  }

  .starter-sources li:first-child {
    border-top: 1px solid var(--registry-rule);
  }

  .starter-sources a {
    font-weight: 700;
    text-decoration: underline;
  }

  .starter-source-path {
    color: var(--registry-muted);
    display: block;
    font-size: var(--type-xs);
    overflow-wrap: anywhere;
  }

  .starter-inside-technical {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    margin-top: 16px;
  }

  .starter-request {
    margin: 18px 0 0;
  }

  .starter-attribution {
    border-top: 1px solid var(--registry-rule);
    color: var(--registry-body);
    font-size: var(--type-md);
    margin: 40px 0 0;
    max-width: 760px;
    padding-top: 20px;
  }

  .starter-next {
    display: grid;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 900px) {
    .starter-roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .starter-records,
    .starter-actions,
    .starter-roles,
    .starter-inside {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
