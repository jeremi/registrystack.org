---
// One page per starter. Every fact on the page comes from the catalogue
// entry in src/data/starters.json; the prose only explains what it means.
// The page reads the way Registry Studio shows a project: record types,
// fields and roles in words, with the identifiers in technical details.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import StarterIncludes from '../../components/StarterIncludes.astro';
import StarterRecordType from '../../components/StarterRecordType.astro';
import StarterTechnical from '../../components/StarterTechnical.astro';
import { products } from '../../data/products';
import { areaForStarter, featuredStarterForArea, starters, startersSource, type Starter } from '../../data/starters';
import { words } from '../../data/starter-words';

export function getStaticPaths() {
  return starters.map((starter) => ({ params: { id: starter.id }, props: { starter } }));
}

interface Props {
  starter: Starter;
}
const { starter } = Astro.props;

const area = areaForStarter(starter.id);
if (!area) throw new Error(`starter ${starter.id} is not assigned to a register family in solutions.ts`);
const featured = featuredStarterForArea(area)?.id === starter.id;
const baseRegistry = products.find((p) => p.key === 'base-registry')!;

// A starter is sent on request, free of charge, until the catalogue is
// published for download. The request asks for the register the office
// keeps, which is also how we learn what a starter lacks.
const requestFields = ['Organization', 'Your role', 'The register you keep', 'What this starter should cover that it does not'];
const requestHref = `mailto:contact@registrystack.org?subject=${encodeURIComponent(`Starter request: ${starter.title}`)}&body=${encodeURIComponent(
  [`Starter: ${starter.id}`, '', ...requestFields.map((field) => `${field}: `)].join('\n'),
)}`;

const plural = (count: number, one: string, many: string) => `${count} ${count === 1 ? one : many}`;
const list = (items: string[]) => items.join(', ');
const recordTypeLabel = (id: string) => starter.recordTypes.find((type) => type.id === id)?.label ?? id;
const actionLabel = (id: string) => starter.actions.find((action) => action.id === id)?.label ?? id;
const sizeKb = Math.round(starter.download.bytes / 1024);
const zipName = starter.download.path.split('/').pop();
const firstSentence = starter.task.split(/(?<=[.!?])\s+(?=[A-Z])/)[0];
const requiredFields = starter.recordTypes.some((type) => type.fields.some((field) => field.required));

const pageTitle = `${starter.title} starter | Registry Stack`;
---

<Base title={pageTitle} description={firstSentence}>
  <SiteHeader current="starters" />
  <main class="starter-page">
    <section class="hero" aria-labelledby="starter-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">
            <a href={area.slug}>{area.name}</a>
            {featured && <span class="starter-featured">Start here</span>}
          </p>
          <h1 id="starter-title">{starter.title}</h1>
          <p class="hero-lead">{starter.task}</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href={requestHref} data-journey="starter-request">Request the starter</a>
            <a class="button button-secondary" href="#whats-inside">What you receive</a>
          </div>
          <p class="hero-note">Free of charge, sent by email on request. A starter is a starting point: your team adds what its register needs, and the request is where you tell us what is missing.</p>
          {starter.summary !== starter.task && <p class="hero-note">{starter.summary}</p>}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="records-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">{plural(starter.counts.recordTypes, 'kind of record', 'kinds of record')}</p>
          <h2 id="records-title">What it holds</h2>
          <p>Each box is one kind of record the register keeps, with the fields an entry has. Some records are added once and never changed; later events, such as a renewal or a correction, are added as records of their own.</p>
        </div>
        <div class="starter-records">
          {starter.recordTypes.map((type) => <StarterRecordType type={type} recordTypeLabel={recordTypeLabel} />)}
        </div>
        {requiredFields && <p class="starter-legend"><span aria-hidden="true">*</span> A field every entry must have.</p>}
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="actions-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">{plural(starter.counts.actions, 'action', 'actions')}</p>
          <h2 id="actions-title">What staff can do</h2>
          <p>Each action is one change staff make to the register. The register keeps who made it and when.</p>
        </div>
        <dl class="starter-actions">
          {starter.actions.map((action) => (
            <div>
              <dt>{action.label}</dt>
              <dd>{action.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="section" aria-labelledby="access-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">{plural(starter.accessProfiles.length, 'role', 'roles')}</p>
          <h2 id="access-title">Who can do what</h2>
          <p>The starter sets out roles: what each may record and which records it may see. Your team decides which people and systems hold each role.</p>
        </div>
        <div class="starter-roles">
          {starter.accessProfiles.map((profile) => (
            <article class="starter-role">
              <h3>{words(profile.id)}</h3>
              <dl>
                <dt>Can record</dt>
                <dd>{profile.actions.length > 0 ? list(profile.actions.map(actionLabel)) : 'Nothing. This role only looks things up.'}</dd>
                <dt>Can see</dt>
                <dd>{profile.recordTypes.length > 0 ? list(profile.recordTypes.map(recordTypeLabel)) : 'No records'}</dd>
              </dl>
              <StarterTechnical
                items={[
                  { term: 'Access profile', value: profile.id },
                  { term: 'Required scopes', value: profile.requiredScopes.length > 0 ? list(profile.requiredScopes) : 'none' },
                  { term: 'Required purposes', value: profile.requiredPurposes.length > 0 ? list(profile.requiredPurposes) : 'none' },
                ]}
              />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-muted" id="whats-inside" aria-labelledby="inside-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">Free of charge</p>
          <h2 id="inside-title">What you receive</h2>
          <p>One zip file with the configuration above, sent by email when you request it. A developer turns it into a registry project with the {baseRegistry.name} command-line tools; nothing in it runs on its own.</p>
        </div>
        <div class="starter-inside">
          <div>
            <h3>Parts of this starter</h3>
            <StarterIncludes includes={starter.includes} variant="list" />
          </div>
          <div>
            <h3>Details your team fills in</h3>
            <p>The starter ships with example values for these; your team replaces them with its own.</p>
            <ul class="starter-values">
              {starter.valuesKeys.map((key) => <li>{words(key)}</li>)}
            </ul>
            <h3>Files in the zip</h3>
            <p>A README that says what the starter records and what it leaves to other systems, a description of the record model, the values file, the project files, and the Apache 2.0 licence, notice, and PublicSchema CC BY 4.0 licence files.</p>
            <h3>Not exactly your register?</h3>
            <p>No starter matches a register as it is kept. If yours needs a field, a kind of record or a role this one lacks, your team adds it after generating the project. Say what is missing when you request the starter; it is how the catalogue gets better.</p>
            <p class="starter-request"><a class="button button-primary" href={requestHref} data-journey="starter-request">Request the starter</a></p>
            <div class="starter-inside-technical">
              <StarterTechnical
                items={[
                  { term: 'File', value: `${zipName} (${sizeKb} KB), checksum confirms the file you receive` },
                  { term: 'SHA-256', value: starter.download.sha256 },
                  { term: 'Exported with', value: `${baseRegistry.name} ${startersSource.breg.version}, PublicSchema ${startersSource.publicschema.version}` },
                  { term: 'Values keys', value: list(starter.valuesKeys) },
                ]}
              />
            </div>
          </div>
        </div>
        <p class="starter-attribution">The record definitions draw on <a href={startersSource.publicschema.repository} rel="noopener">PublicSchema</a> {startersSource.publicschema.version}, published under the <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">Creative Commons Attribution 4.0 licence</a>. The starter itself is published under the Apache 2.0 licence.</p>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="next-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">Next steps</p>
          <h2 id="next-title">Where to go next.</h2>
        </div>
        <ul class="starter-next">
          <li><a class="inline-cta" href={area.slug}>See {area.name.toLowerCase()} <span aria-hidden="true">→</span></a></li>
          <li><a class="inline-cta" href={baseRegistry.href}>Read about {baseRegistry.name} <span aria-hidden="true">→</span></a></li>
          <li><a class="inline-cta" href={baseRegistry.tutorialHref}>{baseRegistry.tutorialLabel} <span aria-hidden="true">→</span></a></li>
        </ul>
      </div>
    </section>

    <DocsHandoff />
  </main>
  <SiteFooter />
</Base>

<style>
  .starter-page .hero .eyebrow a {
    color: inherit;
    text-decoration: underline;
  }

  .starter-featured {
    background: var(--registry-brass);
    color: var(--registry-ink);
    font-family: var(--registry-mono);
    font-size: var(--type-2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    margin-left: 10px;
    padding: 3px 7px;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .starter-page h2 {
    font-size: clamp(28px, 3.7vw, 42px);
  }

  .starter-page .section-inner {
    padding-top: clamp(44px, 6vw, 68px);
    padding-bottom: clamp(44px, 6vw, 68px);
  }

  .starter-page h3 {
    font-size: var(--type-body);
  }

  .starter-records {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .starter-legend {
    color: var(--registry-muted);
    font-size: var(--type-sm);
    margin: 14px 0 0;
  }

  .starter-legend span {
    color: var(--registry-stamp);
    font-weight: 700;
  }

  .starter-actions {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .starter-actions > div {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    padding: 22px;
  }

  .starter-actions dt {
    color: var(--registry-ink);
    font-weight: 700;
    margin-bottom: 6px;
  }

  .starter-actions dd {
    margin: 0;
  }

  .starter-roles {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .starter-role {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .starter-role h3 {
    margin: 0;
    padding: 18px 18px 10px;
  }

  .starter-role dl {
    margin: 0;
    padding: 0 18px 14px;
  }

  .starter-role dt {
    color: var(--registry-muted);
    font-size: var(--type-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    margin-top: 8px;
    text-transform: uppercase;
  }

  .starter-role dd {
    color: var(--registry-body);
    font-size: var(--type-md);
    margin: 2px 0 0;
  }

  .starter-role :global(.starter-technical) {
    border-top: 1px solid var(--registry-rule);
    margin-top: auto;
  }

  .starter-inside {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .starter-inside h3:not(:first-child) {
    margin-top: 28px;
  }

  .starter-values {
    border-left: 3px solid var(--registry-blue);
    font-size: var(--type-md);
    list-style: none;
    margin: 0;
    padding: 2px 0 2px 18px;
  }

  .starter-values li + li {
    margin-top: 4px;
  }

  .starter-inside-technical {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    margin-top: 16px;
  }

  .starter-request {
    margin: 18px 0 0;
  }

  .starter-attribution {
    border-top: 1px solid var(--registry-rule);
    color: var(--registry-body);
    font-size: var(--type-md);
    margin: 40px 0 0;
    max-width: 760px;
    padding-top: 20px;
  }

  .starter-next {
    display: grid;
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (max-width: 900px) {
    .starter-roles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .starter-records,
    .starter-actions,
    .starter-roles,
    .starter-inside {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
