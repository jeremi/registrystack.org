---
// The starters catalogue, grouped by register family in the order of
// solutions.ts. Everything a card states comes from the catalogue data.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import StarterCard from '../../components/StarterCard.astro';
import { registerFamilies } from '../../data/solutions';
import { products } from '../../data/products';
import { featuredStarterForArea, starterCount, startersForArea, startersSource } from '../../data/starters';

const baseRegistry = products.find((p) => p.key === 'base-registry')!;
const groups = registerFamilies.map((area) => ({ area, starters: startersForArea(area) }));
const featured = registerFamilies.flatMap((area) => {
  const starter = featuredStarterForArea(area);
  return starter ? [{ area, starter }] : [];
});

const pageTitle = 'Starters | Registry Stack';
const pageDescription = 'Starting configurations for common registers, grouped by the kind of register an organization keeps.';
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="starters" />
  <main>
    <section class="hero" aria-labelledby="starters-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Starters</p>
          <h1 id="starters-title">Start from a register like yours.</h1>
          <p class="hero-lead">A starter is a starting configuration for a common register. It sets out the records the register keeps, the actions staff take on them, and who may do what. Your team requests it, free of charge, fills in the details of its own jurisdiction, and adapts the rest. A starter is a starting point, not a running registry, and does not show that the register is in use anywhere.</p>
          <p class="hero-note">{starterCount} starters in {groups.length} register families. <a href="#start-here">Where to start</a>, or <a href="#whats-in-a-starter">what you receive</a>.</p>
        </div>
      </div>
    </section>

    <section class="section" id="start-here" aria-labelledby="start-here-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">Start here</p>
          <h2 id="start-here-title">The starters to open first.</h2>
          <p>Each is the register every office of its kind keeps, and the one its family page walks through. These are the starters we work on most. The rest of the catalogue are starting points for the registers around them, and some families have no single starter to open first.</p>
        </div>
        <div class="starter-grid">
          {featured.map(({ area, starter }) => <StarterCard starter={starter} featured eyebrow={area.name} />)}
        </div>
      </div>
    </section>

    {groups.map(({ area, starters }, index) => (
      <section class:list={['section', 'starter-family', { 'section-muted': index % 2 === 1 }]} id={area.key} aria-labelledby={`${area.key}-title`}>
        <div class="section-inner">
          <div class="section-heading compact">
            <p class="eyebrow">{starters.length === 1 ? '1 starter' : `${starters.length} starters`}</p>
            <h2 id={`${area.key}-title`}><a href={area.slug}>{area.name}</a></h2>
            <p>{area.intent}.</p>
          </div>
          <div class="starter-grid">
            {starters.map((starter) => <StarterCard starter={starter} featured={starter.id === area.featuredStarter} />)}
          </div>
        </div>
      </section>
    ))}

    <section class="section" id="whats-in-a-starter" aria-labelledby="starter-contents-title">
      <div class="section-inner starter-contents">
        <div class="section-heading compact">
          <p class="eyebrow">What you receive</p>
          <h2 id="starter-contents-title">A starting point your team generates and adapts.</h2>
          <p>Each starter is free. Request it from its page, with a word on the register you keep, and we send it by email as one zip file. The zip holds the configuration a developer turns into a registry project on their own machine. Nothing in it runs until your team generates the project and deploys it.</p>
          <p>No starter matches a register exactly as it is kept. Take the closest one, add the fields, kinds of record and roles yours needs, and tell us what was missing when you ask for it.</p>
        </div>
        <dl>
          <dt>In the zip</dt>
          <dd>A README that says what the starter records and what it leaves to other systems, a description of the record model, a values file with the details your team fills in, the project files, and the licence and notice files.</dd>
          <dt>To generate a project</dt>
          <dd>A developer generates the project with the {baseRegistry.name} command-line tools, the toolchain the {baseRegistry.name} tutorial sets up. The starters were exported against version {startersSource.breg.version}. <a href={baseRegistry.tutorialHref}>{baseRegistry.tutorialLabel}</a> to install the tools and create a first registry.</dd>
          <dt>Licences</dt>
          <dd>The starters are open source under the Apache 2.0 licence. The record definitions draw on <a href={startersSource.publicschema.repository}>PublicSchema</a> {startersSource.publicschema.version}, published under the Creative Commons Attribution 4.0 licence (CC BY 4.0). Each zip carries both licences.</dd>
        </dl>
      </div>
    </section>

    <DocsHandoff />
  </main>
  <SiteFooter />
</Base>

<style>
  .starter-family h2 a {
    color: inherit;
  }

  .starter-family h2 a:hover {
    color: var(--registry-blue);
  }

  .starter-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .starter-contents {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .starter-contents dl {
    margin: 0;
  }

  .starter-contents dt {
    color: var(--registry-ink);
    font-weight: 700;
    margin-bottom: 5px;
  }

  .starter-contents dd {
    border-bottom: 1px solid var(--registry-rule);
    line-height: 1.55;
    margin: 0 0 20px;
    padding-bottom: 18px;
  }

  .starter-contents dd:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .starter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .starter-grid,
    .starter-contents {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
