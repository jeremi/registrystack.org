---
// Keep useful category bookmarks; the marketplace owns configuration browsing.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import MarketplaceCatalogueRedirect from '../../components/MarketplaceCatalogueRedirect.astro';
import { registerFamilies } from '../../data/solutions';
import { describeServiceHref } from '../../data/contact';
import { MARKETPLACE_ORIGIN, marketplaceCollectionHref, marketplaceMigrationEnabled } from '../../lib/marketplace-routes.mjs';

const migrateStarters = marketplaceMigrationEnabled(process.env.PUBLIC_MARKETPLACE_MIGRATION_ENABLED, process.env.MARKETPLACE_INDEXING_DECISION);

const pageTitle = 'Starting configurations | Registry Stack';
const pageDescription = 'Browse starting configurations in the Registry Stack Marketplace, grouped by service area. Free access is available on request.';
const discussHref = describeServiceHref('a registry service');
---

{migrateStarters ? <MarketplaceCatalogueRedirect /> : <Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="starters" />
  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="starters-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Starting configurations</p>
          <h1 id="starters-title">Find a starting configuration in the marketplace.</h1>
          <p class="hero-lead">Browse models for public registers, see what each configuration contains and request free access. Choose a service area below, or describe your service to us first.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href={`${MARKETPLACE_ORIGIN}/`}>Open the marketplace</a>
            <a class="button button-secondary" href={discussHref}>Describe your service</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="configuration-areas-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <h2 id="configuration-areas-title">Browse by service area.</h2>
          <p>The marketplace holds the models, configuration details and access requests. A starting configuration needs to be adapted to your institution's rules, systems and service.</p>
        </div>
        <div class="configuration-areas">
          {registerFamilies.map((area) => (
            <article id={area.key} aria-labelledby={`${area.key}-title`}>
              <h3 id={`${area.key}-title`}>{area.name}</h3>
              <p>{area.intent}.</p>
              <a class="inline-cta" href={marketplaceCollectionHref(area.key)} aria-label={`Browse configurations for ${area.name.toLowerCase()}`}>Browse configurations <span aria-hidden="true">→</span></a>
              <a class="configuration-service-link" href={area.slug}>Explore the service area</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <DocsHandoff
      eyebrow="Discuss your service"
      heading="Begin with the service you need."
      body="You do not need to select a configuration before contacting us. Tell us who uses the service, what it needs to do and any systems it needs to connect."
      primaryLabel="Describe your service"
      primaryHref={discussHref}
      emphasis="docs"
    />
  </main>
  <SiteFooter />
</Base>}

<style>
  .configuration-areas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .configuration-areas article { border-top: 1px solid var(--registry-rule); padding-block: 24px; scroll-margin-top: 100px; }
  .configuration-areas h3 { margin-block: 0 12px; }
  .configuration-areas p { max-width: 58ch; }
  .configuration-service-link { display: block; width: fit-content; margin-top: 12px; }
  @media (max-width: 640px) { .configuration-areas { grid-template-columns: 1fr; } }
</style>
