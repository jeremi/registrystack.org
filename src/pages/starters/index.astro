---
// The starters catalogue, grouped by register family in the order of
// solutions.ts. Everything a card states comes from the catalogue data.
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import DocsHandoff from '../../components/DocsHandoff.astro';
import StarterCard from '../../components/StarterCard.astro';
import { registerFamilies } from '../../data/solutions';
import { products } from '../../data/products';
import { describeServiceHref } from '../../data/contact';
import { featuredStarterForArea, starterById, starterCount, starterRequestHref, startersForArea, startersSource } from '../../data/starters';

const baseRegistry = products.find((p) => p.key === 'base-registry')!;
const groups = registerFamilies.map((area) => ({ area, starters: startersForArea(area) }));
const featured = registerFamilies.flatMap((area) => {
  const starter = featuredStarterForArea(area);
  return starter ? [{ area, starter }] : [];
});

const pageTitle = 'Starters | Registry Stack';
const pageDescription = 'Browse examples of public registers and find a starting configuration to adapt. Configuration files are available free on request.';
const discussHref = describeServiceHref('a registry service');
const requestHref = starterRequestHref('a starter not selected yet');
---

<Base title={pageTitle} description={pageDescription}>
  <SiteHeader current="starters" />
  <main>
    <section class="hero" aria-labelledby="starters-title">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Starters</p>
          <h1 id="starters-title">Find a starting point for your register.</h1>
          <p class="hero-lead">Browse {starterCount} register examples, including professional licences, companies and land parcels. Each page describes a starting configuration and the records and staff actions it covers. Configuration files are available free on request.</p>
          <div class="hero-actions" aria-label="Primary actions">
            <a class="button button-primary" href={discussHref}>Discuss your service</a>
            <a class="button button-secondary" href={requestHref}>Request a starter</a>
          </div>
          <nav class="starter-contents-nav hero-note" aria-label="On this page">
            <p>On this page:</p>
            <ul>
              <li><a href="#start-here">Start here</a></li>
              {groups.map(({ area }) => <li><a href={`#${area.key}`}>{area.name}</a></li>)}
              <li><a href="#whats-in-a-starter">What you receive</a></li>
            </ul>
          </nav>
        </div>
      </div>
    </section>

    <section class="section" id="start-here" aria-labelledby="start-here-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <p class="eyebrow">Start here</p>
          <h2 id="start-here-title">Selected starting configurations.</h2>
          <p>Choose an example to read about the records, staff actions and access roles it covers.</p>
        </div>
        <div class="starter-grid">
          {featured.map(({ area, starter }) => <StarterCard starter={starter} featured eyebrow={area.name} />)}
        </div>
        <p class="starter-cards-legend">Each card names the starter and what it records. Some starters also come with parts the starter page lists: staff-screen definitions, an Evidence Gateway companion, client definitions, statistics, reusable modules.</p>
      </div>
    </section>

    {groups.map(({ area, starters }, index) => {
      const featuredStarter = featuredStarterForArea(area);
      const openFirst = (area.openFirst ?? []).flatMap((id) => { const starter = starterById(id); return starter ? [starter] : []; });
      const rest = starters.filter((starter) => starter.id !== featuredStarter?.id);
      return (
      <section class:list={['section', 'starter-family', { 'section-muted': index % 2 === 1 }]} id={area.key} aria-labelledby={`${area.key}-title`}>
        <div class="section-inner">
          <div class="section-heading compact">
            <p class="eyebrow">{starters.length === 1 ? '1 starter' : `${starters.length} starters`}</p>
            <h2 id={`${area.key}-title`}><a href={area.slug}>{area.name}</a></h2>
            <p>{area.intent}.</p>
            {featuredStarter && <p class="starter-open-first">Open first: <a href={`/starters/${featuredStarter.id}/`}>{featuredStarter.title}</a></p>}
            {!featuredStarter && openFirst.length > 0 && <p class="starter-open-first">Open first: {openFirst.map((starter, index) => <Fragment>{index > 0 && ", or "}<a href={`/starters/${starter.id}/`}>{starter.title}</a></Fragment>)}</p>}
          </div>
          {rest.length > 0 && (
            <div class="starter-grid">
              {rest.map((starter) => <StarterCard starter={starter} />)}
            </div>
          )}
        </div>
      </section>
      );
    })}

    <section class="section" id="whats-in-a-starter" aria-labelledby="starter-contents-title">
      <div class="section-inner starter-contents">
        <div class="section-heading compact">
          <p class="eyebrow">What you receive</p>
          <h2 id="starter-contents-title">A reviewed model and project configuration.</h2>
          <p>Each starter is free. Its page shows the available record types, actions, access roles, configuration values, and optional companion definitions. Request the configuration only when it is useful to your evaluation. You can also discuss the service you need before selecting a starter.</p>
          <p>The core registry configuration defines records, actions, and access. Some starters also have a separate staff-screen definition for an application to implement. Neither is a deployed service. Your institution still needs to review the model against its law, policy, operating process, identity system, existing data, integrations, screens, hosting, and support arrangements.</p>
          <p>The models draw on public registers that publish their structure. Those references are models, not customer examples or endorsements.</p>
        </div>
        <dl>
          <dt>Provided on request</dt>
          <dd>The registry model and configuration shown on the starter page, plus any companion definitions that page marks as included.</dd>
          <dt>To generate a project</dt>
          <dd>A developer generates the project with the {baseRegistry.name} command-line tools. <a href={baseRegistry.tutorialHref}>{baseRegistry.tutorialLabel}</a> to install the tools and create a first registry.</dd>
          <dt>Licences</dt>
          <dd>The starter configurations are provided under the Apache 2.0 licence. The record definitions draw on <a href={startersSource.publicschema.repository}>PublicSchema</a> {startersSource.publicschema.version}, available under the Creative Commons Attribution 4.0 licence (CC BY 4.0).</dd>
        </dl>
      </div>
    </section>

    <section class="section section-muted" aria-labelledby="project-status-title">
      <div class="section-inner">
        <div class="section-heading compact">
          <h2 id="project-status-title">Where the project stands</h2>
          <p>The Registry Stack source and software releases are public under Apache 2.0. The starter repository and release are not public yet, so the {starterCount} available configurations are provided on request. Registry Stack is pre-1.0: interfaces may change before 1.0, and the documentation keeps a list of <a href="https://docs.registrystack.org/explanation/known-limitations/">known limitations</a>.</p>
        </div>
      </div>
    </section>

    <DocsHandoff
      eyebrow="Discuss your service"
      heading="Discuss the register your service needs."
      body="Tell us about your service. We can help identify a starting point and discuss the changes, screens and system connections you need."
      primaryLabel="Describe your service"
      primaryHref={discussHref}
      emphasis="docs"
    />
  </main>
  <SiteFooter />
</Base>

<style>
  .starter-family h2 a {
    color: inherit;
  }

  .starter-family h2 a:hover {
    color: var(--registry-blue);
  }

  .starter-contents-nav p {
    margin: 0 0 4px;
  }

  .starter-contents-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .starter-cards-legend {
    border-top: 1px solid var(--registry-rule);
    color: var(--registry-muted);
    font-size: var(--type-sm);
    margin: 32px 0 0;
    padding-top: 14px;
  }

  .starter-open-first a {
    font-weight: 700;
    text-decoration: underline;
  }

  .starter-version {
    padding-top: 0;
  }

  .starter-version summary {
    color: var(--registry-muted);
    cursor: pointer;
    font-family: var(--registry-mono);
    font-size: var(--type-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .starter-version p {
    margin: 10px 0 0;
    max-width: 760px;
  }

  .starter-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .starter-contents {
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }

  .starter-contents dl {
    margin: 0;
  }

  .starter-contents dt {
    color: var(--registry-ink);
    font-weight: 700;
    margin-bottom: 5px;
  }

  .starter-contents dd {
    border-bottom: 1px solid var(--registry-rule);
    line-height: 1.55;
    margin: 0 0 20px;
    padding-bottom: 18px;
  }

  .starter-contents dd:last-child {
    margin-bottom: 0;
  }

  @media (max-width: 900px) {
    .starter-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .starter-grid,
    .starter-contents {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
