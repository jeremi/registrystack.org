---
// The home page's story: one licence correction, from request to a
// signed answer. The same story is the brief for the home page video. The
// figure itself is RegisterWeek, which every register family page also uses.
import RegisterWeek from './RegisterWeek.astro';
import type { WeekStep } from '../data/register-week';

const steps: WeekStep[] = [
  {
    when: 'Tuesday 09:14',
    product: 'Your application',
    title: 'A request arrives',
    text: 'A licence holder asks the board to correct the scope of practice on their licence. The register does not change until an officer decides.',
    card: { kind: 'record', recordType: 'Correction request', recordId: 'REQ-3106', icon: 'data', fields: [
      { label: 'Licence', value: 'LIC-4471' },
      { label: 'Requested change', value: 'Scope of practice' },
      { label: 'Submitted by', value: 'Licence holder' },
    ] },
  },
  {
    when: 'Tuesday to Wednesday',
    product: 'Registry Casework',
    title: 'An officer decides',
    text: 'The request lands in the licence corrections queue. R. Adeyemi takes it, asks for the missing certificate, and approves the correction inside the board&rsquo;s 48-hour target.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Routed to Licence corrections' },
      { state: 'Claimed', note: 'Held by R. Adeyemi' },
      { state: 'Waiting', note: 'Certificate requested from the applicant' },
      { state: 'Approved', note: 'Wednesday 10:02' },
    ] },
  },
  {
    when: 'Wednesday 10:02',
    product: 'Base Registry Engine',
    title: 'The record changes and keeps its history',
    text: 'The officer applies the approved change under their own account. The register records revision 12 against their name, and revision 11 stays readable.',
    card: { kind: 'record', recordType: 'Licence record', recordId: 'LIC-4471', icon: 'person', fields: [
      { label: 'Scope of practice', value: 'Corrected' },
      { label: 'Changed by', value: 'R. Adeyemi' },
      { label: 'Revision', value: '12' },
    ] },
  },
  {
    when: 'Wednesday 10:20',
    product: 'Evidence Gateway',
    title: 'Another service asks, and gets a signed answer',
    text: 'Twenty minutes later a procurement service asks whether the licence is in good standing. It receives a signed yes. The licence file, the correction, and the holder&rsquo;s details stay in the register.',
    card: { kind: 'answer', fieldLabel: 'Licence in good standing', value: 'Yes', recipient: 'Procurement service', issuer: 'Licensing board' },
  },
];
---

<RegisterWeek
  id="register-day"
  kicker="One licence, one request"
  heading="A correction arrives on Tuesday. An officer decides on Wednesday, and twenty minutes later another service can rely on it."
  steps={steps}
/>
