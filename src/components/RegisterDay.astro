---
// Illustrative licensing journey. A review decision and the authorized
// register change are separate steps; the illustration does not imply timing.
import RegisterWeek from './RegisterWeek.astro';
import type { WeekStep } from '../data/register-week';

const steps: WeekStep[] = [
  {
    when: 'Request',
    product: 'Applicant service',
    title: 'A request arrives',
    text: 'A licence holder asks the board to correct the scope of practice on their licence. The register does not change until an officer decides.',
    card: { kind: 'record', recordType: 'Correction request', recordId: 'REQ-3106', icon: 'data', fields: [
      { label: 'Licence', value: 'LIC-4471' },
      { label: 'Requested change', value: 'Scope of practice' },
      { label: 'Submitted by', value: 'Licence holder' },
    ] },
  },
  {
    when: 'Review',
    product: 'Registry Casework',
    title: 'An officer decides',
    text: 'An officer takes responsibility for the request, checks the submitted documents and records the review decision.',
    card: { kind: 'history', items: [
      { state: 'Received', note: 'Licence correction requested' },
      { state: 'Assigned', note: 'R. Adeyemi reviews the request' },
      { state: 'Evidence checked', note: 'Submitted certificate reviewed' },
      { state: 'Approved', note: 'Decision and reason recorded' },
    ] },
  },
  {
    when: 'Update',
    product: 'Base Registry Engine',
    title: 'The record changes and keeps its history',
    text: 'An authorized officer applies the approved correction. The register records who changed the licence and retains the previous version.',
    card: { kind: 'record', recordType: 'Licence record', recordId: 'LIC-4471', icon: 'person', fields: [
      { label: 'Scope of practice', value: 'Corrected' },
      { label: 'Changed by', value: 'R. Adeyemi' },
      { label: 'Revision', value: '12' },
    ] },
  },
  {
    when: 'Check',
    product: 'Evidence Gateway',
    title: 'A connected service checks the licence',
    text: 'An authorized procurement service asks whether the licence is in good standing. It receives the answer, digitally signed by the board, without receiving the full licence file.',
    card: { kind: 'answer', fieldLabel: 'Licence in good standing', value: 'Yes', recipient: 'Procurement service', issuer: 'Licensing board' },
  },
];
---

<RegisterWeek
  id="register-day"
  kicker="One licence, one request"
  heading="Follow a licence correction from request to updated record."
  steps={steps}
/>
