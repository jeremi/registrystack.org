---
// The optional parts a starter ships with, read from the catalogue's
// `includes` flags: every part, with whether this starter includes it.
import type { Starter } from '../data/starters';

interface Props {
  includes: Starter['includes'];
}
const { includes } = Astro.props;

const parts: { key: keyof Starter['includes']; label: string; meaning: string }[] = [
  { key: 'staffUi', label: 'Staff screens', meaning: 'A model of the staff screens, for the App Kit.' },
  { key: 'evidenceCompanion', label: 'Evidence Gateway companion', meaning: 'A companion project for Evidence Gateway.' },
  { key: 'clients', label: 'Client definitions', meaning: 'Definitions of the client systems that call the registry.' },
  { key: 'statistics', label: 'Statistics', meaning: 'Definitions of statistical datasets drawn from the records.' },
  { key: 'modules', label: 'Reusable modules', meaning: 'Modules the project shares with other projects.' },
];
---
<p class="starter-includes-head"><span>Part</span><span>In this starter</span></p>
<dl class="starter-includes">
  {parts.map((part) => (
    <div class:list={['starter-include', { 'is-included': includes[part.key] }]}>
      <dt>
        {part.label}
        <span class="starter-include-state">{includes[part.key] ? 'Included' : 'Not included'}</span>
      </dt>
      <dd>{part.meaning}</dd>
    </div>
  ))}
</dl>

<style>
  .starter-includes-head {
    color: var(--registry-muted);
    display: flex;
    font-family: var(--registry-mono);
    font-size: var(--type-2xs);
    font-weight: 600;
    justify-content: space-between;
    letter-spacing: 0.06em;
    margin: 0 0 6px;
    text-transform: uppercase;
  }

  .starter-includes {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .starter-include {
    border-bottom: 1px solid var(--registry-rule);
    padding: 12px 0;
  }

  .starter-include:first-child {
    border-top: 2px solid var(--registry-ink);
  }

  .starter-include dt {
    align-items: baseline;
    color: var(--registry-muted);
    display: flex;
    flex-wrap: wrap;
    font-weight: 700;
    gap: 6px 12px;
    justify-content: space-between;
  }

  .starter-include.is-included dt {
    color: var(--registry-ink);
  }

  .starter-include-state {
    font-size: var(--type-sm);
    font-weight: 600;
  }

  .starter-include.is-included .starter-include-state {
    color: var(--registry-blue);
  }

  .starter-include dd {
    color: var(--registry-body);
    margin: 4px 0 0;
  }
</style>
