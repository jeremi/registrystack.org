---
import RecordCard from './RecordCard.astro';
import SignedAnswer from './SignedAnswer.astro';

const sourceFields = [
  { label: 'Registration status', value: 'Active' },
  { label: 'Registered address', value: '12 Market Road' },
  { label: 'Filing history', value: '4 filings' },
];
---

<figure class="evidence-flow" aria-labelledby="evidence-flow-title">
  <figcaption id="evidence-flow-title">Illustrative example with a fictional business registration</figcaption>

  <section class="request-strip" aria-labelledby="request-title">
    <div class="request-origin">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="m3 8 9-5 9 5M4 9h16M5 20h14M7 10v7m5-7v7m5-7v7" />
      </svg>
      <p class="flow-label">Procurement service</p>
    </div>
    <h3 id="request-title">Is this business actively registered?</h3>
    <span class="request-reference">A-1042</span>
  </section>

  <div class="request-path">
    <section class="source-step" aria-labelledby="evidence-source-title">
      <div class="panel-heading">
        <p class="flow-label">Kept by the business registry</p>
        <h3 id="evidence-source-title">Source record</h3>
      </div>
      <RecordCard recordType="Business registration" recordId="A-1042" icon="business" fields={sourceFields} />
      <p class="source-note">The registry continues to maintain these fields.</p>
    </section>

    <section class="authority-step" aria-labelledby="authority-title">
      <p class="flow-label">Evidence Gateway</p>
      <h3 id="authority-title">A defined answer</h3>
      <svg class="evidence-arrow" viewBox="0 0 120 32" fill="none" aria-hidden="true">
        <path d="M1 16h114m-11-11 11 11-11 11" />
      </svg>
      <p>Checks permission.<br />Derives and signs the status.</p>
    </section>

    <section class="answer-step" aria-labelledby="answer-title">
      <div class="panel-heading">
        <p class="flow-label">Returned to the service</p>
        <h3 id="answer-title">Signed answer</h3>
      </div>
      <SignedAnswer fieldLabel="Registration status" value="Active" recipient="Procurement service" issuer="Business registry" />
      <p class="verification-note">The service checks the issuer, signature, and validity dates before use.</p>
    </section>
  </div>

  <div class="flow-caption">
    <p><strong>Kept at source</strong> Address, filing history, and other source fields.</p>
    <p><strong>Audit</strong> The request and its outcome are recorded.</p>
  </div>
</figure>

<style>
  .evidence-flow { margin: 0; }
  figcaption { color: var(--registry-muted); font-size: 13px; margin-bottom: 18px; }
  .request-strip { align-items: center; background: var(--registry-active); border: 1px solid #c4d2e9; display: flex; flex-wrap: wrap; gap: 14px 24px; padding: 19px 22px; }
  .request-origin { align-items: center; display: flex; gap: 10px; }
  .request-origin svg { color: var(--registry-blue); flex: 0 0 auto; height: 26px; stroke: currentColor; stroke-width: 1.5; width: 26px; }
  .flow-label { color: var(--registry-blue); font: 11px/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .request-strip h3 { flex: 1 1 300px; font-size: 18px; line-height: 1.4; margin: 0; }
  .request-reference { color: var(--registry-blue); font: 13px var(--registry-mono); }
  .request-path { align-items: start; display: grid; gap: clamp(18px, 2.5vw, 30px); grid-template-columns: minmax(0, 1.15fr) minmax(140px, 0.5fr) minmax(0, 1fr); padding: 28px 0 0; }
  .source-step, .answer-step { min-width: 0; }
  .panel-heading { margin-bottom: 13px; }
  .panel-heading h3 { font-size: 20px; line-height: 1.3; margin: 5px 0 0; }
  .source-note, .verification-note { color: var(--registry-muted); font-size: 13px; line-height: 1.5; margin: 14px 0 0; }
  .authority-step { align-self: center; padding: 20px 0; text-align: center; }
  .authority-step h3 { font-size: 17px; line-height: 1.35; margin: 7px 0 15px; }
  .evidence-arrow { color: var(--registry-blue); display: block; height: 32px; margin: 0 auto 14px; max-width: 120px; stroke: currentColor; stroke-width: 1.5; width: 100%; }
  .authority-step > p:last-child { color: var(--registry-muted); font-size: 13px; line-height: 1.65; margin: 0; }
  .flow-caption { border-top: 1px solid #d7ddd5; display: flex; flex-wrap: wrap; gap: 12px 28px; justify-content: space-between; margin-top: 24px; padding-top: 16px; }
  .flow-caption p { color: var(--registry-muted); font-size: 13px; line-height: 1.5; margin: 0; }
  .flow-caption strong { color: var(--registry-body); font-weight: 600; margin-right: 7px; }
  @media (max-width: 800px) {
    .request-path { gap: 20px; grid-template-columns: minmax(0, 1fr); }
    .request-strip { align-items: start; gap: 9px 16px; padding: 18px; }
    .request-origin { flex: 1 1 auto; }
    .request-strip h3 { flex-basis: 100%; order: 1; }
    .authority-step { align-items: center; background: var(--registry-active); display: grid; gap: 5px 18px; grid-template-columns: 1fr auto; padding: 16px 20px; text-align: left; }
    .authority-step .flow-label, .authority-step h3, .authority-step > p:last-child { grid-column: 1; }
    .authority-step h3 { margin: 0; }
    .authority-step > p:last-child { font-size: 12px; }
    .evidence-arrow { grid-column: 2; grid-row: 1 / 4; height: 32px; margin: 0; transform: rotate(90deg); width: 46px; }
  }
</style>
