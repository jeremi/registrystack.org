---
import { products } from '../data/products';
import { solutionAreas } from '../data/solutions';
import { askQuestionHref, contactEmail } from '../data/contact';
import { marketingTrackingUrl } from '../lib/marketing-tracking';
const year = new Date().getFullYear();
const repoHref = 'https://github.com/registrystack/registry-stack';
const trackingPreferencesAvailable = Boolean(
  marketingTrackingUrl(import.meta.env.PUBLIC_MAUTIC_URL),
);
const registerFamilies = solutionAreas.filter((area) => area.kind === 'register-family');
const crossCutting = solutionAreas.filter((area) => area.kind === 'cross-cutting');
// The flagship products lead the column, as they do in the header menu.
const productEntries = [...products].sort((a, b) => Number(b.featured) - Number(a.featured));
// An entry with `heading` instead of `href` is a sub-label over the entries
// that follow it in the column.
type FooterEntry = { href: string; label: string } | { heading: string };
const columns: { title: string; links: FooterEntry[] }[] = [
  { title: 'Solutions', links: [
    { href: '/solutions/', label: 'All solutions' },
    ...registerFamilies.map((area) => ({ href: area.slug, label: area.name })),
    { heading: 'Shared capabilities' },
    ...crossCutting.map((area) => ({ href: area.slug, label: area.name })),
  ] },
  { title: 'Products', links: productEntries.map((product) => ({ href: product.href, label: product.name })) },
  { title: 'Explore', links: [
    { href: '/starters/', label: 'Starting configurations' },
    { href: '/customization/', label: 'AI-assisted customization' },
    { href: '/digital-public-infrastructure/', label: 'Digital public infrastructure' },
    { href: '/blog/', label: 'Blog' },
    { href: '/security/', label: 'Security' },
    { href: '/faq/', label: 'FAQ' },
  ] },
  { title: 'For developers', links: [
    { href: '/#developers', label: 'Try a tutorial' },
    { href: 'https://docs.registrystack.org/', label: 'Documentation' },
    { href: repoHref, label: 'Source and releases' },
  ] },
  { title: 'Work with us', links: [
    { href: '/pricing/', label: 'Implementation pilots' },
    { href: '/pricing/#support', label: 'Support contracts' },
    { href: '/pricing/#inquiry', label: 'Discuss your needs' },
    { href: askQuestionHref(), label: 'Ask a question' },
    { href: `mailto:${contactEmail}`, label: contactEmail },
  ] },
];
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-brand">
      <a class="footer-brand-name" href="/">Registry Stack</a>
      <p>Public registers and services for national, regional and local government.</p>
      <p>Built and supported by Aubex.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      {columns.map((column) => (
        <div class="footer-col">
          <p class="footer-col-title">{column.title}</p>
          <ul>{column.links.map((link) => 'heading' in link
            ? <li class="footer-col-label">{link.heading}</li>
            : <li><a href={link.href}>{link.label}</a></li>)}</ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="site-footer-base">
    <p>&copy; {year} Aubex Consulting LLC. Core software: Apache-2.0.</p>
    <p>
      <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/imprint/">Legal notice</a>
      {trackingPreferencesAvailable && (
        <span data-tracking-preferences-control hidden>
          {' · '}
          <button class="footer-tracking-preferences" type="button" data-tracking-preferences-open>
            Tracking preferences
          </button>
        </span>
      )}
    </p>
  </div>
</footer>

<style>
  .footer-tracking-preferences {
    appearance: none;
    background: none;
    border: 0;
    color: rgba(255, 255, 255, 0.78);
    cursor: pointer;
    font-weight: 700;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-tracking-preferences:hover {
    color: var(--registry-white);
  }
</style>
