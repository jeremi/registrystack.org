---
import { products } from '../data/products';
import { solutionAreas } from '../data/solutions';
const year = new Date().getFullYear();
const repoHref = 'https://github.com/registrystack/registry-stack';
const registerFamilies = solutionAreas.filter((area) => area.kind === 'register-family');
const crossCutting = solutionAreas.filter((area) => area.kind === 'cross-cutting');
// The flagship products lead the column, as they do in the header menu.
const productEntries = [...products].sort((a, b) => Number(b.featured) - Number(a.featured));
const columns = [
  { title: 'Solutions', links: registerFamilies.map((area) => ({ href: area.slug, label: area.name })) },
  { title: 'Products', links: productEntries.map((product) => ({ href: product.href, label: product.name })) },
  { title: 'Explore', links: [
    { href: '/starters/', label: 'Starters' },
    ...crossCutting.map((area) => ({ href: area.slug, label: area.name })),
    { href: '/blog/', label: 'Blog' },
    { href: '/security/', label: 'Security' },
    { href: '/faq/', label: 'FAQ' },
  ] },
  { title: 'For developers', links: [
    { href: '/#developers', label: 'Try a tutorial' },
    { href: 'https://docs.registrystack.org/', label: 'Documentation' },
    { href: repoHref, label: 'Source and releases' },
  ] },
  { title: 'Work with us', links: [
    { href: '/pricing/', label: 'Implementation pilots' },
    { href: '/pricing/#support', label: 'Support contracts' },
    { href: '/pricing/#inquiry', label: 'Discuss your needs' },
  ] },
];
---
<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-brand">
      <a class="footer-brand-name" href="/">Registry Stack</a>
      <p>Open-source building blocks for registries and the services that use them.</p>
      <p>Built and supported by Aubex.</p>
    </div>
    <nav class="footer-nav" aria-label="Footer">
      {columns.map((column) => (
        <div class="footer-col">
          <p class="footer-col-title">{column.title}</p>
          <ul>{column.links.map((link) => (<li><a href={link.href}>{link.label}</a></li>))}</ul>
        </div>
      ))}
    </nav>
  </div>
  <div class="site-footer-base">
    <p>&copy; {year} Aubex Consulting LLC. Apache-2.0 open source.</p>
    <p><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/imprint/">Legal notice</a></p>
  </div>
</footer>
