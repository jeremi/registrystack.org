---
interface Props {
  mauticUrl: string;
  canonicalUrl: string;
}

const { mauticUrl, canonicalUrl } = Astro.props;
---

<aside
  class="tracking-preferences"
  data-tracking-preferences
  data-mautic-url={mauticUrl}
  data-canonical-url={canonicalUrl}
  aria-labelledby="tracking-preferences-title"
  hidden
>
  <div class="tracking-preferences-copy">
    <h2 id="tracking-preferences-title" tabindex="-1">Cookies on Registry Stack</h2>
    <p>
      We use optional cookies to understand how you use our website and documentation.
      If you contact us, we may link this activity to your enquiry. You can change your choice at any time.
      <a href="/privacy/">Privacy policy</a>.
    </p>
    <p data-tracking-signal hidden>
      Your browser is asking sites not to track you, so tracking stays off.
    </p>
    <p class="tracking-preferences-error" data-tracking-error role="alert" hidden>
      Shared tracking is unavailable. Tracking remains off on this page. You can still send a request.
    </p>
  </div>
  <div class="tracking-preferences-actions">
    <button class="tracking-choice" type="button" data-tracking-accept>Accept optional cookies</button>
    <button class="tracking-choice" type="button" data-tracking-reject>Reject optional cookies</button>
  </div>
</aside>

<script>
  import {
    buildMauticPageview,
    getSharedTrackingClient,
    trackingDeniedByBrowser,
    trackingFailureReason,
  } from '../lib/shared-tracking-client.mjs';

  const panel = document.querySelector<HTMLElement>('[data-tracking-preferences]');
  const acceptButton = panel?.querySelector<HTMLButtonElement>('[data-tracking-accept]');
  const rejectButton = panel?.querySelector<HTMLButtonElement>('[data-tracking-reject]');
  const signalMessage = panel?.querySelector<HTMLElement>('[data-tracking-signal]');
  const errorMessage = panel?.querySelector<HTMLElement>('[data-tracking-error]');
  const title = panel?.querySelector<HTMLElement>('#tracking-preferences-title');

  if (panel && acceptButton && rejectButton && signalMessage && errorMessage) {
    const mauticUrl = panel.dataset.mauticUrl;
    const canonicalUrl = panel.dataset.canonicalUrl;
    if (!mauticUrl || !canonicalUrl) throw new Error('Tracking preferences are missing their configuration.');

    const pageview = buildMauticPageview({
      canonicalUrl,
      pageTitle: document.title,
      currentUrl: window.location.href,
      referrer: document.referrer,
    });
    const browserDeniesTracking = trackingDeniedByBrowser();
    const openPreferences = (moveFocus = false) => {
      signalMessage.hidden = !browserDeniesTracking;
      acceptButton.disabled = browserDeniesTracking;
      panel.hidden = false;
      if (moveFocus) title?.focus();
    };
    const closePreferences = () => {
      panel.hidden = true;
    };
    const showError = (error?: unknown) => {
      openPreferences();
      errorMessage.hidden = false;
      errorMessage.dataset.trackingFailure = trackingFailureReason(error);
      if (client.readRetryReason) panel.dataset.trackingReadRetry = client.readRetryReason;
    };
    // Retain attempts after ambiguous delivery so recovery cannot count a visit twice.
    let attemptedGeneration: string | null = null;
    const client = getSharedTrackingClient({ onFailure: showError });
    const renderState = (state: typeof client.state, confirmed = false) => {
      if (client.readRetryReason) panel.dataset.trackingReadRetry = client.readRetryReason;
      if (confirmed) {
        errorMessage.hidden = true;
        delete errorMessage.dataset.trackingFailure;
      }
      if (state.choice === 'accepted' && !browserDeniesTracking) {
        closePreferences();
        if (state.generation !== attemptedGeneration) {
          const generation = state.generation;
          attemptedGeneration = generation;
          void client.pageview(pageview).catch((error: unknown) => {
            if (client.state.choice === 'accepted' && client.state.generation === generation) showError(error);
          });
        }
      } else if (state.choice === null && !browserDeniesTracking) {
        openPreferences();
      } else {
        closePreferences();
      }
    };
    client.subscribe(renderState);

    for (const control of document.querySelectorAll<HTMLElement>('[data-tracking-preferences-open]')) {
      const container = control.closest<HTMLElement>('[data-tracking-preferences-control]');
      if (container) container.hidden = false;
      control.addEventListener('click', () => openPreferences(true));
    }

    acceptButton.addEventListener('click', async () => {
      errorMessage.hidden = true;
      if (browserDeniesTracking) {
        showError();
        return;
      }
      try {
        renderState(await client.choose('accepted'));
      } catch (error) {
        showError(error);
        return;
      }
    });

    rejectButton.addEventListener('click', async () => {
      errorMessage.hidden = true;
      try {
        renderState(await client.choose('rejected'));
      } catch (error) {
        showError(error);
        return;
      }
    });
    void client.read().then(renderState).catch(showError);
  }
</script>

<style>
  .tracking-preferences {
    align-items: end;
    background: var(--registry-white);
    border: 2px solid var(--registry-ink);
    bottom: 16px;
    box-shadow: var(--offset-md);
    display: grid;
    gap: 18px;
    grid-template-columns: minmax(0, 1fr) auto;
    left: 50%;
    max-width: min(860px, calc(100vw - 32px));
    padding: 20px;
    position: fixed;
    transform: translateX(-50%);
    width: 100%;
    z-index: 40;
  }

  .tracking-preferences[hidden] {
    display: none;
  }

  .tracking-preferences-copy h2 {
    color: var(--registry-ink);
    font-size: var(--type-body);
    margin: 0 0 6px;
  }

  .tracking-preferences-copy p {
    font-size: var(--type-sm);
    line-height: 1.55;
    margin: 0;
    max-width: 640px;
  }

  .tracking-preferences-copy p + p {
    margin-top: 8px;
  }

  .tracking-preferences-error {
    color: var(--registry-stamp);
    font-weight: 700;
  }

  .tracking-preferences-actions {
    display: grid;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(140px, 1fr));
  }

  .tracking-choice {
    background: var(--registry-white);
    border: 2px solid var(--registry-blue);
    color: var(--registry-blue);
    cursor: pointer;
    font-weight: 700;
    min-height: 44px;
    padding: 8px 14px;
  }

  .tracking-choice:hover:not(:disabled) {
    background: var(--registry-active);
  }

  .tracking-choice:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  @media (max-width: 720px) {
    .tracking-preferences {
      align-items: stretch;
      bottom: 8px;
      gap: 14px;
      grid-template-columns: 1fr;
      max-width: calc(100vw - 16px);
      padding: 16px;
    }
  }

  @media (max-width: 420px) {
    .tracking-preferences-actions {
      grid-template-columns: 1fr;
    }
  }
</style>
