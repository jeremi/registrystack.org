---
// Shared top navigation for every marketing page. Marketing is organized by
// the outcomes a team needs; product implementation detail lives in the docs.
import { products } from '../data/products';
const { current } = Astro.props;
const solutions = products.filter((product) => product.featured).map((product) => ({
  ...product, label: product.name, blurb: product.intent,
}));

const links = [
  { href: '/use-cases/', label: 'Use cases', key: 'use-cases' },
  { href: '/pricing/', label: 'Pricing', key: 'pricing' },
];

const onSolutionPage = products.some((product) => product.key === current);
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Registry Stack home">
    <span class="brand-mark" aria-hidden="true">RS</span>
    <span>Registry Stack</span>
  </a>
  <nav class="top-nav" aria-label="Main navigation">
    <details class="nav-group">
      <summary aria-current={onSolutionPage ? 'page' : undefined}>Solutions</summary>
      <div class="nav-group-panel">
        {solutions.map((solution) => (
          <a href={solution.href} aria-current={current === solution.key ? 'page' : undefined}>
            <span class="nav-entry-name">{solution.label}</span>
            <span class="nav-entry-blurb">{solution.blurb}</span>
          </a>
        ))}
      </div>
    </details>
    {links.map((link) => (
      <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label}</a>
    ))}
    <a href="https://docs.registrystack.org/">Docs</a>
    <a class="nav-emphasis" href="/#developers">For developers</a>
  </nav>
</header>
