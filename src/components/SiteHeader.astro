---
// Shared top navigation for every marketing page. Marketing is organized by
// the register a team keeps, then the products; implementation detail lives
// in the docs.
import { products } from '../data/products';
import { solutionAreas } from '../data/solutions';
const { current } = Astro.props;
const registerFamilies = solutionAreas.filter((area) => area.kind === 'register-family');
const crossCutting = solutionAreas.filter((area) => area.kind === 'cross-cutting');

const links = [
  { href: '/customization/', label: 'Customization', key: 'customization' },
  { href: '/pricing/', label: 'Pricing', key: 'pricing' },
];
const evaluationLinks = [
  { href: '/starters/', label: 'Starting configurations', key: 'starters' },
  { href: '/#developers', label: 'Developer tutorials', key: 'developers' },
  { href: 'https://docs.registrystack.org/', label: 'Documentation', key: 'docs' },
];

const onSolutionPage = current === 'solutions' || current === 'local-government' || solutionAreas.some((area) => area.key === current);
const onProductPage = current === 'starters' || products.some((product) => product.key === current);
// The flagship products lead the menu; the data order is otherwise kept.
const productEntries = [...products].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Registry Stack home">
    <span class="brand-mark" aria-hidden="true">RS</span>
    <span>Registry Stack</span>
  </a>
  <nav class="top-nav" aria-label="Main navigation">
    <details class="nav-group">
      <summary aria-current={onSolutionPage ? 'page' : undefined}>Solutions</summary>
      <div class="nav-group-panel">
        <a href="/solutions/" aria-current={current === 'solutions' ? 'page' : undefined}>
          <span class="nav-entry-name">All solutions</span>
          <span class="nav-entry-blurb">For national, regional and local government</span>
        </a>
        <hr class="nav-group-rule" />
        {registerFamilies.map((area) => (
          <a href={area.slug} aria-current={current === area.key ? 'page' : undefined}>
            <span class="nav-entry-name">{area.name}</span>
            <span class="nav-entry-blurb">{area.intent}</span>
          </a>
        ))}
        <hr class="nav-group-rule" />
        <p class="nav-group-label">Shared capabilities</p>
        {crossCutting.map((area) => (
          <a href={area.slug} aria-current={current === area.key ? 'page' : undefined}>
            <span class="nav-entry-name">{area.name}</span>
            <span class="nav-entry-blurb">{area.intent}</span>
          </a>
        ))}
      </div>
    </details>
    <details class="nav-group">
      <summary aria-current={onProductPage ? 'page' : undefined}>Products</summary>
      <div class="nav-group-panel">
        {productEntries.map((product) => (
          <a href={product.href} aria-current={current === product.key ? 'page' : undefined}>
            <span class="nav-entry-name">{product.name}</span>
            <span class="nav-entry-blurb">{product.intent}</span>
          </a>
        ))}
        <hr class="nav-group-rule" />
        {evaluationLinks.map((link) => (
          <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>
            <span class="nav-entry-name">{link.label}</span>
          </a>
        ))}
      </div>
    </details>
    {links.map((link) => (
      <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>{link.label}</a>
    ))}
    <a class="nav-emphasis" href="/pricing/#inquiry">Contact</a>
  </nav>
</header>
