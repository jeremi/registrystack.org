---
interface Props {
  fieldLabel: string;
  value: string;
  recipient: string;
  issuer: string;
}
const { fieldLabel, value, recipient, issuer } = Astro.props;
---

<section class="signed-answer" aria-label={`Signed answer for ${recipient}`}>
  <p class="answer-recipient">{recipient} receives</p>
  <dl class="answer-result">
    <dt>{fieldLabel}</dt>
    <dd>{value}</dd>
  </dl>
  <div class="answer-signature">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path d="M14 3H4v18h16V11M8 8h3M8 12h3m3 3 7-7-3-3-7 7-1 4 4-1Z" />
    </svg>
    <span><strong>Digitally signed</strong><span class="answer-issuer">{issuer}</span></span>
  </div>
</section>

<style>
  .signed-answer { min-width: 0; color: var(--registry-blue); background: #eef3fc; border: 1px solid #b8c9e1; border-top: 3px solid var(--registry-blue); }
  .answer-recipient { color: var(--registry-blue); padding: 14px 18px 0; margin: 0; font: 11px/1.5 var(--registry-mono); text-transform: uppercase; }
  .answer-result { margin: 0; padding: 13px 18px 17px; }
  .answer-result dt { font-size: 14px; line-height: 1.4; color: var(--registry-body); }
  .answer-result dd { font-size: clamp(28px, 3vw, 36px); font-weight: 700; line-height: 1.2; margin: 6px 0 0; }
  .answer-signature { display: flex; align-items: center; gap: 10px; padding: 11px 18px; border-top: 1px solid #c6d4e7; }
  .answer-signature svg { flex: 0 0 20px; }
  .answer-signature > span { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
  .answer-signature strong { font-size: 12px; line-height: 1.4; }
  .answer-issuer { font-size: 11px; line-height: 1.4; color: var(--registry-body); }
</style>
