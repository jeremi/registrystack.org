---
import RecordCard from './RecordCard.astro';
import { localeForPath, translator } from '../i18n';
const t = translator(localeForPath(Astro.url.pathname));

const requestFields = [
  { label: t('Licence', 'Autorisation'), value: 'LIC-4471' },
  { label: t('Requested change', 'Modification demandée'), value: t('Correct recorded activities', 'Corriger les activités inscrites') },
  { label: t('Submitted by', 'Déposée par'), value: t('Licence holder', 'Titulaire de l’autorisation') },
  { label: t('Received', 'Reçue'), value: t('Tuesday 09:14', 'Mardi 9 h 14') },
];
const licenceFields = [
  { label: t('Permitted activities', 'Activités autorisées'), value: t('Corrected', 'Corrigées') },
  { label: t('Changed by', 'Modifiée par'), value: t('Licensing application', 'Application de délivrance des autorisations') },
  { label: t('Applied', 'Appliquée'), value: t('Wednesday 10:02', 'Mercredi 10 h 02') },
  { label: t('Revision', 'Révision'), value: '12' },
];
---

<figure class="casework-flow" aria-labelledby="casework-flow-title">
  <div class="flow-intro">
    <p class="flow-kicker">{t('An illustrative correction request', 'Exemple de demande de correction')}</p>
    <h3 id="casework-flow-title">{t('Staff review the request. The licensing application updates the professional register after approval.', 'Les agents examinent la demande. Après approbation, l’application de délivrance des autorisations met à jour le registre professionnel.')}</h3>
  </div>

  <div class="work-journey" role="group" aria-label={t('Fictional licence correction moving from request to inbox to applied change', 'Correction fictive d’une autorisation, de la demande à la file d’examen puis à la modification appliquée')}>
    <section class="request-panel" aria-labelledby="request-panel-title">
      <div class="panel-heading">
        <p class="panel-label">{t('Licensing application', 'Application de délivrance des autorisations')}</p>
        <h4 id="request-panel-title">{t('Correction request', 'Demande de correction')}</h4>
      </div>
      <RecordCard recordType={t('Correction request', 'Demande de correction')} recordId="REQ-3106" icon="data" fields={requestFields} />
      <p class="panel-note">{t('The licensing application collects the request and supporting documents.', 'L’application de délivrance des autorisations recueille la demande et les pièces justificatives.')}</p>
    </section>

    <section class="inbox-panel" aria-labelledby="inbox-panel-title">
      <div class="panel-heading">
        <p class="panel-label">Registry Casework</p>
        <h4 id="inbox-panel-title">{t('Licence correction reviews', 'Examens des corrections d’autorisations')}</h4>
      </div>
      <ol class="item-history">
        <li><strong>{t('Request sent for review', 'Demande transmise pour examen')}</strong><span>{t('The request enters the licence corrections queue with a due date.', 'La demande entre dans la file des corrections d’autorisations avec une échéance.')}</span></li>
        <li><strong>{t('Missing certificate identified', 'Attestation manquante repérée')}</strong><span>{t('The reviewer asks for the certificate. This completes the first review.', 'L’agent demande l’attestation. Ce premier examen est alors terminé.')}</span></li>
        <li><strong>{t('Certificate provided', 'Attestation fournie')}</strong><span>{t('The licensing application collects the certificate and submits a new review request.', 'L’application recueille l’attestation et soumet une nouvelle demande d’examen.')}</span></li>
        <li><strong>{t('Revised request approved', 'Demande corrigée approuvée')}</strong><span>{t('A reviewer records the approval. This review has its own due date.', 'Un agent consigne l’approbation. Cet examen a sa propre échéance.')}</span></li>
      </ol>
      <p class="panel-note">{t('Supervisors can see who is responsible for each review and when it is due.', 'Les responsables voient qui est chargé de chaque examen et quand il est dû.')}</p>
    </section>

    <section class="register-panel" aria-labelledby="register-panel-title">
      <div class="panel-heading">
        <p class="panel-label">{t('Professional register', 'Registre professionnel')}</p>
        <h4 id="register-panel-title">{t('Change applied', 'Modification appliquée')}</h4>
      </div>
      <div class="applied-record">
        <p class="applied-label"><span aria-hidden="true">↳</span> {t('Updated by the licensing application', 'Mise à jour par l’application de délivrance des autorisations')}</p>
        <RecordCard recordType={t('Licence record', 'Fiche d’autorisation')} recordId="LIC-4471" icon="person" fields={licenceFields} />
      </div>
      <p class="panel-note">{t('The licensing application asks the professional register to apply the approved correction. The register checks permission before accepting the change.', 'L’application demande au registre professionnel d’appliquer la correction approuvée. Le registre vérifie les droits d’accès avant d’accepter la modification.')}</p>
    </section>

    <div class="audit-slip">
      <svg class="audit-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 3h12v18H6zM9 7h6M9 11h6M9 15h4" />
      </svg>
      <p><strong>{t('Review history', 'Historique des examens')}</strong> {t('When each review was submitted, assigned and completed, and who made the decision. The register keeps the history of record changes.', 'Date de dépôt, d’attribution et de clôture de chaque examen, et auteur de la décision. Le registre conserve l’historique des modifications des fiches.')}</p>
    </div>
  </div>

  <figcaption>{t('Fictional licence data. In this example, the licensing application submits the approved correction to the professional register. Registry Casework records each staff review.', 'Données d’autorisation fictives. Dans cet exemple, l’application de délivrance des autorisations soumet la correction approuvée au registre professionnel. Registry Casework consigne chaque examen par un agent.')}</figcaption>
</figure>

<style>
  .casework-flow { margin: 0 auto; max-width: var(--registry-max); }
  .flow-intro { border-bottom: 1px solid var(--registry-paper-rule); margin-bottom: 25px; padding-bottom: 20px; }
  .flow-intro h3 { font-size: var(--type-subhead); line-height: 1.4; margin: 7px 0 0; }
  .flow-kicker, .panel-label { color: var(--registry-blue); font: var(--type-2xs)/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .work-journey { align-items: start; display: grid; gap: 24px; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); }
  .request-panel, .inbox-panel, .register-panel { min-width: 0; }
  .panel-heading { margin-bottom: 13px; }
  .panel-heading h4 { font-size: var(--type-subhead); line-height: 1.3; margin: 5px 0 0; }
  .panel-note { color: var(--registry-muted); font-size: var(--type-sm); line-height: 1.5; margin: 14px 0 0; }
  .item-history { background: var(--registry-slate-tint); border: 1px solid var(--registry-slate-rule); display: grid; gap: 14px; list-style: none; margin: 0; padding: 16px 18px; }
  .item-history li { border-left: 2px solid var(--registry-blue); display: grid; gap: 3px; padding-left: 12px; }
  .item-history strong { color: var(--registry-ink); font-size: var(--type-base); line-height: 1.4; }
  .item-history span { color: var(--registry-body); font-size: var(--type-sm); line-height: 1.5; }
  .applied-record { background: var(--registry-blue-tint); padding: 0 10px 10px; }
  .applied-label { align-items: center; color: var(--registry-blue); display: flex; gap: 8px; font: var(--type-2xs)/1.5 var(--registry-mono); margin: 0; padding: 10px 5px; }
  .applied-label > span { font-size: var(--type-body); }
  .audit-slip { align-items: center; border-top: 1px solid var(--registry-paper-rule); display: flex; gap: 12px; grid-column: 1 / -1; padding-top: 18px; }
  .audit-mark { color: var(--registry-blue); flex: 0 0 auto; height: 25px; stroke: currentColor; stroke-width: 1.5; width: 25px; }
  .audit-slip p { color: var(--registry-muted); font-size: var(--type-sm); line-height: 1.5; margin: 0; }
  .audit-slip strong { color: var(--registry-body); font-weight: 600; margin-right: 8px; }
  .casework-flow figcaption { color: var(--registry-muted); font-size: var(--type-xs); line-height: 1.5; margin-top: 16px; }
  @media (max-width: 800px) {
    .work-journey { gap: 20px; grid-template-columns: minmax(0, 1fr); }
    .audit-slip { align-items: start; }
  }
</style>
