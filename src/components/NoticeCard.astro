---
// One notice on its way to one person: the channel, who it went to, what it
// said, and what the provider reported back.
interface Props {
  channel: 'Email' | 'SMS';
  to: string;
  subject: string;
  status: string;
}
const { channel, to, subject, status } = Astro.props;
---

<section class="notice-card" aria-label={`${channel} notice to ${to}`}>
  <p class="notice-channel">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      {channel === 'SMS' ? (
        <path d="M4 5h16v11H9l-5 4V5z" />
      ) : (
        <><rect x="3" y="5" width="18" height="14" rx="1" /><path d="m3 7 9 6 9-6" /></>
      )}
    </svg>
    {channel} notice
  </p>
  <dl class="notice-fields">
    <div><dt>To</dt><dd>{to}</dd></div>
    <div><dt>{channel === 'SMS' ? 'Text' : 'Subject'}</dt><dd>{subject}</dd></div>
  </dl>
  <p class="notice-status"><span class="notice-dot" aria-hidden="true"></span>{status}</p>
</section>

<style>
  .notice-card { min-width: 0; background: var(--registry-white); color: var(--registry-ink); border: 1px solid var(--registry-slate-rule); border-left: 3px solid var(--registry-blue); }
  .notice-channel { display: flex; align-items: center; gap: 8px; margin: 0; padding: 14px 16px 12px; color: var(--registry-blue); font: var(--type-2xs)/1.4 var(--registry-mono); text-transform: uppercase; }
  .notice-channel svg { flex-shrink: 0; }
  .notice-fields { margin: 0; }
  .notice-fields > div { display: grid; grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.6fr); align-items: baseline; gap: 8px 16px; border-top: 1px solid var(--registry-slate-rule-light); padding: 11px 16px; font-size: var(--type-sm); line-height: 1.45; }
  .notice-fields dt { margin: 0; color: var(--registry-muted); }
  .notice-fields dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .notice-status { display: flex; align-items: center; gap: 8px; margin: 0; padding: 11px 16px; border-top: 1px solid var(--registry-slate-rule-light); font-size: var(--type-xs); font-weight: 700; line-height: 1.4; }
  .notice-dot { background: var(--registry-blue); border-radius: 50%; display: inline-block; flex: none; height: 8px; width: 8px; }
</style>
