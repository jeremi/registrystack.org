---
// Optional starting configurations for a register family, with the featured
// starter first, then
// the ones to open first, then the order solutions.ts lists them. Titles and one-line leads come from the
// starters catalogue data.
import type { SolutionArea } from '../data/solutions';
import { startersForArea, starterCount, starterLead } from '../data/starters';

interface Props {
  area: SolutionArea;
  heading: string;
  intro: string;
  // What the featured starter covers of the page's example, shown under it,
  // or under the list when the family features none.
  featuredNote?: string;
}

const { area, heading, intro, featuredNote } = Astro.props;
const areaStarters = startersForArea(area);
const isOpenFirst = (id: string): boolean => area.openFirst?.includes(id) ?? false;
---
<section id="starters" class="section" aria-labelledby="solution-starters-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="eyebrow">Optional starting configurations</p>
      <h2 id="solution-starters-title">{heading}</h2>
      <p>{intro}</p>
      <p class="product-note">Current starting configurations are available by request. Browse them if useful, or begin by describing the service you need and we will help identify the closest starting point.</p>
    </div>
    <ul class="solution-starter-list">
      {areaStarters.map((starter) => (
        <li class:list={{ 'is-featured': starter.id === area.featuredStarter || isOpenFirst(starter.id) }}>
          <h3>
            <a href={`/starters/${starter.id}/`}>{starter.title}</a>
            {starter.id === area.featuredStarter && <span class="solution-starter-featured">Start here</span>}
            {isOpenFirst(starter.id) && <span class="solution-starter-featured">Open first</span>}
          </h3>
          <p>{starterLead(starter)}</p>
          {featuredNote && starter.id === area.featuredStarter && <p class="solution-starter-note">{featuredNote}</p>}
        </li>
      ))}
    </ul>
    {featuredNote && !area.featuredStarter && <p class="solution-starter-note">{featuredNote}</p>}
    <p class="solution-starter-all"><a class="inline-cta" href="/starters/">Browse all {starterCount} starting configurations <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .solution-starter-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; list-style: none; margin: 0; padding: 0; }
  .solution-starter-list li { border-top: 1px solid var(--registry-rule); padding: 20px 0 22px; min-width: 0; }
  .solution-starter-list li.is-featured { border-top-color: var(--registry-brass); border-top-width: 3px; }
  .solution-starter-list h3 { font-size: var(--type-body); margin: 0 0 6px; }
  .solution-starter-featured { background: var(--registry-brass); color: var(--registry-ink); font-family: var(--registry-mono); font-size: var(--type-2xs); font-weight: 600; letter-spacing: 0.06em; margin-left: 8px; padding: 2px 6px; text-transform: uppercase; vertical-align: middle; }
  .solution-starter-list p { color: var(--registry-body); font-size: var(--type-md); margin: 0; }
  .solution-starter-list .solution-starter-note, .solution-starter-note { border-left: 3px solid var(--registry-brass); color: var(--registry-body); font-size: var(--type-md); margin: 10px 0 0; padding-left: 12px; }
  .solution-starter-all { font-size: var(--type-base); margin: 24px 0 0; }
  @media (max-width: 700px) {
    .solution-starter-list { grid-template-columns: 1fr; }
  }
</style>
