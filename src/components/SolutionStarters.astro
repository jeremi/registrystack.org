---
// Service pages explain fit; the marketplace owns pack models and access requests.
import type { SolutionArea } from '../data/solutions';
import { marketplaceCollectionHref } from '../lib/marketplace-routes.mjs';
import { englishHreflang, localeForPath, translator } from '../i18n';
interface Props {
  area: SolutionArea;
}
const { area } = Astro.props;
// The marketplace is in English: on a French page the link says so.
const locale = localeForPath(Astro.url.pathname);
const t = translator(locale);
const collectionHref = marketplaceCollectionHref(area.key);
---
<section id="starters" class="section section-muted" aria-labelledby="solution-starters-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="eyebrow">{t('Optional starting configurations', 'Configurations de départ facultatives')}</p>
      <h2 id="solution-starters-title">{t('Find a starting configuration.', 'Trouvez une configuration de départ.')}</h2>
      <p>{locale === 'fr'
        ? `Parcourez dans le catalogue de configurations la collection « ${area.name} » : modèles, composants inclus et demandes d’accès. Une configuration est un point de départ : la mise en œuvre doit encore l’adapter à vos règles, à vos canaux de service et à vos systèmes existants.`
        : `Explore the ${area.name.toLowerCase()} collection in the marketplace, with models, included parts and access requests. A configuration is a starting point: an implementation still needs to fit your rules, service channels and existing systems.`}</p>
    </div>
    <a class="button button-primary" href={collectionHref} hreflang={englishHreflang(collectionHref, locale)}>{t('Browse this service area in the marketplace', 'Parcourir ce domaine de service dans le catalogue (en anglais)')} <span aria-hidden="true">→</span></a>
    <p class="marketplace-note">{t('Current starting configurations are free to request. You can also discuss your service with us without choosing one first.', 'Les configurations de départ actuelles se demandent gratuitement. Vous pouvez aussi nous parler de votre service sans en choisir une au préalable.')}</p>
  </div>
</section>
<style>
  .marketplace-note { color: var(--registry-body); font-size: var(--type-base); margin: 20px 0 0; max-width: 680px; }
</style>
