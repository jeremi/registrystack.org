---
// Service pages explain fit; the marketplace owns pack models and access requests.
import type { SolutionArea } from '../data/solutions';
import { marketplaceCollectionHref } from '../lib/marketplace-routes.mjs';
interface Props {
  area: SolutionArea;
}
const { area } = Astro.props;
---
<section id="starters" class="section section-muted" aria-labelledby="solution-starters-title">
  <div class="section-inner">
    <div class="section-heading">
      <p class="eyebrow">Optional starting configurations</p>
      <h2 id="solution-starters-title">Find a starting configuration.</h2>
      <p>Explore the {area.name.toLowerCase()} collection in the marketplace, with models, included parts and access requests. A configuration is a starting point: an implementation still needs to fit your rules, service channels and existing systems.</p>
    </div>
    <a class="button button-primary" href={marketplaceCollectionHref(area.key)}>Browse this service area in the marketplace <span aria-hidden="true">→</span></a>
    <p class="marketplace-note">Current starting configurations are free to request. You can also discuss your service with us without choosing one first.</p>
  </div>
</section>
<style>
  .marketplace-note { color: var(--registry-body); font-size: var(--type-base); margin: 20px 0 0; max-width: 680px; }
</style>
