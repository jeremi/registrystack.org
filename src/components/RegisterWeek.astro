---
// One record over one working week: the four moments every register shares,
// told with the record the page is about. All four steps are always visible,
// so the figure reads the same without JavaScript and with reduced motion.
// When the script may move, the highlight walks through the steps and a button
// pauses it; otherwise the first step stays highlighted.
import type { WeekStep } from '../data/register-week';
import RecordCard from './RecordCard.astro';
import SignedAnswer from './SignedAnswer.astro';
import DocumentCard from './DocumentCard.astro';
import NoticeCard from './NoticeCard.astro';
import BookingCard from './BookingCard.astro';

interface Props {
  id?: string;
  kicker: string;
  heading: string;
  steps: WeekStep[];
}

const { id = 'register-week', kicker, heading, steps } = Astro.props;
const titleId = `${id}-title`;
---

<figure class="register-week" id={id} aria-labelledby={titleId} data-register-day>
  <div class="day-intro">
    <div>
      <p class="day-kicker">{kicker}</p>
      <h3 id={titleId}>{heading}</h3>
    </div>
  </div>

  <ol class="day-steps">
    {steps.map((step, index) => (
      <li class:list={['day-step', { 'is-active': index === 0 }]} data-day-step>
        <p class="step-when"><span class="step-count" aria-hidden="true">{index + 1}</span> {step.when}</p>
        <p class="step-product">{step.productHref ? <a href={step.productHref}>{step.product}</a> : step.product}</p>
        <h4>{step.title}</h4>
        <p class="step-text" set:html={step.text} />
        {step.card.kind === 'record' && (
          <RecordCard recordType={step.card.recordType} recordId={step.card.recordId} icon={step.card.icon} fields={step.card.fields} />
        )}
        {step.card.kind === 'history' && (
          <ol class="step-history">
            {step.card.items.map((item) => (
              <li><strong>{item.state}</strong><span>{item.note}</span></li>
            ))}
          </ol>
        )}
        {step.card.kind === 'answer' && (
          <SignedAnswer fieldLabel={step.card.fieldLabel} value={step.card.value} recipient={step.card.recipient} issuer={step.card.issuer} />
        )}
        {step.card.kind === 'document' && (
          <DocumentCard documentType={step.card.documentType} format={step.card.format} title={step.card.title} fields={step.card.fields} footnote={step.card.footnote} hash={step.card.hash} />
        )}
        {step.card.kind === 'notice' && (
          <NoticeCard channel={step.card.channel} to={step.card.to} subject={step.card.subject} status={step.card.status} />
        )}
        {step.card.kind === 'booking' && (
          <BookingCard service={step.card.service} place={step.card.place} slot={step.card.slot} status={step.card.status} />
        )}
      </li>
    ))}
  </ol>

</figure>

<style>
  .register-week { margin: clamp(24px, 4vw, 36px) 0 0; max-width: var(--registry-max); }
  .day-intro { align-items: start; border-bottom: 1px solid var(--registry-paper-rule); display: flex; gap: 20px; justify-content: space-between; margin-bottom: 24px; padding-bottom: 18px; }
  .day-intro h3 { font-size: var(--type-subhead); line-height: 1.4; margin: 7px 0 0; max-width: 640px; }
  .day-kicker, .step-product { color: var(--registry-blue); font: var(--type-2xs)/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .step-product a { color: inherit; text-decoration-thickness: 1px; text-underline-offset: 3px; }
  .step-product a:hover, .step-product a:focus-visible { text-decoration-thickness: 2px; }
  .day-pause { background: var(--registry-white); border: 1px solid var(--registry-slate-rule); color: var(--registry-body); cursor: pointer; flex: none; font: 600 var(--type-sm)/1.2 inherit; min-height: 36px; padding: 8px 14px; }
  .day-pause:hover, .day-pause:focus-visible { border-color: var(--registry-blue); color: var(--registry-blue); }
  .day-steps { display: grid; gap: 20px; grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; }
  .day-step { background: var(--registry-white); border: 1px solid var(--registry-slate-rule); border-top: 3px solid var(--registry-slate-rule); display: grid; gap: 10px; grid-template-rows: auto auto auto auto 1fr; min-width: 0; padding: 18px 18px 20px; transition: border-top-color 0.4s ease, background-color 0.4s ease; }
  .day-step.is-active { background: var(--registry-blue-tint); border-top-color: var(--registry-blue); }
  .step-when { align-items: center; color: var(--registry-body); display: flex; font-size: var(--type-sm); gap: 8px; line-height: 1.4; margin: 0; }
  .step-count { align-items: center; background: var(--registry-blue); border-radius: 50%; color: var(--registry-white); display: inline-flex; flex: none; font-size: var(--type-xs); font-weight: 700; height: 22px; justify-content: center; width: 22px; }
  .day-step h4 { font-size: var(--type-subhead); line-height: 1.3; margin: 0; }
  .step-text { color: var(--registry-body); font-size: var(--type-sm); line-height: 1.5; margin: 0 0 4px; }
  .step-history { align-self: start; display: grid; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .step-history li { border-left: 2px solid var(--registry-blue); display: grid; gap: 2px; padding-left: 10px; }
  .step-history strong { color: var(--registry-ink); font-size: var(--type-sm); line-height: 1.4; }
  .step-history span { color: var(--registry-body); font-size: var(--type-xs); line-height: 1.5; }
  @media (max-width: 1000px) { .day-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) {
    .day-steps { grid-template-columns: 1fr; }
    .day-intro { flex-direction: column; }
  }
</style>

<script>
  // Walk the highlight through the steps. Progressive enhancement: the markup
  // already highlights the first step, so with no JavaScript or a reduced-motion
  // preference nothing moves and no pause control is added.
  const STEP_MS = 3200;

  const prefersReducedMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const figure of document.querySelectorAll<HTMLElement>('[data-register-day]')) {
    const steps = Array.from(figure.querySelectorAll<HTMLElement>('[data-day-step]'));
    const intro = figure.querySelector<HTMLElement>('.day-intro');
    if (steps.length < 2 || !intro || prefersReducedMotion()) continue;

    let index = Math.max(0, steps.findIndex((step) => step.classList.contains('is-active')));
    let timer = 0;
    let paused = false;

    const advance = () => {
      steps[index].classList.remove('is-active');
      index = (index + 1) % steps.length;
      steps[index].classList.add('is-active');
    };
    const start = () => {
      if (!timer && !paused) timer = window.setInterval(advance, STEP_MS);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = 0;
      }
    };

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'day-pause';
    button.textContent = 'Pause';
    button.setAttribute('aria-pressed', 'false');
    button.addEventListener('click', () => {
      paused = !paused;
      button.textContent = paused ? 'Play' : 'Pause';
      button.setAttribute('aria-pressed', String(paused));
      if (paused) stop();
      else start();
    });
    intro.appendChild(button);

    // Hold the highlight while a visitor reads a step.
    figure.addEventListener('mouseenter', stop);
    figure.addEventListener('mouseleave', start);
    start();
  }
</script>
