---
import {
  contactEmail as defaultContactEmail,
  contactNeutralRecoveryHref,
  contactRecoveryHref,
} from '../data/contact';
import { contactRequestPresentation, type ContactRequestType } from '../lib/starter-request';

interface Props {
  endpoint?: string;
  trackedEndpoint?: string;
  requestHref?: string;
  contactEmail?: string;
  starterId?: string;
  starterTitle?: string;
  sourcePage?: string;
  requestType?: ContactRequestType;
  requestContext?: string;
  requestFromUrl?: boolean;
  messageRequired?: boolean;
  headingLevel?: 2 | 3;
  eyebrow?: string;
  heading?: string;
  intro?: string;
  messageLabel?: string;
  submitLabel?: string;
  successMessage?: string;
}

const {
  endpoint,
  trackedEndpoint,
  requestHref,
  contactEmail = defaultContactEmail,
  starterId = '',
  starterTitle = '',
  sourcePage,
  requestType = 'starter',
  requestContext = starterTitle,
  requestFromUrl = false,
  messageRequired = requestType !== 'starter',
  headingLevel = 3,
  eyebrow,
  heading,
  intro,
  messageLabel,
  submitLabel,
  successMessage,
} = Astro.props;

const presentation = contactRequestPresentation(requestType);
const displayedEyebrow = eyebrow ?? presentation.eyebrow;
const displayedHeading = heading ?? presentation.heading;
const displayedIntro = intro ?? presentation.intro;
const displayedMessageLabel = messageLabel ?? presentation.messageLabel;
const displayedSubmitLabel = submitLabel ?? presentation.submitLabel;
const displayedSuccessMessage = successMessage ?? presentation.successMessage;

const recoveryHref = requestHref ?? (requestFromUrl
  ? contactNeutralRecoveryHref()
  : contactRecoveryHref(requestType, requestContext));
---

<section
  class="starter-request-panel"
  id="starter-request-form"
  aria-labelledby="starter-request-title"
  data-request-panel
  data-request-type={requestType}
  data-request-context={requestContext}
  data-request-from-url={requestFromUrl ? 'true' : undefined}
>
    <div class="starter-request-intro">
      <p class="eyebrow" data-request-eyebrow>{displayedEyebrow}</p>
      {headingLevel === 2
        ? <h2 id="starter-request-title" data-request-heading>{displayedHeading}</h2>
        : <h3 id="starter-request-title" data-request-heading>{displayedHeading}</h3>}
      <p data-request-intro>{displayedIntro}</p>
      <p class="starter-request-context" data-request-context-summary hidden></p>
    </div>

    {endpoint && <form
      data-starter-request-form
      data-endpoint={endpoint}
      data-tracked-endpoint={trackedEndpoint}
      data-starter-id={starterId}
      data-source-page={sourcePage}
      data-request-type={requestType}
      data-request-context={requestContext}
      data-request-from-url={requestFromUrl ? 'true' : undefined}
      aria-describedby="starter-request-privacy"
    >
      <fieldset disabled data-starter-request-fields>
        <div class="starter-request-fields">
          <label>
            <span>Email address <span data-required-marker aria-hidden="true">*</span></span>
            <input name="email" type="email" autocomplete="email" maxlength="254" required />
          </label>
          <label>
            <span>Organization <span class="optional">Optional</span></span>
            <input name="organization" type="text" autocomplete="organization" maxlength="200" />
          </label>
          <label>
            <span>Your role <span class="optional">Optional</span></span>
            <input name="role" type="text" autocomplete="organization-title" maxlength="200" />
          </label>
          <label class="starter-request-message">
            <span>
              <span data-message-label>{displayedMessageLabel}</span>{' '}
              <span data-required-marker data-message-required-marker aria-hidden="true" hidden={!messageRequired}>*</span>
              <span class="optional" data-message-optional-marker hidden={messageRequired}>Optional</span>
            </span>
            <textarea name="message" rows="5" maxlength="2000" required={messageRequired}></textarea>
          </label>
          <label class="starter-request-honeypot" aria-hidden="true">
            <span>Leave this empty</span>
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <p class="starter-request-privacy" id="starter-request-privacy">
          <span data-request-privacy-copy>{presentation.privacyCopy}</span> Read the <a href="/privacy/">privacy policy</a>.
        </p>
        <button class="button button-primary" type="submit" data-starter-request-submit>{displayedSubmitLabel}</button>
      </fieldset>

      <p class="starter-request-status" role="status" aria-live="polite" data-starter-request-submitting hidden>
        Sending your request&hellip;
      </p>
      <p class="starter-request-status starter-request-success" role="status" aria-live="polite" tabindex="-1" data-starter-request-success hidden>
        <span data-request-success-copy>{displayedSuccessMessage}</span>
      </p>
      <p class="starter-request-status starter-request-error" role="alert" tabindex="-1" data-starter-request-error hidden>
        We could not confirm your request. Your details are still here. You can try again or use the email option below.
      </p>
    </form>}

    <p class="starter-request-fallback">
      {endpoint ? 'If the form does not work, ' : 'The form is unavailable. '}
      <a href={recoveryHref} data-request-recovery>Email {contactEmail}</a>.
    </p>
</section>

<script>
  import {
    isContactRequestType,
    contactRequestPresentation,
    requestContext as normalizeRequestContext,
    requestSourcePage,
    submitStarterRequest,
  } from '../lib/starter-request';
  import { contactRecoveryHref } from '../data/contact';
  import { getConsentedDeviceId } from '../lib/marketing-tracking';

  for (const panel of document.querySelectorAll<HTMLElement>('[data-request-panel]')) {
    const form = panel.querySelector<HTMLFormElement>('[data-starter-request-form]');
    const recoveryLink = panel.querySelector<HTMLAnchorElement>('[data-request-recovery]');
    const requestedType = panel.dataset.requestType;
    let type = isContactRequestType(requestedType) ? requestedType : 'question';
    let context = normalizeRequestContext(panel.dataset.requestContext) ?? '';

    if (panel.dataset.requestFromUrl === 'true') {
      const params = new URLSearchParams(window.location.search);
      const urlType = params.get('type') ?? undefined;
      type = isContactRequestType(urlType) ? urlType : 'question';
      context = normalizeRequestContext(params.get('context') ?? undefined) ?? '';
      const sourcePage = requestSourcePage(params.get('source') ?? undefined) ?? '/contact/';
      const presentation = contactRequestPresentation(type);
      const setText = (selector: string, value: string) => {
        const node = panel.querySelector<HTMLElement>(selector);
        if (node) node.textContent = value;
      };
      setText('[data-request-eyebrow]', presentation.eyebrow);
      setText('[data-request-heading]', presentation.heading);
      setText('[data-request-intro]', presentation.intro);
      setText('[data-message-label]', presentation.messageLabel);
      setText('[data-starter-request-submit]', presentation.submitLabel);
      setText('[data-request-success-copy]', presentation.successMessage);
      setText('[data-request-privacy-copy]', presentation.privacyCopy);
      if (recoveryLink) recoveryLink.href = contactRecoveryHref(type, context);
      const contextSummary = panel.querySelector<HTMLElement>('[data-request-context-summary]');
      if (contextSummary) {
        contextSummary.textContent = context ? `About: ${context}` : '';
        contextSummary.hidden = !context;
      }
      if (form) {
        form.dataset.requestType = type;
        form.dataset.requestContext = context;
        if (!requestSourcePage(form.dataset.sourcePage)) form.dataset.sourcePage = sourcePage;
        const message = form.elements.namedItem('message');
        if (message instanceof HTMLTextAreaElement) message.required = type !== 'starter';
        const requiredMarker = form.querySelector<HTMLElement>('[data-message-required-marker]');
        const optionalMarker = form.querySelector<HTMLElement>('[data-message-optional-marker]');
        if (requiredMarker) requiredMarker.hidden = type === 'starter';
        if (optionalMarker) optionalMarker.hidden = type !== 'starter';
      }
    }

    if (!form) continue;
    const fieldset = form.querySelector<HTMLFieldSetElement>('[data-starter-request-fields]');
    const submitting = form.querySelector<HTMLElement>('[data-starter-request-submitting]');
    const success = form.querySelector<HTMLElement>('[data-starter-request-success]');
    const error = form.querySelector<HTMLElement>('[data-starter-request-error]');
    const recovery = form.closest<HTMLElement>('.starter-request-panel')?.querySelector<HTMLElement>('.starter-request-fallback');
    const endpoint = form.dataset.endpoint;
    const trackedEndpoint = form.dataset.trackedEndpoint;

    if (!fieldset || !submitting || !success || !error || !endpoint) continue;

    let submissionInProgress = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submissionInProgress || !form.reportValidity()) return;

      // Disabled controls are omitted from FormData. Read them before locking
      // the form against a second submission.
      const data = new FormData(form);
      submissionInProgress = true;
      fieldset.disabled = true;
      form.setAttribute('aria-busy', 'true');
      submitting.hidden = false;
      success.hidden = true;
      error.hidden = true;

      try {
        const type = isContactRequestType(form.dataset.requestType) ? form.dataset.requestType : undefined;
        const sourcePage = requestSourcePage(form.dataset.sourcePage) ?? '/contact/';
        await submitStarterRequest(endpoint, {
          email: String(data.get('email') ?? '').trim(),
          organization: String(data.get('organization') ?? '').trim(),
          role: String(data.get('role') ?? '').trim(),
          message: String(data.get('message') ?? '').trim(),
          website: String(data.get('website') ?? '').trim(),
          starterId: form.dataset.starterId,
          sourcePage,
          requestType: type,
          requestContext: form.dataset.requestContext,
        }, import.meta.env.PUBLIC_MAUTIC_URL?.trim() ? getConsentedDeviceId() : undefined, trackedEndpoint);
        submitting.hidden = true;
        success.hidden = false;
        recovery?.classList.remove('show-recovery');
        success.focus();
      } catch {
        submitting.hidden = true;
        error.hidden = false;
        fieldset.disabled = false;
        recovery?.classList.add('show-recovery');
        error.focus();
      } finally {
        submissionInProgress = false;
        form.removeAttribute('aria-busy');
      }
    });
    fieldset.disabled = false;
    panel.setAttribute('data-form-enhanced', 'true');
  }
</script>

<style>
  .starter-request-panel {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    border-left: 5px solid var(--registry-blue);
    display: grid;
    gap: clamp(24px, 4vw, 44px);
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    margin: 30px 0 40px;
    padding: clamp(24px, 4vw, 40px);
  }

  .starter-request-intro h2,
  .starter-request-intro h3 {
    font-size: clamp(24px, 3vw, 32px);
    margin: 6px 0 12px;
  }

  .starter-request-intro p:last-child {
    color: var(--registry-body);
    line-height: 1.6;
    margin-bottom: 0;
  }

  fieldset {
    border: 0;
    margin: 0;
    padding: 0;
  }

  .starter-request-fields {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  label {
    color: var(--registry-ink);
    display: grid;
    font-weight: 700;
    gap: 7px;
  }

  label > span > [data-required-marker] {
    color: var(--registry-stamp);
  }

  .optional {
    color: var(--registry-muted);
    font-size: var(--type-xs);
    font-weight: 400;
    margin-left: 6px;
  }

  input,
  textarea {
    background: var(--registry-paper);
    border: 1px solid var(--registry-paper-rule);
    border-radius: 0;
    color: var(--registry-ink);
    font: inherit;
    line-height: 1.45;
    padding: 11px 12px;
    width: 100%;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 3px solid var(--registry-brass);
    outline-offset: 2px;
  }

  .starter-request-message {
    grid-column: 1 / -1;
  }

  .starter-request-honeypot {
    height: 1px;
    left: -10000px;
    overflow: hidden;
    position: absolute;
    top: auto;
    width: 1px;
  }

  textarea {
    resize: vertical;
  }

  .starter-request-privacy,
  .starter-request-fallback,
  .starter-request-status {
    color: var(--registry-muted);
    font-size: var(--type-sm);
    line-height: 1.55;
  }

  .starter-request-privacy {
    margin: 16px 0;
  }

  .starter-request-fallback {
    border-top: 1px solid var(--registry-rule);
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 18px;
  }

  .starter-request-panel[data-form-enhanced] .starter-request-fallback {
    display: none;
  }

  .starter-request-panel[data-form-enhanced] .starter-request-fallback.show-recovery {
    display: block;
  }

  .starter-request-privacy a,
  .starter-request-fallback a {
    font-weight: 700;
    text-decoration: underline;
  }

  .starter-request-status {
    margin: 14px 0 0;
  }

  .starter-request-success {
    color: var(--registry-blue);
    font-weight: 700;
  }

  .starter-request-error {
    color: var(--registry-stamp);
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .starter-request-panel,
    .starter-request-fields {
      grid-template-columns: 1fr;
    }

    .starter-request-message {
      grid-column: auto;
    }
  }
</style>
