---
import RecordCard from './RecordCard.astro';
---

<div class="linked-records">
  <RecordCard
    recordType="Person record"
    recordId="P-1042"
    name="Amara Mensah"
    icon="person"
    fields={[{ label: 'Date of birth', value: '16 March 1992' }]}
  />
  <div class="record-relationship">
    <svg width="28" height="34" viewBox="0 0 28 34" fill="none" aria-hidden="true">
      <path d="M14 0v30m-4-4 4 4 4-4" stroke="currentColor" stroke-width="1.5" />
    </svg>
    <span>Member of household</span>
  </div>
  <RecordCard
    recordType="Household record"
    recordId="H-208"
    icon="household"
    fields={[{ label: 'District', value: 'Northfield' }]}
  />
</div>

<style>
  .linked-records { min-width: 0; }
  .record-relationship { display: flex; align-items: center; gap: 8px; padding-left: 16px; color: var(--registry-blue); }
  .record-relationship span { font-size: 12px; line-height: 1.4; }
  .record-relationship svg { flex: 0 0 28px; }
</style>
