---
// Shared next steps for organizational readers and technical evaluators.
interface Props {
  eyebrow?: string;
  heading?: string;
  primaryLabel?: string;
  primaryHref?: string;
  body?: string;
  emphasis?: 'docs' | 'pilot';
}

const {
  eyebrow = 'Take the next step',
  heading = 'Explore it with your team.',
  primaryLabel = 'Try a developer tutorial',
  primaryHref = '/#developers',
  body = 'Evaluate the open-source software with your team, or get paid implementation help and ongoing support.',
  emphasis = 'docs',
} = Astro.props;
---

<section class="final-cta" aria-labelledby="handoff-title">
  <div class="section-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="handoff-title">{heading}</h2>
    <p>{body}</p>
    <div class="hero-actions">
      {emphasis === 'pilot' ? (
        <>
          <a class="button button-primary" href="/pricing/">Implementation and support</a>
          <a class="button button-secondary" href={primaryHref}>{primaryLabel}</a>
        </>
      ) : (
        <>
          <a class="button button-primary" href={primaryHref}>{primaryLabel}</a>
          <a class="button button-secondary" href="/pricing/">Implementation and support</a>
        </>
      )}
    </div>
  </div>
</section>
