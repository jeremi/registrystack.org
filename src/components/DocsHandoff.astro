---
// Shared next steps for organizational readers and technical evaluators.
import { englishHreflang, localeForPath, localizedPath, translator } from '../i18n';
interface Props {
  eyebrow?: string;
  heading?: string;
  primaryLabel?: string;
  primaryHref?: string;
  body?: string;
  emphasis?: 'docs' | 'pilot';
  // A line under the buttons, such as the plain address behind a mailto button.
  note?: string;
}

// The defaults follow the page's locale. A French page that passes its own
// `primaryHref` to an English page says so in `primaryLabel`.
const locale = localeForPath(Astro.url.pathname);
const t = translator(locale);
const pricingHref = localizedPath('/pricing/', locale);
const {
  eyebrow = t('Next step', 'Passer à l’étape suivante'),
  heading = t('Explore the software with your own team.', 'Explorez le logiciel avec votre équipe.'),
  primaryLabel = t('See the developer tutorials', 'Suivez un tutoriel pour développeurs'),
  primaryHref = localizedPath('/#developers', locale),
  body = t('The software is open source. Your technical team can evaluate it themselves. Or you can work with us on implementation and ongoing support. Both are paid services.', 'Le logiciel est open source : évaluez-le par vous-mêmes, ou travaillez avec nous sur la mise en œuvre et l’assistance technique dans la durée.'),
  emphasis = 'docs',
  note,
} = Astro.props;
---

<section class="final-cta" aria-labelledby="handoff-title">
  <div class="section-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="handoff-title">{heading}</h2>
    <p>{body}</p>
    <div class="hero-actions">
      {emphasis === 'pilot' ? (
        <>
          <a class="button button-primary" href={pricingHref}>{t('Implementation and pricing', 'Mise en œuvre et tarifs')}</a>
          <a class="button button-secondary" href={primaryHref} hreflang={englishHreflang(primaryHref, locale)}>{primaryLabel}</a>
        </>
      ) : (
        <>
          <a class="button button-primary" href={primaryHref} hreflang={englishHreflang(primaryHref, locale)}>{primaryLabel}</a>
          <a class="button button-secondary" href={pricingHref}>{t('Implementation and pricing', 'Mise en œuvre et tarifs')}</a>
        </>
      )}
    </div>
    {note && <p class="final-cta-note">{note}</p>}
  </div>
</section>

<style>
  .final-cta-note { font-size: var(--type-sm); margin-top: 12px; opacity: 0.85; }
</style>
