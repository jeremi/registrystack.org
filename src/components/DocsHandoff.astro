---
// Shared next steps for organizational readers and technical evaluators.
interface Props {
  eyebrow?: string;
  heading?: string;
  primaryLabel?: string;
  primaryHref?: string;
  body?: string;
  emphasis?: 'docs' | 'pilot';
  // A line under the buttons, such as the plain address behind a mailto button.
  note?: string;
}

const {
  eyebrow = 'Take the next step',
  heading = 'Explore it with your team.',
  primaryLabel = 'Try a developer tutorial',
  primaryHref = '/#developers',
  body = 'Evaluate the open-source software with your team, or work with us on implementation and ongoing support.',
  emphasis = 'docs',
  note,
} = Astro.props;
---

<section class="final-cta" aria-labelledby="handoff-title">
  <div class="section-inner">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="handoff-title">{heading}</h2>
    <p>{body}</p>
    <div class="hero-actions">
      {emphasis === 'pilot' ? (
        <>
          <a class="button button-primary" href="/pricing/">Implementation and support</a>
          <a class="button button-secondary" href={primaryHref}>{primaryLabel}</a>
        </>
      ) : (
        <>
          <a class="button button-primary" href={primaryHref}>{primaryLabel}</a>
          <a class="button button-secondary" href="/pricing/">Implementation and support</a>
        </>
      )}
    </div>
    {note && <p class="final-cta-note">{note}</p>}
  </div>
</section>

<style>
  .final-cta-note { font-size: var(--type-sm); margin-top: 12px; opacity: 0.85; }
</style>
