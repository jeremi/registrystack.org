---
import RecordCard from './RecordCard.astro';
import SignedAnswer from './SignedAnswer.astro';
import { localeForPath, translator } from '../i18n';

const t = translator(localeForPath(Astro.url.pathname));

// One fictional source record supports separately configured service requests.
// Keep the record and each result readable without JavaScript or animation.
const sourceFields = [
  { label: t('Date of birth', 'Date de naissance'), value: t('8 July 1988', '8 juillet 1988') },
  { label: t('Vital status', 'Statut vital'), value: t('Alive', 'En vie') },
  { label: t('Registered district', 'District d’enregistrement'), value: 'Northfield' },
  { label: t('Street address', 'Adresse'), value: '18 River Road' },
  { label: t('Marital status', 'Situation matrimoniale'), value: t('Married', 'Mariée') },
];

const answers = [
  { recipient: t('Pension service', 'Service des pensions'), question: t('Is this person alive?', 'Cette personne est-elle en vie ?'), fieldLabel: t('Vital status', 'Statut vital'), value: t('Alive', 'En vie') },
  { recipient: t('Licensing service', 'Service des autorisations'), question: t('Is this person 18 or older?', 'Cette personne a-t-elle 18 ans ou plus ?'), fieldLabel: t('18 or older', '18 ans ou plus'), value: t('Yes', 'Oui') },
  { recipient: t('Local office', 'Bureau local'), question: t('Where is this person registered?', 'Où cette personne est-elle enregistrée ?'), fieldLabel: t('Registered district', 'District d’enregistrement'), value: 'Northfield' },
];
---

<figure class="service-answers" aria-labelledby="service-answers-caption">
  <figcaption id="service-answers-caption">{t('Illustrative example with a fictional person record and separately configured service requests.', 'Exemple illustratif avec une fiche de personne fictive et des demandes de services configurées séparément.')}</figcaption>

  <div class="source-path">
    <section class="source-step" aria-labelledby="civil-source-title">
      <div class="step-heading">
        <p class="flow-label">{t('Kept by the civil registry', 'Tenu par le service de l’état civil')}</p>
        <h3 id="civil-source-title">{t('One source record', 'Une fiche source')}</h3>
      </div>
      <RecordCard recordType={t('Person record', 'Fiche de personne')} recordId="P-2084" name="Maya Okafor" icon="person" fields={sourceFields} />
      <p class="source-note">{t('The registry owner maintains the record. The full record stays here.', 'Le service qui tient le registre met la fiche à jour. La fiche complète reste ici.')}</p>
    </section>

    <svg class="source-connector" viewBox="0 0 72 32" fill="none" aria-hidden="true">
      <path d="M1 16h66M56 5l11 11-11 11" />
    </svg>

    <section class="gateway-step" aria-labelledby="civil-gateway-title">
      <div class="gateway-heading">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M16 3 5 7v8c0 7 6 11 11 14 5-3 11-7 11-14V7L16 3Z" />
          <path d="m10 15 4 4 8-9" />
        </svg>
        <div>
          <p class="flow-label">Evidence Gateway</p>
          <h3 id="civil-gateway-title">{t('Check each request', 'Contrôler chaque demande')}</h3>
        </div>
      </div>
      <p>{t('The registry owner defines which questions each service may ask.', 'Le service qui tient le registre définit les questions que chaque service peut poser.')}</p>
      <div class="permitted-request">
        <p class="permission-label">{t('When permitted', 'Si la demande est autorisée')}</p>
        <p>{t('Derive and sign only the agreed answer.', 'Seule la réponse convenue est établie et signée.')}</p>
      </div>
      <div class="refused-request" role="group" aria-labelledby="refused-request-title">
        <p class="request-origin">{t('Data broker asks', 'Un courtier en données demande')}</p>
        <h4 id="refused-request-title">{t('What is this person’s marital status?', 'Quelle est la situation matrimoniale de cette personne ?')}</h4>
        <p class="refused-status">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="7" /><path d="m5 5 10 10" />
          </svg>
          {t('Request not permitted', 'Demande non autorisée')}
        </p>
        <p class="refused-note">{t('No source information returned.', 'Aucune information de la source n’est renvoyée.')}</p>
      </div>
    </section>
  </div>

  <section class="returned-answers" aria-labelledby="civil-answers-title">
    <div class="answers-heading">
      <svg viewBox="0 0 28 36" fill="none" aria-hidden="true">
        <path d="M14 1v30M4 21l10 10 10-10" />
      </svg>
      <div>
        <p class="flow-label">{t('Returned separately to each service', 'Renvoyée séparément à chaque service')}</p>
        <h3 id="civil-answers-title">{t('One answer for each permitted request', 'Une réponse pour chaque demande autorisée')}</h3>
      </div>
    </div>
    <div class="answer-grid">
      {answers.map((answer) => (
        <div class="service-response">
          <p class="service-question">{answer.question}</p>
          <SignedAnswer fieldLabel={answer.fieldLabel} value={answer.value} recipient={answer.recipient} issuer={t('Civil registry', 'État civil')} />
        </div>
      ))}
    </div>
  </section>

  <div class="flow-notes">
    <p><strong>{t('Kept at source', 'Conservé à la source')}</strong> {t('Date of birth, street address, marital status, and the rest of the record.', 'La date de naissance, l’adresse, la situation matrimoniale et le reste de la fiche.')}</p>
    <p><strong>{t('Audit', 'Audit')}</strong> {t('Each request and its outcome are recorded.', 'Chaque demande et son résultat sont enregistrés.')}</p>
  </div>
</figure>

<style>
  .service-answers { margin: 32px auto 0; max-width: 1080px; }
  figcaption { color: var(--registry-muted); font-size: var(--type-sm); line-height: 1.5; margin-bottom: 22px; }
  .source-path { align-items: center; display: grid; gap: clamp(18px, 2.5vw, 30px); grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr); }
  .source-step, .gateway-step { min-width: 0; }
  .step-heading { margin-bottom: 13px; }
  .flow-label { color: var(--registry-blue); font: var(--type-2xs)/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .step-heading h3, .gateway-heading h3, .answers-heading h3 { color: var(--registry-ink); font-size: var(--type-subhead); line-height: 1.3; margin: 5px 0 0; }
  .source-note { color: var(--registry-muted); font-size: var(--type-sm); line-height: 1.5; margin: 14px 0 0; }
  .source-connector { color: var(--registry-blue); height: 32px; stroke: currentColor; stroke-width: 1.5; width: 100%; }
  .gateway-step { background: var(--registry-white); border: 1px solid var(--registry-blue-rule); border-top: 3px solid var(--registry-blue); padding: clamp(20px, 2.5vw, 28px); }
  .gateway-heading { align-items: center; display: flex; gap: 14px; }
  .gateway-heading > svg { color: var(--registry-blue); flex: 0 0 32px; height: 32px; stroke: currentColor; stroke-width: 1.5; }
  .gateway-step > p { color: var(--registry-body); font-size: var(--type-md); line-height: 1.6; margin: 18px 0; }
  .permitted-request { border-left: 2px solid var(--registry-blue); padding-left: 13px; }
  .permitted-request p { color: var(--registry-body); font-size: var(--type-base); line-height: 1.5; margin: 4px 0 0; }
  .permitted-request .permission-label { color: var(--registry-blue); font-size: var(--type-xs); font-weight: 700; margin: 0; }
  .refused-request { background: var(--registry-stamp-tint); border: 1px solid #e2d4ce; border-left: 3px solid var(--registry-stamp); margin-top: 24px; padding: 15px 17px; }
  .request-origin { color: var(--registry-body); font: var(--type-2xs)/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .refused-request h4 { color: var(--registry-ink); font-size: var(--type-base); font-weight: 400; line-height: 1.5; margin: 6px 0 14px; }
  .refused-status { align-items: center; color: var(--registry-stamp); display: flex; font-size: var(--type-base); font-weight: 700; gap: 7px; line-height: 1.4; margin: 0; }
  .refused-status svg { flex: 0 0 18px; stroke: currentColor; stroke-width: 1.4; }
  .refused-note { color: var(--registry-body); font-size: var(--type-xs); line-height: 1.5; margin: 5px 0 0; }
  .returned-answers { margin-top: 30px; }
  .answers-heading { align-items: center; display: flex; gap: 14px; margin-bottom: 22px; }
  .answers-heading > svg { color: var(--registry-blue); flex: 0 0 28px; height: 36px; stroke: currentColor; stroke-width: 1.5; }
  .answer-grid { display: grid; gap: 20px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .service-response { display: flex; flex-direction: column; min-width: 0; }
  .service-question { color: var(--registry-ink); font-size: var(--type-md); font-weight: 600; line-height: 1.5; margin: 0 0 12px; }
  .service-response :global(.signed-answer) { margin-top: auto; }
  .flow-notes { border-top: 1px solid var(--registry-paper-rule); display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 24px; padding-top: 16px; }
  .flow-notes p { color: var(--registry-muted); font-size: var(--type-sm); line-height: 1.5; margin: 0; }
  .flow-notes strong { color: var(--registry-body); font-weight: 600; margin-right: 7px; }
  @media (max-width: 900px) {
    .source-path { gap: 16px; grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr); }
    .gateway-step { padding: 18px; }
    .gateway-heading { gap: 10px; }
    .gateway-heading > svg { flex-basis: 26px; height: 26px; }
    .answer-grid { gap: 14px; }
  }
  @media (max-width: 700px) {
    .source-path, .answer-grid { grid-template-columns: minmax(0, 1fr); }
    .source-connector { height: 32px; justify-self: center; transform: rotate(90deg); width: 46px; }
    .gateway-step { padding: 22px; }
    .answer-grid { gap: 22px; }
    .service-question { margin-bottom: 10px; }
  }
</style>
