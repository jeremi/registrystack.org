---
import RecordCard from './RecordCard.astro';
import SignedAnswer from './SignedAnswer.astro';

// One fictional source record supports separately configured service requests.
// Keep the record and each result readable without JavaScript or animation.
const sourceFields = [
  { label: 'Date of birth', value: '8 July 1988' },
  { label: 'Vital status', value: 'Alive' },
  { label: 'Registered district', value: 'Northfield' },
  { label: 'Street address', value: '18 River Road' },
  { label: 'Marital status', value: 'Married' },
];

const answers = [
  { recipient: 'Pension service', question: 'Is this person alive?', fieldLabel: 'Vital status', value: 'Alive' },
  { recipient: 'Licensing service', question: 'Is this person 18 or older?', fieldLabel: '18 or older', value: 'Yes' },
  { recipient: 'Local office', question: 'Where is this person registered?', fieldLabel: 'Registered district', value: 'Northfield' },
];
---

<figure class="service-answers" aria-labelledby="service-answers-caption">
  <figcaption id="service-answers-caption">Illustrative example with a fictional person record and separately configured service requests.</figcaption>

  <div class="source-path">
    <section class="source-step" aria-labelledby="civil-source-title">
      <div class="step-heading">
        <p class="flow-label">Kept by the civil registry</p>
        <h3 id="civil-source-title">One source record</h3>
      </div>
      <RecordCard recordType="Person record" recordId="P-2084" name="Maya Okafor" icon="person" fields={sourceFields} />
      <p class="source-note">The registry owner maintains the record. The full record stays here.</p>
    </section>

    <svg class="source-connector" viewBox="0 0 72 32" fill="none" aria-hidden="true">
      <path d="M1 16h66M56 5l11 11-11 11" />
    </svg>

    <section class="gateway-step" aria-labelledby="civil-gateway-title">
      <div class="gateway-heading">
        <svg viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M16 3 5 7v8c0 7 6 11 11 14 5-3 11-7 11-14V7L16 3Z" />
          <path d="m10 15 4 4 8-9" />
        </svg>
        <div>
          <p class="flow-label">Evidence Gateway</p>
          <h3 id="civil-gateway-title">Check each request</h3>
        </div>
      </div>
      <p>The registry owner defines which questions each service may ask.</p>
      <div class="permitted-request">
        <p class="permission-label">When permitted</p>
        <p>Derive and sign only the agreed answer.</p>
      </div>
      <div class="refused-request" role="group" aria-labelledby="refused-request-title">
        <p class="request-origin">Data broker asks</p>
        <h4 id="refused-request-title">What is this person’s marital status?</h4>
        <p class="refused-status">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="7" /><path d="m5 5 10 10" />
          </svg>
          Request not permitted
        </p>
        <p class="refused-note">No source information returned.</p>
      </div>
    </section>
  </div>

  <section class="returned-answers" aria-labelledby="civil-answers-title">
    <div class="answers-heading">
      <svg viewBox="0 0 28 36" fill="none" aria-hidden="true">
        <path d="M14 1v30M4 21l10 10 10-10" />
      </svg>
      <div>
        <p class="flow-label">Returned separately to each service</p>
        <h3 id="civil-answers-title">One answer for each permitted request</h3>
      </div>
    </div>
    <div class="answer-grid">
      {answers.map((answer) => (
        <div class="service-response">
          <p class="service-question">{answer.question}</p>
          <SignedAnswer fieldLabel={answer.fieldLabel} value={answer.value} recipient={answer.recipient} issuer="Civil registry" />
        </div>
      ))}
    </div>
  </section>

  <div class="flow-notes">
    <p><strong>Kept at source</strong> Date of birth, street address, marital status, and the rest of the record.</p>
    <p><strong>Audit</strong> Each request and its outcome are recorded.</p>
  </div>
</figure>

<style>
  .service-answers { margin: 32px auto 0; max-width: 1080px; }
  figcaption { color: var(--registry-muted); font-size: 13px; line-height: 1.5; margin-bottom: 22px; }
  .source-path { align-items: center; display: grid; gap: clamp(18px, 2.5vw, 30px); grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr); }
  .source-step, .gateway-step { min-width: 0; }
  .step-heading { margin-bottom: 13px; }
  .flow-label { color: var(--registry-blue); font: 11px/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .step-heading h3, .gateway-heading h3, .answers-heading h3 { color: var(--registry-ink); font-size: 21px; line-height: 1.3; margin: 5px 0 0; }
  .source-note { color: var(--registry-muted); font-size: 13px; line-height: 1.5; margin: 14px 0 0; }
  .source-connector { color: var(--registry-blue); height: 32px; stroke: currentColor; stroke-width: 1.5; width: 100%; }
  .gateway-step { background: #fff; border: 1px solid #c4d2e9; border-top: 3px solid var(--registry-blue); padding: clamp(20px, 2.5vw, 28px); }
  .gateway-heading { align-items: center; display: flex; gap: 14px; }
  .gateway-heading > svg { color: var(--registry-blue); flex: 0 0 32px; height: 32px; stroke: currentColor; stroke-width: 1.5; }
  .gateway-step > p { color: var(--registry-body); font-size: 15px; line-height: 1.6; margin: 18px 0; }
  .permitted-request { border-left: 2px solid var(--registry-blue); padding-left: 13px; }
  .permitted-request p { color: var(--registry-body); font-size: 14px; line-height: 1.5; margin: 4px 0 0; }
  .permitted-request .permission-label { color: var(--registry-blue); font-size: 12px; font-weight: 700; margin: 0; }
  .refused-request { background: #fbf7f5; border: 1px solid #e2d4ce; border-left: 3px solid var(--registry-stamp); margin-top: 24px; padding: 15px 17px; }
  .request-origin { color: var(--registry-body); font: 11px/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .refused-request h4 { color: var(--registry-ink); font-size: 14px; font-weight: 500; line-height: 1.5; margin: 6px 0 14px; }
  .refused-status { align-items: center; color: var(--registry-stamp); display: flex; font-size: 14px; font-weight: 700; gap: 7px; line-height: 1.4; margin: 0; }
  .refused-status svg { flex: 0 0 18px; stroke: currentColor; stroke-width: 1.4; }
  .refused-note { color: var(--registry-body); font-size: 12px; line-height: 1.5; margin: 5px 0 0; }
  .returned-answers { margin-top: 30px; }
  .answers-heading { align-items: center; display: flex; gap: 14px; margin-bottom: 22px; }
  .answers-heading > svg { color: var(--registry-blue); flex: 0 0 28px; height: 36px; stroke: currentColor; stroke-width: 1.5; }
  .answer-grid { display: grid; gap: 20px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .service-response { display: flex; flex-direction: column; min-width: 0; }
  .service-question { color: var(--registry-ink); font-size: 15px; font-weight: 600; line-height: 1.5; margin: 0 0 12px; }
  .service-response :global(.signed-answer) { margin-top: auto; }
  .flow-notes { border-top: 1px solid #d7ddd5; display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 24px; padding-top: 16px; }
  .flow-notes p { color: var(--registry-muted); font-size: 13px; line-height: 1.5; margin: 0; }
  .flow-notes strong { color: var(--registry-body); font-weight: 600; margin-right: 7px; }
  @media (max-width: 900px) {
    .source-path { gap: 16px; grid-template-columns: minmax(0, 1fr) 40px minmax(0, 1fr); }
    .gateway-step { padding: 18px; }
    .gateway-heading { gap: 10px; }
    .gateway-heading > svg { flex-basis: 26px; height: 26px; }
    .answer-grid { gap: 14px; }
  }
  @media (max-width: 700px) {
    .source-path, .answer-grid { grid-template-columns: minmax(0, 1fr); }
    .source-connector { height: 32px; justify-self: center; transform: rotate(90deg); width: 46px; }
    .gateway-step { padding: 22px; }
    .answer-grid { gap: 22px; }
    .service-question { margin-bottom: 10px; }
  }
</style>
