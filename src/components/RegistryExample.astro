---
import PersonHouseholdRecords from './PersonHouseholdRecords.astro';
import SignedAnswer from './SignedAnswer.astro';
import { localeForPath, translator } from '../i18n';
const t = translator(localeForPath(Astro.url.pathname));
---

<figure class="registry-example" aria-labelledby="registry-example-caption">
  <div class="example-source">
    <div class="example-heading">
      <p class="example-product">Base Registry Engine</p>
      <p class="example-description">{t('Stores and manages linked records', 'Conserve et gère des fiches liées')}</p>
    </div>
    <PersonHouseholdRecords />
    <p class="example-history">
      <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 8a7 7 0 1 1 1 6M3 3v5h5m2-3v5l3 2" /></svg>
      {t('Current records and their change history', 'Fiches actuelles et historique de leurs modifications')}
    </p>
  </div>
  <div class="example-exchange">
    <div class="example-heading">
      <p class="example-product">Evidence Gateway</p>
      <p class="example-description">{t('Answers an approved question', 'Répond à une question approuvée')}</p>
    </div>
    <p class="example-question">{t('Is Amara 18 or older?', 'Amara a-t-elle 18 ans ou plus ?')}</p>
    <SignedAnswer fieldLabel={t('18 or older', '18 ans ou plus')} value={t('Yes', 'Oui')} recipient={t('Licensing service', 'Service de délivrance des autorisations')} issuer={t('Registry authority', 'Autorité du registre')} />
    <p class="example-detail">{t('Date of birth and household details stay in the registry.', 'La date de naissance et les informations du ménage restent dans le registre.')}</p>
  </div>
  <figcaption id="registry-example-caption">{t('Fictional records and a configured connection. Each product can also be used independently.', 'Fiches fictives et connexion configurée. Chaque produit peut aussi être utilisé séparément.')}</figcaption>
</figure>

<style>
  .registry-example { color: var(--registry-ink); background: var(--registry-white); border-top: 4px solid var(--registry-brass); box-shadow: var(--offset-lg); margin: 0; width: 100%; }
  .example-source { padding: 20px; background: var(--registry-code-bg); }
  .example-heading { margin-bottom: 16px; }
  .example-product { color: var(--registry-blue); font-size: var(--type-base); font-weight: 700; line-height: 1.4; margin: 0 0 3px; }
  .example-description { color: var(--registry-body); font-size: var(--type-xs); line-height: 1.5; margin: 0; }
  .example-history { display: flex; gap: 7px; align-items: center; color: var(--registry-body); font-size: var(--type-2xs); line-height: 1.5; margin: 13px 0 0; }
  .example-history svg { flex: 0 0 16px; }
  .example-exchange { border-top: 1px solid var(--registry-slate-rule); padding: 20px; }
  .example-exchange .example-heading { margin-bottom: 11px; }
  .example-question { font-size: var(--type-body-sm); font-weight: 600; line-height: 1.45; color: var(--registry-ink); margin: 0 0 12px; }
  .example-detail { color: var(--registry-muted); font-size: var(--type-xs); line-height: 1.5; margin: 12px 0 0; }
  figcaption { background: var(--registry-code-bg); border-top: 1px solid var(--registry-slate-rule-light); color: var(--registry-body); padding: 12px 20px; font-size: var(--type-2xs); line-height: 1.5; }
</style>
