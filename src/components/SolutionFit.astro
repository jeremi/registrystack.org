---
// "How it fits your institution" for a solution area: each product the area
// leads to, from products.ts, with its job in this area, then how the area
// fits the institution, including any systems it chooses to retain. A register family also
// links to the review queue page, which applies to any register.
import type { SolutionArea } from '../data/solutions';
import { products as englishProducts } from '../data/products';
import { products as frenchProducts } from '../data/fr/products';
import { localeForPath, localizedPath, translator } from '../i18n';

interface Item {
  term: string;
  body: string;
}

interface Props {
  area: SolutionArea;
  heading: string;
  jobs: Record<string, string>;
  extra?: Item[];
  muted?: boolean;
}

const { area, heading, jobs, extra = [], muted = false } = Astro.props;
// French pages list the French products and link to their French pages.
const locale = localeForPath(Astro.url.pathname);
const t = translator(locale);
const products = locale === 'fr' ? frenchProducts : englishProducts;
const areaProducts = area.products.map((key) => {
  const product = products.find((p) => p.key === key);
  if (!product) throw new Error(`solution area ${area.key} names unknown product ${key}`);
  const job = jobs[key];
  if (!job) throw new Error(`solution area ${area.key} has no job sentence for product ${key}`);
  return { product, job };
});
---
<section id="fit" class={muted ? 'section section-muted' : 'section'} aria-labelledby="solution-fit-title">
  <div class="section-inner product-fit">
    <div class="section-heading compact">
      <p class="eyebrow">{t('How it fits your institution', 'Comment cela s’intègre dans votre institution')}</p>
      <h2 id="solution-fit-title">{heading}</h2>
      <slot />
      {area.kind === 'register-family' && <p><a class="inline-cta" href={localizedPath('/solutions/review-changes/#what-your-office-calls-it', locale)}>{t('See how staff review a request', 'Voir comment les agents examinent une demande')} <span aria-hidden="true">→</span></a></p>}
    </div>
    <dl>
      {areaProducts.map(({ product, job }) => (
        <>
          <dt><a href={localizedPath(product.href, locale)}>{product.name}</a></dt>
          <dd>{job}</dd>
        </>
      ))}
      {extra.map((item) => (
        <>
          <dt>{item.term}</dt>
          <dd>{item.body}</dd>
        </>
      ))}
    </dl>
  </div>
</section>
