---
import RecordCard from './RecordCard.astro';

const sourceFields: Array<{ label: string; value: string; state: 'selected' | 'withheld' }> = [
  { label: 'Household reference', value: 'H-208', state: 'selected' },
  { label: 'District', value: 'Northfield', state: 'selected' },
  { label: 'Enrollment status', value: 'Enrolled', state: 'selected' },
  { label: 'Home address', value: '14 Market Lane', state: 'withheld' },
  { label: 'Payment details', value: 'Account ending 4418', state: 'withheld' },
];
const returnedFields = sourceFields
  .filter((field) => field.state === 'selected')
  .map(({ label, value }) => ({ label, value }));
---

<figure class="registry-flow" aria-labelledby="registry-flow-title">
  <div class="flow-intro">
    <p class="flow-kicker">An illustrative sharing agreement</p>
    <h3 id="registry-flow-title">The registry owner controls which fields each service can receive.</h3>
  </div>

  <div class="field-journey" role="group" aria-label="Fictional household record showing selected and withheld fields">
    <section class="source-panel" aria-labelledby="source-panel-title">
      <div class="panel-heading">
        <p class="panel-label">Registry owner</p>
        <h4 id="source-panel-title">Source record</h4>
      </div>
      <RecordCard recordType="Household record" recordId="H-208" icon="household" fields={sourceFields} />
      <p class="source-note">Corrections and updates stay in this source register.</p>
    </section>

    <section class="boundary-panel" aria-labelledby="field-permissions-title">
      <p class="panel-label">Registry Relay</p>
      <h4 id="field-permissions-title">Field permissions</h4>
      <svg class="boundary-arrow" viewBox="0 0 120 48" fill="none" aria-hidden="true">
        <path d="M1 24h114m-11-11 11 11-11 11" />
        <path d="M49 6h16v36H49z" />
      </svg>
      <p class="boundary-gate"><strong>3 agreed fields</strong><span>Returned for this request</span></p>
      <p class="boundary-stop"><span aria-hidden="true">−</span>Other fields stay at source</p>
    </section>

    <section class="service-panel" aria-labelledby="service-panel-title">
      <div class="panel-heading">
        <p class="panel-label">Public assistance service</p>
        <h4 id="service-panel-title">Selected data returned</h4>
      </div>
      <div class="returned-record">
        <p class="response-label"><span aria-hidden="true">↳</span> Response · 3 fields</p>
        <RecordCard recordType="Household data" recordId="H-208" icon="household" fields={returnedFields} />
      </div>
      <p class="service-note">The service receives the agreed values and record reference.</p>
    </section>

    <div class="audit-slip">
      <svg class="audit-mark" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 3h12v18H6zM9 7h6M9 11h6M9 15h4" />
      </svg>
      <p><strong>Audit record</strong> Requested fields, access rules and purpose, outcome, and time.</p>
    </div>
  </div>

  <figcaption>Fictional household data. The full source record remains with the registry owner.</figcaption>
</figure>

<style>
  .registry-flow { margin: 0 auto; max-width: var(--registry-max); }
  .flow-intro { border-bottom: 1px solid #d7ddd5; margin-bottom: 25px; padding-bottom: 20px; }
  .flow-intro h3 { font-size: 20px; line-height: 1.4; margin: 7px 0 0; }
  .flow-kicker, .panel-label { color: var(--registry-blue); font: 11px/1.5 var(--registry-mono); margin: 0; text-transform: uppercase; }
  .field-journey { align-items: start; display: grid; gap: 24px; grid-template-columns: minmax(0, 1.15fr) minmax(145px, 0.5fr) minmax(0, 1fr); }
  .source-panel, .service-panel { min-width: 0; }
  .panel-heading { margin-bottom: 13px; }
  .panel-heading h4 { font-size: 20px; line-height: 1.3; margin: 5px 0 0; }
  .source-note, .service-note { color: var(--registry-muted); font-size: 13px; line-height: 1.5; margin: 14px 0 0; }
  .boundary-panel { align-self: center; padding: 18px 0; text-align: center; }
  .boundary-panel h4 { font-size: 17px; line-height: 1.35; margin: 7px 0 15px; }
  .boundary-arrow { color: var(--registry-blue); display: block; height: 48px; margin: 0 auto 16px; max-width: 120px; stroke: currentColor; stroke-width: 1.5; width: 100%; }
  .boundary-gate { color: var(--registry-blue); font-size: 13px; line-height: 1.5; margin: 0; }
  .boundary-gate strong, .boundary-gate span { display: block; }
  .boundary-gate span { color: var(--registry-muted); font-size: 12px; margin-top: 2px; }
  .boundary-stop { border-top: 1px solid #d7ddd5; color: var(--registry-muted); font-size: 12px; line-height: 1.5; margin: 15px 0 0; padding-top: 13px; }
  .boundary-stop > span { color: var(--registry-stamp); font-size: 18px; margin-right: 4px; }
  .returned-record { background: #e8eef8; padding: 0 10px 10px; }
  .response-label { align-items: center; color: var(--registry-blue); display: flex; gap: 8px; font: 11px/1.5 var(--registry-mono); margin: 0; padding: 10px 5px; }
  .response-label > span { font-size: 17px; }
  .audit-slip { align-items: center; border-top: 1px solid #d7ddd5; display: flex; gap: 12px; grid-column: 1 / -1; padding-top: 18px; }
  .audit-mark { color: var(--registry-blue); flex: 0 0 auto; height: 25px; stroke: currentColor; stroke-width: 1.5; width: 25px; }
  .audit-slip p { color: var(--registry-muted); font-size: 13px; line-height: 1.5; margin: 0; }
  .audit-slip strong { color: var(--registry-body); font-weight: 600; margin-right: 8px; }
  .registry-flow figcaption { color: var(--registry-muted); font-size: 12px; line-height: 1.5; margin-top: 16px; }
  @media (max-width: 800px) {
    .field-journey { gap: 20px; grid-template-columns: minmax(0, 1fr); }
    .boundary-panel { align-items: center; background: var(--registry-active); display: grid; gap: 5px 18px; grid-template-columns: 1fr auto; padding: 16px 20px; text-align: left; }
    .boundary-panel > .panel-label, .boundary-panel h4, .boundary-gate, .boundary-stop { grid-column: 1; }
    .boundary-panel h4 { margin: 0 0 6px; }
    .boundary-arrow { grid-column: 2; grid-row: 1 / 5; height: 48px; margin: 0; transform: rotate(90deg); width: 58px; }
    .boundary-stop { border: 0; margin: 0; padding-top: 4px; }
    .audit-slip { align-items: start; }
  }
</style>
