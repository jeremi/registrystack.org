---
// One starter in the catalogue: its title and what it records. Counts and
// parts stay on the starter's own page.
// `featured` marks the starter its family suggests first; `eyebrow` names
// the family when the card sits outside its family's section.
import { starterLead, type Starter } from '../data/starters';

interface Props {
  starter: Starter;
  featured?: boolean;
  eyebrow?: string;
}
const { starter, featured = false, eyebrow } = Astro.props;
---
<article class:list={['starter-card', { 'is-featured': featured }]}>
  {(eyebrow || featured) && (
    <p class="starter-card-eyebrow">
      {eyebrow && <span>{eyebrow}</span>}
      {featured && <span class="starter-card-featured">Start here</span>}
    </p>
  )}
  <h3><a href={`/starters/${starter.id}/`}>{starter.title}</a></h3>
  <p>{starterLead(starter)}</p>
</article>

<style>
  .starter-card {
    background: var(--registry-white);
    border: 1px solid var(--registry-rule);
    display: flex;
    flex-direction: column;
    padding: 22px;
  }

  .starter-card.is-featured {
    border-color: var(--registry-blue-rule-strong);
    border-top: 3px solid var(--registry-brass);
  }

  .starter-card h3 {
    font-size: var(--type-body);
    margin-bottom: 8px;
  }

  .starter-card .starter-card-eyebrow {
    color: var(--registry-muted);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--type-xs);
    gap: 6px 10px;
    margin-bottom: 10px;
  }

  .starter-card-featured {
    background: var(--registry-brass);
    color: var(--registry-ink);
    font-family: var(--registry-mono);
    font-size: var(--type-2xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 2px 6px;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .starter-card p {
    font-size: var(--type-md);
    margin-bottom: 12px;
  }
</style>
